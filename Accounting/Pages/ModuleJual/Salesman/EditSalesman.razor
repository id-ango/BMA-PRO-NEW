@page "/ModuleJual/EditSalesman/{Id:int}"
@using eSoft.Penjualan.Model
@using eSoft.Penjualan.View
@using eSoft.Penjualan.Services
@using Accounting.Services

@inject ISalesServices service
@inject NavigationManager navigationmanager

<h3>Edit Salesman</h3>

<EditForm Model="@bank" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>
            Salesman :
            <InputText id="codeBank" class="form-control" @bind-Value="bank.Salesman" style="text-transform:uppercase" @onfocusout="cekKode" disabled="disabled" />
        </label>
    </div>
    <div class="form-group">
        <label>
            Nama :
            <InputText class="form-control" @bind-Value="bank.NamaSales" />
        </label>
    </div>
    <div class="form-group">
        <table style="width:100%">
            <tr>
                <td style="width:70%">
                    <label>
                        Alamat :
                        <InputTextArea class="form-control" @bind-Value="bank.Alamat" />
                    </label>
                </td>
                <td style="width:30%">
                    <label>
                        Kota :
                        <InputText class="form-control" @bind-Value="bank.Kota" />
                    </label>
                </td>
            </tr>
            <tr>
                <td style="width:70%">
                    <label>
                        Keterangan :
                        <InputTextArea class="form-control" @bind-Value="bank.AlmtKrm" />
                    </label>
                </td>
               @* <td style="width:30%">
                    <label>
                        Kota Kirim :
                        <InputText class="form-control" @bind-Value="bank.KotaKrm" />
                    </label>
                </td>*@
            </tr>
        </table>

    </div>


    <div class="form-group">
        <label>
            Telpon :
            <InputText class="form-control" @bind-Value="bank.Telpon" />
        </label>
    </div>

    <div class="form-group">
        <label>
            Kontak Person :
            <InputText class="form-control" @bind-Value="bank.Kontak" />
        </label>
    </div>
@*    <div class="form-group">
        <label>
            NPWP/NIK :
            <InputText class="form-control" @bind-Value="bank.NPWP_Cust" />
        </label>
    </div>
*@
@*    <br />
     <div class="form-group">
        <label>
            Termin :
            <InputNumber class="form-control" @bind-Value="bank.Termin" />
        </label>
    </div>*@

@*    <br />
    <div class="form-group">
        <label>
            Set Account :
            <InputSelect class="form-control" @bind-Value="bank.AcctSet" style="width:80%; display:inline">
                <option value="">&nbsp;&nbsp;---Select Set Account---&nbsp;&nbsp;</option>
                @foreach (var item in GlAccounts)
                {
                    <option value="@item.AcctSet">@item.Description</option>
                }

            </InputSelect>
            <button class="btn btn-primary" type="button" @onclick="@(()=> SearchOpen = !SearchOpen)">Cari</button>
        </label>
    </div>*@

    <br />
    <div class="float-md-right">
        <button class="btn-success" type="submit">Simpan</button>
        <button class="btn-danger" type="button" @onclick="@(() => navigationmanager.NavigateTo("/ModuleJual/SetupKurir", false))">Batal</button>
    </div>


</EditForm>

@if (DialogOpen)
{
    <ModalDialogComponent Title="Alert" Text="Kurir Sudah Ada" TombolSave="false" OnClose="OnDialogClose"></ModalDialogComponent>
}


<style>
    label {
        width: 100%;
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    OeSalesmanView bank = new ();
    OeSalesman Bank = new ();
    public string Testing { get; set; }
    private bool DialogOpen { get; set; }
 
    public bool SearchOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadBank();
      
    }

    void LoadBank()
    {
        Bank = service.GetSalesmanId(Id);
        bank.OeSalesmanId = Bank.OeSalesmanId;
        bank.Salesman = Bank.Salesman;
        bank.NamaSales = Bank.NamaSales;
        bank.Alamat = Bank.Alamat;
        bank.Kota = Bank.Kota;
        bank.AlmtKrm = Bank.AlmtKrm;
        bank.KotaKrm = Bank.KotaKrm;
        bank.Telpon = Bank.Telpon;
        bank.Kontak = Bank.Kontak;
        bank.AcctSet = Bank.AcctSet;
        bank.NPWP_Sales = Bank.NPWP_Sales;
        bank.Termin = Bank.Termin;

    }

    private void cekKode()
    {
        Testing = bank.Salesman;
        DialogOpen = service.CekKdSalesman(Testing);
        if (DialogOpen)
        {
            bank.Salesman = "";
        }
        StateHasChanged();
    }

    private void OnDialogClose(bool accepted)
    {

        DialogOpen = false;
        StateHasChanged();

    }



    private async Task HandleValidSubmit()
    {
        var newEdit = await service.EditSalesman(bank);
        if (newEdit)
        {


        }

        navigationmanager.NavigateTo("/ModuleJual/SetupSalesman", false);

    }

   

