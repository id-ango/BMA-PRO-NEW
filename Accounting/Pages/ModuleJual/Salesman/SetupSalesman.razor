@page "/ModuleJual/SetupSalesman"
@attribute [Authorize(Roles = "Admin, Finance")]
@using eSoft.Penjualan.Model
@using eSoft.Penjualan.Services
@using Accounting.Services
@using System.IO

@inject ISalesServices piutang

@inject NavigationManager navigationmanager

@inject IJSRuntime JS

<div class="container">
    <h1>Setup Salesman</h1>
</div>


<div class="container">
    <NavLink href="/ModuleJual/AddSalesman" class="btn btn-primary">Add</NavLink>
</div>


<br />
<br />


<div class="container">
    <DataGridComponent Items="SortedBanks"
                       Context="cbBank"
                       GetFilterableText="@(item =>$"{item.Salesman} {item.NamaSales} {item.Alamat} {item.AlmtKrm}  {item.Kota} {item.Telpon}")"
                       TotalEnabled=false>

        <TableHeader>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(OeSalesman.Salesman)))" @onclick='() => ApplySort(nameof(OeSalesman.Salesman))'>Code <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(OeSalesman.Salesman))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(OeSalesman.NamaSales)))" @onclick='() => ApplySort(nameof(OeSalesman.NamaSales))'>Nama <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(OeSalesman.NamaSales))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass("Address"))" @onclick='() => ApplySort("Address")'>Alamat <span class="data-grid-sort-indicator">@GetSortIndicator("Address")</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(OeSalesman.Telpon)))" @onclick='() => ApplySort(nameof(OeSalesman.Telpon))'>Telpon <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(OeSalesman.Telpon))</span></button></th>
            @* <th scope="col">Piutang</th>*@
            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@cbBank.Salesman</td>
            <td>@cbBank.NamaSales</td>
            <td>
                <span>@cbBank.Alamat</span>
                <span>@cbBank.Kota</span>
            </td>
            <td>@cbBank.Telpon</td>
            @*  <td>@cbBank.Piutang.ToString("N")</td>*@
            <td>
                <button @onclick="() => OpenRubah(cbBank.OeSalesmanId)" class="btn btn-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                    </svg>
                </button>
                <button @onclick="() => OpenDeleteDialog(cbBank)" class="btn btn-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                    </svg>
                </button>
            </td>
        </RowTemplate>
    </DataGridComponent>


</div>

@if (DeleteDialogOpen)
{
    <ModalDialogComponent Title="Are you sure?" Text="Do you want to delete this entry?" OnClose="OnDeleteDialogClose"></ModalDialogComponent>
}

@if (NullDialogOpen)
{
    <ModalDialogComponent Title="MESSAGE" Text="Receivable is not Zero" TombolSave="false" OnClose="OnDeleteNullClose"></ModalDialogComponent>
}



@code {

    private List<OeSalesman> Banks;
    private OeSalesman _bankToDelete;
    private string currentSortColumn = nameof(OeSalesman.Salesman);
    private bool sortAscending = true;

    private IEnumerable<OeSalesman> SortedBanks => ApplyCurrentSort(Banks ?? new List<OeSalesman>());

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadGet();

    }

    private void LoadGet()
    {
        Banks = piutang.GetSalesman();
    }

    private void ApplySort(string columnName)
    {
        if (string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            sortAscending = !sortAscending;
            return;
        }

        currentSortColumn = columnName;
        sortAscending = true;
    }

    private IEnumerable<OeSalesman> ApplyCurrentSort(IEnumerable<OeSalesman> source)
    {
        return currentSortColumn switch
        {
            nameof(OeSalesman.NamaSales) => OrderBy(source, x => x.NamaSales),
            "Address" => OrderBy(source, x => $"{x.Alamat} {x.Kota}"),
            nameof(OeSalesman.Telpon) => OrderBy(source, x => x.Telpon),
            _ => OrderBy(source, x => x.Salesman)
        };
    }

    private IEnumerable<OeSalesman> OrderBy<TKey>(IEnumerable<OeSalesman> source, Func<OeSalesman, TKey> keySelector)
    {
        return sortAscending ? source.OrderBy(keySelector) : source.OrderByDescending(keySelector);
    }

    private string GetSortButtonClass(string columnName)
    {
        return string.Equals(currentSortColumn, columnName, StringComparison.Ordinal) ? "active" : string.Empty;
    }

    private string GetSortIndicator(string columnName)
    {
        if (!string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            return "↕";
        }

        return sortAscending ? "↑" : "↓";
    }


    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {
            await piutang.DelSalesman(_bankToDelete.OeSalesmanId);
            _bankToDelete = null;
        }

        DeleteDialogOpen = false;
        LoadGet();

        StateHasChanged();

    }

    private void OnDeleteNullClose(bool accepted)
    {
        //if (accepted)
        //{
        //    await cashBank.DelBank(_bankToDelete.CbBankId);
        //    _bankToDelete = null;
        //}

        DeleteDialogOpen = false;
        NullDialogOpen = false;
        LoadGet();
        StateHasChanged();

    }
    private void OpenDeleteDialog(OeSalesman bank)
    {
        if (bank.Piutang != 0)
        {
            NullDialogOpen = true;
        }
        else
        {
            DeleteDialogOpen = true;
        }


        _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenRubah(int xKdBank)
    {
        navigationmanager.NavigateTo($"/ModuleJual/EditSalesman/{xKdBank}");
    }

    private void proses3()
    {
        navigationmanager.NavigateTo($"/ModuleJual/LaporanSalesman");

    }

   
}
