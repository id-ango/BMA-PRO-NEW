@page "/ModuleJual/CekStockSalesOrder"
@attribute [Authorize(Roles = "Admin, Finance")]
@using eSoft.Order.Services
@using eSoft.Order.Model
@using eSoft.Order.View
@using Accounting.Services
@using System.IO

@inject IOrderSalesServices service
@inject IOrderPurchaseServices purchaseService
@inject IExcelServices serviceXL
@inject IJSRuntime JS

<div class="so-page-shell">
<div class="container-fluid">
    <h1>Cek Stock Sales Order</h1>
    <p class="text-muted">Matrix ketersediaan stock untuk setiap Sales Order yang masih aktif</p>
</div>

<div class="container-fluid mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <span class="badge bg-success p-2">&#9632; Stock Tersedia</span>
        </div>
        <div class="col-auto">
            <span class="badge bg-danger p-2">&#9632; Stock Kurang</span>
        </div>
        <div class="col-auto">
            <span class="badge bg-secondary p-2">&#9632; Tidak Dipesan</span>
        </div>
        <div class="col-auto">
            <span class="badge bg-warning text-dark p-2">&#9632; SO Lengkap (semua item ready)</span>
        </div>
        <div class="col-auto">
            <span class="badge bg-primary p-2">&#9632; Order Beli Tercatat</span>
        </div>
        @if (Matrix != null && Matrix.Rows.Any())
        {
            <div class="col-auto ms-3">
                <button class="btn btn-success" @onclick="DownloadExcel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-excel me-1" viewBox="0 0 16 16">
                        <path d="M5.884 6.68a.5.5 0 1 0-.768.64L7.349 10l-2.233 2.68a.5.5 0 0 0 .768.64L8 10.781l2.116 2.54a.5.5 0 0 0 .768-.641L8.651 10l2.233-2.68a.5.5 0 0 0-.768-.64L8 9.219l-2.116-2.54z"/>
                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                    </svg>
                    Download Excel
                </button>
            </div>
            <div class="col-auto">
                <button class="btn btn-info text-white" @onclick="ToggleSummary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bar-chart-line me-1" viewBox="0 0 16 16">
                        <path d="M11 2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H1v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h1V7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7h1V2z"/>
                    </svg>
                    @(ShowSummary ? "Sembunyikan Analisa SO vs PO" : "Lihat Analisa SO vs PO")
                </button>
            </div>
        }
    </div>
</div>

@if (Matrix != null && Matrix.Rows.Any())
{
    <div class="container-fluid mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label mb-1">Cari SO / Customer / No Prj / Keterangan</label>
                <input class="form-control" @bind="SearchText" @bind:event="oninput" placeholder="Ketik untuk filter..." />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1">Status</label>
                <select class="form-select" @bind="StatusFilter">
                    <option value="Semua">Semua</option>
                    <option value="Siap">Siap Proses</option>
                    <option value="Menunggu">Menunggu</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1">Fokus Item</label>
                <select class="form-select" @bind="SelectedItemCode">
                    <option value="">Semua Item</option>
                    @foreach (var item in Matrix.ItemHeaders)
                    {
                        <option value="@item.ItemCode">@item.ItemCode - @item.NamaItem</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-secondary" @onclick="ResetFilter">Reset Filter</button>
            </div>
        </div>
    </div>
}

@if (Matrix == null)
{
    <div class="container-fluid">
        <p><em>Memuat data...</em></p>
    </div>
}
else if (!Matrix.Rows.Any())
{
    <div class="container-fluid">
        <div class="alert alert-info">Tidak ada Sales Order aktif saat ini.</div>
    </div>
}
else
{
    <div class="container-fluid px-0 so-matrix-host">
        <div class="so-matrix-wrapper">
            <table class="table table-sm so-matrix-table" style="white-space: nowrap; font-size: 0.85rem; margin-bottom: 0; border-collapse: separate; border-spacing: 0;">
                <thead class="table-dark">
                    <tr>
                        <th class="so-sticky-header so-sticky-col-1">No SO</th>
                        <th class="so-sticky-header so-sticky-col-2">Customer</th>
                        <th class="so-sticky-header so-sticky-col-3">Tanggal</th>
                        <th class="so-sticky-header so-sticky-col-4">No Prj</th>
                        <th class="so-sticky-header so-sticky-col-5">Keterangan</th>
                        <th class="so-sticky-header so-sticky-col-6 text-center">Status</th>
                        @foreach (var item in VisibleHeaders)
                        {
                            <th class="so-sticky-header" style="min-width:130px; text-align:center;" title="@item.NamaItem">
                                <div>@item.ItemCode</div>
                                <div class="text-warning" style="font-size:0.75rem;">@item.NamaItem</div>
                                <div class="badge bg-info text-dark" style="font-size:0.7rem;">
                                    Stk Awal: @item.QtyStock.ToString("N0") @item.Satuan
                                </div>
                                <div class="badge bg-primary text-white" style="font-size:0.7rem; margin-top:0.25rem;">
                                    PO Rencana: @GetPlannedPurchaseQty(item.ItemCode).ToString("N0")
                                </div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredRows)
                    {
                        var rowBg = GetRowBackground(row);
                        var rowStatus = GetRowStatus(row);
                        <tr style="background-color:@rowBg">
                            <td class="so-sticky-col-1" style="background:@rowBg; min-width:120px;">
                                <strong>@row.NoLpb</strong>
                            </td>
                            <td class="so-sticky-col-2" style="background:@rowBg; min-width:140px;">
                                @row.NamaCustomer
                            </td>
                            <td class="so-sticky-col-3" style="background:@rowBg; min-width:90px;">@row.Tanggal.ToString("dd/MM/yy")</td>
                            <td class="so-sticky-col-4" style="background:@rowBg; min-width:80px;">@row.NoPrj</td>
                            <td class="so-sticky-col-5" style="background:@rowBg; min-width:150px;">@row.Keterangan</td>
                            <td class="so-sticky-col-6 text-center" style="background:@rowBg; min-width:80px;">
                                @if (rowStatus == "Terkirim")
                                {
                                    <span class="badge bg-success">Terkirim</span>
                                }
                                else if (rowStatus == "Lengkap")
                                {
                                    <span class="badge bg-warning text-dark">Lengkap</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Kurang</span>
                                }
                                @* <div class="mt-1" style="font-size:0.75rem;">@rowStatus</div> *@
                            </td>
                            @foreach (var cell in GetVisibleCells(row))
                            {
                                @if (!cell.IsOrdered)
                                {
                                    <td style="text-align:center; background-color:#f8f9fa; color:#adb5bd;">-</td>
                                }
                                else if (cell.IsTerkirim)
                                {
                                    <td style="text-align:center; background-color:#d1e7dd;" title="Order: @cell.QtyOrder | Terkirim: @cell.QtyBo | Sisa: @cell.QtySisa">
                                        <span class="badge bg-success">Terkirim: @cell.QtyBo.ToString("N0")</span>
                                        <div style="font-size:0.7rem; color:#198754;">Sisa: @cell.QtySisa.ToString("N0")</div>
                                    </td>
                                }
                                else if (cell.HasStock)
                                {
                                    <td style="text-align:center; background-color:#cfe2ff;" title="Order: @cell.QtyOrder | Terkirim: @cell.QtyBo | Sisa: @cell.QtySisa | Stock Sebelum: @cell.QtyStockSisa | Stock Sesudah: @cell.QtyStockSetelah">
                                        <span class="badge bg-primary">Lengkap: @cell.QtySisa.ToString("N0")</span>
                                        <div style="font-size:0.7rem; color:#0d6efd;">Terkirim: @cell.QtyBo.ToString("N0") &nbsp;|&nbsp; Sisa Stock: @cell.QtyStockSisa.ToString("N0") &rarr; @cell.QtyStockSetelah.ToString("N0")</div>
                                    </td>
                                }
                                else
                                {
                                    <td style="text-align:center; background-color:#f8d7da;" title="Order: @cell.QtyOrder | Terkirim: @cell.QtyBo | Sisa: @cell.QtySisa | Stock Sebelum: @cell.QtyStockSisa | Kurang: @(cell.QtySisa - cell.QtyStockSisa)">
                                        <span class="badge bg-danger">Kurang: @cell.QtySisa.ToString("N0")</span>
                                        <div style="font-size:0.7rem; color:#dc3545;">Terkirim: @cell.QtyBo.ToString("N0") &nbsp;|&nbsp; Stock: @cell.QtyStockSisa.ToString("N0") &nbsp;&#9888;&nbsp;Kurang: @((cell.QtySisa - cell.QtyStockSisa).ToString("N0"))</div>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
                <tfoot class="table-secondary">
                    <tr>
                        <td colspan="6" class="so-sticky-footer" style="font-weight:bold; background:#e9ecef;">
                            Total Dipesan / PO / Sisa Stock Akhir
                        </td>
                        @foreach (var item in VisibleHeaders)
                        {
                            var totalOrder = GetTotalSalesOrderQty(item.ItemCode);
                            var totalPo = GetPlannedPurchaseQty(item.ItemCode);
                            var sisaAkhir = item.QtyStock + totalPo - totalOrder;
                            var kurang = sisaAkhir < 0;
                            <td style="text-align:center; font-weight:bold;">
                                <div style="color:#0d6efd;">Order: @totalOrder.ToString("N0")</div>
                                <div style="color:#0d6efd;">PO: @totalPo.ToString("N0")</div>
                                <div style="font-size:0.8rem; color:@(kurang ? "#dc3545" : "#198754"); font-weight:bold;">
                                    Sisa: @sisaAkhir.ToString("N0")
                                </div>
                            </td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="container-fluid mt-3">
        <div class="card">
            <div class="card-header"><strong>Ringkasan SO &amp; PO</strong></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <div class="card text-white bg-primary mb-2">
                            <div class="card-body p-2 text-center">
                                <h5 class="card-title mb-0">@FilteredRows.Count</h5>
                                <small>SO Tampil</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card text-dark bg-warning mb-2">
                            <div class="card-body p-2 text-center">
                                <h5 class="card-title mb-0">@FilteredRows.Count(r => r.IsComplete)</h5>
                                <small>SO Siap Diproses</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card text-white bg-secondary mb-2">
                            <div class="card-body p-2 text-center">
                                <h5 class="card-title mb-0">@FilteredRows.Count(r => !r.IsComplete)</h5>
                                <small>SO Menunggu Stock</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card text-white bg-info mb-2">
                            <div class="card-body p-2 text-center">
                                <h5 class="card-title mb-0">@VisibleHeaders.Count</h5>
                                <small>Item Tampil</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card text-white bg-primary mb-2">
                            <div class="card-body p-2 text-center">
                                <h5 class="card-title mb-0">@VisibleHeaders.Count(i => GetPlannedPurchaseQty(i.ItemCode) > 0)</h5>
                                <small>Item Sudah Ada PO</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card text-dark bg-light mb-2 border">
                            <div class="card-body p-2 text-center">
                                <h5 class="card-title mb-0">@VisibleHeaders.Count(i => GetPlannedPurchaseQty(i.ItemCode) == 0)</h5>
                                <small>Item Belum Ada PO</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="text-muted mt-2" style="font-size:0.85rem;">
                    PO dihitung dari order beli yang tercatat di sistem, sehingga user bisa langsung melihat apakah barang untuk SO ini sudah masuk rencana pembelian.
                </div>
            </div>
        </div>
    </div>

    @if (ShowSummary)
    {
        <div class="container-fluid mt-3 so-summary-host">
            <div class="card border-info">
                <div class="card-header bg-primary text-white">
                    <strong>&#128202; Analisa Sales Order vs Order Beli per Item</strong>
                    <span class="ms-2 text-white-50" style="font-size:0.85rem;">Dibandingkan antara kebutuhan SO, stock tersedia, dan PO aktif yang masih open</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered table-sm mb-0" style="font-size:0.875rem;">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:3%;">No</th>
                                <th style="width:10%;">Kode Item</th>
                                <th style="width:22%;">Nama Item</th>
                                <th style="width:6%; text-align:center;">Satuan</th>
                                <th style="width:10%; text-align:center;">Stock</th>
                                <th style="width:10%; text-align:center;">Qty Sisa SO</th>
                                <th style="width:10%; text-align:center;">Total PO</th>
                                <th style="width:10%; text-align:center;">Proyeksi</th>
                                <th style="width:16%; text-align:center;">Status</th>
                                <th style="width:19%; text-align:center;">Keterangan No PI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int noUrut = 1; }
                            @foreach (var item in VisibleHeaders)
                            {
                                var totalSo = GetTotalSalesOrderQty(item.ItemCode);
                                var totalPo = GetPlannedPurchaseQty(item.ItemCode);
                                var proyeksi = item.QtyStock + totalPo - totalSo;
                                var kebutuhanTambahanPo = Math.Max(totalSo - item.QtyStock, 0);
                                var poKurang = Math.Max(kebutuhanTambahanPo - totalPo, 0);
                                var noPiList = GetRelatedNoPi(item.ItemCode);
                                var rowBg = totalSo == 0 ? "#d1e7dd" : totalSo <= item.QtyStock ? "#cfe2ff" : totalPo >= kebutuhanTambahanPo ? "#cfe2ff" : "#f8d7da";

                                <tr style="background-color:@rowBg;">
                                    <td>@noUrut</td>
                                    <td><strong>@item.ItemCode</strong></td>
                                    <td>@item.NamaItem</td>
                                    <td style="text-align:center;">@item.Satuan</td>
                                    <td style="text-align:center; font-weight:bold;">@item.QtyStock.ToString("N0")</td>
                                    <td style="text-align:center;">@totalSo.ToString("N0")</td>
                                    <td style="text-align:center;">@totalPo.ToString("N0")</td>
                                    <td style="text-align:center; font-weight:bold; color:@(proyeksi < 0 ? "#dc3545" : "#198754");">
                                        @proyeksi.ToString("N0")
                                    </td>
                                    <td style="text-align:center;">
                                        @if (totalSo == 0)
                                        {
                                            <span class="badge bg-success">&#10003; Terkirim</span>
                                            <div class="mt-1" style="font-size:0.75rem; color:#198754;">Qty sisa sudah 0</div>
                                        }
                                        else if (totalSo <= item.QtyStock)
                                        {
                                            <span class="badge bg-primary">&#10003; Lengkap</span>
                                            <div class="mt-1" style="font-size:0.75rem; color:#0d6efd;">Qty sisa tertutup stock</div>
                                        }
                                        else if (totalPo >= kebutuhanTambahanPo)
                                        {
                                            <span class="badge bg-primary">&#10003; Tertutup oleh PO</span>
                                            <div class="mt-1" style="font-size:0.75rem; color:#0d6efd;">Sisa kebutuhan: 0</div>
                                        }
                                        else if (totalPo > 0)
                                        {
                                            <span class="badge bg-warning text-dark">&#9888; PO belum cukup</span>
                                            <div class="mt-1" style="font-size:0.75rem; color:#856404;">Masih kurang @poKurang.ToString("N0") @item.Satuan</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">&#9888; Belum ada PO</span>
                                            <div class="mt-1" style="font-size:0.75rem; color:#dc3545;">Perlu pesan min. @kebutuhanTambahanPo.ToString("N0") @item.Satuan</div>
                                        }
                                    </td>
                                    <td style="text-align:left; font-size:0.75rem;">
                                        @if (!string.IsNullOrWhiteSpace(noPiList))
                                        {
                                            <div><strong>No PI:</strong> @noPiList</div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">-</div>
                                        }
                                    </td>
                                </tr>
                                noUrut++;
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-secondary">
                                <td colspan="4" style="font-weight:bold;">Total</td>
                                <td style="text-align:center; font-weight:bold;">
                                    @VisibleHeaders.Sum(i => i.QtyStock).ToString("N0")
                                </td>
                                <td style="text-align:center; font-weight:bold;">
                                    @VisibleHeaders.Sum(i => GetTotalSalesOrderQty(i.ItemCode)).ToString("N0")
                                </td>
                                <td style="text-align:center; font-weight:bold;">
                                    @VisibleHeaders.Sum(i => GetPlannedPurchaseQty(i.ItemCode)).ToString("N0")
                                </td>
                                <td style="text-align:center; font-weight:bold;">
                                    @VisibleHeaders.Sum(i => i.QtyStock + GetPlannedPurchaseQty(i.ItemCode) - GetTotalSalesOrderQty(i.ItemCode)).ToString("N0")
                                </td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
}

</div>

@code {
    private SalesOrderStockMatrixView Matrix;
    private List<PoTransH> PurchaseHeaders = new();
    private List<PoTransD> PurchaseDetails = new();
    private Dictionary<string, decimal> PurchaseQtyByItem = new(StringComparer.OrdinalIgnoreCase);
    private bool ShowSummary = false;
    private string SearchText = string.Empty;
    private string StatusFilter = "Semua";
    private string SelectedItemCode = string.Empty;

    private List<SalesOrderItemHeader> VisibleHeaders =>
        Matrix == null
            ? new List<SalesOrderItemHeader>()
            : string.IsNullOrWhiteSpace(SelectedItemCode)
                ? Matrix.ItemHeaders
                : Matrix.ItemHeaders.Where(x => x.ItemCode == SelectedItemCode).ToList();

    private List<SalesOrderMatrixRow> FilteredRows =>
        Matrix == null
            ? new List<SalesOrderMatrixRow>()
            : Matrix.Rows.Where(RowVisible).ToList();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadData();
    }

    private void ToggleSummary() => ShowSummary = !ShowSummary;

    private void LoadData()
    {
        Matrix = service.GetSalesOrderStockMatrix();
        LoadPurchaseSummary();
    }

    private void LoadPurchaseSummary()
    {
        PurchaseHeaders = purchaseService.GetTransHAktif() ?? new List<PoTransH>();

        var purchaseDocNos = PurchaseHeaders
            .Where(x => !string.IsNullOrWhiteSpace(x.NoLpb))
            .Select(x => x.NoLpb)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        PurchaseDetails = purchaseService.GetTransD()
            .Where(d => d != null && !string.IsNullOrWhiteSpace(d.NoLpb) && purchaseDocNos.Contains(d.NoLpb))
            .ToList();

        PurchaseQtyByItem = PurchaseDetails
            .Where(d => !string.IsNullOrWhiteSpace(d.ItemCode))
            .GroupBy(d => d.ItemCode, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Qty), StringComparer.OrdinalIgnoreCase);
    }

    private void ResetFilter()
    {
        SearchText = string.Empty;
        StatusFilter = "Semua";
        SelectedItemCode = string.Empty;
    }

    private bool RowVisible(SalesOrderMatrixRow row)
    {
        var matchSearch = string.IsNullOrWhiteSpace(SearchText)
            || $"{row.NoLpb} {row.NamaCustomer} {row.NoPrj} {row.Keterangan}".Contains(SearchText, StringComparison.OrdinalIgnoreCase);

        var matchStatus = StatusFilter switch
        {
            "Siap" => row.IsComplete,
            "Menunggu" => !row.IsComplete,
            _ => true
        };

        var matchItem = string.IsNullOrWhiteSpace(SelectedItemCode)
            || row.Cells.Any(c => c.ItemCode == SelectedItemCode && c.IsOrdered);

        return matchSearch && matchStatus && matchItem;
    }

    private decimal GetTotalSalesOrderQty(string itemCode)
    {
        if (string.IsNullOrWhiteSpace(itemCode))
        {
            return 0;
        }

        return FilteredRows
            .SelectMany(r => r.Cells)
            .Where(c => string.Equals(c.ItemCode, itemCode, StringComparison.OrdinalIgnoreCase) && c.IsOrdered)
            .Sum(c => c.QtySisa);
    }

    private decimal GetPlannedPurchaseQty(string itemCode)
    {
        if (string.IsNullOrWhiteSpace(itemCode))
        {
            return 0;
        }

        return PurchaseQtyByItem.TryGetValue(itemCode, out var qty) ? qty : 0;
    }

    private string GetRelatedNoPi(string itemCode)
    {
        if (string.IsNullOrWhiteSpace(itemCode))
        {
            return string.Empty;
        }

        var noPiList = PurchaseHeaders
            .Where(h => !string.IsNullOrWhiteSpace(h.NoPrj) && PurchaseDetails.Any(d =>
                string.Equals(d.ItemCode, itemCode, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(d.NoLpb, h.NoLpb, StringComparison.OrdinalIgnoreCase)))
            .Select(h => h.NoPrj)
            .Where(noPi => !string.IsNullOrWhiteSpace(noPi))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

        return noPiList == null || noPiList.Count == 0 ? string.Empty : string.Join(", ", noPiList);
    }

    private IEnumerable<SalesOrderMatrixCell> GetVisibleCells(SalesOrderMatrixRow row)
    {
        var visibleCodes = VisibleHeaders.Select(x => x.ItemCode).ToHashSet();
        return row.Cells.Where(c => visibleCodes.Contains(c.ItemCode));
    }

    private bool IsFullyTerkirim(SalesOrderMatrixRow row)
    {
        var orderedCells = row.Cells.Where(c => c.IsOrdered).ToList();
        return orderedCells.Any() && orderedCells.All(c => c.IsTerkirim);
    }

    private string GetRowStatus(SalesOrderMatrixRow row)
    {
        if (IsFullyTerkirim(row))
            return "Terkirim";

        return row.IsComplete ? "Lengkap" : "Kurang";
    }

    private string GetRowBackground(SalesOrderMatrixRow row)
    {
        return GetRowStatus(row) switch
        {
            "Terkirim" => "#d1e7dd",
            "Lengkap" => "#fff3cd",
            _ => "#f8d7da"
        };
    }

    private async Task DownloadExcel()
    {
        var data = serviceXL.CreateSalesOrderStockExcel(Matrix);
        var stream = new MemoryStream(data);
        var fileName = $"CekStockSO_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
        using var streamRef = new DotNetStreamReference(stream: stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
}
