@page "/ModuleJual/TransOrderJual"
@using eSoft.Order.Model
@using eSoft.Order.Services


@inject IOrderSalesServices service
@implements IDisposable
@inject NavigationManager navigationmanager

<div class="container-fluid">
    <h1>Transaksi Order Sales</h1>
</div>


<div class="container-fluid">
    <NavLink href="/ModuleJual/AddTransSalesOrder" class="btn btn-primary">Order Sales</NavLink> &nbsp;&nbsp;
    
</div>

<br />
<br />


<div class="container-fluid">
    <DataGridVerticalComponent Items="TransHeader" Context="transaksi" GetFilterableText="@(item =>$"{item.NoLpb} {item.NamaVendor} {item.Keterangan}")">
        <TableHeader>

            <th scope="col" style="width:15%">No Bukti</th>
            <th scope="col" style="width:20%">Supplier</th>
         
            <th scope="col" style="width:20%">Keterangan</th>
            <th scope="col" style="width:10%">Total</th>
            <th scope="col" style="width:20%">Jumlah/PPn/Ongkir</th>

            <th scope="col" style="width:15%"></th>
        </TableHeader>
        <RowTemplate>

            <td style="width:15%; background-color:@(transaksi.Cek == "3" ? "yellow" : "")">
                @transaksi.NoLpb
                <br />
                <span class="badge bg-primary">@transaksi.Tanggal.ToShortDateString()</span>
            </td>
            <td style="width:20%; background-color:@(transaksi.Cek == "3" ? "yellow" : "")">@transaksi.NamaVendor
             <br />
                <span class="badge bg-primary">@transaksi.NoPrj</span>
              @*   <br /> *@
               @*  @if (string.IsNullOrEmpty(transaksi.Lokasi))
                {
                    <InputFile OnChange="HandleFileUpload" class="mb-3" />
                    <button class="btn btn-primary custom-button" @onclick="() => SaveFile(transaksi.PoTransHId)">Simpan File</button>
                     
                } else
                {
                    <a href="@($"/pdfkontrak/{transaksi.Lokasi}")" target="_blank" class="btn btn-primary white-bg">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="red" class="bi bi-file-pdf" viewBox="0 0 16 16">
