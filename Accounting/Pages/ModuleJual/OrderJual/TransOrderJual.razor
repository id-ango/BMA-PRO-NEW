                } *@
                @* <br/>
                *@
            </td>
         
            <td style="width:20%; background-color:@(transaksi.Cek == "3" ? "yellow" : "")">@transaksi.Keterangan</td>
            <td style="width:10%; background-color:@(transaksi.Cek == "3" ? "yellow" : "")">@transaksi.Jumlah.ToString("N")</td>
            <td style="width:20%; background-color:@(transaksi.Cek == "3" ? "yellow" : "")">
                <span>Jumlah. &nbsp;</span>@transaksi.TtlJumlah.ToString("N") <br />
                @if(transaksi.Discount !=0)
                {
                    <span>Discount. &nbsp;</span>@transaksi.Discount.ToString("N") <br />

                }
                <span>PPn. &nbsp;</span>@transaksi.Ppn.ToString("N") <br />
                <span>Ongkir. &nbsp;</span>@transaksi.Ongkos.ToString("N") <br />
            </td>


            <td style="background-color:@(transaksi.Cek == "3" ? "yellow" : "")" >
                <button @onclick="() => OpenRubah(transaksi)" class="btn btn-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                    </svg>
                </button>
                <button @onclick="() => OpenDeleteDialog(transaksi)" class="btn btn-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                    </svg>
                </button>
                <button @onclick="() => OpenPrint(transaksi.PoTransHId)" class="btn btn-info">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-printer" viewBox="0 0 16 16">
                        <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z" />
                        <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2H5zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1z" />
                    </svg>
                </button>
                @if(transaksi.Cek != "3")
                {
                 <button @onclick="() => OpenDeleteCloseDialog(transaksi)" class="btn btn-warning">
                @*<button @onclick="() => OpenClose(transaksi.PoTransHId)" class="btn btn-warning">*@
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-save" viewBox="0 0 16 16">
                            <path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z" />
                        </svg>
                </button>
                    
                }
            </td>
        </RowTemplate>
    </DataGridVerticalComponent>


</div>

@if (DeleteDialogOpen)
{
    <ModalDialogComponent Title="Are you sure?" Text="Do you want to delete this entry?" OnClose="OnDeleteDialogClose"></ModalDialogComponent>
}

@if (NullDialogOpen)
{
    <ModalDialogComponent Title="MESSAGE" Text="This Order Already Received" TombolSave="false" OnClose="OnDeleteNullClose"></ModalDialogComponent>
}
@if (CloseDialogOpen)
{
    <ModalDialogComponent Title="Are you Sure? " Text="Do you want to Close Order? "  OnClose="OnDeleteCloseDialogClose"></ModalDialogComponent>
}
@if (showDeleteConfirmation)
{
    <ModalDialogComponent Title="Are you Sure? " Text="Do you want to Delete? " OnClose="OnDeleteFileCloseDialogClose"></ModalDialogComponent>
}

@code {

    private List<PoTransH> TransHeader;
    private List<PoTransD> TransDetail;
    private PoTransH _bankToDelete;
    private IBrowserFile uploadedFile;
    private string decodedFileName ;
    private long maxFileSize = long.MaxValue;
    private bool showDeleteConfirmation = false;
    private string fileToDelete;

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }
    public bool CloseDialogOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadGet();

    }
    private void HandleFileUpload(InputFileChangeEventArgs e)
    {
        uploadedFile = e.File;

    }

    private string GetUniqueFileName(string fileName)
    {
        var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(fileName);
        var fileExtension = Path.GetExtension(fileName);
        var timestamp = DateTime.Now.ToString("yyyyMMddHHmmssfff");

        return $"{fileNameWithoutExtension}_{timestamp}{fileExtension}";
    }
    private async Task SaveFile(int id)
    {
        if (uploadedFile != null)
        {
            var uniqueFileName = GetUniqueFileName(uploadedFile.Name);
            var uploadFolder = Path.Combine("wwwroot", "PDFKontrak");
            var filePath = Path.Combine(uploadFolder, uniqueFileName);
            decodedFileName = System.Net.WebUtility.UrlDecode(uniqueFileName);

            // Baca konten file PDF
            using (var fileStream = new FileStream(filePath, FileMode.Create))
            {
                await uploadedFile.OpenReadStream(maxFileSize).CopyToAsync(fileStream);
            }

            TransHeader.Find(x => x.PoTransHId == id).Lokasi = uniqueFileName;
            PoTransH header = TransHeader.Find(x => x.PoTransHId == id);
            service.SavePdf(header);

            uploadedFile = null;


        }

    }
    private void ShowDeleteConfirmation(string file)
    {
        fileToDelete = file;
        showDeleteConfirmation = true;
        StateHasChanged();
    }

    private void OnDeleteFileCloseDialogClose(bool accepted)
    {
        if (accepted)
        {
            var uploadFolder = Path.Combine("wwwroot", "PDFKontrak");
            var filePath = Path.Combine(uploadFolder, fileToDelete);

            // Hapus file dari penyimpanan (misalnya, direktori)
            File.Delete(filePath);
            
            PoTransH header = TransHeader.Find(x => x.Lokasi == fileToDelete);
            TransHeader.Find(x => x.Lokasi == fileToDelete).Lokasi = "";

            service.SavePdf(header);
        }

        showDeleteConfirmation = false;
        LoadGet();

        StateHasChanged();

    }
    
   

    private void LoadGet()
    {
        TransHeader = service.GetTransH();
        TransDetail = service.GetTransD();
        TransHeader = TransHeader.OrderBy(x => x.Cek).ThenBy(x =>x.NoLpb).ToList();
    }

     private void OpenDeleteCloseDialog(PoTransH bank)
    {
       
        CloseDialogOpen = true;
       
        _bankToDelete = bank;
        StateHasChanged();
    }

      private async Task OnDeleteCloseDialogClose(bool accepted)
    {
        if (accepted)
        {
            await OpenClose(_bankToDelete.PoTransHId);
            _bankToDelete = null;
        }

       CloseDialogOpen = false;
        LoadGet();

        StateHasChanged();

    }


    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {
            await service.DelTransH(_bankToDelete.PoTransHId);
            _bankToDelete = null;
        }

        DeleteDialogOpen = false;
        LoadGet();

        StateHasChanged();

    }

    private void OnDeleteNullClose(bool accepted)
    {
        //if (accepted)
        //{
        //    await service.DelBank(_bankToDelete.CbBankId);
        //    _bankToDelete = null;
        //}

        DeleteDialogOpen = false;
        NullDialogOpen = false;
        LoadGet();
        StateHasChanged();

    }
    private void OpenDeleteDialog(PoTransH bank)
    {
        if (bank.Cek == "3")
        {
            NullDialogOpen = true;
        }
        else
        {
            DeleteDialogOpen = true;
        }


        _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenRubah(PoTransH bank)
    {
        if (bank.Cek == "3")
        {
            NullDialogOpen = true;
        }
        else
        {
            navigationmanager.NavigateTo($"/ModuleJual/EditTransOrderJual/{bank.PoTransHId}");
        }

    }

    private void OpenPrint(int xKdBank)
    {

        navigationmanager.NavigateTo($"/ModulePrinting/PrintOrderSales/{xKdBank}");
    }

    private async Task OpenClose(int xKdBank)
    {
        await service.CloseOrder(xKdBank);

        StateHasChanged();
    }


    public void Dispose()
    {

    }
}
