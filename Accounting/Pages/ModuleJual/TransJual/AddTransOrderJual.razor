@page "/ModuleJual/AddTransOrderJual"

@using eSoft.Piutang.Model
@using eSoft.Piutang.View
@using eSoft.Piutang.Services
@using eSoft.Persediaan.Model
@using eSoft.Persediaan.View
@using eSoft.Persediaan.Services
@using eSoft.Penjualan.Model
@using eSoft.Penjualan.View
@using eSoft.Penjualan.Services
@using eSoft.Order.Model
@using eSoft.Order.View
@using eSoft.Order.Services

@inject ISalesServices service
@inject IReceivableServices serviceAR
@inject IInventoryServices serviceIC
@inject IOrderSalesServices serviceOrder

@inject NavigationManager navigationmanager



<div class="top-row px-4 " style="z-index:5">
    <h3>Add Transaksi Order Jual</h3>
</div>

@if (ShowValidationError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>❌ Error:</strong> @ValidationMessage
        <button type="button" class="btn-close" @onclick="@(() => ShowValidationError = false)"></button>
    </div>
}

<div class="container">
    <EditForm Model="@Transh" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>
                Tanggal :
                <InputDate class="form-control" @bind-Value="Transh.Tanggal" @onfocusout="UbahJthTempo" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>
                P/I Jual :
                <InputSelect class="form-control" @bind-Value="Transh.NoPrj" style="width:60%; display:inline" @oninput="OnPI">
                    <option value="">&nbsp;&nbsp;---Select P/I---&nbsp;&nbsp;</option>

                    @foreach (var item in banks)
                    {
                        <option value="@item.NoLpb">[@item.NoPrj] &nbsp; @item.NamaVendor</option>
                    }
                </InputSelect>
                @*&nbsp;@kurs*@
            </label>
        </div>
        <br />

        <div class="form-group">
            <label>
                Customer :
                <InputText class="form-control" @bind-Value="Transh.Customer" disabled="disabled" style="width:40%; display:inline" />
                @Transh.NamaCust
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>
                Jth Tempo :
                <InputDate class="form-control" @bind-Value="Transh.JthTempo" />
            </label>
        </div>
        <br />

        @* <div class="form-group">
            <label>
                Kurs :
                <InputNumber class="form-control" @bind-Value="Transh.Kurs" />
            </label>
        </div>
        <br />*@
        <div class="form-group">
            <label>
                Alamat Kirim :
                <InputTextArea class="form-control" @bind-Value="Transh.AlamatKirim" />
            </label>
        </div>
        <div class="form-group">
            <label>
                Keterangan :
                <InputTextArea class="form-control" @bind-Value="Transh.Keterangan" />
            </label>
        </div>

        <div class="container">
            <table>
                <tr>
                    <td>
                        <div class="row">
                            <div class=" col-sm  form-message">
                                <span>Saldo   : @Transh.TtlJumlah.ToString("N")</span>
                            </div>

                        </div>
                    </td>
                    <td></td>
                </tr>
                <tr>
                    <td>
                        <div class="form-group">
                            <label>
                                Diskon :
                                <InputNumber class="form-control" @bind-Value="Transh.Discount" @onchange="HitungTotal" />
                            </label>
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            <label>
                                PPN % :
                                <InputNumber class="form-control" @bind-Value="Transh.PpnPersen" @onchange="rubahppn" />
                            </label>
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            <label>
                                PPN :
                                <InputNumber class="form-control" @bind-Value="Transh.Ppn" />
                            </label>
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            <label>
                                Ongkos :
                                <InputNumber class="form-control" @bind-Value="Transh.Ongkos" />
                            </label>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <div class="row">
                            <div class=" col-sm  form-message">
                                <span>Jumlah   : @Transh.Jumlah.ToString("N")</span>
                            </div>

                        </div>
                    </td>
                    <td>
                        @* <div class="row">
                            <div class=" col-sm  form-message">
                                <span>Balance   : @Transh.Nilai.ToString("N")</span>
                            </div>

                        </div>*@
                    </td>
                </tr>
            </table>


        </div>

        <div class="float-md-right">
            <button class="btn-success" type="submit">Simpan</button>
            <button class="btn-danger" type="button" @onclick="@(() => navigationmanager.NavigateTo("/ModuleJual/TransJualNon", false))">Batal</button>
        </div>
        <br />
        <br />



    </EditForm>

    <div class="container">
        <DetailGridComponent Items="Transh.OeTransDs" Context="transaksi">
            <TableHeader>

                <th scope="col">Item</th>
                <th scope="col">Nama Item</th>
                <th scope="col">Satuan</th>
                <th scope="col">Qty</th>
                <th scope="col">Sisa (Max)</th>
                <th scope="col">Harga</th>
                <th scope="col">Diskon</th>
                <th scope="col">Jumlah</th>
                <th scope="col">Lokasi</th>
                <th scope="col">&nbsp;</th>
                <th></th>
            </TableHeader>
            <RowTemplate>
                <td>@transaksi.ItemCode</td>
                <td>@transaksi.NamaItem</td>
                <td>@transaksi.Satuan</td>
                <td>
                    <InputNumber class="form-control form-control-sm"
                                 @bind-Value="transaksi.Qty"
                                 @bind-Value:after="() => OnQtyChanged(transaksi)"
                                 min="0"
                                 step="0.01" />
                </td>
                <td>
                    @{
                        // var soItem = transaksi.GetType().Name == "OeTransDView" ?
                        //     TransaksiSoItem(transaksi.ItemCode) : null;
                        // var maxQty = soItem?.Qty-soItem?.QtyBo ?? 0;
                        <span class="badge bg-info">@transaksi.QtyBo.ToString("#,##0.##")</span>
                    }
                </td>
                <td>@transaksi.Harga.ToString("#,##0.##")</td>
                <td>@transaksi.Discount.ToString("#,##0.##")</td>
                <td>@transaksi.Jumlah.ToString("#,##0.##")</td>
                <td>@transaksi.Lokasi</td>
                <td>
                    @*<button @onclick="(() => Rubah(transaksi))" class="btn btn-success">Edit</button>
                    <button @onclick="(() => Hapus(transaksi))" class="btn btn-danger">Delete</button>*@
                </td>
            </RowTemplate>
        </DetailGridComponent>


        @*<Button Class="btn btn-info" @onclick="@OnAddLine">Add Line</Button>*@
    </div>

</div>



@if (DialogOpen)
{
    <ModalDialogComponent Title="Alert" Text="Kode Bank Sudah Ada" TombolSave="false" OnClose="OnDialogClose"></ModalDialogComponent>
}



<style>
    label {
        width: 100%;
    }
</style>


@code {
    private OeTransHView Transh = new OeTransHView() { OeTransDs = new List<OeTransDView>() };

    private List<IcLokasi> lokasi;
    private List<PoTransH> banks;


    private OeTransDView Transd = new OeTransDView();
    private OeTransDView TransK = new OeTransDView();

    private string enabled { get; set; }
    private int termin = 0;
    private int dblclick = 1;
    private string ValidationMessage = "";  // Store validation error message
    private bool ShowValidationError = false;  // Show/hide error display

    public PoTransH transaksi { get; set; }
    public int SupplierId { get; set; }
    public string namaItem { get; set; }
    public string namasupplier { get; set; }
    public int ItemId { get; set; }

    public string Testing { get; set; }
    private bool DialogOpen { get; set; }
    public bool IsVisible { get; set; }
    public bool IsKurs { get; set; }
    public bool IsEdit { get; set; }
    public bool SearchOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Transh.Tanggal = DateTime.Now;
        Transh.JthTempo = Transh.Tanggal.AddDays(termin);
        Loadsupplier();

        Loadlokasi();
    }

    private void OnVisibleClose()
    {

        IsVisible = false;
        IsKurs = false;
        StateHasChanged();

    }


    private void OnDialogClose(bool accepted)
    {

        DialogOpen = false;
        StateHasChanged();

    }


    void Loadsupplier()
    {

        banks = serviceOrder.GetTransHAktif();

    }

    private void HitungTotal()
    {
        // ✅ Header totals auto-calculate from model
        // Just trigger re-render
        StateHasChanged();
    }

    private void HandleValidSubmit()
    {
        if (dblclick != 1) return;

        dblclick++;

        // Validate quantities before saving
        foreach (var item in Transh.OeTransDs)
        {
            // ✅ ALLOW Qty = 0 (untuk barang yang belum datang / tidak include)
            if (item.Qty < 0)
            {
                // Show error: qty cannot be negative
                var message = $"❌ Qty untuk item '{item.ItemCode} - {item.NamaItem}' tidak boleh minus (negatif)";
                ValidationMessage = message;
                ShowValidationError = true;
                dblclick--;
                return;
            }

            // Get original qty from SO (remaining available)
            var soItem = transaksi?.PoTransDs?.FirstOrDefault(x => x.ItemCode == item.ItemCode);
            if (soItem != null && item.Qty > (soItem.Qty - soItem.QtyBo))
            {
                // Show error: qty exceeds original SO qty
                var message = $"❌ Qty untuk item '{item.ItemCode} - {item.NamaItem}' tidak boleh melebihi {(soItem.Qty - soItem.QtyBo).ToString("#,##0.##")}\n(Anda isi: {item.Qty.ToString("#,##0.##")})";
                ValidationMessage = message;
                ShowValidationError = true;
                dblclick--;
                return;
            }
        }

        var newEdit = service.AddTransH(Transh, true);
        if (newEdit != null)
        {
            var soldItems = Transh.OeTransDs.Select(x => new PoTransDView
            {
                ItemCode = x.ItemCode,
                Qty = x.Qty
            }).ToList();

            // Call smart SaveOrderAktif dengan qty yang dijual
            serviceOrder.SaveOrderAktif(Transh.NoPrj, soldItems);

            var id = newEdit.OeTransHId.ToString().Trim();
            //  navigationmanager.NavigateTo("/PrintBuktiBayar/{id", false);
            // navigationmanager.NavigateTo("/ModuleBeli/TransBeli", false);
            //  navigationmanager.NavigateTo($"/PrintBuktiBayar/{id}");
            navigationmanager.NavigateTo($"/ModulePrinting/PrintSuratJalan/{id}");
        }


    }

    private void OnDetailTrans(OeTransDView transD)
    {
        if (!IsEdit)
        {
            Transh.OeTransDs.Add(transD);
        }

        IsVisible = false;
        IsKurs = false;
        IsEdit = false;
        StateHasChanged();
    }






    void Loadlokasi()
    {

        lokasi = serviceIC.GetIcLokasi();

    }

    private void Rubah(OeTransDView transd)
    {
        Transd = new OeTransDView();
        Transd = transd;
        IsEdit = true;
        OnAddLine();

    }

    private void Hapus(OeTransDView transd)
    {

        Transh.OeTransDs.Remove(transd);
        //ShowOnClick();
    }

    private void OnAddLine()
    {

        this.IsVisible = true;





        StateHasChanged();

        //IsEdit = false;
        //ShowOnClick();
    }

    private void rubahppn()
    {
        var persen = (Transh.TtlJumlah - Transh.Discount) * (Transh.PpnPersen / 100);
        Transh.Ppn = persen;

        // ✅ Re-render so header totals update
        StateHasChanged();
    }

    private void BtnChoose(string textSearch)
    {
        if (!string.IsNullOrEmpty(textSearch))
        {
            Transh.Customer = textSearch;

        }

        SearchOpen = false;
        StateHasChanged();
    }

    private void OnSearchClose(bool accepted)
    {

        SearchOpen = false;
        StateHasChanged();

    }

    private void UbahJthTempo()
    {
        Transh.JthTempo = Transh.Tanggal.AddDays(termin);
    }

    public void OnPI(ChangeEventArgs args)
    {
        transaksi = serviceOrder.GetOrderAktif(args.Value.ToString());
        Transh.Customer = transaksi.Vendor;
        Transh.NamaCust = transaksi.NamaVendor;
        Transh.PpnPersen = transaksi.PpnPersen;
        Transh.AlamatKirim = serviceAR.GetCustomerCode(transaksi.Vendor).AlmtKrm + "\r\n" + serviceAR.GetCustomerCode(transaksi.Vendor).KotaKrm;
        Transh.Discount = transaksi.Discount;
        Transh.Ppn = transaksi.Ppn;
        Transh.Ongkos = transaksi.Ongkos;
        termin = serviceAR.GetCustomerCode(transaksi.Vendor).Termin;

        Transh.JthTempo = Transh.Tanggal.AddDays(termin);

        Transh.OeTransDs.Clear();
        if (transaksi != null)
        {
            foreach (var item in transaksi.PoTransDs)
            {
                // ✅ CORRECT LOGIC: Remaining Qty = Original Qty - QtyBo
                // QtyBo is stored in PoTransD for each line item
                // QtyBo = qty yang sudah dijual/backorder
                // This gives us exactly: Qty Sisa = Qty - QtyBo

                decimal remainingQty = item.Qty - item.QtyBo;

                // Make sure remaining is not negative
                if (remainingQty < 0) remainingQty = 0;

                Transh.OeTransDs.Add(new OeTransDView()
                {
                    ItemCode = item.ItemCode,
                    NamaItem = item.NamaItem,
                    Qty = remainingQty,  // ✅ Set initial Qty to remaining available
                    QtyBo = remainingQty,  // ✅ Initial state: not yet sold
                    Satuan = item.Satuan,
                    Harga = item.Harga,
                    Discount = item.Discount,
                    Jumlah = (remainingQty * item.Harga) - item.Discount,  // ✅ Initial Jumlah based on remaining Qty
                    Lokasi = item.Lokasi

                    // ✅ Jumlah auto-calculated via property getter!
                });
            }
        }

        // ✅ Force re-render so header totals calculate
        StateHasChanged();
    }

    // ✅ BARU: Method untuk handle qty change dan recalculate Jumlah
    private void OnQtyChanged(OeTransDView item)
    {
        item.Jumlah = (item.Qty * item.Harga) - item.Discount;

        StateHasChanged();
    }


    // Helper method to get SO item for maximum qty display
    private PoTransD TransaksiSoItem(string itemCode)
    {
        return transaksi?.PoTransDs?.FirstOrDefault(x => x.ItemCode == itemCode);
    }
}
