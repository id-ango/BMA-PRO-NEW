@page "/ModuleJual/TransJual"
@using eSoft.Penjualan.Model
@using eSoft.Penjualan.Services
@using eSoft.Piutang.Services
@using eSoft.Order.Services

@inject ISalesServices service
@inject IReceivableServices serviceAR
@inject IOrderSalesServices serviceOrder
@inject IJSRuntime JSRuntime

@*
@implements IDisposable *@

@inject NavigationManager navigationmanager

<div class="container">
    <h1>Transaksi Penjualan</h1>
</div>


<div class="container">
    <NavLink href="/ModuleJual/AddTransJual" class="btn btn-primary">Add</NavLink>
    <NavLink href="/ModuleJual/AddTransReturJual" class="btn btn-primary">Retur</NavLink>
    <NavLink href="/ModuleJual/AddTransOrderJual" class="btn btn-primary">Terima Order</NavLink>
   
</div>
<br />

<EditForm Model="this">
    <div class="container">
        <div class="row mb-2">
            <div class="col-md-2">
                <InputDate @bind-Value="tgl1" class="form-control" />
            </div>
            <div class="col-md-2">
                <InputDate @bind-Value="tgl2" class="form-control" />
            </div>
            <div class="col-md-2">
                <button @onclick="LoadGet" class="btn btn-success w-100" type="button">
                    Display Transaksi
                    <span style="display: @(isProcessing ? "inline" : "none"); margin-left:5px;">
                        <i class="fas fa-spinner fa-spin"></i>
                    </span>
                </button>
            </div>
        </div>
    </div>
</EditForm>

<br />
<br />


<div class="container">
    <DataGridVerticalComponent Items="TransHeader" Context="transaksi" GetFilterableText="@(item =>$"{item.NoLpb} {item.NamaCust} {item.Keterangan} {item.Kurir} {item.Salesman} {item.Lokasi}")">
        <TableHeader>

            @* <th scope="col" style="width:15%" @onclick="@(() => SortColumn("NoLpb"))">No Bukti</th>*@
            <th scope="col" style="width:15%">No Bukti</th>
            <th scope="col" style="width:20%">Customer</th>

            <th scope="col" style="width:20%">Keterangan</th>
            <th scope="col" style="width:10%">Total</th>
            <th scope="col" style="width:20%">Jumlah/PPn/Ongkir</th>

            <th scope="col" style="width:15%"></th>
        </TableHeader>
        <RowTemplate>

            <td style="width:15%; background-color:@(transaksi.Jumlah == 0 ? "yellow" : "")">
                @transaksi.NoLpb
                <br />
                <span class="badge bg-primary">@transaksi.Tanggal.ToShortDateString()</span>
                <br />
                <span class="badge bg-success">@transaksi.NoPrj</span>
            </td>
            <td style="width:20%;background-color:@(transaksi.Jumlah == 0 ? "yellow" : "") ">
                @transaksi.NamaCust
            <br/>
                <select class="form-control" @bind="transaksi.Salesman" style="width:60%; display:inline">
                    <option value="">&nbsp;&nbsp;---Select Salesman---&nbsp;&nbsp;</option>
                    @foreach (var item in salesmans)
                    {
                        <option value="@item.Salesman">[@item.Salesman]&nbsp; @item.NamaSales</option>
                    }

                </select>
            </td>

            <td style="width:20%;background-color:@(transaksi.Jumlah == 0 ? "yellow" : "")">
                @transaksi.Keterangan
                <br />
                <span class="badge bg-warning">@transaksi.Kurir</span>
                <br />
                <span class="badge bg-secondary">@transaksi.Lokasi</span>
            </td>

            <td style="width:10%;text-align:right;background-color:@(transaksi.Jumlah == 0 ? "yellow" : "")">@transaksi.Jumlah.ToString("N")</td>
            <td style="width:20%;background-color:@(transaksi.Jumlah == 0 ? "yellow" : "")">
                <span>Jumlah. &nbsp;</span>@transaksi.TtlJumlah.ToString("N") <br />
                @if(transaksi.Discount !=0)
                {
                    <span>Discount. &nbsp;</span>@transaksi.Discount.ToString("N") <br />

                }

                <span>PPn. &nbsp;</span>@transaksi.Ppn.ToString("N") <br />
                <span>Ongkir. &nbsp;</span>@transaksi.Ongkos.ToString("N") <br />
            </td>


            <td style="width:15%;background-color:@(transaksi.Jumlah == 0 ? "yellow" : "")">
                <button @onclick="() => OpenRubah(transaksi.OeTransHId)" class="btn btn-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                    </svg>
                </button>
                <button @onclick="() => OpenDeleteDialog(transaksi)" class="btn btn-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                    </svg>
                </button>
                <button @onclick="() => OpenPrint(transaksi.OeTransHId)" class="btn btn-info">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-printer" viewBox="0 0 16 16">
                        <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z" />
                        <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2H5zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1z" />
                    </svg>
                </button>
                <button @onclick="() => OpenSalesmanDialog(transaksi)" class="btn btn-warning">

                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-save" viewBox="0 0 16 16">
                        <path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z" />
                    </svg>
                </button>
            </td>
        </RowTemplate>
    </DataGridVerticalComponent>


</div>

@if (DeleteDialogOpen)
{
    <ModalDialogComponent Title="Are you sure?" Text=@textDelete OnClose="OnDeleteDialogClose"></ModalDialogComponent>
}

@if (NullDialogOpen)
{
    <ModalDialogComponent Title="MESSAGE" Text=@textAlert TombolSave="false" OnClose="OnDeleteNullClose"></ModalDialogComponent>
}



@code {
    private List<OeTransH> TransHeader = new();
    //   private List<OeTransD> TransDetail;
    private OeTransH _bankToDelete;
    private List<OeSalesman> salesmans;
    public string textAlert { get; set; } = "Transaction Already Posting";
    public string textDelete { get; set; } = "Do you want to delete this entry?";

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }
    string currentUri;
    private bool isProcessing = false;
    private DateTime tgl1 = DateTime.Now.AddDays(-30);
    private DateTime tgl2 = DateTime.Now;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        currentUri = navigationmanager.Uri;
        LoadFirst();
        LoadSalesmans();
    }
    private void LoadFirst()
    {
        int hari = 30;
        DateTime startDate = DateTime.Now.AddDays(-hari);
        DateTime endDate = DateTime.Now.AddDays(hari); ;

        TransHeader = service.GetFirstTransH();
        
        // var filteredTrans = service.GetFirstTransH();
      //  TransHeader = filteredTrans.Where(e => e.Tanggal >= startDate && e.Tanggal <= endDate).ToList();

    }
    private void LoadSalesmans()
    {
        salesmans = service.GetSalesman();
    }
  

    private async Task LoadGet()
    {
        try
        {
            var awal = tgl1.Date;
            var akhir = tgl2.Date.AddDays(1).AddTicks(-1); // penting

            isProcessing = true;

            TransHeader = await service.GetTransH(awal, akhir); ;
            // TransDetail = service.GetTransD();

            // TransHeader.ForEach(
            //               x => x.Kurir = service.GetKurirKode((string.IsNullOrEmpty(x.Kurir) ? "" : x.Kurir))
            //             );
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Terjadi Kesalahan: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            // await JSRuntime.InvokeVoidAsync("alert", "Proses Sudah Selesai");
            StateHasChanged();
        }
    }


    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {
            try
            {
                await service.DelTransH(_bankToDelete.OeTransHId);
                if (!string.IsNullOrEmpty(_bankToDelete.NoPrj))
                    serviceOrder.DelOrderAktif(_bankToDelete.NoPrj);
                _bankToDelete = null;
            }

            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Terjadi Kesalahan: " + ex.Message);
            }
        }

        DeleteDialogOpen = false;
        LoadFirst();

        StateHasChanged();

    }

    private void OnDeleteNullClose(bool accepted)
    {
        //if (accepted)
        //{
        //    await service.DelBank(_bankToDelete.CbBankId);
        //    _bankToDelete = null;
        //}

        DeleteDialogOpen = false;
        NullDialogOpen = false;
        LoadFirst();
        StateHasChanged();

    }
    private void OpenDeleteDialog(OeTransH bank)
    {
        if (bank.Cek == "3")
        {
            textAlert = "Transaction Already Posting";
            NullDialogOpen = true;
        }
        else
        {
            if (!string.IsNullOrEmpty(bank.Cek) && !serviceAR.HasSettlement(bank.NoLpb))
            {
                textDelete = "Do you want to delete this entry?";
                DeleteDialogOpen = true;
            }
            else
            {
                DeleteDialogOpen = false;

                textAlert = "Transaction have a Payment";
                NullDialogOpen = true;
            }
        }


        _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenRubah(int xKdBank)
    {
        navigationmanager.NavigateTo($"/ModuleJual/EditTransJual/{xKdBank}");
    }

    private void OpenPrint(int xKdBank)
    {

        //  navigationmanager.NavigateTo($"/ModulePrinting/PrintSuratJalan/{xKdBank}");
        navigationmanager.NavigateTo($"/ModulePrinting/PrintSuratJalan/{xKdBank}?prevUri ={Uri.EscapeDataString(currentUri)}");
    }

    private void OpenSalesmanDialog(OeTransH bank)
    {
        try
        {
            service.SimpanSalesman(bank);
        }
        catch
        {

        };



        //Console.WriteLine(bank.NoLpb);
        //Console.WriteLine(bank.Kurir);
        //System.Console.WriteLine(bank.Keterangan);
     //   LoadGet();
        StateHasChanged();
    }
}
