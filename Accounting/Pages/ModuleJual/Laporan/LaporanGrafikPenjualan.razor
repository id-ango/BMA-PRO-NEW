@page "/ModuleJual/LaporanGrafikPenjualan"
@attribute [Authorize(Roles = "Admin, Finance")]
@using System.Globalization
@using Accounting.Services
@using eSoft.Pembelian.Data
@using eSoft.Penjualan.Data
@using eSoft.Persediaan.Data
@using Microsoft.EntityFrameworkCore
@inject DbContextOptions<DbContextJual> DatabaseOptions
@inject DbContextOptions<DbContextBeli> PurchaseDatabaseOptions
@inject DbContextOptions<DbContextPersediaan> InventoryDatabaseOptions
@inject ILogger<LaporanGrafikPenjualan> Logger
@inject IJSRuntime JS

<PageTitle>Grafik Penjualan</PageTitle>

<div class="sales-chart-page">
    <div class="sales-chart-heading">
        <div>
            <h1>Grafik Penjualan</h1>
            <p class="text-muted mb-0">Penjualan bersih bulanan (penjualan dikurangi retur), dalam IDR.</p>
        </div>
        <div class="sales-chart-actions">
            <button class="btn btn-outline-primary" @onclick="ExportPdfAsync" disabled="@(isLoading || isGroupLoading || isAnnualLoading || isExporting || !loadedDate.HasValue || !string.IsNullOrEmpty(errorMessage))">
                @if (isExporting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                Simpan PDF
            </button>
            <button class="btn btn-primary" @onclick="LoadAsync" disabled="@(isLoading || isGroupLoading || isAnnualLoading || isExporting)">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                Refresh Data
            </button>
        </div>
    </div>

    @if (isExporting)
    {
        <div class="alert alert-info mt-3" role="status">Menyiapkan PDF grafik dan rincian, mohon tunggu...</div>
    }
    else if (!string.IsNullOrEmpty(exportMessage))
    {
        <div class="alert @(exportFailed ? "alert-danger" : "alert-success") mt-3" role="status">@exportMessage</div>
    }

    @if (isLoading)
    {
        <div class="alert alert-info mt-3" role="status">Memuat data penjualan dan pembelian, mohon tunggu...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
    }
    else if (loadedDate.HasValue)
    {
        var salesScale = new SalesChartScale(VisibleValues);
        var combinedScale = new SalesChartScale(CombinedValues);
        var differenceScale = new SalesChartScale(DifferenceValues);
        <div class="sales-chart-panel mt-3">
            <div class="sales-chart-controls">
                <div>
                    <label for="comparisonYears" class="form-label">Tahun pembanding</label>
                    <select id="comparisonYears" class="form-select" @bind="comparisonYears" @bind:after="OnComparisonYearsChanged" disabled="@(isExporting || isGroupLoading || isAnnualLoading)">
                        <option value="0">Tanpa pembanding</option>
                        <option value="1">1 tahun sebelumnya</option>
                        <option value="2">2 tahun sebelumnya</option>
                        <option value="3">3 tahun sebelumnya</option>
                        <option value="4">4 tahun sebelumnya</option>
                        <option value="5">5 tahun sebelumnya</option>
                    </select>
                </div>
                <small class="text-muted">Tahun berjalan hingga @loadedDate.Value.ToString("dd MMMM yyyy", IndonesianCulture). Bulan berikutnya belum ditampilkan.</small>
            </div>

            <div class="chart-legend" aria-label="Keterangan tahun">
                @foreach (var year in SelectedYears)
                {
                    <span><i class="legend-color year-@(currentYear - year)"></i>@year</span>
                }
            </div>

            @if (monthlySales.Count == 0)
            {
                <div class="alert alert-light">Tidak ada transaksi penjualan atau retur dalam periode yang dimuat.</div>
            }

            <div class="chart-scroll">
                <div class="chart-layout" style="min-width:@(Math.Max(720, 140 + (comparisonYears + 1) * 12 * 16))px" aria-label="Grafik penjualan bersih per bulan. Nilai lengkap tersedia pada tabel di bawah.">
                    <div class="chart-axis">
                        @foreach (var tick in salesScale.Ticks)
                        {
                            <span class="axis-tick" style="bottom:@CssPercent(tick.Position)%">@Money(tick.Value)</span>
                        }
                    </div>
                    <div class="chart-months">
                        @foreach (var tick in salesScale.Ticks)
                        {
                            <div class="chart-grid-line" style="bottom:@CssPercent(tick.Position)%"></div>
                        }
                        <div class="chart-zero-line" style="bottom:@CssPercent(salesScale.ZeroPosition)%"></div>
                        @for (var month = 1; month <= 12; month++)
                        {
                            var currentMonth = month;
                            <div class="chart-month">
                                <div class="chart-bars">
                                    @foreach (var year in SelectedYears)
                                    {
                                        var value = GetValue(year, currentMonth);
                                        <div class="bar-slot">
                                            @if (value.HasValue && value.Value != 0)
                                            {
                                                <div class="chart-bar year-@(currentYear - year)" style="@BarStyle(value.Value, salesScale)" title="@MonthNames[currentMonth - 1] @year: @Money(value.Value) IDR"></div>
                                            }
                                        </div>
                                    }
                                </div>
                                <span class="month-label">@MonthNames[currentMonth - 1]</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="sales-chart-panel mt-3">
            <h2>Perbandingan Penjualan dan Pembelian</h2>
            <p class="text-muted mb-0">Nilai bersih dalam IDR; retur mengurangi penjualan atau pembelian.</p>
            <div class="chart-legend" aria-label="Keterangan tahun">
                @foreach (var year in SelectedYears)
                {
                    <span><i class="legend-color year-@(currentYear - year)"></i>@year</span>
                }
            </div>
            <div class="chart-legend chart-type-legend" aria-label="Keterangan jenis transaksi">
                <span><i class="legend-color transaction-sample"></i>Penjualan</span>
                <span><i class="legend-color transaction-sample purchase-bar"></i>Pembelian</span>
            </div>
            @if (monthlySales.Count == 0 && monthlyPurchases.Count == 0)
            {
                <div class="alert alert-light">Tidak ada transaksi penjualan atau pembelian dalam periode yang dimuat.</div>
            }
            <div class="chart-scroll">
                <div class="chart-layout combined-chart" style="min-width:@(Math.Max(720, 140 + (comparisonYears + 1) * 12 * 28))px" aria-label="Grafik kolom penjualan dan pembelian bersih per bulan. Nilai lengkap tersedia pada tabel di bawah.">
                    <div class="chart-axis">
                        @foreach (var tick in combinedScale.Ticks)
                        {
                            <span class="axis-tick" style="bottom:@CssPercent(tick.Position)%">@Money(tick.Value)</span>
                        }
                    </div>
                    <div class="chart-months">
                        @foreach (var tick in combinedScale.Ticks)
                        {
                            <div class="chart-grid-line" style="bottom:@CssPercent(tick.Position)%"></div>
                        }
                        <div class="chart-zero-line" style="bottom:@CssPercent(combinedScale.ZeroPosition)%"></div>
                        @for (var month = 1; month <= 12; month++)
                        {
                            var currentMonth = month;
                            <div class="chart-month">
                                <div class="chart-bars">
                                    @foreach (var year in SelectedYears)
                                    {
                                        var sale = GetValue(year, currentMonth);
                                        var purchase = GetPurchaseValue(year, currentMonth);
                                        <div class="bar-slot">
                                            @if (sale.HasValue && sale.Value != 0)
                                            {
                                                <div class="chart-bar year-@(currentYear - year)" style="@BarStyle(sale.Value, combinedScale)" title="Penjualan @MonthNames[currentMonth - 1] @year: @Money(sale.Value) IDR"></div>
                                            }
                                        </div>
                                        <div class="bar-slot">
                                            @if (purchase.HasValue && purchase.Value != 0)
                                            {
                                                <div class="chart-bar purchase-bar year-@(currentYear - year)" style="@BarStyle(purchase.Value, combinedScale)" title="Pembelian @MonthNames[currentMonth - 1] @year: @Money(purchase.Value) IDR"></div>
                                            }
                                        </div>
                                    }
                                </div>
                                <span class="month-label">@MonthNames[currentMonth - 1]</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <small class="text-muted">Pembelian menggunakan nilai rupiah tersimpan jika ada kurs, atau jumlah transaksi jika tidak ada kurs.</small>
        </div>

        <div class="sales-chart-panel mt-3">
            <h2>Analisis Penjualan per Group</h2>
            <p class="text-muted">Nilai dan jumlah bersih: penjualan dikurangi retur. Pilih tahun lalu muat analisis untuk melihat group yang paling banyak terjual.</p>
            <div class="sales-chart-controls">
                <div>
                    <label for="groupYear" class="form-label">Tahun analisis</label>
                    <select id="groupYear" class="form-select" @bind="groupYear" @bind:after="OnGroupYearChanged" disabled="@(isGroupLoading || isAnnualLoading || isExporting)">
                        @foreach (var year in SelectedYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
                <button class="btn btn-outline-primary" @onclick="LoadGroupAsync" disabled="@(isGroupLoading || isAnnualLoading || isExporting)">
                    @if (isGroupLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    Muat Analisis Group
                </button>
            </div>
            @if (isGroupLoading)
            {
                <div class="alert alert-info mt-3" role="status">Memuat dan menghitung penjualan per group, mohon tunggu...</div>
            }
            else if (!string.IsNullOrEmpty(groupError))
            {
                <div class="alert alert-danger mt-3" role="alert">@groupError</div>
            }
            else if (groupResult is not null)
            {
                var groupScale = new SalesChartScale(groupResult.Values.Select(x => x.Amount));
                <div class="alert alert-success mt-3" role="status">Analisis group tahun @groupResult.Year selesai dimuat hingga @groupResult.Through.ToString("dd MMMM yyyy", IndonesianCulture).</div>
                @if (groupResult.HeaderTotal != YearTotal(groupResult.Year))
                {
                    <div class="alert alert-warning" role="alert">Total transaksi berubah sejak grafik dimuat. Refresh Data dan muat ulang analisis agar periode yang sama dapat dibandingkan.</div>
                }
                <h3 class="h6 mt-3">Peringkat berdasarkan nilai penjualan bersih (IDR)</h3>
                <div class="mb-3">
                    <label for="itemSort" class="form-label">Urutkan rincian item berdasarkan</label>
                    <select id="itemSort" class="form-select w-auto" @bind="itemSort" @bind:after="OnItemSortChanged" disabled="@isExporting">
                        <option value="quantity">Jumlah terjual</option>
                        <option value="amount">Nilai penjualan</option>
                    </select>
                </div>
                @if (groupResult.Values.Count == 0)
                {
                    <p class="text-muted">Tidak ada transaksi dalam periode ini.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead><tr><th scope="col">Group</th><th scope="col">Grafik nilai</th><th scope="col" class="text-end">Nilai bersih (IDR)</th></tr></thead>
                            <tbody>
                                @foreach (var entry in groupResult.Values)
                                {
                                    <tr>
                                        <th scope="row">
                                            @entry.Group
                                            @if (entry.Items.Count > 0)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary ms-2" @onclick="() => ToggleGroup(entry.Id)" aria-expanded="@(expandedGroupId == entry.Id)">
                                                    @(expandedGroupId == entry.Id ? "Tutup rincian" : $"Rincian item ({entry.Items.Count})")
                                                </button>
                                            }
                                        </th>
                                        <td>
                                            <div class="group-value-chart" aria-hidden="true">
                                                <div class="group-value-zero" style="left:@CssPercent(groupScale.ZeroPosition)%"></div>
                                                @if (entry.Amount != 0)
                                                {
                                                    <div class="group-value-bar @(entry.Amount < 0 ? "negative" : "")" style="@GroupBarStyle(entry.Amount, groupScale)"></div>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-end">@DetailedNumber(entry.Amount)</td>
                                    </tr>
                                    @if (expandedGroupId == entry.Id)
                                    {
                                        var orderedItems = SortGroupItems(entry.Items);
                                        var pageCount = (entry.Items.Count + ItemPageSize - 1) / ItemPageSize;
                                        <tr>
                                            <td colspan="3">
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-striped align-middle mb-2">
                                                        <caption class="caption-top">Rincian item: @entry.Group</caption>
                                                        <thead><tr><th scope="col">Kode item</th><th scope="col">Nama item</th><th scope="col" class="text-end">Qty bersih</th><th scope="col" class="text-end">Nilai bersih (IDR)</th></tr></thead>
                                                        <tbody>
                                                            @foreach (var item in orderedItems.Skip(itemPage * ItemPageSize).Take(ItemPageSize))
                                                            {
                                                                <tr>
                                                                    <td>@(string.IsNullOrEmpty(item.Code) ? "—" : item.Code)</td>
                                                                    <th scope="row">@item.Name</th>
                                                                    <td class="text-end">@DetailedNumber(item.Quantity)@(item.UnitWarning ? " *" : "")</td>
                                                                    <td class="text-end">@DetailedNumber(item.Amount)</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                @if (pageCount > 1)
                                                {
                                                    <div class="d-flex align-items-center gap-2">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousItemPage" disabled="@(itemPage == 0)">Sebelumnya</button>
                                                        <span>Halaman @(itemPage + 1) dari @pageCount</span>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextItemPage" disabled="@(itemPage + 1 >= pageCount)">Berikutnya</button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot><tr><th scope="row" colspan="2">Total</th><th class="text-end">@DetailedNumber(groupResult.HeaderTotal)</th></tr></tfoot>
                        </table>
                    </div>
                }
                @if (groupResult.Values.Any(group => group.Items.Any(item => item.UnitWarning)))
                {
                    <div class="alert alert-warning" role="alert">* Qty dijumlahkan tanpa konversi; item bertanda memiliki satuan berbeda atau kosong sehingga jumlahnya perlu diperiksa.</div>
                }
                <small class="text-muted">Nilai faktur dialokasikan sesuai proporsi nilai detail; retur dikurangi. Qty dijumlahkan sesuai transaksi tanpa konversi satuan. Group mengikuti master item saat ini. Faktur dengan detail kosong atau total detail nol: @groupResult.UnallocatedDocuments; nilainya ditampilkan sebagai nilai tidak teralokasi.</small>
            }
        </div>

        <div class="sales-chart-panel mt-3">
            <h2>Perbandingan Tahunan Group dan Item</h2>
            <p class="text-muted">Gunakan pilihan tahun pembanding di atas. Tahun @currentYear sampai @loadedDate.Value.ToString("dd MMMM yyyy", IndonesianCulture); tahun sebelumnya setahun penuh, sehingga periodenya belum setara.</p>
            <button class="btn btn-outline-primary" @onclick="LoadAnnualAsync" disabled="@(comparisonYears == 0 || isAnnualLoading || isGroupLoading || isExporting)">
                @if (isAnnualLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                Muat Perbandingan Tahunan
            </button>
            @if (comparisonYears == 0)
            {
                <small class="d-block text-muted mt-2">Pilih minimal satu tahun pembanding untuk memuat perbandingan.</small>
            }
            @if (isAnnualLoading)
            {
                <div class="alert alert-info mt-3" role="status">Memuat perbandingan tahunan group dan item, mohon tunggu...</div>
            }
            else if (!string.IsNullOrEmpty(annualError))
            {
                <div class="alert alert-danger mt-3" role="alert">@annualError</div>
            }
            else if (annualResult is not null)
            {
                <div class="alert alert-success mt-3" role="status">Perbandingan tahunan selesai dimuat.</div>
                @if (annualResult.HeaderTotals.Any(x => x.Value != YearTotal(x.Key)))
                {
                    <div class="alert alert-warning" role="alert">Total transaksi berubah sejak grafik dimuat. Refresh Data dan muat ulang perbandingan agar periode yang sama dapat dibandingkan.</div>
                }
                <div class="mb-3">
                    <label for="annualItemSort" class="form-label">Urutkan item berdasarkan tahun @annualResult.Years[0]</label>
                    <select id="annualItemSort" class="form-select w-auto" @bind="annualItemSort" @bind:after="OnAnnualSortChanged" disabled="@isExporting">
                        <option value="quantity">Qty bersih</option>
                        <option value="amount">Nilai bersih</option>
                    </select>
                </div>
                @if (annualResult.Groups.Count == 0)
                {
                    <p class="text-muted">Tidak ada transaksi dalam tahun yang dipilih.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead><tr><th scope="col">Group</th>@foreach (var year in annualResult.Years) { <th scope="col" class="text-end">@year (IDR)</th> }</tr></thead>
                            <tbody>
                                @foreach (var group in annualResult.Groups)
                                {
                                    <tr>
                                        <th scope="row">
                                            @group.Group
                                            @if (group.Items.Count > 0)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary ms-2" @onclick="() => ToggleAnnualGroup(group.Id)" aria-expanded="@(expandedAnnualGroupId == group.Id)">@(expandedAnnualGroupId == group.Id ? "Tutup rincian" : $"Rincian item ({group.Items.Count})")</button>
                                            }
                                        </th>
                                        @foreach (var year in annualResult.Years) { <td class="text-end">@DetailedNumber(group.Values.GetValueOrDefault(year))</td> }
                                    </tr>
                                    @if (expandedAnnualGroupId == group.Id)
                                    {
                                        var sortedItems = SalesGroupAnnualAnalysis.SortItems(group.Items, annualResult.Years[0], annualSortByQuantity);
                                        var pages = (group.Items.Count + ItemPageSize - 1) / ItemPageSize;
                                        <tr><td colspan="@(annualResult.Years.Count + 1)">
                                            <div class="table-responsive">
                                                <table class="table table-sm table-striped align-middle mb-2">
                                                    <caption class="caption-top">Rincian tahunan: @group.Group</caption>
                                                    <thead><tr><th scope="col">Kode item</th><th scope="col">Nama item</th>@foreach (var year in annualResult.Years) { <th scope="col" class="text-end">Qty @year</th><th scope="col" class="text-end">Nilai @year (IDR)</th> }</tr></thead>
                                                    <tbody>
                                                        @foreach (var item in sortedItems.Skip(annualItemPage * ItemPageSize).Take(ItemPageSize))
                                                        {
                                                            <tr>
                                                                <td>@(string.IsNullOrEmpty(item.Code) ? "—" : item.Code)</td>
                                                                <th scope="row">@item.Name@(item.UnitWarning ? " *" : "")</th>
                                                                @foreach (var year in annualResult.Years)
                                                                {
                                                                    var value = item.Values.GetValueOrDefault(year);
                                                                    <td class="text-end">@DetailedNumber(value?.Quantity ?? 0)</td>
                                                                    <td class="text-end">@DetailedNumber(value?.Amount ?? 0)</td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            @if (pages > 1)
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousAnnualPage" disabled="@(annualItemPage == 0)">Sebelumnya</button>
                                                    <span>Halaman @(annualItemPage + 1) dari @pages</span>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextAnnualPage" disabled="@(annualItemPage + 1 >= pages)">Berikutnya</button>
                                                </div>
                                            }
                                        </td></tr>
                                    }
                                }
                            </tbody>
                            <tfoot><tr><th scope="row">Total</th>@foreach (var year in annualResult.Years) { <th class="text-end">@DetailedNumber(annualResult.HeaderTotals[year])</th> }</tr></tfoot>
                        </table>
                    </div>
                }
                @if (annualResult.Groups.Any(group => group.Items.Any(item => item.UnitWarning)))
                {
                    <div class="alert alert-warning" role="alert">* Qty dijumlahkan tanpa konversi; item bertanda memiliki satuan berbeda atau kosong dalam tahun yang dipilih.</div>
                }
                <small class="text-muted">Nilai bersih adalah penjualan dikurangi retur dan dialokasikan dari total faktur. Group mengikuti master item saat ini. Nilai tanpa dasar detail ditampilkan sebagai nilai tidak teralokasi.</small>
            }
        </div>

        <div class="sales-chart-panel mt-3">
            <h2>Selisih Penjualan dan Pembelian</h2>
            <p class="text-muted mb-0">Penjualan bersih dikurangi pembelian bersih per bulan (IDR); selisih ini bukan laba.</p>
            <div class="chart-legend" aria-label="Keterangan tahun">
                @foreach (var year in SelectedYears)
                {
                    <span><i class="legend-color year-@(currentYear - year)"></i>@year</span>
                }
            </div>
            <div class="chart-scroll">
                <div class="chart-layout" style="min-width:@(Math.Max(720, 140 + (comparisonYears + 1) * 12 * 16))px" aria-label="Grafik selisih penjualan dan pembelian bersih per bulan. Nilai lengkap tersedia pada tabel di bawah.">
                    <div class="chart-axis">
                        @foreach (var tick in differenceScale.Ticks)
                        {
                            <span class="axis-tick" style="bottom:@CssPercent(tick.Position)%">@Money(tick.Value)</span>
                        }
                    </div>
                    <div class="chart-months">
                        @foreach (var tick in differenceScale.Ticks)
                        {
                            <div class="chart-grid-line" style="bottom:@CssPercent(tick.Position)%"></div>
                        }
                        <div class="chart-zero-line" style="bottom:@CssPercent(differenceScale.ZeroPosition)%"></div>
                        @for (var month = 1; month <= 12; month++)
                        {
                            var currentMonth = month;
                            <div class="chart-month">
                                <div class="chart-bars">
                                    @foreach (var year in SelectedYears)
                                    {
                                        var value = GetDifferenceValue(year, currentMonth);
                                        <div class="bar-slot">
                                            @if (value.HasValue && value.Value != 0)
                                            {
                                                <div class="chart-bar year-@(currentYear - year)" style="@BarStyle(value.Value, differenceScale)" title="Selisih @MonthNames[currentMonth - 1] @year: @Money(value.Value) IDR"></div>
                                            }
                                        </div>
                                    }
                                </div>
                                <span class="month-label">@MonthNames[currentMonth - 1]</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead><tr><th scope="col">Bulan</th>@foreach (var year in SelectedYears) { <th scope="col" class="text-end">@year (IDR)</th> }</tr></thead>
                    <tbody>
                        @for (var month = 1; month <= 12; month++)
                        {
                            var currentMonth = month;
                            <tr>
                                <th scope="row">@MonthNames[currentMonth - 1]</th>
                                @foreach (var year in SelectedYears)
                                {
                                    var value = GetDifferenceValue(year, currentMonth);
                                    <td class="text-end">@(value.HasValue ? Money(value.Value) : "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th scope="row">Total</th>@foreach (var year in SelectedYears) { <th class="text-end">@Money(YearTotal(year) - PurchaseYearTotal(year))</th> }</tr></tfoot>
                </table>
            </div>
        </div>

        <div class="sales-chart-panel mt-3">
            <h2>Rincian Penjualan Bulanan</h2>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead><tr><th scope="col">Bulan</th>@foreach (var year in SelectedYears) { <th scope="col" class="text-end">@year (IDR)</th> }</tr></thead>
                    <tbody>
                        @for (var month = 1; month <= 12; month++)
                        {
                            var currentMonth = month;
                            <tr>
                                <th scope="row">@MonthNames[currentMonth - 1]</th>
                                @foreach (var year in SelectedYears)
                                {
                                    var value = GetValue(year, currentMonth);
                                    <td class="text-end">@(value.HasValue ? Money(value.Value) : "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th scope="row">Total</th>@foreach (var year in SelectedYears) { <th class="text-end">@Money(YearTotal(year))</th> }</tr></tfoot>
                </table>
            </div>
            <small class="text-muted">Total tahun berjalan hingga tanggal di atas; total tahun pembanding mencakup setahun penuh. Tanda — menunjukkan bulan yang belum berjalan.</small>
        </div>

        <div class="sales-chart-panel mt-3">
            <h2>Rincian Pembelian Bulanan</h2>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead><tr><th scope="col">Bulan</th>@foreach (var year in SelectedYears) { <th scope="col" class="text-end">@year (IDR)</th> }</tr></thead>
                    <tbody>
                        @for (var month = 1; month <= 12; month++)
                        {
                            var currentMonth = month;
                            <tr>
                                <th scope="row">@MonthNames[currentMonth - 1]</th>
                                @foreach (var year in SelectedYears)
                                {
                                    var value = GetPurchaseValue(year, currentMonth);
                                    <td class="text-end">@(value.HasValue ? Money(value.Value) : "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th scope="row">Total</th>@foreach (var year in SelectedYears) { <th class="text-end">@Money(PurchaseYearTotal(year))</th> }</tr></tfoot>
                </table>
            </div>
            <small class="text-muted">Total tahun berjalan hingga tanggal di atas; total tahun pembanding mencakup setahun penuh. Tanda — menunjukkan bulan yang belum berjalan.</small>
        </div>
    }
</div>

@code {
#nullable enable
    private static readonly CultureInfo IndonesianCulture = CultureInfo.GetCultureInfo("id-ID");
    private static readonly string[] MonthNames = { "Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des" };
    private const int ItemPageSize = 100;
    private Dictionary<(int Year, int Month), decimal> monthlySales = new();
    private Dictionary<(int Year, int Month), decimal> monthlyPurchases = new();
    private DateTime? loadedDate;
    private int currentYear = DateTime.Today.Year;
    private int comparisonYears;
    private int groupYear;
    private bool isLoading;
    private bool isGroupLoading;
    private bool isAnnualLoading;
    private bool isExporting;
    private bool exportFailed;
    private string? errorMessage;
    private string exportMessage = string.Empty;
    private string? groupError;
    private SalesGroupResult? groupResult;
    private string? expandedGroupId;
    private int itemPage;
    private bool sortItemsByQuantity = true;
    private SalesGroupAnnualResult? annualResult;
    private string? annualError;
    private string? expandedAnnualGroupId;
    private int annualItemPage;
    private bool annualSortByQuantity = true;

    private string itemSort
    {
        get => sortItemsByQuantity ? "quantity" : "amount";
        set => sortItemsByQuantity = value == "quantity";
    }

    private string annualItemSort
    {
        get => annualSortByQuantity ? "quantity" : "amount";
        set => annualSortByQuantity = value == "quantity";
    }

    private IEnumerable<int> SelectedYears => Enumerable.Range(0, comparisonYears + 1).Select(offset => currentYear - offset);
    private IEnumerable<decimal> VisibleValues => SelectedYears.SelectMany(year => Enumerable.Range(1, 12).Select(month => GetValue(year, month))).Where(value => value.HasValue).Select(value => value!.Value);
    private IEnumerable<decimal> CombinedValues => VisibleValues.Concat(SelectedYears.SelectMany(year => Enumerable.Range(1, 12).Select(month => GetPurchaseValue(year, month))).Where(value => value.HasValue).Select(value => value!.Value));
    private IEnumerable<decimal> DifferenceValues => SelectedYears.SelectMany(year => Enumerable.Range(1, 12).Select(month => GetDifferenceValue(year, month))).Where(value => value.HasValue).Select(value => value!.Value);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        groupResult = null;
        groupError = null;
        expandedGroupId = null;
        annualResult = null;
        annualError = null;
        expandedAnnualGroupId = null;
        ClearExportStatus();
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            var today = DateTime.Today;
            var start = new DateTime(today.Year - 5, 1, 1);
            var end = today.AddDays(1);
            await using var db = new DbContextJual(DatabaseOptions);
            var results = await db.OeTransHs.AsNoTracking()
                .Where(x => x.Tanggal >= start && x.Tanggal < end && (x.Kode == "94" || x.Kode == "95"))
                .GroupBy(x => new { x.Tanggal.Year, x.Tanggal.Month })
                .Select(g => new { g.Key.Year, g.Key.Month, Total = g.Sum(x => x.Kode == "94" ? x.Jumlah : -x.Jumlah) })
                .ToListAsync();
            await using var purchaseDb = new DbContextBeli(PurchaseDatabaseOptions);
            var purchaseResults = await purchaseDb.IrTransHs.AsNoTracking()
                .Where(x => x.Tanggal >= start && x.Tanggal < end && (x.Kode == "82" || x.Kode == "83"))
                .GroupBy(x => new { x.Tanggal.Year, x.Tanggal.Month })
                .Select(g => new
                {
                    g.Key.Year,
                    g.Key.Month,
                    Total = g.Sum(x => x.Kode == "82"
                        ? (x.Kurs > 0 ? x.Nilai : x.Jumlah)
                        : -(x.Kurs > 0 ? x.Nilai : x.Jumlah))
                })
                .ToListAsync();
            monthlySales = results.ToDictionary(x => (x.Year, x.Month), x => x.Total);
            monthlyPurchases = purchaseResults.ToDictionary(x => (x.Year, x.Month), x => x.Total);
            currentYear = today.Year;
            groupYear = today.Year;
            loadedDate = today;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Gagal memuat grafik penjualan dan pembelian");
            errorMessage = "Data penjualan dan pembelian belum dapat dimuat. Silakan coba kembali.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadGroupAsync()
    {
        if (!loadedDate.HasValue || isLoading || isGroupLoading || isAnnualLoading || isExporting || !SelectedYears.Contains(groupYear))
            return;
        isGroupLoading = true;
        groupResult = null;
        groupError = null;
        expandedGroupId = null;
        ClearExportStatus();
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            groupResult = await SalesGroupAnalysis.LoadAsync(DatabaseOptions, InventoryDatabaseOptions, groupYear, loadedDate.Value);
            expandedGroupId = groupResult.Values.FirstOrDefault(group => group.Items.Count > 0)?.Id;
            itemPage = 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Gagal memuat analisis penjualan per group");
            groupError = "Analisis penjualan per group belum dapat dimuat. Silakan coba kembali.";
        }
        finally
        {
            isGroupLoading = false;
        }
    }

    private void OnComparisonYearsChanged()
    {
        annualResult = null;
        annualError = null;
        expandedAnnualGroupId = null;
        if (!SelectedYears.Contains(groupYear))
        {
            groupYear = currentYear;
            groupResult = null;
            groupError = null;
            expandedGroupId = null;
        }
        ClearExportStatus();
    }

    private void OnGroupYearChanged()
    {
        groupResult = null;
        groupError = null;
        expandedGroupId = null;
        ClearExportStatus();
    }

    private void ToggleGroup(string id)
    {
        expandedGroupId = expandedGroupId == id ? null : id;
        itemPage = 0;
    }

    private void OnItemSortChanged()
    {
        itemPage = 0;
        ClearExportStatus();
    }

    private void PreviousItemPage() => itemPage = Math.Max(0, itemPage - 1);
    private void NextItemPage() => itemPage++;
    private IEnumerable<SalesGroupItemTotal> SortGroupItems(IReadOnlyList<SalesGroupItemTotal> items) =>
        SalesGroupAnalysis.SortItems(items, sortItemsByQuantity);

    private async Task LoadAnnualAsync()
    {
        if (!loadedDate.HasValue || comparisonYears == 0 || isLoading || isGroupLoading || isAnnualLoading || isExporting)
            return;
        isAnnualLoading = true;
        annualResult = null;
        annualError = null;
        expandedAnnualGroupId = null;
        ClearExportStatus();
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            annualResult = await SalesGroupAnnualAnalysis.LoadAsync(DatabaseOptions, InventoryDatabaseOptions, SelectedYears.ToArray(), loadedDate.Value);
            expandedAnnualGroupId = annualResult.Groups.FirstOrDefault(group => group.Items.Count > 0)?.Id;
            annualItemPage = 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Gagal memuat perbandingan tahunan group dan item");
            annualError = "Perbandingan tahunan belum dapat dimuat. Silakan coba kembali.";
        }
        finally
        {
            isAnnualLoading = false;
        }
    }

    private void ToggleAnnualGroup(string id)
    {
        expandedAnnualGroupId = expandedAnnualGroupId == id ? null : id;
        annualItemPage = 0;
    }

    private void OnAnnualSortChanged()
    {
        annualItemPage = 0;
        ClearExportStatus();
    }

    private void PreviousAnnualPage() => annualItemPage = Math.Max(0, annualItemPage - 1);
    private void NextAnnualPage() => annualItemPage++;

    private async Task ExportPdfAsync()
    {
        if (!loadedDate.HasValue || isLoading || isGroupLoading || isAnnualLoading || isExporting)
            return;

        isExporting = true;
        ClearExportStatus();
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            var report = new SalesChartReport(loadedDate.Value, SelectedYears.ToArray(),
                new Dictionary<(int Year, int Month), decimal>(monthlySales),
                new Dictionary<(int Year, int Month), decimal>(monthlyPurchases),
                groupResult, groupResult is null ? null : YearTotal(groupResult.Year), sortItemsByQuantity, annualResult, annualSortByQuantity);
            var pdf = SalesChartPdfExporter.Generate(report);
            using var stream = new MemoryStream(pdf);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Grafik_Penjualan_Pembelian_{loadedDate.Value:yyyyMMdd}.pdf", streamRef);
            exportMessage = "PDF telah disiapkan dan unduhan dimulai.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Gagal membuat PDF grafik penjualan dan pembelian");
            exportFailed = true;
            exportMessage = "PDF belum dapat dibuat atau diunduh. Silakan coba kembali.";
        }
        finally
        {
            isExporting = false;
        }
    }

    private void ClearExportStatus()
    {
        exportFailed = false;
        exportMessage = string.Empty;
    }

    private decimal? GetValue(int year, int month) => year == currentYear && month > loadedDate!.Value.Month
        ? null
        : monthlySales.GetValueOrDefault((year, month));

    private decimal? GetPurchaseValue(int year, int month) => year == currentYear && month > loadedDate!.Value.Month
        ? null
        : monthlyPurchases.GetValueOrDefault((year, month));

    private decimal? GetDifferenceValue(int year, int month) => GetValue(year, month) - GetPurchaseValue(year, month);

    private decimal YearTotal(int year) => Enumerable.Range(1, 12).Sum(month => GetValue(year, month) ?? 0);
    private decimal PurchaseYearTotal(int year) => Enumerable.Range(1, 12).Sum(month => GetPurchaseValue(year, month) ?? 0);
    private static string Money(decimal value) => value.ToString("N0", IndonesianCulture);
    private static string DetailedNumber(decimal value) => value.ToString("N4", IndonesianCulture);
    private static string CssPercent(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static string GroupBarStyle(decimal value, SalesChartScale scale)
    {
        var width = scale.Range == 0 ? 0 : Math.Abs(value) / scale.Range * 100;
        var left = value < 0 ? scale.ZeroPosition - width : scale.ZeroPosition;
        return $"width:{CssPercent(width)}%;left:{CssPercent(left)}%";
    }
    private static string BarStyle(decimal value, SalesChartScale scale)
    {
        var height = scale.Range == 0 ? 0 : Math.Abs(value) / scale.Range * 100;
        var bottom = value < 0 ? scale.ZeroPosition - height : scale.ZeroPosition;
        return $"height:{CssPercent(height)}%;bottom:{CssPercent(bottom)}%";
    }
}
