<div class="container">
    <h1>
        Laporan Penjualan/Tahun
        <input type="number" min="2022" @bind-value="@Tahun" />
    </h1>
</div>


<div class="container">
    <label>
        <input type="checkbox" checked=@asChecked
               @onchange="EventArgs => { CheckboxAll(EventArgs.Value); }" />
        Selected All
    </label>

    <br />
    <br />


    
    

    @foreach (var bank in Banks)
    {
        var Text = bank.NamaDiv;
        var Value = bank.Divisi.ToString();
        bool Checked = false;
        if (selectedList.Contains(Value))
        {
            Checked = true;
        }
        

            <div class="col">
                <label>
                    <input type="checkbox" checked="@Checked"
                   @onchange="EventArgs => { CheckboxClicked(Value, EventArgs.Value); }" />

                    @bank.NamaDiv
                </label>

                <br />
            </div>
        
    }
    @OutputValue
    <br/>
    @Tahun
</div>

<br />
<br />
<div class="col-4">
        <br />
        <button class="btn btn-primary" @onclick="@(() => proses1())">Display Penjualan</button>
         <button class="btn btn-primary" @onclick="@(() => proses2())">Display Penjualan Belum Laku</button>
          <button class="btn btn-primary" @onclick="@(() => proses3())">Display Penjualan/Tahun</button>
    <button class="btn btn-primary" @onclick="@(() => proses4())">Display Per Divisi</button>
        <br />
        
    </div>

<div class="container">

    @if(SearchOpen)
    {
         <DataGridJualPertahunComponent Items="RekKoran" Tahun="Tahun"></DataGridJualPertahunComponent>
    }

    @if (DivisiOpen)
    {
        <DataGridJualDivisiPertahunComponent Items="RekKoran" Tahun="Tahun"></DataGridJualDivisiPertahunComponent>
    }

    @if(DetailOpen)
    {
          <DataGridJualBeliPertahunComponent Items="RekKoran"></DataGridJualBeliPertahunComponent>
    }
  

    </div>




