    private void CheckboxAll(object aChecked)
    {
        if ((bool)aChecked)
        {
            //foreach (var bank in Banks)
            //{
            //    selectedList.Remove(bank.KodeBank);
            //    TglStarts.Remove(bank.KodeBank);
            //    TglEnds.Remove(bank.KodeBank);
            //};

            selectedList.Clear();
            TglStarts.Clear();
            TglEnds.Clear();


            foreach (var bank in Banks)
            {
                selectedList.Add(bank.Divisi);
                TglStarts.Add(bank.Divisi, DateTime.Today);
                TglEnds.Add(bank.Divisi, DateTime.Today);
            }
        }
        else
        {
            foreach (var bank in Banks)
            {
                selectedList.Remove(bank.Divisi);
                TglStarts.Remove(bank.Divisi);
                TglEnds.Remove(bank.Divisi);
            }
        }
        OutputValue = string.Join(",", selectedList.ToArray());

        BankView = (from e in Banks where selectedList.Contains(e.Divisi) select e).ToList();

        //    totalJumlah = BankView.Sum(x => x.Saldo);

        StateHasChanged();
    }

    private void CheckboxClicked(string aSelectedId, object aChecked)
    {
        if ((bool)aChecked)
        {
            if (!selectedList.Contains(aSelectedId))
            {
                selectedList.Add(aSelectedId);
                TglStarts.Add(aSelectedId, DateTime.Today);
                TglEnds.Add(aSelectedId, DateTime.Today);
            }
        }
        else
        {
            if (selectedList.Contains(aSelectedId))
            {
                selectedList.Remove(aSelectedId);
                TglStarts.Remove(aSelectedId);
                TglEnds.Remove(aSelectedId);


            }
        }

        OutputValue = string.Join(",", selectedList.ToArray());

        BankView = (from e in Banks where selectedList.Contains(e.Divisi) select e).ToList();

        //    totalJumlah = BankView.Sum(x => x.Saldo);

        StateHasChanged();

    }

    private void OnSearchClose(bool accepted)
    {

        SearchOpen = false;
        StateHasChanged();

    }

  

