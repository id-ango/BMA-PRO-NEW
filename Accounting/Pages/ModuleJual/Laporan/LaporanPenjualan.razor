    case 5:
        <div class="container">

            <DataGridPenjualanPerSalesComponent Items="TransSales" OnDetail="OpenDetail5"></DataGridPenjualanPerSalesComponent>

        </div>
        @if (DetailOpen5)
        {

            <ModalDetailJualComponent OnClose="OnSearchClose" Items="TransDetail2" Context="transaksi5" GetFilterableText="@(item =>$"{item.Customer} {item.NamaCust} {item.Lokasi} {item.AlamatKirim} {item.NoLpb}")">
                <TableHeader>
                    <th scope="col">Customer</th>

                    <th scope="col">Dokumen</th>

                    <th scope="col">Alamat Kirim</th>
                    @*<th scope="col">Harga</th>
                <th scope="col">Disc%</th>
                <th scope="col">Jumlah</th>*@
