@code {

    public List<OeTransH> TransHeader;
    public List<OeTransD> TransDetail;
    public List<IcItem> TransItem;
    public List<OeTrans> TransDetail2;
    public List<ArCust> TransCustomer;
    public List<OeKurir> TransKurir;
    public List<OeSalesman> TransSales;

    private string nCount { get; set; }
    private string nOngkir { get; set; }
    private string nJumlah { get; set; }
    private string nPPn { get; set; }

    public OeTransH transh = new OeTransH();
    List<OeTransH> transaksi = new List<OeTransH>();


    public int Tampilan { get; set; } = 1;

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }
    public bool DetailOpen { get; set; }
    public bool DetailOpen2 { get; set; }
    public bool DetailOpen3 { get; set; }
    public bool DetailOpen4 { get; set; }
    public bool DetailOpen5 { get; set; }

    public DateTime Tanggal1 { get; set; }
    public DateTime Tanggal2 { get; set; }



    protected override void OnInitialized()
    {
        base.OnInitialized();
        Tanggal1 = DateTime.Today;
        Tanggal2 = DateTime.Today;
        proses1();

    }



    private void OnSearchClose(bool accepted)
    {

        DetailOpen = false;
        DetailOpen2 = false;
        DetailOpen3 = false;
        DetailOpen4 = false;
        DetailOpen5 = false;
        StateHasChanged();

    }

    private void proses1()
    {
        TransHeader = service.Laporan1(Tanggal1, Tanggal2);
        var kurirLookup = service.GetKurir()
            .Where(x => string.IsNullOrWhiteSpace(x.Kurir) == false)
            .ToDictionary(x => x.Kurir, x => x.NamaKurir);

        var salesmanLookup = service.GetSalesman()
            .Where(x => string.IsNullOrWhiteSpace(x.Salesman) == false)
            .ToDictionary(x => x.Salesman, x => x.NamaSales);

        TransHeader.ForEach(x =>
        {
            x.Kurir = string.IsNullOrEmpty(x.Kurir)
                ? string.Empty
                : kurirLookup.GetValueOrDefault(x.Kurir, x.Kurir);
            x.Lokasi = string.IsNullOrEmpty(x.Salesman)
                ? string.Empty
                : salesmanLookup.GetValueOrDefault(x.Salesman, x.Salesman);
        });

        Tampilan = 1;
        //  nJumlah = TransHeader.Sum(x => x.Jumlah).ToString("N");
        // StateHasChanged();
    }

    private void OpenDetail(OeTransH xKdBank)
    {

        TransDetail = service.Detail1(xKdBank.OeTransHId);
        DetailOpen = !DetailOpen;
        //  navigationmanager.NavigateTo($"/ModuleJual/EditTransJual/{xKdBank}");
        StateHasChanged();
    }

    //private void OpenPrint(int xKdBank)
    //{
    //    navigationmanager.NavigateTo($"/PrintSuratJalan/{xKdBank}");
    //}
    private void proses2()
    {
        //  TransItem = serviceIC.GetIcItem();
        TransItem = serviceLaporan.CetakItemCustomer(Tanggal1, Tanggal2);
        Tampilan = 2;
        //  nJumlah = TransHeader.Sum(x => x.Jumlah).ToString("N");
        StateHasChanged();
    }

    private void OpenDetail2(IcItem xKdBank)
    {

        TransDetail2 = service.Detail2(xKdBank.ItemCode, Tanggal1, Tanggal2);
        DetailOpen2 = !DetailOpen2;
        //  navigationmanager.NavigateTo($"/ModuleJual/EditTransJual/{xKdBank}");
        StateHasChanged();
    }

    private void proses3()
    {
        // TransCustomer = serviceAR.GetCustomer();
        TransCustomer = serviceLaporan.CetakCustomerItem(Tanggal1, Tanggal2);
        Tampilan = 3;
        //  nJumlah = TransHeader.Sum(x => x.Jumlah).ToString("N");
        StateHasChanged();
    }

    private void OpenDetail3(ArCust xKdBank)
    {

        TransDetail2 = service.Detail3(xKdBank.Customer, Tanggal1, Tanggal2);
        DetailOpen3 = !DetailOpen3;
        //  navigationmanager.NavigateTo($"/ModuleJual/EditTransJual/{xKdBank}");
        StateHasChanged();
    }

    private void proses4()
    {
        // TransCustomer = serviceAR.GetCustomer();
        TransKurir = serviceLaporan.CetakKurirCustomer(Tanggal1, Tanggal2);
        Tampilan = 4;
        //  nJumlah = TransHeader.Sum(x => x.Jumlah).ToString("N");
        StateHasChanged();
    }

    private void OpenDetail4(OeKurir xKdBank)
    {

        TransDetail2 = service.Detail4(xKdBank.Kurir, Tanggal1, Tanggal2);
        DetailOpen4 = !DetailOpen4;
        //  navigationmanager.NavigateTo($"/ModuleJual/EditTransJual/{xKdBank}");
        StateHasChanged();
    }

    private void proses5()
{
    // TransCustomer = serviceAR.GetCustomer();
    TransSales = serviceLaporan.CetakSalesCustomer(Tanggal1, Tanggal2);
    Tampilan = 5;
    //  nJumlah = TransHeader.Sum(x => x.Jumlah).ToString("N");
    StateHasChanged();
}

private void OpenDetail5(OeSalesman xKdBank)
{

    TransDetail2 = service.Detail5(xKdBank.Salesman, Tanggal1, Tanggal2);
    DetailOpen5 = !DetailOpen4;
    //  navigationmanager.NavigateTo($"/ModuleJual/EditTransJual/{xKdBank}");
    StateHasChanged();
}

    private Stream GetFileStream()
    {
        var TransD = service.LaporanDownload(Tanggal1, Tanggal2);

        var randomBinaryData = serviceXL.CreatePenjualanExport(TransD);

        //   var randomBinaryData = new byte[50 * 1024];
        var fileStream = new MemoryStream(randomBinaryData);

        return fileStream;
    }

    private async Task DownloadFileFromStream()
    {
        var fileStream = GetFileStream();
        var fileName = $"Penjualan{DateTime.Now.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)}.xlsx";

        using var streamRef = new DotNetStreamReference(stream: fileStream);

        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }


}
