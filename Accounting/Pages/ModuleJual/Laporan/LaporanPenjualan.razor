        </div>
        @if (DetailOpen4)
        {

            <ModalDetailJualComponent OnClose="OnSearchClose" Items="TransDetail2" Context="transaksi4" GetFilterableText="@(item =>$"{item.Customer} {item.NamaCust} {item.Lokasi} {item.AlamatKirim} {item.NoLpb}")">
                <TableHeader>
                    <th scope="col">Customer</th>

                    <th scope="col">Dokumen</th>

                    <th scope="col">Alamat Kirim</th>
                    
