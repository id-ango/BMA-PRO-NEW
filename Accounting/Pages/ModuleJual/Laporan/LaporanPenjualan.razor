                    <td style="text-align:right">@transaksi4.Harga.ToString("N")</td>
                    <td style="text-align:right">@transaksi4.Persen.ToString("N")</td>
                    <td style="text-align:right">@transaksi4.Jumlah.ToString("N")</td>*@
                    <td>@transaksi4.Jumlah.ToString("N")</td>
                </RowTemplate>
            </ModalDetailJualComponent>


