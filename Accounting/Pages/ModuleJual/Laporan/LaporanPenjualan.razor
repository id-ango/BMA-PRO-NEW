@page "/ModuleJual/LaporanPenjualan"

@using eSoft.Piutang.Model
@using eSoft.Piutang.View
@using eSoft.Piutang.Services
@using eSoft.Persediaan.Model
@using eSoft.Persediaan.View
@using eSoft.Persediaan.Services
@using eSoft.Penjualan.Model
@using eSoft.Penjualan.View
@using eSoft.Penjualan.Services
@using eSoft.LaporanStock.Services
@using Accounting.Services
@using System.IO

@inject ISalesServices service
@inject IReceivableServices serviceAR
@inject IInventoryServices serviceIC
@inject ILaporanStockServices serviceLaporan
@inject IExcelServices serviceXL
@inject IJSRuntime JS

@inject NavigationManager navigationmanager

<h3>Laporan Penjualan</h3>
<div class="row">
    <div class="col-4">
        <EditForm Model="transh">
            <div class="form-group">
                <label>
                    Dari Tanggal :
                    <InputDate class="form-control" @bind-Value="Tanggal1" />
                </label>
            </div>
            <div class="form-group">
                <label>
                    Sd Tanggal :
                    <InputDate class="form-control" @bind-Value="Tanggal2" />
                </label>
            </div>

        </EditForm>
    </div>

    <div class="col-4">
        <br />
        <button class="btn btn-primary" @onclick="@(() => proses1())">Display Penjualan</button>
        <br />
        <button class="btn btn-primary" @onclick="@(() => proses2())">Display Item/Customer</button>
        <br />
        <button class="btn btn-primary" @onclick="@(() => proses3())">Display Customer/Item</button>
        <br />
        <button class="btn btn-primary" @onclick="@(() => proses4())">Display Kurir/Customer</button>
        <br />
        <button class="btn btn-primary" @onclick="@(() => proses5())">Display Sales/Customer</button>
        <br />
        <button class="btn btn-success" @onclick="@(() => DownloadFileFromStream())">Download Penjualan</button>
    </div>
</div>

<div class="row">
    <br />
</div>

@switch (Tampilan)
{
    case 1:
        <div class="container">

            <DataGridPenjualanComponent Items="TransHeader" OnDetail="OpenDetail"></DataGridPenjualanComponent>

        </div>
        @if (DetailOpen)
        {

            <ModalDetailJualComponent OnClose="OnSearchClose" Items="TransDetail" Context="transaksi2" GetFilterableText="@(item =>$"{item.ItemCode} {item.NamaItem} ")">
                <TableHeader>
                    <th scope="col">Item</th>
                    <th scope="col">Nama Item</th>
                    <th scope="col">Satuan</th>
                    <th scope="col">Qty</th>
                    <th scope="col">Harga</th>
                    <th scope="col">Diskon</th>
                    <th scope="col">Jumlah</th>
                    <th scope="col">Lokasi</th>

                    <th></th>
                </TableHeader>
                <RowTemplate>
                    <td>@transaksi2.ItemCode</td>
                    <td>@transaksi2.NamaItem</td>
                    <td>@transaksi2.Satuan</td>
                    <td style="text-align:right">@transaksi2.Qty.ToString("N")</td>
                    <td style="text-align:right">@transaksi2.Harga.ToString("N")</td>
                    <td style="text-align:right">@transaksi2.Discount.ToString("N")</td>
                    <td style="text-align:right">@transaksi2.Jumlah.ToString("N")</td>
                    <td>@transaksi2.Lokasi</td>
                </RowTemplate>
            </ModalDetailJualComponent>


        }

        break;
    case 2:
        <div class="container">

            <DataGridPenjualanPerItemComponent Items="TransItem" OnDetail="OpenDetail2"></DataGridPenjualanPerItemComponent>

        </div>
        @if (DetailOpen2)
        {

            <ModalDetailJualComponent OnClose="OnSearchClose" Items="TransDetail2" Context="transaksi3" GetFilterableText="@(item =>$"{item.Customer} {item.NamaCust} {item.Lokasi} {item.AlamatKirim} {item.NoLpb}")">
                <TableHeader>
                    <th scope="col">Customer</th>

                    <th scope="col">Dokumen</th>

                    <th scope="col">Qty</th>
                    <th scope="col">Harga</th>
                    <th scope="col">Disc%</th>
                    <th scope="col">Jumlah</th>
                    <th scope="col">Lokasi</th>

                    <th></th>
                </TableHeader>
                <RowTemplate>

                    <td>
                        @transaksi3.NamaCust
                        <br />
                        <span class="badge bg-primary">@transaksi3.Customer</span>
                    </td>

                    <td>
                        @transaksi3.NoLpb
                        <br />
                        <span class="badge bg-primary">@transaksi3.Tanggal.ToShortDateString()</span>
                        <br />
                        @if (!string.IsNullOrWhiteSpace(transaksi3.Keterangan))
                        {
                            <span class="remarks">@transaksi3.Keterangan</span>
                        }
                        else
                        {
                            @transaksi3.Keterangan
                        }
                    </td>
                    @*<td>@transaksi3.AlamatKirim</td>*@
                    <td style="text-align:right">@transaksi3.Qty.ToString("N")</td>
                    <td style="text-align:right">@transaksi3.Harga.ToString("N")</td>
                    <td style="text-align:right">@transaksi3.Persen.ToString("N")</td>
                    <td style="text-align:right">@transaksi3.Jumlah.ToString("N")</td>
                    <td>@transaksi3.Lokasi</td>
                </RowTemplate>
            </ModalDetailJualComponent>


        }

        break;
    case 3:
        <div class="container">

            <DataGridPenjualanPerCustComponent Items="TransCustomer" OnDetail="OpenDetail3"></DataGridPenjualanPerCustComponent>

        </div>
        @if (DetailOpen3)
        {

            <ModalDetailJualComponent OnClose="OnSearchClose" Items="TransDetail2" Context="transaksi2" GetFilterableText="@(item =>$"{item.ItemCode} {item.NamaItem} {item.NoLpb} ")">
                <TableHeader>
                    <th scope="col">Item</th>
                    <th scope="col">Dokumen</th>

                    <th scope="col">Qty</th>
                    <th scope="col">Harga</th>
                    <th scope="col">Diskon</th>
                    <th scope="col">Jumlah</th>
                    <th scope="col">Lokasi</th>

                    <th></th>
                </TableHeader>
                <RowTemplate>
                    <td>
                        @transaksi2.NamaItem
                        <br />
                        <span class="badge bg-primary">@transaksi2.ItemCode</span>
                        <br />
                        <span class="badge bg-secondary">@transaksi2.Satuan</span>
                    </td>

                    <td>
                        @transaksi2.NoLpb
                        <br />
