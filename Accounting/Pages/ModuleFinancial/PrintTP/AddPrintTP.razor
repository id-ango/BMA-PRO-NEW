@page "/ModuleFinancial/AddPrintTP"
@using eSoft.Financial.Model
@using eSoft.Financial.View
@using eSoft.Financial.Services

@inject IFinancialServices service
@inject NavigationManager navigationmanager


<div class="top-row px-4 " style="z-index:5">
    <h3>Add Cetak</h3>
</div>

<div class="content px-4">

    <EditForm Model="@bank" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label>
                Kode Cetak:
                <InputText id="codeBank" class="form-control" @bind-Value="bank.KodeCetak" style="text-transform:uppercase" @onfocusout="cekKode" />
            </label>
        </div>
        <div class="form-group">
            <label>
                Name :
                <InputText class="form-control" @bind-Value="bank.NamaCetak" />
            </label>
        </div>

        <br />
        <div class="container">
            <button class="btn-success" type="submit">Simpan</button>
            <button class="btn-danger" type="button" @onclick="@(() => navigationmanager.NavigateTo("/ModuleFinancial/SetupPrintTP", false))">Batal</button>
        </div>

    </EditForm>

</div>

@if (DialogOpen)
{
    <ModalDialogComponent Title="Alert" Text="Kode Sudah Ada" TombolSave="false" OnClose="OnDialogClose"></ModalDialogComponent>
}

<style>
    label {
        width: 100%;
    }
</style>

@code {
    FcPrintTPView bank = new ();
    public string Testing { get; set; }
    private bool DialogOpen { get; set; }

    public bool SearchOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        bank.KodeCetak = "";

    }

    private void cekKode()
    {
        Testing = bank.KodeCetak;
        DialogOpen = service.CekKdPrintTP(Testing);
        if (DialogOpen)
        {
            bank.KodeCetak = "";
        }
        StateHasChanged();
    }

    private void OnDialogClose(bool accepted)
    {

        DialogOpen = false;
        StateHasChanged();

    }



    private void HandleValidSubmit()
    {
        var newEdit = service.AddPrintTP(bank);
        if (newEdit)
        {


        }

        navigationmanager.NavigateTo("/ModuleFinancial/SetupPrintTP", false);

    }


}
