    //}


    private void OpenCetak()
    {
        //   SearchOpen = !SearchOpen;
        //   string OutputValue = string.Join(",", starship.SelectedClassification);
        RekKoran = serviceFC.CetakBukuBesar(TglStart, TglEnd, selectedList);
        nJumlah = RekKoran.Sum(x => x.Saldo);

        StateHasChanged();

    }

    private void PrintCetak()
    {

        var srccode = string.Join("-", selectedList);
        var kodebank = string.Join("-", selectedBank);
        //  SearchOpen = !SearchOpen;

        //   RekKoran = cashBank.CetakMutasi(TglStart, TglEnd, kodeBank);
        string words = srccode + '+' + TglStart.ToString("yyyy-MM-dd") + '+' + TglEnd.ToString("yyyy-MM-dd") + '+' + kodebank;


        navigationmanager.NavigateTo($"/ModulePrinting/PrintSourceBank/{words}");
        StateHasChanged();

    }


    private void HandleValidSubmit()
    {

    }

    private void OnSearchClose(bool accepted)
    {

        SearchOpen = false;
        StateHasChanged();

    }

        private void OpenRekap()
    {
        //   SearchOpen = !SearchOpen;
        //   string OutputValue = string.Join(",", starship.SelectedClassification);
        RekKoran = serviceFC.CetakBukuBesar(TglStart, TglEnd, selectedList);
        nJumlah = RekKoran.Sum(x => x.Saldo);

        StateHasChanged();

    }
}

