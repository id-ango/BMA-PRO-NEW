@page "/ModuleFinancial/BukuBesar"
@using eSoft.Ledger.Model
@using eSoft.Ledger.View
@using eSoft.Financial.View
@using eSoft.Financial.Services


@using System.ComponentModel.DataAnnotations

@using eSoft.Ledger.Services

@inject IFinancialServices serviceFC
@inject ILedgerServices serviceGL

@inject NavigationManager navigationmanager


<div class="container">
    <h1>Laporan Buku Besar</h1>
</div>
<div class="container">

    <EditForm Model="@SrcCodes" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <div class="row">
                <div class="col-6">
                    <InputSelect class="form-control" @bind-Value="selectedList" style="width:80%; height:250px;">
                        <option value="">&nbsp;&nbsp;---Select GL Account---&nbsp;&nbsp;</option>
                        @foreach (var item in SrcCodes)
                        {
                            <option value="@item.GlAcct">[@item.GlAcct]&nbsp; @item.GlNama</option>
                        }

                    </InputSelect>
                    <br />
                    <button class="btn btn-primary" type="button" @onclick="@(()=> SearchOpen = !SearchOpen)">Cari</button>
                    <button @onclick="() => BtnClear()" class="btn btn-success">Clear</button>

                </div>
               @* <div class="col-6">
                    <InputSelect class="form-control" @bind-Value="selectedBank" style="width:80%; height:250px;">
                        <option value="">&nbsp;&nbsp;---Select Bank---&nbsp;&nbsp;</option>
                        @foreach (var item in Banks)
                        {
                            <option value="@item.KodeBank">[@item.KodeBank]&nbsp; @item.NmBank</option>
                        }

                    </InputSelect>

                </div>*@
            </div>


        </div>
        <br />
        <div class="form-group">
            <label>
                Tanggal :
                <InputDate class="form-control" @bind-Value="@TglStart" />
            </label>
        </div>
        <div class="form-group">
            <label>
                Tanggal :
                <InputDate class="form-control" @bind-Value="@TglEnd" />
            </label>
        </div>


        <br />

        <br />
        <div class="float-md-right">
            @*<button class="btn-success" type="submit">Mutasi</button>*@
            <button class="btn-success" type="button" @onclick="OpenCetak">Mutasi</button>
            <button class="btn-info" type="button" @onclick="PrintCetak">Cetak Mutasi</button>
             <button class="btn-info" type="button" @onclick="OpenRekap">Rekap</button>
        </div>
        <br />
        <br />

    </EditForm>
</div>

<br />


<div class="container">
    <DataGridVerticalComponent Items="RekKoran" Context="cbBank" GetFilterableText="@(item => $"{item.Keterangan} {item.DocNo} ")" TotalJumlah=@nJumlah >
        <TableHeader>
            <th scope="col" style="width:15%">Doc #</th>
            <th scope="col" style="width: 15%">Tanggal</th>
            <th scope="col" style="width: 5%">Gl Akun</th>
            <th scope="col" style="width: 5%">Tipe</th>
            <th scope="col" style="width: 40%">Keterangan</th>
            <th scope="col" style="width: 10%">Mutasi</th>
            <th scope="col" style="width: 10%">Saldo</th>

        </TableHeader>
        <RowTemplate>
            <td style="width:15%">@cbBank.DocNo</td>
            <td style="width:15%">@cbBank.Tanggal.ToShortDateString()</td>
            <td style="width:5%">@cbBank.GlAcct</td>
            <td style="width:5%">@cbBank.TipeGL</td>
            <td style="width:40%">@cbBank.Keterangan</td>
            <td style="text-align: right; width: 10%">@cbBank.Saldo.ToString("N")</td>
            <td style="text-align: right; width: 10%">@cbBank.Balance.ToString("N")</td>

        </RowTemplate>
    </DataGridVerticalComponent>


</div>

@if (SearchOpen)
{

    <ModalSearchComponent OnClose="OnSearchClose" Items="SrcCodes" Context="cbBank" GetFilterableText="@(item =>$"{item.GlAcct} {item.GlNama} ")">
        <TableHeader>
            <th scope="col">Akun</th>
            <th scope="col">Nama Akun</th>

            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@cbBank.GlAcct</td>
            <td>@cbBank.GlNama</td>

            <td>
                <button @onclick="() => BtnChoose(cbBank.GlAcct)" class="btn btn-success">Choose</button>

            </td>
        </RowTemplate>
    </ModalSearchComponent>


}


@code {

    private List<GlAccount> SrcCodes;
    private List<GlAccountView> SrcCodeView = new List<GlAccountView>();
    private List<FcLedgerView> RekKoran = new List<FcLedgerView>();
  


    private string[] selectedList = new string[] { };
    private string[] selectedBank = new string[] { };

    public string kurs { get; set; } = "";
    private string kodeBank { get; set; } = "";

    private DateTime TglStart = DateTime.Today;
    private DateTime TglEnd = DateTime.Today;

    public decimal nJumlah { get; set; }

    public List<string> list = new List<string>();
    public List<string> listBank = new List<string>();

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }
    public bool SearchOpen { get; set; }

    public bool asChecked { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadGet();
        //this.TglStart = DateTime.Today;
        //this.TglEnd = DateTime.Now;
        //StateHasChanged();
    }

    private void LoadGet()
    {
        SrcCodes = serviceGL.GetGlAccount();
       
      
    }

    private void BtnClear()
    {
        list.Clear();
        selectedList = list.ToArray();

        StateHasChanged();
    }


    private void BtnChoose(string textSearch)
    {
        if (!string.IsNullOrEmpty(textSearch))
        {

            list.Add(textSearch);
            selectedList = list.ToArray();

            //  string.Join(textSearch,selectedList);
        }

        SearchOpen = false;
        StateHasChanged();
    }

    //public class SelectedList
    //{


