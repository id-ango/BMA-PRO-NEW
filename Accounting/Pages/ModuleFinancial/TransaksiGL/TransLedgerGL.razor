@page "/ModuleFinancial/TransLedgerGL"
@using eSoft.Ledger.Model
@using eSoft.Financial.Model
@using eSoft.Financial.Services
@using eSoft.Ledger.Services

@using System.ComponentModel.DataAnnotations
@inject ILedgerServices serviceGL
@inject IFinancialServices serviceFC

@implements IDisposable
@inject NavigationManager navigationmanager

<div class="container">
    <h1>Transaksi Ledger GL</h1>
</div>


<div class="container">
    @*<NavLink href="/ModuleFinancial/AddTransLedgerFCGL" class="btn btn-primary">Add</NavLink>*@
    <EditForm Model="@tarikData">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label>
                Tahun Proses :
                <InputNumber class="form-control" @bind-Value="tarikData.Tahun" />
            </label>
        </div>
        <br />
        <button class="btn-success" type="button" @onclick="OpenProses1">Proses</button>
    </EditForm>
</div>

<br />
<br />


<div class="container">
    <DataGridComponent Items="TransHeader" Context="transaksi" GetFilterableText="@(item =>$"{item.DocNo} {item.GlMemo} {item.KodeGl} {item.FcComKode}")">
        <TableHeader>
            <th scope="col">Company</th>
            <th scope="col">Doc #</th>
            <th scope="col">Kode GL</th>
            <th scope="col">Tanggal</th>
            <th scope="col">Keterangan</th>
            <th scope="col">Saldo</th>
            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@transaksi.FcComKode</td>
            <td>@transaksi.DocNo</td>
            <td>@transaksi.KodeGl</td>
            <td>@transaksi.Tanggal.ToShortDateString()</td>
            <td>@transaksi.GlMemo</td>
            <td>@transaksi.Debet.ToString("N")</td>
            <td>
                @*<button @onclick="() => OpenRubah(transaksi.FcGlTransHId)" class="btn btn-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                </svg>
                </button>*@
                <button @onclick="() => OpenDeleteDialog(transaksi)" class="btn btn-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                    </svg>
                </button>
                <button @onclick="() => CicilanBeli(transaksi)" class="btn btn-info">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                    </svg>
                </button>
            </td>
        </RowTemplate>
    </DataGridComponent>


</div>

@if (DeleteDialogOpen)
{
    <ModalDialogComponent Title="Are you sure?" Text="Do you want to delete this entry?" OnClose="OnDeleteDialogClose"></ModalDialogComponent>
}

@if (NullDialogOpen)
{
    <ModalDialogComponent Title="MESSAGE" Text="Transaction Already Has Payment" TombolSave="false" OnClose="OnDeleteNullClose"></ModalDialogComponent>
}

@if (dispCicilan)
{

    <ModalSearchComponent OnClose="OnSearchClose" Items="TransDetail" Context="transaksi2">
        <TableHeader>
            <th scope="col">GlAkun</th>
            <th scope="col">Keterangan</th>
            <th scope="col">Debet</th>
            <th scope="col">Kredit</th>



            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>
                @transaksi2.GlAcct

            </td>

            <td>
                @transaksi2.Keterangan
                <br />

                <span class="badge bg-success">@transaksi2.GlDept</span>


            </td>
            <td style="text-align:right">@transaksi2.Debet.ToString("N")</td>
            <td style="text-align:right">@transaksi2.Kredit.ToString("N")</td>


        </RowTemplate>
    </ModalSearchComponent>


}

@code {

    private List<FcTransH> TransHeader;
    private List<FcTransD> TransDetail;
    private FcTransH _bankToDelete;
    private modelTest tarikData = new modelTest();

    public class modelTest
    {
        [Range(2021, int.MaxValue, ErrorMessage = "Minimum number 2021")]
        public int Tahun { get; set; } = DateTime.Today.Year;
        public string KodeCompany { get; set; }
    }
    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }
    private bool dispCicilan { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadGet();

    }

    private void LoadGet()
    {
        TransHeader = serviceFC.GetTransH(tarikData.Tahun);
       // TransDetail = serviceFC.GetTransD();
    }


    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {
            await serviceFC.DelTransH(_bankToDelete.FcTransHId);
            _bankToDelete = null;
        }

        DeleteDialogOpen = false;
        LoadGet();

        StateHasChanged();

    }
    private void OnSearchClose(bool accepted)
    {

        dispCicilan = false;
        StateHasChanged();

    }
    private void OnDeleteNullClose(bool accepted)
    {
        //if (accepted)
        //{
        //    await cashBank.DelBank(_bankToDelete.CbBankId);
        //    _bankToDelete = null;
        //}

        DeleteDialogOpen = false;
        NullDialogOpen = false;
        LoadGet();
        StateHasChanged();

    }
    private void OpenDeleteDialog(FcTransH bank)
    {

        DeleteDialogOpen = true;


        _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenProses1()
    {
       TransHeader = serviceFC.GetTransH(tarikData.Tahun);
        
    }
    //private void OpenRubah(int xKdBank)
    //{
    //    navigationmanager.NavigateTo($"/ModuleFinancial/EditTransLedgerFCGL/{xKdBank}");
    //}

    //private void OpenPrint(int xKdBank)
    //{
    //      navigationmanager.NavigateTo($"/ModulePrinting/PrintNotaLedgerGL/{xKdBank}");
    //}

    private void CicilanBeli(FcTransH transaksiFC)
    {
        TransDetail = transaksiFC.FcTransDs;
        dispCicilan = true;

    }
    public void Dispose()
    {

    }
}
