@page "/ModuleFinancial/EditCompany/{Id:int}"
@using eSoft.Financial.Model
@using eSoft.Financial.View
@using eSoft.Financial.Services
@using eSoft.Ledger.Model
@using eSoft.Ledger.Services

@inject ILedgerServices serviceGL
@inject IFinancialServices serviceFC
@inject NavigationManager navigationmanager

<h3>Edit Company</h3>

<div class="content px-4">
    <EditForm Model="@bank" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label>
                Company Code :
                <InputText id="codeBank" class="form-control" @bind-Value="bank.FcComKode" style="text-transform:uppercase" @onfocusout="cekKode" disabled="disabled" />
            </label>
        </div>
        <div class="form-group">
            <label>
                Nama Company :
                <InputText class="form-control" @bind-Value="bank.FcNamaPerusahaan" />
            </label>
        </div>
        <br/>
        <div class="form-group">
            <label>
                CashBank Clearing :
                <InputSelect class="form-control" @bind-Value="bank.GlAcct1" style="width:60%; display:inline">
                    <option value="">&nbsp;&nbsp;---Select GL Account---&nbsp;&nbsp;</option>
                    @foreach (var item in GlAccounts)
                    {
                        <option value="@item.GlAcct">@item.NamaLengkap</option>
                    }

                </InputSelect>
                <button class="btn btn-primary" type="button" @onclick="@(() => openSearch(1))">Cari</button>
            </label>
        </div>
        <div class="form-group">
            <label>
                AR Clearing :
                <InputSelect class="form-control" @bind-Value="bank.GlAcct2" style="width:60%; display:inline">
                    <option value="">&nbsp;&nbsp;---Select GL Account---&nbsp;&nbsp;</option>
                    @foreach (var item in GlAccounts)
                    {
                        <option value="@item.GlAcct">@item.NamaLengkap</option>
                    }

                </InputSelect>
                <button class="btn btn-primary" type="button" @onclick="@(() => openSearch(2))">Cari</button>
            </label>
        </div>
        <div class="form-group">
            <label>
                AP Clearing :
                <InputSelect class="form-control" @bind-Value="bank.GlAcct3" style="width:60%; display:inline">
                    <option value="">&nbsp;&nbsp;---Select GL Account---&nbsp;&nbsp;</option>
                    @foreach (var item in GlAccounts)
                    {
                        <option value="@item.GlAcct">@item.NamaLengkap</option>
                    }

                </InputSelect>
                <button class="btn btn-primary" type="button" @onclick="@(() => openSearch(3))">Cari</button>
            </label>
        </div>
       @* <div class="form-group">
            <label>
                GL Account 4 :
                <InputSelect class="form-control" @bind-Value="bank.GlAcct4" style="width:60%; display:inline">
                    <option value="">&nbsp;&nbsp;---Select GL Account---&nbsp;&nbsp;</option>
                    @foreach (var item in GlAccounts)
                    {
                        <option value="@item.GlAcct">@item.NamaLengkap</option>
                    }

                </InputSelect>
                <button class="btn btn-primary" type="button" @onclick="@(() => openSearch(4))">Cari</button>
            </label>
        </div>
        <div class="form-group">
            <label>
                GL Account 5 :
                <InputSelect class="form-control" @bind-Value="bank.GlAcct5" style="width:60%; display:inline">
                    <option value="">&nbsp;&nbsp;---Select GL Account---&nbsp;&nbsp;</option>
                    @foreach (var item in GlAccounts)
                    {
                        <option value="@item.GlAcct">@item.NamaLengkap</option>
                    }

                </InputSelect>
                <button class="btn btn-primary" type="button" @onclick="@(() => openSearch(5))">Cari</button>
            </label>
        </div>
        <div class="form-group">
            <label>
                GL Account 6 :
                <InputSelect class="form-control" @bind-Value="bank.GlAcct6" style="width:60%; display:inline">
                    <option value="">&nbsp;&nbsp;---Select GL Account---&nbsp;&nbsp;</option>
                    @foreach (var item in GlAccounts)
                    {
