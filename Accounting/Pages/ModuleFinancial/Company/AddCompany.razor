        <br/>
        <div class="float-md-right">
            <button class="btn-success" type="submit">Simpan</button>
            <button class="btn-danger" type="button" @onclick="@(() => navigationmanager.NavigateTo("/ModuleFinancial/SetupCompany", false))">Batal</button>
        </div>

    </EditForm>
</div>

@if (DialogOpen)
{
    <ModalDialogComponent Title="Alert" Text="Kode Company Sudah Ada" TombolSave="false" OnClose="OnDialogClose"></ModalDialogComponent>
}

@if (SearchOpen)
{

    <ModalSearchComponent OnClose="OnSearchClose" Items="GlAccounts" Context="cbBank" GetFilterableText="@(item =>$"{item.GlAcct} {item.GlNama} ")">
        <TableHeader>
            <th scope="col">Code</th>
            <th scope="col">GL Name</th>

            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@cbBank.GlAcct</td>
            <td>@cbBank.GlNama</td>

            <td>

                <button @onclick="() => BtnChoose(cbBank.GlAcct,i)" class="btn btn-success">Choose</button>

            </td>
        </RowTemplate>
    </ModalSearchComponent>


}

<style>
    label {
        width: 100%;
    }
</style>

@code {
    FcComView bank = new ();
    public string Testing { get; set; }
    private bool DialogOpen { get; set; }
    private List<GlAccount> GlAccounts;
    public bool SearchOpen { get; set; }
    public int i = 1;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        bank.FcComKode = "";
        LoadGlAccounts();
    }

    private void cekKode()
    {
        Testing = bank.FcComKode;
        DialogOpen = serviceFC.CekCompany(Testing);
        if (DialogOpen)
        {
            bank.FcComKode = "";
        }
        StateHasChanged();
    }

    private void OnDialogClose(bool accepted)
    {

        DialogOpen = false;
        StateHasChanged();

    }



    private void HandleValidSubmit()
    {
        var newEdit = serviceFC.AddCompany(bank);
        if (newEdit)
        {


        }

        navigationmanager.NavigateTo("/ModuleFinancial/SetupCompany", false);

    }

    void LoadGlAccounts()
    {
        GlAccounts = serviceGL.GetGlAccount();
    }

    private void openSearch(int i)
    {
        SearchOpen = !SearchOpen;
        this.i = i;

    }
    private void BtnChoose(string textSearch, int i)
    {
        if (!string.IsNullOrEmpty(textSearch))
        {
            switch (i)
            {
                case 1:
                    bank.GlAcct1 = textSearch;
                    break;
                case 2:
                    bank.GlAcct2 = textSearch;
                    break;
                case 3:
                    bank.GlAcct3 = textSearch;
                    break;
                case 4:
                    bank.GlAcct4 = textSearch;
                    break;
                case 5:
                    bank.GlAcct5 = textSearch;
                    break;
                case 6:
                    bank.GlAcct6 = textSearch;
                    break;
            }

        }

        SearchOpen = false;
        StateHasChanged();
    }

    private void OnSearchClose(bool accepted)
    {

        SearchOpen = false;
        StateHasChanged();

    }
}
