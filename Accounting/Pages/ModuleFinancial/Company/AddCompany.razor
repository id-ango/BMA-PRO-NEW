                GL Account 6 :
                <InputSelect class="form-control" @bind-Value="bank.Acct6" style="width: 60%; display: inline">
                    <option value="">&nbsp;&nbsp;---Select GL Account---&nbsp;&nbsp;</option>
                    @foreach (var item in GlAccounts)
