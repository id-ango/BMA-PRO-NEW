@page "/ModuleFinancial/TarikDataFinancial"
@using eSoft.Ledger.Model
@using eSoft.Ledger.View
@using eSoft.Financial.Model
@using eSoft.Financial.View
@using eSoft.Financial.Services
@using Accounting.Services

@using System.ComponentModel.DataAnnotations

@using eSoft.Ledger.Services

@inject IJSRuntime JS
@inject IExcelServices serviceXL
@inject IFinancialServices serviceFC
@inject ILedgerServices serviceGL

@inject NavigationManager navigationmanager

<div class="top-row px-4 " style="z-index:5">
    <h3>Proses Financial</h3>
</div>


<div class="container">
    <EditForm Model="@tarikData">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label>
                Tahun Proses :
                <InputNumber class="form-control" @bind-Value="tarikData.Tahun" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>
                Perusahaan :
                <InputSelect class="form-control" @bind-Value="tarikData.KodeCompany">
                    <option value="">&nbsp;&nbsp;---Select Company---&nbsp;&nbsp;</option>
                    @foreach (var item in Companies)
                    {
                        <option value="@item.FcComKode">@item.FcNamaPerusahaan</option>
                    }

                </InputSelect>
                @* <button class="btn btn-primary" type="button" @onclick="@(()=> SearchOpen = !SearchOpen)">Cari</button>*@
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>
                Dari Tanggal :
                <InputDate class="form-control" @bind-Value="Tanggal1" />
            </label>
        </div>
        <div class="form-group">
            <label>
                Sd Tanggal :
                <InputDate class="form-control" @bind-Value="Tanggal2" />
            </label>
        </div>
        <br />
        @* <button class="btn-success" type="submit">Simpan</button>*@
        <button class="btn-success" type="button" @onclick="OpenProses1">Proses</button>
        <button class="btn-info" type="button" @onclick="OpenProses2">Proses Tax</button>
        <button class="btn-info" type="button" @onclick="OpenProses3">Proses Tax 3</button>
        <button class="btn-warning" type="button" @onclick="@(() => DownloadFileFromStream())">Download to Excel</button>
    </EditForm>

    <br />
</div>

<div class="container">
    <DataGridVerticalComponent Items="transaksiFC" Context="cbBank" GetFilterableText="@(item => $"{item.GlMemo} {item.DocNo} ")" TotalJumlah=@nJumlah>
        <TableHeader>
            <th scope="col" style="width:15%">Doc #</th>
            <th scope="col" style="width: 15%">Tanggal</th>
            <th scope="col" style="width: 5%">Code</th>
            <th scope="col" style="width: 5%">KodeGL</th>
            <th scope="col" style="width: 40%">Keterangan</th>
            <th scope="col" style="width: 10%">Mutasi</th>


        </TableHeader>
        <RowTemplate>
            <td style="width:15%">@cbBank.DocNo</td>
            <td style="width:15%">@cbBank.Tanggal.ToShortDateString()</td>
            <td style="width:5%">@cbBank.FcComKode</td>
            <td style="width:5%">@cbBank.KodeGl</td>
            <td style="width:40%">@cbBank.GlMemo</td>
            <td style="text-align: right; width: 10%">@cbBank.Debet.ToString("N")</td>
            <td style="text-align: right; width: 10%">@cbBank.Saldo.ToString("N")</td>
            <td style="width:10%;">


                <button @onclick="() => CicilanBeli(cbBank.DocNo,cbBank.KodeGl)" class="btn btn-info">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                    </svg>
                </button>
            </td>
        </RowTemplate>
    </DataGridVerticalComponent>


</div>

@if (dispCicilan)
{

    <ModalSearchComponent OnClose="OnSearchClose" Items="transaksiFD" Context="transaksi2">
        <TableHeader>
            <th scope="col">GlAkun</th>
            <th scope="col">Keterangan</th>
            <th scope="col">Debet</th>
            <th scope="col">Kredit</th>



            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>
                @transaksi2.GlAcct

            </td>

            <td>
                @transaksi2.Keterangan
                <br />

                <span class="badge bg-success">@transaksi2.GlDept</span>


            </td>
            <td style="text-align:right">@transaksi2.Debet.ToString("N")</td>
            <td style="text-align:right">@transaksi2.Kredit.ToString("N")</td>


        </RowTemplate>
    </ModalSearchComponent>


}




@code {
 //   private int Tahun = 2022;
 //   private string KodeCompany = "";
    private List<FcCom> Companies;
    private bool DialogOpen { get; set; }
    public bool IsVisible { get; set; }
    public decimal nJumlah { get; set; }

    public bool SearchOpen { get; set; }
    private bool dispCicilan { get; set; }

    private modelTest tarikData = new modelTest();
    private List<FcTransH> transaksiFC = new();
    private List<FcTransD> transaksiFD = new();
    public DateTime Tanggal1 { get; set; }
    public DateTime Tanggal2 { get; set; }

    public class modelTest
    {
        [Range(2021, int.MaxValue, ErrorMessage = "Minimum number 2021")]
        public int Tahun { get; set; } = DateTime.Today.Year;
        public string KodeCompany { get; set; }
    }

    protected override void OnInitialized()
    {
        Tanggal1 = DateTime.Today;
        Tanggal2 = DateTime.Today;

        base.OnInitialized();
        LoadCompany();

    }



    void LoadCompany()
    {
        Companies = serviceFC.GetFcCom();
    }


    private void OnSearchClose(bool accepted)
    {

        dispCicilan = false;
        StateHasChanged();

    }
    private void OpenProses1()
    {
        transaksiFC = serviceFC.prosesFinancial1(tarikData.Tahun, tarikData.KodeCompany);
        nJumlah = transaksiFC.Sum(x => x.Saldo);
    }

    private void OpenProses2()
    {
        transaksiFC = serviceFC.prosesFinancial2(tarikData.Tahun, tarikData.KodeCompany);
        nJumlah = transaksiFC.Sum(x => x.Saldo);
    }

     private void OpenProses3()
    {
        transaksiFC = serviceFC.prosesFinancial3(tarikData.Tahun, tarikData.KodeCompany);
        nJumlah = transaksiFC.Sum(x => x.Saldo);
    }

    private void CicilanBeli(string itemcode, string kodegl)
    {
        transaksiFD = transaksiFC.Find(x => x.DocNo == itemcode && x.KodeGl == kodegl).FcTransDs;
        dispCicilan = true;

    }

    private Stream GetFileStream()
    {
        List<FcTransDxls> transDetail = new List<FcTransDxls>();

        if (transaksiFC != null)
        {

            try
            {
                foreach (var header in transaksiFC.Where(x =>x.Tanggal >= Tanggal1 && x.Tanggal <= Tanggal2).ToList())
                {
                    if (header != null)
                    {
                        foreach (var detail in header.FcTransDs)
                        {
                            transDetail.Add(
                            new FcTransDxls()
                                {
                                    DocNo = header.DocNo,
                                    Tanggal = header.Tanggal,
                                    KodeGl = header.KodeGl,
                                    GlAcct = detail.GlAcct,
                                    Keterangan = header.GlMemo,
                                    Debet = detail.Debet,
                                    Kredit = detail.Kredit,
                                    Jumlah = detail.Debet - detail.Kredit
                                }
                            );
                        }
                    }
                }


            }
            catch
            {

            };
        }

        var randomBinaryData = serviceXL.CreateLedgerExport(transDetail);

        //   var randomBinaryData = new byte[50 * 1024];
        var fileStream = new MemoryStream(randomBinaryData);

        return fileStream;
    }
    private async Task DownloadFileFromStream()
    {
        var fileStream = GetFileStream();
        var fileName = $"Ledger{DateTime.Now.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)}.xlsx";

        using var streamRef = new DotNetStreamReference(stream: fileStream);

        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
}
