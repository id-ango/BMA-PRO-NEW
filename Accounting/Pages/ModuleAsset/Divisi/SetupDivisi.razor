@page "/ModuleAsset/SetupDivisi"
@using eSoft.Asset.Model
@using eSoft.Asset.Services

@inject IAssetServices service
@implements IDisposable
@inject NavigationManager navigationmanager

<div class="container">
    <h1>Setup Divisi</h1>
</div>


<div class="container">
    <NavLink href="/ModuleAsset/AddDivisi" class="btn btn-primary">Add</NavLink>
</div>

<br />
<br />


<div class="container">
    <DataGridComponent Items="SortedBanks" Context="cbBank" GetFilterableText="@(item =>$"{item.Divisi} {item.NamaDiv} ")">
        <TableHeader>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(AsDivisi.Divisi)))" @onclick='() => ApplySort(nameof(AsDivisi.Divisi))'>Code <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(AsDivisi.Divisi))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(AsDivisi.NamaDiv)))" @onclick='() => ApplySort(nameof(AsDivisi.NamaDiv))'>Name <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(AsDivisi.NamaDiv))</span></button></th>

            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@cbBank.Divisi</td>
            <td>@cbBank.NamaDiv</td>

            <td>
                <button @onclick="() => OpenRubah(cbBank.AsDivId)" class="btn btn-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                    </svg>
                </button>
                <button @onclick="() => OpenDeleteDialog(cbBank)" class="btn btn-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                    </svg>
                </button>
            </td>
        </RowTemplate>
    </DataGridComponent>


</div>

@if (DeleteDialogOpen)
{
    <ModalDialogComponent Title="Are you sure?" Text="Do you want to delete this entry?" OnClose="OnDeleteDialogClose"></ModalDialogComponent>
}

@if (NullDialogOpen)
{
    <ModalDialogComponent Title="MESSAGE" Text="Receivable is not Zero" TombolSave="false" OnClose="OnDeleteNullClose"></ModalDialogComponent>
}



@code {

    private List<AsDivisi> Banks;
    private AsDivisi _bankToDelete;
    private string currentSortColumn = nameof(AsDivisi.Divisi);
    private bool sortAscending = true;

    private IEnumerable<AsDivisi> SortedBanks => ApplyCurrentSort(Banks ?? new List<AsDivisi>());

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadGet();

    }

    private void LoadGet()
    {
        Banks = service.GetAsDiv();
    }

    private void ApplySort(string columnName)
    {
        if (string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            sortAscending = !sortAscending;
            return;
        }

        currentSortColumn = columnName;
        sortAscending = true;
    }

    private IEnumerable<AsDivisi> ApplyCurrentSort(IEnumerable<AsDivisi> source)
    {
        return currentSortColumn switch
        {
            nameof(AsDivisi.NamaDiv) => OrderBy(source, x => x.NamaDiv),
            _ => OrderBy(source, x => x.Divisi)
        };
    }

    private IEnumerable<AsDivisi> OrderBy<TKey>(IEnumerable<AsDivisi> source, Func<AsDivisi, TKey> keySelector)
    {
        return sortAscending ? source.OrderBy(keySelector) : source.OrderByDescending(keySelector);
    }

    private string GetSortButtonClass(string columnName)
    {
        return string.Equals(currentSortColumn, columnName, StringComparison.Ordinal) ? "active" : string.Empty;
    }

    private string GetSortIndicator(string columnName)
    {
        if (!string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            return "↕";
        }

        return sortAscending ? "↑" : "↓";
    }


    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {
            await service.DelAsDiv(_bankToDelete.AsDivId);
            _bankToDelete = null;
        }

        DeleteDialogOpen = false;
        LoadGet();

        StateHasChanged();

    }

    private void OnDeleteNullClose(bool accepted)
    {
        //if (accepted)
        //{
        //    await cashBank.DelBank(_bankToDelete.CbBankId);
        //    _bankToDelete = null;
        //}

        DeleteDialogOpen = false;
        NullDialogOpen = false;
        LoadGet();
        StateHasChanged();

    }
    private void OpenDeleteDialog(AsDivisi bank)
    {
        DeleteDialogOpen = true;


        _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenRubah(int xKdBank)
    {
        navigationmanager.NavigateTo($"/ModuleAsset/EditDivisi/{xKdBank}");
    }


    public void Dispose()
    {

    }
}
