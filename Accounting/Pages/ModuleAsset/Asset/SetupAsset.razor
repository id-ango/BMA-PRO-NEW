</div>

@if (DeleteDialogOpen)
{
    <ModalDialogComponent Title="Are you sure?" Text="Do you want to delete this entry?" OnClose="OnDeleteDialogClose"></ModalDialogComponent>
}

@if (NullDialogOpen)
{
    <ModalDialogComponent Title="MESSAGE" Text="Qty is not Zero" TombolSave="false" OnClose="OnDeleteNullClose"></ModalDialogComponent>
}

@*@if (DisplayDialogOpen)
{
    <ModalDisplayImageComponent Title="IMAGE" Text=@imaging TombolSave="false" OnClose="OnDisplayClose"></ModalDisplayImageComponent>
}*@

@code {

    private List<AsAssets> Banks;
    private AsAssets _bankToDelete;
    private string imaging;
    private string currentSortColumn = nameof(AsAssets.BarcodeAssets);
    private bool sortAscending = true;

    private IEnumerable<AsAssets> SortedBanks => ApplyCurrentSort(Banks ?? new List<AsAssets>());

    public bool DisplayDialogOpen { get; set; }

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadGet();

    }

    private void LoadGet()
    {
        Banks = Services.GetAsAsset();
    }

    private void ApplySort(string columnName)
    {
        if (string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            sortAscending = !sortAscending;
            return;
        }

        currentSortColumn = columnName;
        sortAscending = true;
    }

    private IEnumerable<AsAssets> ApplyCurrentSort(IEnumerable<AsAssets> source)
    {
        return currentSortColumn switch
        {
            nameof(AsAssets.NamaBarang) => OrderBy(source, x => x.NamaBarang),
            nameof(AsAssets.AsItemCode) => OrderBy(source, x => x.AsItemCode),
            nameof(AsAssets.Nilai) => sortAscending ? source.OrderBy(x => x.Nilai) : source.OrderByDescending(x => x.Nilai),
            nameof(AsAssets.TglBeli) => sortAscending ? source.OrderBy(x => x.TglBeli) : source.OrderByDescending(x => x.TglBeli),
            nameof(AsAssets.Termin) => sortAscending ? source.OrderBy(x => x.Termin) : source.OrderByDescending(x => x.Termin),
            _ => OrderBy(source, x => x.BarcodeAssets)
        };
    }

    private IEnumerable<AsAssets> OrderBy<TKey>(IEnumerable<AsAssets> source, Func<AsAssets, TKey> keySelector)
    {
        return sortAscending ? source.OrderBy(keySelector) : source.OrderByDescending(keySelector);
    }

    private string GetSortButtonClass(string columnName)
    {
        return string.Equals(currentSortColumn, columnName, StringComparison.Ordinal) ? "active" : string.Empty;
    }

    private string GetSortIndicator(string columnName)
    {
        if (!string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            return "↕";
        }

        return sortAscending ? "↑" : "↓";
    }

    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {
            await Services.DelAsAssets(_bankToDelete.AsAssetsId);
            _bankToDelete = null;
        }

        DeleteDialogOpen = false;
        LoadGet();
        StateHasChanged();

    }

    private void OnDeleteNullClose(bool accepted)
    {
        

        DeleteDialogOpen = false;
        NullDialogOpen = false;
       
        LoadGet();
        StateHasChanged();

    }

    private void OnDisplayClose(bool accepted)
    {
        DisplayDialogOpen = false;
        LoadGet();
        StateHasChanged();

    }
    private void OpenDeleteDialog(AsAssets bank)
    {
        if (bank.SisaNilai != bank.Nilai)
        {
            NullDialogOpen = true;

        }
        else
        {
            DeleteDialogOpen = true;
        }


        _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenDisplayDialog(AsAssets bank)
    {
        if (!string.IsNullOrEmpty(bank.Merek))
        {
            DisplayDialogOpen = true;
            imaging = bank.Merek;
        }
        else
        {
            DisplayDialogOpen = false;
            imaging = "";
        }


      //  _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenRubah(int xKdBank)
    {
        navigationmanager.NavigateTo($"/ModuleAsset/EditAsset/{xKdBank}");
    }


    public void Dispose()
    {

    }
}
