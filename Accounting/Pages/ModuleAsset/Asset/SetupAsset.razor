        <TableHeader>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(AsAssets.BarcodeAssets)))" @onclick='() => ApplySort(nameof(AsAssets.BarcodeAssets))'>BarCode <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(AsAssets.BarcodeAssets))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(AsAssets.NamaBarang)))" @onclick='() => ApplySort(nameof(AsAssets.NamaBarang))'>Name <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(AsAssets.NamaBarang))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(AsAssets.AsItemCode)))" @onclick='() => ApplySort(nameof(AsAssets.AsItemCode))'>Item <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(AsAssets.AsItemCode))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(AsAssets.Nilai)))" @onclick='() => ApplySort(nameof(AsAssets.Nilai))'>NIlai <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(AsAssets.Nilai))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(AsAssets.TglBeli)))" @onclick='() => ApplySort(nameof(AsAssets.TglBeli))'>Tgl Beli <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(AsAssets.TglBeli))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(AsAssets.Termin)))" @onclick='() => ApplySort(nameof(AsAssets.Termin))'>Termin <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(AsAssets.Termin))</span></button></th>
            
            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@cbBank.BarcodeAssets</td>
            <td>@cbBank.NamaBarang</td>
            <td>@cbBank.AsItemCode</td>
            <td>@cbBank.Nilai.ToString("N")</td>
            <td>@cbBank.TglBeli.ToShortDateString()</td>
            <td>@cbBank.Termin.ToString("N")</td>
            
            <td>
                
               @* <button @onclick="() => OpenRubah(cbBank.AsAssetsId)" class="btn btn-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                    </svg>
                </button>*@
                <button @onclick="() => OpenDeleteDialog(cbBank)" class="btn btn-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
