@page "/ModuleAsset/AddAsset"
@using eSoft.Asset.Model
@using eSoft.Asset.View
@using eSoft.Asset.Services

@inject IAssetServices service
@inject NavigationManager navigationmanager
@*@inject IJSRuntime JSRuntime
@implements IAsyncDisposable*@

<div class="top-row px-4 " style="z-index:5">
    <h3>Add Asset</h3>
</div>

<div class="content px-4">
    <EditForm Model="@bank" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label>
                Kode Barcode :
                <InputText id="barCode" class="form-control" @bind-Value="bank.KodeBarcodeAssets" style="text-transform:uppercase"  />
            </label>
        </div>
        <div class="form-group">
            <label>
                Item Code :
                <InputSelect class="form-control" @bind-Value="bank.AsItemCode">
                    <option value="">&nbsp;&nbsp;---Select item code---&nbsp;&nbsp;</option>
                    @foreach (var item in ItemSet)
                    {
                        <option value="@item.ItemCode">@item.NamaItem</option>
                    }

                </InputSelect>
                @*<button class="btn btn-primary" type="button" @onclick="@(()=> SearchOpen = !SearchOpen)">Cari</button>*@
            </label>
        </div>
        <div class="form-group">
            <label>
                Asset Name :
                <InputText class="form-control" @bind-Value="bank.NamaBarang" />
            </label>

        </div>
        <br/>

     
      
        <br />
        <div class="form-group">
            <label>
                Category Set :
                <InputSelect class="form-control" @bind-Value="bank.Acctset">
                    <option value="">&nbsp;&nbsp;---Select Account Set---&nbsp;&nbsp;</option>
                    @foreach (var item in AkunSet)
                    {
                        <option value="@item.AcctSet">@item.Description</option>
                    }

                </InputSelect>
                @*<button class="btn btn-primary" type="button" @onclick="@(()=> SearchOpen = !SearchOpen)">Cari</button>*@
            </label>
        </div>
        <br />

        <div class="form-group">
            <label>
                Category Set :
                <InputSelect class="form-control" @bind-Value="bank.DistCode">
                    <option value="">&nbsp;&nbsp;---Select Distribution Code---&nbsp;&nbsp;</option>
                    @foreach (var item in CategorySet)
                    {
                        <option value="@item.DistCode">@item.Description</option>
                    }

                </InputSelect>
                @*<button class="btn btn-primary" type="button" @onclick="@(()=> SearchOpen = !SearchOpen)">Cari</button>*@
            </label>
        </div>
        <br />
         <div class="form-group">
            <label>
               Nilai Asset :
                <InputNumber class="form-control" @bind-Value="bank.Nilai" />
            </label>

        </div>
        <br/>
        <div class="form-group">
            <label>
                Tanggal Beli/Datang :
                <InputDate class="form-control" @bind-Value="bank.TglBeli" />
            </label>
        </div>
        <br/>
        <div class="form-group">
            <label>
                Disusutkan Dalam Bulan :
                <InputNumber class="form-control" @bind-Value="bank.Termin"  />
            </label>
        </div>
        <br/>
        <div class="form-group">
            <label>
                Nilai Penyusutan :
                <InputNumber class="form-control" @bind-Value="bank.Penyusutan" />
            </label>
        </div>
        <br/>
        <div class="form-group">
            <label>
                Jumlah Asset (Pcs) :
                <InputNumber class="form-control" @bind-Value="bank.Qty" />
            </label>

        </div>
        <br/>
        <div class="container">
            <button class="btn-success" type="submit">Simpan</button>
            <button class="btn-danger"type="button" @onclick="@(() => navigationmanager.NavigateTo("/ModuleAsset/SetupAsset", false))">Batal</button>
        </div>

    </EditForm>
</div>
<br/>
<br/>

