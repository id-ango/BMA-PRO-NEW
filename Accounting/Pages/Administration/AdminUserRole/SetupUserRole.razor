@page "/ModuleAdministration/SetupUserRole"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.AspNetCore.Identity;
@using Accounting.Services;
@using Accounting.Services.View;
@using Accounting.Data;

@inject IAdministrationServices service

@inject AuthenticationStateProvider AuthenticationStateProvider

@implements IDisposable
@inject NavigationManager navigationmanager

<div class="setup-page user-role-setup-page">
    <section class="setup-page-hero">
        <div>
            <p class="setup-page-eyebrow">Administration</p>
            <h1>Setup User Role</h1>
            <p class="setup-page-subtitle">Manage user roles and permissions with ease.</p>
        </div>
        <div class="setup-page-actions">
            <NavLink href="/ModuleAdministration/AddRole" class="btn btn-primary setup-action-button" title="Add new user role">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
                Add Role
            </NavLink>
        </div>
    </section>

    <section class="setup-search-section">
        <div class="search-container">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="search-icon" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.003-.003.007-.007.01-.01l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.01-.01zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
            </svg>
            <input type="text" 
                   class="form-control search-input" 
                   placeholder="Search by username or ID..." 
                   @oninput="@((ChangeEventArgs e) => FilterUsers(e.Value?.ToString() ?? ""))"
                   title="Search users">
            @if (!string.IsNullOrEmpty(searchText))
            {
                <button class="btn-clear" @onclick="ClearSearch" title="Clear search">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                    </svg>
                </button>
            }
        </div>
        <div class="results-info">
            Showing <strong>@FilteredBanks.Count()</strong> of <strong>@Banks?.Count ?? 0</strong> users
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(actionMessage))
    {
        <section class="setup-grid-card mt-3">
            <div class="p-3 alert alert-info mb-0">
                @actionMessage
            </div>
        </section>
    }

    @if (resetPasswordOpen)
    {
        <section class="setup-grid-card mt-3">
            <div class="p-3">
                <h5 class="mb-3">Reset Password - @selectedUserName</h5>
                <div class="mb-3">
                    <label class="form-label">New password</label>
                    <InputText type="password" class="form-control" @bind-Value="newPassword" placeholder="Enter new password" />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="button" @onclick="ConfirmResetPassword">Save</button>
                    <button class="btn btn-secondary" type="button" @onclick="CancelResetPassword">Cancel</button>
                </div>
            </div>
        </section>
    }

    <section class="setup-grid-card">
        @if (FilteredBanks.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover setup-table">
                    <thead>
                        <tr>
                            <th scope="col" class="col-id">
                                <span>ID</span>
                            </th>
                            <th scope="col" class="col-name">
                                <span>Username</span>
                            </th>
                            <th scope="col" class="col-role">
                                <span>Role</span>
                            </th>
                            <th scope="col" class="col-action">
                                <span>Action</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredBanks)
                        {
                            <tr class="setup-table-row">
                                <td class="col-id">
                                    <span class="badge bg-light text-dark">@item.IdUser?.Substring(0, Math.Min(8, item.IdUser?.Length ?? 0))</span>
                                </td>
                                <td class="col-name">
                                    <strong>@item.Name</strong>
                                </td>
                                <td class="col-role">
                                    <div class="role-select-wrapper">
                                        <select class="form-select form-select-sm role-select" 
                                                @onchange="@((ChangeEventArgs e) => UpdateSelectedRole(item.IdUser, e.Value?.ToString() ?? ""))"
                                                title="Select user role">
                                            <option value="">---Select Role---</option>
                                            @foreach (var role in roles ?? new List<IdentityRole>())
                                            {
                                                <option value="@role.Id" 
                                                        selected="@(item.IdRole == role.Id)">
                                                    @role.Name
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </td>
                                <td class="col-action">
                                    <div class="action-buttons">
                                        <button @onclick="() => SaveUserRole(item.IdUser, selectedRoles.ContainsKey(item.IdUser) ? selectedRoles[item.IdUser] : item.IdRole)" 
                                                class="btn btn-sm btn-save-role" 
                                                type="button"
                                                title="Save role assignment">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                                                <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                            </svg>
                                            Save
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="empty-icon" viewBox="0 0 16 16">
                    <path d="M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm.256 7a4.474 4.474 0 0 1-.126-1H0v1a6 6 0 0 0 3.25 5.342A3.986 3.986 0 0 1 8.256 14Z"/>
                    <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Zm-1.993-1.679a.5.5 0 0 0-.686.172l-1.335 2.226-1.335-2.226a.5.5 0 1 0-.858.515l1.528 2.557 1.528-2.557a.5.5 0 0 0-.172-.686Z"/>
                </svg>
                <h3>No users found</h3>
                <p>Try adjusting your search criteria or add a new user role.</p>
            </div>
        }
    </section>
</div>

@if (DeleteDialogOpen)
{
    <ModalDialogComponent Title="Are you sure?" Text="Do you want to delete this user?" OnClose="OnDeleteDialogClose"></ModalDialogComponent>
}

@if (NullDialogOpen)
{
    <ModalDialogComponent Title="Success" Text="@successDialogText" TombolSave="false" OnClose="OnSuccessClose"></ModalDialogComponent>
}

@code {
    private List<IdentityView> Banks = new();
    private List<IdentityView> FilteredBanks => string.IsNullOrEmpty(searchText) 
        ? Banks 
        : Banks.Where(x => (x.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                           (x.IdUser?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
               .ToList();

    private List<IdentityRole> roles = new();
    private string searchText = "";
    private Dictionary<string, string> selectedRoles = new();
    private string actionMessage = string.Empty;
    private string successDialogText = "Role has been assigned successfully!";
    private string selectedUserId = string.Empty;
    private string selectedUserName = string.Empty;
    private string newPassword = string.Empty;
    private bool resetPasswordOpen;

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadGet();
        LoadRoles();
    }

    private void LoadRoles()
    {
        roles = service.GetRoles();
    }

    private void LoadGet()
    {
        Banks = service.GetUsersRole();
    }

    private void FilterUsers(string searchQuery)
    {
        searchText = searchQuery;
    }

    private void ClearSearch()
    {
        searchText = "";
    }

    private void UpdateSelectedRole(string userId, string roleId)
    {
        if (selectedRoles.ContainsKey(userId))
            selectedRoles[userId] = roleId;
        else
            selectedRoles.Add(userId, roleId);
    }

    private void SaveUserRole(string userId, string roleId)
    {
        if (string.IsNullOrEmpty(roleId))
        {
            NullDialogOpen = false;
            return;
        }

        var result = service.SaveRole(userId, roleId);
        NullDialogOpen = result;

        if (result)
        {
            successDialogText = "Role has been assigned successfully!";
            LoadGet();
            if (selectedRoles.ContainsKey(userId))
                selectedRoles.Remove(userId);
            StateHasChanged();
        }
    }

    private void ConfirmDeleteUser(IdentityView item)
    {
        selectedUserId = item.IdUser;
        selectedUserName = item.Name;
        DeleteDialogOpen = true;
    }

    private async Task DeleteUserAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedUserId))
        {
            return;
        }

        var result = await service.DeleteUser(selectedUserId);
        actionMessage = result
            ? $"User '{selectedUserName}' deleted successfully."
            : $"Unable to delete user '{selectedUserName}'.";

        LoadGet();
        DeleteDialogOpen = false;
        StateHasChanged();
    }

    private void BeginResetPassword(IdentityView item)
    {
        selectedUserId = item.IdUser;
        selectedUserName = item.Name;
        newPassword = string.Empty;
        resetPasswordOpen = true;
        actionMessage = string.Empty;
    }

    private async Task ConfirmResetPassword()
    {
        if (string.IsNullOrWhiteSpace(selectedUserId) || string.IsNullOrWhiteSpace(newPassword))
        {
            actionMessage = "Please enter a new password.";
            return;
        }

        var result = await service.ResetUserPassword(selectedUserId, newPassword.Trim());
        actionMessage = result
            ? $"Password updated for '{selectedUserName}'."
            : $"Unable to update password for '{selectedUserName}'.";

        if (result)
        {
            resetPasswordOpen = false;
            newPassword = string.Empty;
        }

        StateHasChanged();
    }

    private void CancelResetPassword()
    {
        resetPasswordOpen = false;
        newPassword = string.Empty;
        selectedUserId = string.Empty;
        selectedUserName = string.Empty;
    }

    private void OnSuccessClose(bool accepted)
    {
        NullDialogOpen = false;
        actionMessage = string.Empty;
        StateHasChanged();
    }

    private void OnDeleteDialogClose(bool accepted)
    {
        DeleteDialogOpen = false;

        if (accepted)
        {
            _ = DeleteUserAsync();
            return;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
    }
}
