@page "/ModulePersediaan/SetupItem"
@using eSoft.Persediaan.Model
@using eSoft.Persediaan.View
@using eSoft.Persediaan.Services

@inject IInventoryServices Services
@implements IDisposable
@inject NavigationManager navigationmanager

<div class="setup-page item-setup-page">
    <section class="setup-page-hero">
        <div>
            <p class="setup-page-eyebrow">Persediaan Master</p>
            <h1>Setup Item</h1>
            <p class="setup-page-subtitle">Tampilkan item lebih informatif dengan divisi, account set, category, dan nilai stok utama.</p>
        </div>
        <div class="setup-page-actions">
            <NavLink href="/ModulePersediaan/AddItem" class="btn btn-primary setup-action-button" title="Add new item to inventory">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
                Add Item
            </NavLink>
        </div>
    </section>

    <section class="setup-filter-section">
        <div class="status-filter-container">
            <label class="filter-label">Status Filter:</label>
            <div class="btn-group status-filter-group" role="group" aria-label="Status filter">
                <button type="button" 
                        class="btn btn-sm @(statusFilter == "all" ? "btn-primary" : "btn-outline-primary")" 
                        @onclick='() => SetStatusFilter("all")'
                        title="Show all items">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zM2.5 2a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zM1 10.5A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z"/>
                    </svg>
                    All (@AllItemsCount)
                </button>
                <button type="button" 
                        class="btn btn-sm @(statusFilter == "active" ? "btn-success" : "btn-outline-success")" 
                        @onclick='() => SetStatusFilter("active")'
                        title="Show active items only">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                    Active (@ActiveItemsCount)
                </button>
                <button type="button" 
                        class="btn btn-sm @(statusFilter == "inactive" ? "btn-warning" : "btn-outline-warning")" 
                        @onclick='() => SetStatusFilter("inactive")'
                        title="Show inactive items only">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                    </svg>
                    Inactive (@InactiveItemsCount)
                </button>
            </div>
        </div>
    </section>

    <section class="setup-grid-card">
        <DataGridComponent Items="SortedBanks" TotalJumlah="@((decimal)(Banks?.Count ?? 0))" TotalFormat="N0" Context="cbBank" GetFilterableText="@(item =>$"{item.NamaItem} {item.ItemCode} {item.Satuan} {item.Divisi} {item.AcctSet} {item.Category}" )">
        <TableHeader>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcItem.ItemCode)))" @onclick='() => ApplySort(nameof(IcItem.ItemCode))' title="Sort by Item Code">Item <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcItem.ItemCode))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcItem.NamaItem)))" @onclick='() => ApplySort(nameof(IcItem.NamaItem))' title="Sort by Item Name">Name <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcItem.NamaItem))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcItem.Satuan)))" @onclick='() => ApplySort(nameof(IcItem.Satuan))' title="Sort by Unit">Satuan <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcItem.Satuan))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcItem.Divisi)))" @onclick='() => ApplySort(nameof(IcItem.Divisi))' title="Sort by Division">Divisi <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcItem.Divisi))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcItem.AcctSet)))" @onclick='() => ApplySort(nameof(IcItem.AcctSet))' title="Sort by Account Set">Account Set <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcItem.AcctSet))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcItem.Category)))" @onclick='() => ApplySort(nameof(IcItem.Category))' title="Sort by Category">Category <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcItem.Category))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcItem.Qty)))" @onclick='() => ApplySort(nameof(IcItem.Qty))' title="Sort by Quantity">Qty <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcItem.Qty))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcItem.HrgUsd)))" @onclick='() => ApplySort(nameof(IcItem.HrgUsd))' title="Sort by Import Price">Hrg Import <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcItem.HrgUsd))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcItem.HrgNetto)))" @onclick='() => ApplySort(nameof(IcItem.HrgNetto))' title="Sort by Net Price">Hrg Net <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcItem.HrgNetto))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcItem.Cost)))" @onclick='() => ApplySort(nameof(IcItem.Cost))' title="Sort by Cost">Cost <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcItem.Cost))</span></button></th>
            <th class="table-action-header">Actions</th>
        </TableHeader>
        <RowTemplate>
            <td class="@GetCellClass(cbBank.Disabled)">@cbBank.ItemCode</td>
            <td class="@GetCellClass(cbBank.Disabled)">@cbBank.NamaItem</td>
            <td class="@GetCellClass(cbBank.Disabled)">@cbBank.Satuan</td>
            <td class="@GetCellClass(cbBank.Disabled)">@cbBank.Divisi</td>
            <td class="@GetCellClass(cbBank.Disabled)">@cbBank.AcctSet</td>
            <td class="@GetCellClass(cbBank.Disabled)">@cbBank.Category</td>
            <td class="@GetCellClass(cbBank.Disabled) text-end">@cbBank.Qty.ToString("N")</td>
            <td class="@GetCellClass(cbBank.Disabled) text-end">@(string.IsNullOrEmpty(cbBank.CurrencyCode) ? "" : cbBank.CurrencyCode) @cbBank.HrgUsd.ToString("N")</td>
            <td class="@GetCellClass(cbBank.Disabled) text-end">@cbBank.HrgNetto.ToString("N")</td>
            <td class="@GetCellClass(cbBank.Disabled) text-end">@cbBank.Cost.ToString("N")</td>
            <td class="table-actions-cell">
                <div class="setup-row-actions setup-row-actions-compact">
                    <button @onclick="() => OpenRubah(cbBank.IcItemId)" 
                            class="setup-row-action setup-row-action-edit" 
                            type="button" 
                            title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                        </svg>
                    </button>
                    <button @onclick="() => OpenDeleteDialog(cbBank)" 
                            class="setup-row-action setup-row-action-delete" 
                            type="button" 
                            title="Delete">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                            <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                        </svg>
                    </button>
                    @if(!string.IsNullOrEmpty(cbBank.Foto))
                    {
                    <button @onclick="() => OpenDisplayDialog(cbBank)" 
                            class="setup-row-action setup-row-action-preview" 
                            type="button" 
                            title="View image">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                            <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
                        </svg>
                    </button>
                    }
                    <button @onclick="() => ToggleFinish(cbBank)" 
                            class="setup-row-action setup-row-action-status" 
                            type="button" 
                            title="@(cbBank.Disabled ? "Activate" : "Deactivate")">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            @if(cbBank.Disabled)
                            {
                            <path d="M2.5 8a5.5 5.5 0 0 1 8.25-4.764.5.5 0 0 0 .5-.866A6.5 6.5 0 1 0 14.5 8a.5.5 0 0 0-1 0 5.5 5.5 0 1 1-11 0z"/>
                            <path d="M15.354 3.354a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0l7-7z"/>
                            }
                            else
                            {
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                            }
                        </svg>
                    </button>
                </div>
            </td>
        </RowTemplate>
    </DataGridComponent>
    </section>
</div>

@if (DeleteDialogOpen)
{
    <ModalDialogComponent Title="Are you sure?" Text="Do you want to delete this entry?" OnClose="OnDeleteDialogClose"></ModalDialogComponent>
}

@if (NullDialogOpen)
{
    <ModalDialogComponent Title="MESSAGE" Text="Qty is not Zero" TombolSave="false" OnClose="OnDeleteNullClose"></ModalDialogComponent>
}

@if (DisplayDialogOpen)
{
    <ModalDisplayImageComponent Title="IMAGE" Text=@imaging TombolSave="false" OnClose="OnDisplayClose"></ModalDisplayImageComponent>
}

@code {

    private List<IcItem> Banks;
    private IcItem _bankToDelete;
    private string imaging;
    private string currentSortColumn = nameof(IcItem.ItemCode);
    private bool sortAscending = true;
    private string statusFilter = "all"; // all, active, inactive

    private IEnumerable<IcItem> SortedBanks => ApplyCurrentSort(ApplyStatusFilter(Banks ?? new List<IcItem>()));

    // Counter properties
    private int AllItemsCount => Banks?.Count ?? 0;
    private int ActiveItemsCount => Banks?.Count(x => !x.Disabled) ?? 0;
    private int InactiveItemsCount => Banks?.Count(x => x.Disabled) ?? 0;

    public bool DisplayDialogOpen { get; set; }

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadGet();

    }

    private void LoadGet()
    {
        Banks = Services.GetIcItemByStatus("all");  // Load semua items (all, active, inactive)
    }

    private void SetStatusFilter(string filter)
    {
        statusFilter = filter;
        StateHasChanged();
    }

    private IEnumerable<IcItem> ApplyStatusFilter(IEnumerable<IcItem> source)
    {
        return statusFilter switch
        {
            "active" => source.Where(x => !x.Disabled),
            "inactive" => source.Where(x => x.Disabled),
            _ => source // "all"
        };
    }

    private void ApplySort(string columnName)
    {
        if (string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            sortAscending = !sortAscending;
            return;
        }

        currentSortColumn = columnName;
        sortAscending = true;
    }

    private IEnumerable<IcItem> ApplyCurrentSort(IEnumerable<IcItem> source)
    {
        return currentSortColumn switch
        {
            nameof(IcItem.NamaItem) => OrderBy(source, x => x.NamaItem),
            nameof(IcItem.Satuan) => OrderBy(source, x => x.Satuan),
            nameof(IcItem.Divisi) => OrderBy(source, x => x.Divisi),
            nameof(IcItem.AcctSet) => OrderBy(source, x => x.AcctSet),
            nameof(IcItem.Category) => OrderBy(source, x => x.Category),
            nameof(IcItem.Qty) => sortAscending ? source.OrderBy(x => x.Qty) : source.OrderByDescending(x => x.Qty),
            nameof(IcItem.HrgUsd) => sortAscending ? source.OrderBy(x => x.HrgUsd) : source.OrderByDescending(x => x.HrgUsd),
            nameof(IcItem.HrgNetto) => sortAscending ? source.OrderBy(x => x.HrgNetto) : source.OrderByDescending(x => x.HrgNetto),
            nameof(IcItem.Cost) => sortAscending ? source.OrderBy(x => x.Cost) : source.OrderByDescending(x => x.Cost),
            _ => OrderBy(source, x => x.ItemCode)
        };
    }

    private IEnumerable<IcItem> OrderBy<TKey>(IEnumerable<IcItem> source, Func<IcItem, TKey> keySelector)
    {
        return sortAscending ? source.OrderBy(keySelector) : source.OrderByDescending(keySelector);
    }

    private string GetSortButtonClass(string columnName)
    {
        return string.Equals(currentSortColumn, columnName, StringComparison.Ordinal) ? "active" : string.Empty;
    }

    private string GetSortIndicator(string columnName)
    {
        if (!string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            return "↕";
        }

        return sortAscending ? "↑" : "↓";
    }

    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {
            await Services.DelIcItem(_bankToDelete.IcItemId);
            _bankToDelete = null;
        }

        DeleteDialogOpen = false;
        LoadGet();
        StateHasChanged();

    }

    private void OnDeleteNullClose(bool accepted)
    {
        

        DeleteDialogOpen = false;
        NullDialogOpen = false;
       
        LoadGet();
        StateHasChanged();

    }

    private void OnDisplayClose(bool accepted)
    {
        DisplayDialogOpen = false;
        LoadGet();
        StateHasChanged();

    }
    private void OpenDeleteDialog(IcItem bank)
    {
        if (bank.Qty != 0)
        {
            NullDialogOpen = true;

        }
        else
        {
            DeleteDialogOpen = true;
        }


        _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenDisplayDialog(IcItem bank)
    {
        if (!string.IsNullOrEmpty(bank.Foto))
        {
            DisplayDialogOpen = true;
            imaging = bank.Foto;
        }
        else
        {
            DisplayDialogOpen = false;
            imaging = "";
        }


      //  _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenRubah(int xKdBank)
    {
        navigationmanager.NavigateTo($"/ModulePersediaan/EditItem/{xKdBank}");
    }

    private async Task ToggleFinish(IcItem bank)
    {
        bank.Disabled = !bank.Disabled;
        await Services.UpdateProject(bank); // Assuming you have an update method in your service
        LoadGet();
    }

    private string GetCellClass(bool finish)
    {
        return finish ? "table-warning" : string.Empty;
    }
    public void Dispose()
    {

    }
}
