    private static bool IsImportItem(IcItem item)
    {
        return item != null
            && item.HrgUsd > 0
            && !string.IsNullOrWhiteSpace(item.CurrencyCode)
            && !string.Equals(item.CurrencyCode, "IDR", StringComparison.OrdinalIgnoreCase);
    }

    private bool TryGetKurs(string currencyCode, out decimal kurs)
    {
        kurs = 0;

        if (string.IsNullOrWhiteSpace(currencyCode))
        {
            return false;
        }

        if (string.Equals(currencyCode, "CNY", StringComparison.OrdinalIgnoreCase))
        {
            kurs = Transh.CNY;
            return true;
        }

        if (string.Equals(currencyCode, "USD", StringComparison.OrdinalIgnoreCase))
        {
            kurs = Transh.USD;
            return true;
        }

        return false;
    }

    private async Task DownloadExcelAllAsync()
    {
        var items = (srccode ?? new List<IcItem>())
            .Where(IsImportItem)
            .ToList();

        if (items.Count == 0)
        {
            return;
        }

        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Harga Jual Import");

        worksheet.Cell(1, 1).Value = "No";
        worksheet.Cell(1, 2).Value = "ItemCode";
        worksheet.Cell(1, 3).Value = "NamaItem";
        worksheet.Cell(1, 4).Value = "Satuan";
        worksheet.Cell(1, 5).Value = "Currency";
        worksheet.Cell(1, 6).Value = "Harga Import";
        worksheet.Cell(1, 7).Value = "Kurs";
        worksheet.Cell(1, 8).Value = "Harga Pokok";
        worksheet.Cell(1, 9).Value = "PPN Masukan (%)";
        worksheet.Cell(1, 10).Value = "PPH (%)";
        worksheet.Cell(1, 11).Value = "Forwarder (%)";
        worksheet.Cell(1, 12).Value = "TotalCost";
        worksheet.Cell(1, 13).Value = "Markup (%)";
        worksheet.Cell(1, 14).Value = "Harga Sebelum PPN";
        worksheet.Cell(1, 15).Value = "PPN Keluaran (%)";
        worksheet.Cell(1, 16).Value = "Harga Jual";
        worksheet.Cell(1, 17).Value = "Keuntungan";
        worksheet.Cell(1, 18).Value = "Gross Profit (%)";

        var row = 2;
        var nomor = 1;

        foreach (var item in items)
        {
            if (!TryGetKurs(item.CurrencyCode, out var kurs) || kurs <= 0)
            {
                continue;
            }

            worksheet.Cell(row, 1).Value = nomor++;
            worksheet.Cell(row, 2).Value = item.ItemCode;
            worksheet.Cell(row, 3).Value = item.NamaItem;
            worksheet.Cell(row, 4).Value = item.Satuan;
            worksheet.Cell(row, 5).Value = item.CurrencyCode;
            worksheet.Cell(row, 6).Value = item.HrgUsd;
            worksheet.Cell(row, 7).Value = kurs;
            worksheet.Cell(row, 8).FormulaA1 = $"F{row}*G{row}";
            worksheet.Cell(row, 9).Value = Transh.NilaiPPnM;
            worksheet.Cell(row, 10).Value = Transh.NilaiPPh;
            worksheet.Cell(row, 11).Value = Transh.NilaiExpd;
            worksheet.Cell(row, 12).FormulaA1 = $"H{row}+(ROUND(H{row}*(I{row}/100),0)+ROUND(H{row}*(J{row}/100),0)+ROUND(H{row}*(K{row}/100),0))";
            worksheet.Cell(row, 13).Value = ExportMarkupPct;
            worksheet.Cell(row, 14).FormulaA1 = $"L{row}*(1+(M{row}/100))";
            worksheet.Cell(row, 15).Value = Transh.NilaiPPnK;
            worksheet.Cell(row, 16).FormulaA1 = $"N{row}*(1+(O{row}/100))";
            worksheet.Cell(row, 17).FormulaA1 = $"N{row}-L{row}";
            worksheet.Cell(row, 18).FormulaA1 = $"IF(N{row}=0,0,(Q{row}/N{row})*100)";

            row++;
        }

        var usedRange = worksheet.Range(1, 1, row - 1, 18);
        usedRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
        usedRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
        worksheet.Range(1, 1, 1, 18).Style.Fill.BackgroundColor = XLColor.FromArgb(31, 78, 121);
        worksheet.Range(1, 1, 1, 18).Style.Font.FontColor = XLColor.White;
        worksheet.Range(1, 1, 1, 18).Style.Font.Bold = true;
        worksheet.Range(2, 6, Math.Max(row - 1, 2), 18).Style.NumberFormat.Format = "#,##0.00";
        worksheet.Range(2, 9, Math.Max(row - 1, 2), 11).Style.NumberFormat.Format = "0.00";
        worksheet.Range(2, 13, Math.Max(row - 1, 2), 15).Style.NumberFormat.Format = "0.00";
        worksheet.Range(2, 18, Math.Max(row - 1, 2), 18).Style.NumberFormat.Format = "0.00";
        worksheet.Range(1, 1, row - 1, 18).Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
        worksheet.Range(1, 1, row - 1, 18).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left;
        worksheet.SheetView.FreezeRows(1);
        worksheet.Range(1, 1, row - 1, 18).SetAutoFilter();
        worksheet.Columns().AdjustToContents();

        using var ms = new MemoryStream();
        workbook.SaveAs(ms);
        ms.Position = 0;

        using var streamRef = new DotNetStreamReference(stream: ms);
        var fileName = $"HargaJualImport_{DateTime.Now:yyyy-MM-dd}.xlsx";
        await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }


}