@code {
    private const string DraftStorageKey = "CheckingPrice.Draft";
    IcPriceHView Transh = new IcPriceHView() { IcPriceDs = new List<IcPriceDView>() };

    private List<IcItem> srccode;
    private List<IcLokasi> banks;
    private IcPriceDView Transd = new();
    private IcPriceDView TransK = new();

    public string kurs { get; set; } = "";

    public string Testing { get; set; }
    private bool DialogOpen { get; set; }
    public bool IsVisible { get; set; }
    public bool IsKurs { get; set; }
    public bool IsEdit { get; set; }
    public bool SearchOpen { get; set; }
    private bool _draftRestored;

    protected override async Task OnInitializedAsync()
    {
        LoadBank();
        LoadSrcCode();
        RestoreDraftFromQuery();
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_draftRestored)
        {
            var restored = await RestoreDraftFromSessionAsync();
            if (restored)
            {
                _draftRestored = true;
                StateHasChanged();
            }
        }
    }

    private void RestoreDraftFromQuery()
    {
        var uri = new Uri(navigationmanager.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        var encodedState = query["state"];

        if (string.IsNullOrWhiteSpace(encodedState))
        {
            return;
        }

        var json = Uri.UnescapeDataString(encodedState);
        var loaded = JsonSerializer.Deserialize<IcPriceHView>(json);

        if (loaded != null)
        {
            loaded.IcPriceDs ??= new List<IcPriceDView>();
            Transh = loaded;
            _draftRestored = true;
        }
    }

    private async Task<bool> RestoreDraftFromSessionAsync()
    {
        var json = await JSRuntime.InvokeAsync<string>("checkingPriceDraftGet", DraftStorageKey);
        if (string.IsNullOrWhiteSpace(json))
        {
            return false;
        }

        var loaded = JsonSerializer.Deserialize<IcPriceHView>(json);
        if (loaded == null)
        {
            return false;
        }

        loaded.IcPriceDs ??= new List<IcPriceDView>();
        Transh = loaded;
        return true;
    }

    private async Task SaveDraftAsync()
    {
        var json = JsonSerializer.Serialize(Transh);
        await JSRuntime.InvokeVoidAsync("checkingPriceDraftSet", DraftStorageKey, json);
    }

    private async Task ClearDraftAsync()
    {
        await JSRuntime.InvokeVoidAsync("checkingPriceDraftClear", DraftStorageKey);
        Transh = new IcPriceHView() { IcPriceDs = new List<IcPriceDView>() };
        Transd = new IcPriceDView();
        IsVisible = false;
        IsEdit = false;
        StateHasChanged();
    }

    private void OnVisibleClose()
    {

        IsVisible = false;
        IsEdit = false;
        StateHasChanged();

    }


    private void OnDialogClose(bool accepted)
    {

        DialogOpen = false;
        StateHasChanged();

    }



    private async Task HandleValidSubmit()
    {
        await SaveDraftAsync();
        string transhJson = JsonSerializer.Serialize(Transh);
        string encodedTranshJson = Uri.EscapeDataString(transhJson);
        navigationmanager.NavigateTo($"/ModulePrinting/NotaCheckingPrice/?transh={encodedTranshJson}&prevUri=/ModulePersediaan/CheckingPrice");

        // var newEdit = service.AddTransH(Transh);
        // if (newEdit != null)
        // {
        //     var id = newEdit.IcTransHId.ToString().Trim();
        //     //  navigationmanager.NavigateTo("/PrintBuktiBayar/{id", false);
        //     navigationmanager.NavigateTo("/ModulePersediaan/TransAdjustment", false);
        //     //  navigationmanager.NavigateTo($"/PrintBuktiBayar/{id}");
        // }


    }

    private async Task OnDetailTrans(IcPriceDView transD)
    {
        transD.NamaItem = serviceIC.GetIcItemProduk(transD.ItemCode).NamaItem;
        transD.Satuan = serviceIC.GetIcItemProduk(transD.ItemCode).Satuan;

        if (!IsEdit)
        {

            Transh.IcPriceDs.Add(transD);
        }

        IsVisible = false;
        IsKurs = false;
        IsEdit = false;
        await SaveDraftAsync();
        StateHasChanged();
    }


    void LoadBank()
    {

        banks = serviceIC.GetIcLokasi();

    }

    void LoadSrcCode()
    {

        srccode = serviceIC.GetIcItem();

    }


    private void Rubah(IcPriceDView transd)
    {
        Transd = new IcPriceDView();
        Transd = transd;
        IsEdit = true;
        OnAddLine();

    }

    private async Task Hapus(IcPriceDView transd)
    {

        Transh.IcPriceDs.Remove(transd);
        await SaveDraftAsync();
        // ShowOnClick();
    }

    private void OnAddLine()
    {

        this.IsVisible = true;


        StateHasChanged();

        //IsEdit = false;
        //ShowOnClick();
    }

    private void BtnChoose(string textSearch)
    {
        if (!string.IsNullOrEmpty(textSearch))
        {
            // Transh.Lokasi = textSearch;
        }

        SearchOpen = false;
        StateHasChanged();
    }

    private void OnSearchClose(bool accepted)
    {

        SearchOpen = false;
        StateHasChanged();

    }
    private async Task ProsesUlangDetail()
    {
        foreach (var item in Transh.IcPriceDs)
        {
           

            if (item.CurrencyCode == "CNY")
                item.Kurs = Transh.CNY;
            else if (item.CurrencyCode == "USD")
                item.Kurs = Transh.USD;

           
        }

        
      //  HitungTotalCost();
        await SaveDraftAsync();
        StateHasChanged();
    }


