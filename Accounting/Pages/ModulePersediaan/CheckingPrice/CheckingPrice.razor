@page "/ModulePersediaan/CheckingPrice"
@using eSoft.Persediaan.Model
@using eSoft.Persediaan.View
@using eSoft.Persediaan.Services
@using System.Text.Json;
@using System.Web

@inject IIcAdjustServices service
@inject IInventoryServices serviceIC
@inject NavigationManager navigationmanager
@inject IJSRuntime JSRuntime


<div class="top-row px-4 " style="z-index:5">
    <h3>Price Checking</h3>
</div>

<div class="container">
    <EditForm Model="@Transh" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>
                CNY :
                <InputNumber class="form-control" @bind-Value="Transh.CNY" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>
                USD :
                <InputNumber class="form-control" @bind-Value="Transh.USD" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>
                Keterangan :
                <InputTextArea class="form-control" @bind-Value="Transh.Keterangan" />
            </label>
        </div>


        <br />

        <div class="form-group">
            <label>
                PPN Masukan (%):
                <InputNumber class="form-control" @bind-Value="Transh.NilaiPPnM" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>
                PPN Keluaran (%):
                <InputNumber class="form-control" @bind-Value="Transh.NilaiPPnK" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>
                PPh (%):
                <InputNumber class="form-control" @bind-Value="Transh.NilaiPPh" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>
                Forwarder (%):
                <InputNumber class="form-control" @bind-Value="Transh.NilaiExpd" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>

                Harga (Rp):
                <InputNumber class="form-control" @bind-Value="Transh.Harga" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>

                TotalCost (Rp) :
                <InputNumber class="form-control" @bind-Value="Transh.TotalCost" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>

                Harga Jual (Rp) :
                <InputNumber class="form-control" @bind-Value="Transh.HargaJual" />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>

                Keuntungan (Rp) :
                <InputNumber class="form-control" @bind-Value="Transh.Keuntungan" disabled />
            </label>
        </div>
        <br />
        <div class="form-group">
            <label>

                Gross Profit (%) :
                <InputNumber class="form-control" @bind-Value="Transh.GProfit" disabled />
            </label>
        </div>
        <br />
        <div class="container mt-3">
            <button class="btn btn-warning me-2" type="button" @onclick="ProsesUlangDetail">Proses Ulang</button>
            <button class="btn btn-secondary me-2" type="button" @onclick="ClearDraftAsync">Clear</button>
            <button class="btn btn-success me-2" type="submit">Cetak</button>
            <button class="btn btn-danger" type="button" @onclick="@(() => navigationmanager.NavigateTo("/ModulePersediaan/TransAdjustment", false))">Batal</button>
        </div>

        <br />
        <br />

    </EditForm>
</div>


<div class="container">
    <DetailGridComponent Items="Transh.IcPriceDs" Context="transaksi">
        <TableHeader>
            <th scope="col">Item</th>
            <th scope="col">Nama</th>
            <th scope="col">Satuan</th>
            <th scope="col">Currency</th>
            <th scope="col">Valas</th>
            <th scope="col">Harga</th>

            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@transaksi.ItemCode</td>
            <td>@transaksi.NamaItem</td>
            <td>@transaksi.Satuan</td>
            <td>@transaksi.CurrencyCode</td>
            <td>@transaksi.HargaBeli.ToString("N")</td>
            <td>@transaksi.HargaPokok.ToString("N")</td>


            <td>
                <button @onclick="(() => Rubah(transaksi))" class="btn btn-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                    </svg>
                </button>
                <button @onclick="(() => Hapus(transaksi))" class="btn btn-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                    </svg>
                </button>
            </td>
        </RowTemplate>
    </DetailGridComponent>

    <button Class="btn btn-info" @onclick="@OnAddLine">Add Line</button>
</div>

@if (IsVisible)
{
    <ModalPriceCheckingComponent SrcCode="srccode" OnClose="OnVisibleClose" OnDetail="OnDetailTrans" isEdit="IsEdit" DetailRubah="Transd" CNY="Transh.CNY" USD="Transh.USD"></ModalPriceCheckingComponent>
}


@if (DialogOpen)
{
    <ModalDialogComponent Title="Alert" Text="Transaksi Sudah Ada" TombolSave="false" OnClose="OnDialogClose"></ModalDialogComponent>
}
