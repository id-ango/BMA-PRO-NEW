@layout PrintLayout

@page "/ModulePersediaan/LaporanCurrentStockGroup"

@using eSoft.Persediaan.View
@using eSoft.Persediaan.Services
@using eSoft.Persediaan.Model
@using eSoft.Persediaan.Repositories
@using eSoft.Order.Services
@using ClosedXML.Excel

@inject IInventoryServices serviceIC
@inject IJSRuntime JSRuntime
@inject IItemGroupRepository groupRepo
@inject IOrderSalesServices serviceOrdJual

<link rel="stylesheet" href="css/laporan-current-stock.css" />


<div class="dontprint" style="display:inline">
    <br />
    &emsp;
    <button class="btn btn-warning btn-lg" @onclick="ToggleAllGroups">@(_expandAll ? "Collapse All" : "Expand All")</button>
    &emsp;
    <NavLink href="/" class="btn btn-primary btn-lg">&nbsp;Back&nbsp;</NavLink>
    &emsp;
    <NavLink class="btn btn-success btn-lg" onclick="window.print()">&nbsp; Cetak &nbsp;</NavLink>
    &emsp;
    <button class="btn btn-info btn-lg" @onclick="PrintStockOpname">&nbsp; Stock Opname &nbsp;</button>
    &emsp;
    <button class="btn btn-secondary btn-lg" @onclick="ExportToExcel">&nbsp; Export Excel &nbsp;</button>
    &emsp;
</div>

@if (_isLoadingReport)
{
    <div class="text-center p-4" role="status" aria-live="polite">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <div class="mt-2">Laporan stock sedang diproses, mohon tunggu...</div>
    </div>
}
else
{
    <div class="report-table group-report" data-print-mode="@_printMode">
        <div class="report-title">@_title</div>

        <div class="dontprint mb-3" style="max-width:600px;">
            <label class="form-label fw-bold">Filter Group</label>
            <select class="form-select" value="@_selectedGroup" @onchange="OnGroupChanged">
                <option value="">Semua Group</option>
                <option value="0">Belum Ada Group</option>
                @foreach (var option in _groupOptions)
                {
                    <option value="@option.Id">@option.Path</option>
                }
            </select>
        </div>

        <div class="dontprint mb-3" style="max-width:600px;">
            <label class="form-label fw-bold">Filter PO / SO</label>
            <select class="form-select" value="@_orderFilter" @onchange="OnOrderFilterChanged">
                <option value="">Semua Item</option>
                <option value="po">Ada PO</option>
                <option value="so">Ada SO</option>
                <option value="any">Ada PO atau SO</option>
                <option value="both">Ada PO dan SO</option>
            </select>
        </div>

        @if (_groups.Count > 0)
        {
            <div class="data-table-container">
                <table class="data-table">
                    <thead>
                        <tr class="header-row">
                            <th class="dontprint" style="width: 40px;"></th>
                            <th class="col-no">No.</th>
                            <th class="col-code">Kode</th>
                            <th class="col-name">Nama Barang</th>
                            <th class="col-unit">Satuan</th>
                            <th class="col-qty">Qty</th>
                            <th class="col-po">PO</th>
                            <th class="col-so">SO</th>
                            <th class="col-total">Total</th>
                            <th class="col-opname-result">Hasil Stock</th>
                            <th class="col-opname-note">Keterangan</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in _groups)
                        {
                            <tr class="division-header group-header to-print" style="cursor:pointer;" @onclick="() => ToggleGroup(group.Path)">
                                <td class="dontprint text-center" @onclick:stopPropagation="true">
                                    <input type="checkbox" class="form-check-input" checked="@IsGroupSelected(group)" @onchange="() => ToggleGroupPrint(group)" />
                                </td>
                                <td colspan="10">
                                    <span class="group-toggle dontprint me-2">@(IsExpanded(group.Path) ? "▼" : "▶")</span>
                                    @group.Path
                                    <span class="ms-2">(@group.Items.Count item, Total Qty: @group.TotalQty.ToString("N"))</span>
                                </td>
                            </tr>
                            @if (IsExpanded(group.Path))
                            {
                                @for (var i = 0; i < group.Items.Count; i++)
                                {
                                    var item = group.Items[i];
                                    <tr class="@(item.IsSelectedForPrinting ? "to-print" : "")">
                                        <td class="dontprint text-center">
                                            <input type="checkbox" class="form-check-input" checked="@item.IsSelectedForPrinting" @onchange="() => TogglePrintRow(item)" />
                                        </td>
                                        <td class="col-no">@(i + 1)</td>
                                        <td class="col-code">@item.ItemCode</td>
                                        <td class="col-name">@item.NamaItem</td>
                                        <td class="col-unit">@item.Satuan</td>
                                        <td class="col-qty @item.QtyClass">@item.Qty.ToString("N")</td>
                                        <td class="col-po">
                                            @item.QtyBeli.ToString("N")
                                            @if (item.HasPurchaseOrder)
                                            {
                                                <button class="dontprint btn btn-link btn-sm p-0 ms-1" title="Lihat detail PO" @onclick="() => CicilanBeli(item.ItemCode)">&#x1F50D;</button>
                                            }
                                        </td>
                                        <td class="col-so">
                                            @item.QtyJual.ToString("N")
                                            @if (item.HasSalesOrder)
                                            {
                                                <button class="dontprint btn btn-link btn-sm p-0 ms-1" title="Lihat detail SO" @onclick="() => CicilanJual(item.ItemCode)">&#x1F50D;</button>
                                            }
                                        </td>
                                        <td class="col-total @item.QtyOrderClass">@item.QtyOrder.ToString("N")</td>
                                        <td class="col-opname-result"></td>
                                        <td class="col-opname-note"></td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div style="margin-top: 20px;">
        <p class="print-date">Tanggal cetak: @DateTime.Now.ToString("dd-MM-yyyy HH:mm:ss")</p>
    </div>
}

@if (dispCicilan)
{
    <ModalSearchComponent OnClose="OnSearchClose" Items="TransParsial" Context="transaksi2">
        <TableHeader>
            <th scope="col">Vendor</th>
            <th scope="col">Tanggal</th>
            <th scope="col">No. PO</th>
            <th scope="col">Keterangan</th>
            <th scope="col">Qty</th>
            <th scope="col">Harga</th>
            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@transaksi2.NamaVendor</td>
            <td>@transaksi2.Tanggal.ToString("dd-MM-yyyy")</td>
            <td>@transaksi2.NoLpb</td>
            <td>@transaksi2.Keterangan</td>
            <td>@transaksi2.Qty</td>
            <td>@transaksi2.Harga</td>
            <td></td>
        </RowTemplate>
    </ModalSearchComponent>
}

@code {
    private sealed class GroupSection
    {
        public string Path { get; init; } = string.Empty;
        public List<IcStockCardView> Items { get; init; } = new();
        public decimal TotalQty => Items.Sum(x => x.Qty);
    }

    private List<GroupSection> _groups = new();
    private readonly HashSet<string> _expanded = new();
    private bool _expandAll = true;
    private bool _isLoadingReport = true;

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();

        try
        {
            _stock = await Task.Run(() => serviceOrdJual.GetCurrentOrderJual(serviceIC.GetCurrentStock()));
            foreach (var item in _stock)
            {
                item.IsSelectedForPrinting = true;
                item.IsSubTitleSelectedForPrinting = true;
                item.HasPurchaseOrder = item.QtyBeli != 0;
                item.HasSalesOrder = item.QtyJual != 0;
            }
            var allGroups = await groupRepo.GetAllAsync();
            _groupLookup = allGroups.ToDictionary(g => g.ItemGroupId);
            _groupOptions = allGroups
                .Select(g => (Id: g.ItemGroupId, Path: GetGroupPath(g.ItemGroupId)))
                .OrderBy(g => g.Path)
                .ToList();
            BuildGroups();
        }
        finally
        {
            _isLoadingReport = false;
        }
    }

    private List<IcStockCardView> _stock = new();
    private Dictionary<int, IcItemGroup> _groupLookup = new();
    private List<(int Id, string Path)> _groupOptions = new();
    private string _selectedGroup = "";
    private string _orderFilter = "";
    private string _title = "Laporan Stock per Group";
    private string _printMode = "normal";
    private List<IcStockCardView> TransParsial = new();
    private bool dispCicilan;

    private bool IsGroupSelected(GroupSection group) => group.Items.Count > 0 && group.Items.All(x => x.IsSelectedForPrinting);

    private void ToggleGroupPrint(GroupSection group)
    {
        var newState = !IsGroupSelected(group);
        foreach (var item in group.Items)
        {
            item.IsSelectedForPrinting = newState;
            item.IsSubTitleSelectedForPrinting = newState;
        }
    }

    private void TogglePrintRow(IcStockCardView item)
    {
        item.IsSelectedForPrinting = !item.IsSelectedForPrinting;
        item.IsSubTitleSelectedForPrinting = item.IsSelectedForPrinting;
    }

    private void CicilanBeli(string itemCode)
    {
        TransParsial = serviceOrdJual.GetListOrderAktif(itemCode, "71");
        dispCicilan = true;
    }

    private void CicilanJual(string itemCode)
    {
        TransParsial = serviceOrdJual.GetListOrderAktif(itemCode, "76");
        dispCicilan = true;
    }

    private void OnSearchClose(bool accepted)
    {
        dispCicilan = false;
    }

    private async Task PrintStockOpname()
    {
        _printMode = "opname";
        _title = "STOCK OPNAME";
        StateHasChanged();
        await Task.Delay(200);
        await JSRuntime.InvokeVoidAsync("window.print");
        await Task.Delay(500);
        _printMode = "normal";
        _title = "Laporan Stock per Group";
        StateHasChanged();
    }

    private async Task ExportToExcel()
    {
        using var excelStream = GenerateExcelWorkbook();
        string fileName = $"LaporanStockGroup_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
        using var streamRef = new DotNetStreamReference(stream: excelStream);
        await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }

    private MemoryStream GenerateExcelWorkbook()
    {
        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Stock Report");

        int rowNum = 1;
        var titleRange = worksheet.Range(rowNum, 1, rowNum, 8);
        titleRange.Merge();
        titleRange.Value = _title;
        titleRange.Style.Font.Bold = true;
        titleRange.Style.Font.FontSize = 14;
        titleRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
        rowNum += 2;

        string[] headers = { "No.", "Kode", "Nama Barang", "Satuan", "Qty", "PO", "SO", "Total" };
        for (int col = 0; col < headers.Length; col++)
        {
            worksheet.Cell(rowNum, col + 1).Value = headers[col];
        }
        var headerRange = worksheet.Range(rowNum, 1, rowNum, 8);
        headerRange.Style.Font.Bold = true;
        headerRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
        headerRange.Style.Fill.BackgroundColor = XLColor.DarkGray;
        headerRange.Style.Font.FontColor = XLColor.White;
        headerRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
        headerRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
        rowNum++;

        foreach (var group in _groups)
        {
            var selected = group.Items.Where(x => x.IsSelectedForPrinting).ToList();
            if (selected.Count == 0)
            {
                continue;
            }

            var groupRange = worksheet.Range(rowNum, 1, rowNum, 8);
            groupRange.Merge();
            groupRange.Value = $"{group.Path} ({selected.Count} item, Total Qty: {selected.Sum(x => x.Qty):N})";
            groupRange.Style.Font.Bold = true;
            groupRange.Style.Fill.BackgroundColor = XLColor.LightGray;
            rowNum++;

            int no = 1;
            foreach (var item in selected)
            {
                worksheet.Cell(rowNum, 1).Value = no++;
                worksheet.Cell(rowNum, 2).Value = item.ItemCode;
                worksheet.Cell(rowNum, 3).Value = item.NamaItem;
                worksheet.Cell(rowNum, 4).Value = item.Satuan;
                worksheet.Cell(rowNum, 5).Value = item.Qty;
                worksheet.Cell(rowNum, 6).Value = item.QtyBeli;
                worksheet.Cell(rowNum, 7).Value = item.QtyJual;
                worksheet.Cell(rowNum, 8).Value = item.QtyOrder;
                rowNum++;
            }
        }

        worksheet.Columns().AdjustToContents();

        var stream = new MemoryStream();
        workbook.SaveAs(stream);
        stream.Position = 0;
        return stream;
    }

    private string GetGroupPath(int groupId)
    {
        var names = new List<string>();
        int? id = groupId;
        while (id.HasValue && _groupLookup.TryGetValue(id.Value, out var group))
        {
            names.Insert(0, group.Name);
            id = group.ParentId;
        }
        return string.Join(" > ", names);
    }

    private HashSet<int> GetDescendantIds(int rootId)
    {
        var result = new HashSet<int>();
        var pending = new Stack<int>();
        pending.Push(rootId);
        while (pending.Count > 0)
        {
            var current = pending.Pop();
            if (!result.Add(current))
            {
                continue;
            }
            foreach (var child in _groupLookup.Values.Where(g => g.ParentId == current))
            {
                pending.Push(child.ItemGroupId);
            }
        }
        return result;
    }

    private void BuildGroups()
    {
        IEnumerable<IcStockCardView> items = _stock;
        if (_selectedGroup == "0")
        {
            items = items.Where(x => x.ItemGroupId is null);
        }
        else if (int.TryParse(_selectedGroup, out var groupId))
        {
            var ids = GetDescendantIds(groupId);
            items = items.Where(x => x.ItemGroupId.HasValue && ids.Contains(x.ItemGroupId.Value));
        }

        items = _orderFilter switch
        {
            "po" => items.Where(x => x.HasPurchaseOrder),
            "so" => items.Where(x => x.HasSalesOrder),
            "any" => items.Where(x => x.HasPurchaseOrder || x.HasSalesOrder),
            "both" => items.Where(x => x.HasPurchaseOrder && x.HasSalesOrder),
            _ => items
        };

        _groups = items
            .GroupBy(x => string.IsNullOrWhiteSpace(x.ItemGroupPath) ? "Belum Ada Group" : x.ItemGroupPath)
            .OrderBy(g => g.Key)
            .Select(g => new GroupSection
            {
                Path = g.Key,
                Items = g.OrderBy(x => x.ItemCode).ToList()
            })
            .ToList();

        _expanded.Clear();
        foreach (var group in _groups)
        {
            _expanded.Add(group.Path);
        }
    }

    private void OnGroupChanged(ChangeEventArgs e)
    {
        _selectedGroup = e.Value?.ToString() ?? "";
        BuildGroups();
    }

    private void OnOrderFilterChanged(ChangeEventArgs e)
    {
        _orderFilter = e.Value?.ToString() ?? "";
        BuildGroups();
    }

    private bool IsExpanded(string path) => _expanded.Contains(path);

    private void ToggleGroup(string path)
    {
        if (!_expanded.Add(path))
        {
            _expanded.Remove(path);
        }
    }

    private void ToggleAllGroups()
    {
        _expandAll = !_expandAll;
        _expanded.Clear();
        if (_expandAll)
        {
            foreach (var group in _groups)
            {
                _expanded.Add(group.Path);
            }
        }
    }
}
