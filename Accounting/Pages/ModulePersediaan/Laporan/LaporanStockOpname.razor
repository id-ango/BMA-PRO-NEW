@page "/ModulePersediaan/LaporanStockOpname"
@layout PrintLayout
@using eSoft.Persediaan.Services
@using eSoft.Persediaan.View
@using ClosedXML.Excel

@inject IInventoryServices InventoryService
@inject IIcAdjustServices AdjustmentService
@inject IJSRuntime JSRuntime

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <h3>Stock Opname per Lokasi</h3>
        <a class="btn btn-outline-secondary" href="/ModulePersediaan/LaporanCurrentStock">Kembali</a>
    </div>

    @if (IsLoading)
    {
        <div class="text-center p-4" role="status" aria-live="polite">
            <div class="spinner-border text-primary" aria-hidden="true"></div>
            <div class="mt-2">Data stock opname sedang diproses, mohon tunggu...</div>
        </div>
    }
    else
    {
        <div class="card mb-3 no-print">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Tanggal</label>
                        <InputDate class="form-control" @bind-Value="Tanggal" disabled="@IsSaving" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Keterangan</label>
                        <InputText class="form-control" @bind-Value="Keterangan" disabled="@IsSaving" />
                    </div>
                    <div class="col-md-3 text-md-end">
                        <button class="btn btn-outline-secondary me-1" @onclick="PrintStockOpname" disabled="@(IsSaving || IsExporting)">Cetak</button>
                        <button class="btn btn-outline-success me-1" @onclick="ExportToExcel" disabled="@(IsSaving || IsExporting)">
                            @if (IsExporting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                <span>Membuat Excel...</span>
                            }
                            else
                            {
                                <span>Excel</span>
                            }
                        </button>
                        <button class="btn btn-primary" @onclick="SimpanStockOpname" disabled="@(IsSaving || IsExporting || Rows.Count == 0)">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                <span>Menyimpan...</span>
                            }
                            else
                            {
                                <span>Buat Transaksi Adjustment</span>
                            }
                        </button>
                    </div>
                </div>
                <div class="form-text mt-2">Isi jumlah fisik pada setiap item-lokasi yang diperiksa. Kolom kosong akan diproses sebagai 0.</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="alert alert-success" role="status">@Message</div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@ErrorMessage</div>
        }

        @if (Rows.Count == 0)
        {
            <div class="alert alert-info">Tidak ada data item atau lokasi.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Item</th>
                            <th>Nama Item</th>
                            <th>Satuan</th>
                            <th class="text-end">Total Sistem</th>
                            @foreach (var location in Locations)
                            {
                                <th class="text-center" colspan="2">@location.NamaLokasi (@location.Lokasi)</th>
                            }
                        </tr>
                        <tr>
                            <th colspan="4"></th>
                            @foreach (var location in Locations)
                            {
                                <th class="text-end">Sistem</th>
                                <th class="text-end">Fisik</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var division in Rows
                            .GroupBy(x => new { x.Divisi, x.NamaDivisi })
                            .OrderBy(x => x.Key.NamaDivisi))
                        {
                            <tr class="division-row">
                                <td colspan="@(4 + Locations.Count * 2)">@division.Key.NamaDivisi</td>
                            </tr>
                            @foreach (var row in division.OrderBy(x => x.NamaItem))
                            {
                                <tr>
                                    <td>@row.ItemCode</td>
                                    <td>@row.NamaItem</td>
                                    <td>@row.Satuan</td>
                                    <td class="text-end fw-bold">@row.Qty.ToString("N2")</td>
                                    @foreach (var location in Locations)
                                    {
                                        var key = CellKey(row.ItemCode, location.Lokasi);
                                        var systemQty = row.Locations.First(x => x.Lokasi == location.Lokasi).Qty;
                                        <td class="text-end">@systemQty.ToString("N2")</td>
                                        <td style="min-width: 110px">
                                            <span class="print-only">&nbsp;</span>
                                            <InputNumber TValue="decimal?" class="form-control form-control-sm text-end no-print" @bind-Value="PhysicalQuantities[key]" disabled="@IsSaving" />
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private List<IcItemQtyByLocationView> Rows { get; set; } = new();
    private List<IcLocationQtyView> Locations { get; set; } = new();
    private Dictionary<string, decimal?> PhysicalQuantities { get; set; } = new();
    private DateTime Tanggal { get; set; } = DateTime.Today;
    private string Keterangan { get; set; } = "Stock opname per lokasi";
    private string Message { get; set; }
    private string ErrorMessage { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private bool IsExporting { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();

        try
        {
            Rows = InventoryService.GetStockOpnameItemsByLocation();
            Locations = Rows.SelectMany(x => x.Locations)
                .GroupBy(x => x.Lokasi)
                .Select(x => x.First())
                .OrderBy(x => x.Lokasi)
                .ToList();

            foreach (var row in Rows)
            {
                foreach (var location in Locations)
                {
                    var qty = row.Locations.First(x => x.Lokasi == location.Lokasi).Qty;
                    PhysicalQuantities[CellKey(row.ItemCode, location.Lokasi)] = qty == 0 ? null : qty;
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Data stock tidak dapat dimuat: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SimpanStockOpname()
    {
        Message = null;
        ErrorMessage = null;
        IsSaving = true;
        await Task.Yield();

        try
        {
            var opname = new IcStockOpnameView
            {
                Tanggal = Tanggal,
                Keterangan = Keterangan,
                Lines = Rows.SelectMany(row => Locations.Select(location =>
                {
                    var key = CellKey(row.ItemCode, location.Lokasi);
                    var systemQty = row.Locations.First(x => x.Lokasi == location.Lokasi).Qty;
                    return new IcStockOpnameLineView
                    {
                        ItemCode = row.ItemCode,
                        Lokasi = location.Lokasi,
                        QtySistem = systemQty,
                        QtyFisik = PhysicalQuantities[key] ?? 0
                    };
                })).ToList()
            };

            var transaction = AdjustmentService.CreateStockOpname(opname);
            if (transaction == null)
            {
                Message = "Tidak ada selisih stock. Tidak ada transaksi yang dibuat.";
            }
            else
            {
                Message = $"Transaksi adjustment {transaction.NoFaktur} berhasil dibuat dengan {transaction.IcTransDs.Count} baris.";
                Rows = InventoryService.GetStockOpnameItemsByLocation();
                foreach (var row in Rows)
                {
                    foreach (var location in Locations)
                    {
                        var qty = row.Locations.First(x => x.Lokasi == location.Lokasi).Qty;
                        PhysicalQuantities[CellKey(row.ItemCode, location.Lokasi)] = qty == 0 ? null : qty;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Transaksi stock opname gagal dibuat: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task PrintStockOpname()
    {
        await Task.Delay(100);
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task ExportToExcel()
    {
        IsExporting = true;
        Message = null;
        ErrorMessage = null;
        await Task.Yield();

        try
        {
            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Stock Opname");
            var lastColumn = 4 + Locations.Count * 2;
            var rowNumber = 1;

            worksheet.Cell(rowNumber, 1).Value = "STOCK OPNAME PER LOKASI";
            worksheet.Range(rowNumber, 1, rowNumber, lastColumn).Merge();
            worksheet.Range(rowNumber, 1, rowNumber, lastColumn).Style.Font.Bold = true;
            worksheet.Range(rowNumber, 1, rowNumber, lastColumn).Style.Font.FontSize = 14;
            worksheet.Range(rowNumber, 1, rowNumber, lastColumn).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            rowNumber += 2;

            var headerRow = rowNumber;
            worksheet.Cell(rowNumber, 1).Value = "Item";
            worksheet.Cell(rowNumber, 2).Value = "Nama Item";
            worksheet.Cell(rowNumber, 3).Value = "Satuan";
            worksheet.Cell(rowNumber, 4).Value = "Total Sistem";
            var column = 5;
            foreach (var location in Locations)
            {
                worksheet.Cell(rowNumber, column).Value = $"{location.NamaLokasi} ({location.Lokasi}) Sistem";
                worksheet.Cell(rowNumber, column + 1).Value = $"{location.NamaLokasi} ({location.Lokasi}) Fisik";
                column += 2;
            }

            var headerRange = worksheet.Range(rowNumber, 1, rowNumber, lastColumn);
            headerRange.Style.Font.Bold = true;
            headerRange.Style.Fill.BackgroundColor = XLColor.DarkGray;
            headerRange.Style.Font.FontColor = XLColor.White;
            headerRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            rowNumber++;

            foreach (var division in Rows
                .GroupBy(x => new { x.Divisi, x.NamaDivisi })
                .OrderBy(x => x.Key.NamaDivisi))
            {
                worksheet.Cell(rowNumber, 1).Value = division.Key.NamaDivisi;
                worksheet.Range(rowNumber, 1, rowNumber, lastColumn).Merge();
                var divisionRange = worksheet.Range(rowNumber, 1, rowNumber, lastColumn);
                divisionRange.Style.Font.Bold = true;
                divisionRange.Style.Fill.BackgroundColor = XLColor.LightGray;
                rowNumber++;

                foreach (var item in division.OrderBy(x => x.NamaItem))
                {
                    worksheet.Cell(rowNumber, 1).Value = item.ItemCode;
                    worksheet.Cell(rowNumber, 2).Value = item.NamaItem;
                    worksheet.Cell(rowNumber, 3).Value = item.Satuan;
                    worksheet.Cell(rowNumber, 4).Value = item.Qty;
                    column = 5;

                    foreach (var location in Locations)
                    {
                        var systemQty = item.Locations.First(x => x.Lokasi == location.Lokasi).Qty;
                        worksheet.Cell(rowNumber, column).Value = systemQty;
                        worksheet.Cell(rowNumber, column + 1).Value = string.Empty;
                        column += 2;
                    }

                    rowNumber++;
                }
            }

            worksheet.Range(1, 1, rowNumber - 1, lastColumn).Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            worksheet.Range(1, 1, rowNumber - 1, lastColumn).Style.Border.InsideBorder = XLBorderStyleValues.Thin;
            var usedRange = worksheet.Range(1, 1, rowNumber - 1, lastColumn);
            usedRange.Style.Alignment.WrapText = true;
            usedRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

            var systemColor = XLColor.FromHtml("#DDEBF7");
            var systemTotalRange = worksheet.Range(headerRow, 4, rowNumber - 1, 4);
            systemTotalRange.Style.Fill.BackgroundColor = systemColor;
            systemTotalRange.Style.Font.FontColor = XLColor.Black;

            column = 5;
            foreach (var location in Locations)
            {
                var systemRange = worksheet.Range(headerRow, column, rowNumber - 1, column);
                var physicalRange = worksheet.Range(headerRow, column + 1, rowNumber - 1, column + 1);
                systemRange.Style.Fill.BackgroundColor = systemColor;
                physicalRange.Style.Fill.BackgroundColor = XLColor.White;
                systemRange.Style.Font.FontColor = XLColor.Black;
                physicalRange.Style.Font.FontColor = XLColor.Black;
                column += 2;
            }

            worksheet.Columns().AdjustToContents();
            worksheet.Column(1).Width = 16;
            worksheet.Column(2).Width = 28;
            worksheet.Column(3).Width = 12;
            worksheet.Column(4).Width = 14;
            for (var locationColumn = 5; locationColumn <= lastColumn; locationColumn++)
            {
                worksheet.Column(locationColumn).Width = 14;
            }

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            stream.Position = 0;
            using var streamReference = new DotNetStreamReference(stream);
            await JSRuntime.InvokeVoidAsync(
                "downloadFileFromStream",
                $"StockOpname_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                streamReference);
            Message = "File Excel stock opname berhasil dibuat dan diunduh.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Export Excel gagal: {ex.Message}";
        }
        finally
        {
            IsExporting = false;
        }
    }

    private static string CellKey(string itemCode, string lokasi) => $"{itemCode}::{lokasi}";
}

<style>
    .division-row td {
        background-color: #e9ecef;
        font-weight: 700;
    }

    .print-only {
        display: none;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .print-only {
            display: block;
            min-height: 24px;
            border-bottom: 1px solid #000;
        }

        .container-fluid {
            padding: 0 !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        table {
            font-size: 9pt;
        }

        .division-row {
            break-after: avoid;
        }
    }
</style>
