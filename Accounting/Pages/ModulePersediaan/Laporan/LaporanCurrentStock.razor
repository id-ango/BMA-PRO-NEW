@layout PrintLayout

@page "/ModulePersediaan/LaporanCurrentStock"

@using eSoft.Persediaan.Model
@using eSoft.Persediaan.View
@using eSoft.Persediaan.Services
@using eSoft.Order.Services
@using eSoft.LaporanStock.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@using ClosedXML.Excel

@inject IInventoryServices serviceIC
@inject IOrderSalesServices serviceOrdJual
@inject NavigationManager navigationmanager
@inject IJSRuntime JSRuntime

<link rel="stylesheet" href="css/laporan-current-stock.css" />

<div class="dontprint" style="display:inline">
    <br />
    &emsp;
    <button class="btn btn-warning btn-lg" style="background-color: @BackgroundColor" @onclick="TogglePrintAll">Toggle Print All</button>
    &emsp;
    <NavLink href="/" class="btn btn-primary btn-lg">&nbsp;Back&nbsp;</NavLink>
    &emsp;
    <NavLink class="btn btn-success btn-lg" onclick="window.print()">&nbsp; Cetak &nbsp;</NavLink>
    &emsp;
    <button class="btn btn-info btn-lg" @onclick="PrintStockOpname">&nbsp; Stock Opname &nbsp;</button>
    &emsp;
    <button class="btn btn-secondary btn-lg" @onclick="ExportToExcel">&nbsp; Export Excel &nbsp;</button>
    &emsp;
</div>

<div class="report-table" data-print-mode="@printMode">
    <div class="report-title">@Title</div>

    @if (DisplayItems != null && DisplayItems.Count > 0)
    {
        <div class="data-table-container">
            <table class="data-table">
                <thead>
                    <tr class="header-row">
                        <th class="col-no">No.</th>
                        <th class="col-code">Kode</th>
                        <th class="col-name">Nama Barang</th>
                        <th class="col-unit">Satuan</th>
                        <th class="col-qty">Qty</th>
                        <th class="col-po">PO</th>
                        <th class="col-so">SO</th>
                        <th class="col-total">Total</th>
                        <th class="col-opname-result">Hasil Stock</th>
                        <th class="col-opname-note">Keterangan</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in DisplayItems)
                    {
                        @if (item.IsDivisionHeader)
                        {
                            <tr class="division-header @(item.IsSelectedForPrinting ? "to-print" : "")">
                                <td colspan="10">
                                    @item.Divisi
                                    <span class="dontprint">
                                        <button type="button" class="btn btn-primary btn-sm @(item.IsSelectedForPrinting ? "btn-marked" : "")" @onclick="@(() => ToggleRowsWithSameDivision(item.KodeDivisi))">Cetak</button>
                                    </span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="@(item.IsSelectedForPrinting ? "to-print" : "") @(item.HasHighlightedQty ? "highlight-row" : "")">
                                <td class="col-no">
                                    @item.RowNumber
                                    <span class="dontprint">
                                        <button type="button" class="btn btn-sm @(item.IsSelectedForPrinting ? "btn-marked btn-success" : "btn-outline-secondary")" @onclick="@(() => TogglePrintRow(item))">✓</button>
                                    </span>
                                </td>
                                 <td class="col-code">
                                    @item.ItemCode
                                    <button class="dontprint btn btn-info btn-sm" @onclick="@(() => CetakStockCard(item.ItemCode,item.NamaItem,item.Satuan))">Kartu</button>
                                </td>
                                <td class="col-name" title="@item.Keterangan">
                                    @item.NamaItem
                                    @if (item.HasPurchaseOrder)
                                    {
                                        <button class="dontprint btn btn-success btn-sm" @onclick="@(() => CicilanBeli(item.ItemCode))">PO</button>
                                    }
                                    @if (item.HasSalesOrder)
                                    {
                                        <button class="dontprint btn btn-info btn-sm" @onclick="@(() => CicilanJual(item.ItemCode))">SO</button>
                                    }
                                </td>
                                        <td class="col-unit">@item.Satuan</td>
                                        <td class="col-qty @item.QtyClass">@item.Qty.ToString("N")</td>
                                        <td class="col-po">@item.QtyBeli.ToString("N")</td>
                                        <td class="col-so">@item.QtyJual.ToString("N")</td>
                                        <td class="col-total @item.QtyOrderClass">@item.QtyOrder.ToString("N")</td>
                                        <td class="col-opname-result"></td>
                                        <td class="col-opname-note"></td>
                                    </tr>
                        }
                    }
                    <tr class="separator-row">
                        <td colspan="10">&nbsp;</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>

<div style="margin-top: 20px;">
    <p id="print-date" class="print-date">Tanggal cetak: @DateTime.Now.ToString("dd-MM-yyyy HH:mm:ss")</p>
    <p>&nbsp;</p>
</div>

@if (dispCicilan)
{
    <ModalSearchComponent OnClose="OnSearchClose" Items="TransParsial" Context="transaksi2">
        <TableHeader>
            <th scope="col">Vendor</th>
            <th scope="col">Tanggal</th>
            <th scope="col">No. PO</th>
            <th scope="col">Keterangan</th>
            <th scope="col">Qty</th>
            <th scope="col">Harga</th>
            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>
                @transaksi2.NamaVendor
            </td>
            <td>
                @transaksi2.Tanggal.ToString("dd-MM-yyyy")
            </td>
            <td>
                @transaksi2.NoLpb
            </td>
            <td>
                @transaksi2.Keterangan
            </td>
            <td>
                @transaksi2.Qty
            </td>

            <td>
                @transaksi2.Harga
            </td>

            <td>

            </td>
        </RowTemplate>
         </ModalSearchComponent>
    }

    @code {

         public List<IcStockCardView> TransDetail = new List<IcStockCardView>();

    // PHASE 2: Display items includes division headers for proper grouping with virtualization
    public List<IcStockCardView> DisplayItems { get; set; } = new List<IcStockCardView>();

    public List<IcStockCardView> TransParsial = new List<IcStockCardView>();

    private string Title = "Laporan Stock";
    private string printMode = "normal"; // "normal" or "opname"

    private bool dispCicilan { get; set; }

    private bool printAllSelected = true;
    private string BackgroundColor = "";

    // OPTIMIZATION: Control render cycles
    private bool _shouldRender = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        loadStock();
    }

    /// <summary>
    /// OPTIMIZATION: Only render when necessary
    /// Prevents unnecessary re-renders and reduces bandwidth
    /// </summary>
    protected override bool ShouldRender() => _shouldRender;

    private void loadStock()
    {
        TransDetail = serviceIC.GetCurrentStock();
        TransDetail = serviceOrdJual.GetCurrentOrderJual(TransDetail);

        // OPTIMIZATION: Pre-compute conditions once at load time
        foreach (var item in TransDetail)
        {
            item.HasPurchaseOrder = item.QtyBeli != 0;
            item.HasSalesOrder = item.QtyJual != 0;
            item.HasHighlightedQty = item.QtyJual != 0;
            item.QtyClass = item.Qty < 0 ? "qty-negative" : (item.Qty == 0 ? "qty-zero" : "");
            item.QtyOrderClass = item.QtyOrder < 0 ? "qty-negative" : (item.QtyOrder == 0 ? "qty-zero" : "");
        }

        // PHASE 2: Build display items with division headers for grouping
        BuildDisplayItems();

        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    /// <summary>
    /// PHASE 2: Builds display list including division headers
    /// This replaces the foreach logic in the template
    /// Handles division grouping with proper row numbering
    /// </summary>
    private void BuildDisplayItems()
    {
        DisplayItems = new List<IcStockCardView>();
        string lastDivision = null;
        int rowNumber = 1;

        if (TransDetail == null || TransDetail.Count == 0)
            return;

        foreach (var item in TransDetail)
        {
            // Add division header when division changes
            if (lastDivision != item.KodeDivisi)
            {
                lastDivision = item.KodeDivisi;
                rowNumber = 1;

                // Check if ANY item in this division is selected for printing
                bool hasPrintableChild = TransDetail.Any(x => 
                    x.KodeDivisi == item.KodeDivisi && 
                    !x.IsDivisionHeader && 
                    x.IsSelectedForPrinting);

                // Create virtual division header row
                DisplayItems.Add(new IcStockCardView
                {
                    IsDivisionHeader = true,
                    KodeDivisi = item.KodeDivisi,
                    Divisi = item.Divisi,
                    IsSelectedForPrinting = hasPrintableChild
                });
            }

            // Add data row
            item.RowNumber = rowNumber++;
            DisplayItems.Add(item);
        }
    }

    private void CicilanBeli(string itemcode)
    {
        TransParsial = serviceOrdJual.GetListOrderAktif(itemcode, "71");

        _shouldRender = true;
        dispCicilan = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void CicilanJual(string itemcode)
    {
        TransParsial = serviceOrdJual.GetListOrderAktif(itemcode, "76");

        _shouldRender = true;
        dispCicilan = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void OnSearchClose(bool accepted)
    {
        _shouldRender = true;
        dispCicilan = false;
        StateHasChanged();
        _shouldRender = false;
    }

    private async Task PrintStockOpname()
    {
        // Set flag untuk CSS tahu mode opname saat print
        printMode = "opname";
        Title = "STOCK OPNAME";
        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;

        // Tunggu render selesai, baru trigger print
        await Task.Delay(200);
        await JSRuntime.InvokeVoidAsync("window.print");

        // Reset mode kembali ke normal setelah print dialog ditutup
        await Task.Delay(500);
        printMode = "normal";
        Title = "Laporan Stock";
        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void TogglePrintRow(IcStockCardView item)
    {
        if (item == null || item.IsDivisionHeader)
            return;

        // Toggle print state for this individual row
        item.IsSelectedForPrinting = !item.IsSelectedForPrinting;
        item.IsSubTitleSelectedForPrinting = item.IsSelectedForPrinting;

        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void ToggleRowsWithSameDivision(string divisionCode)
    {
        // Find first item with this division to determine current state
        var firstItem = TransDetail.FirstOrDefault(x => x.KodeDivisi == divisionCode);
        bool newState = !(firstItem?.IsSelectedForPrinting ?? true);

        // Toggle all items in TransDetail for this division
        foreach (var item in TransDetail.Where(x => x.KodeDivisi == divisionCode && !x.IsDivisionHeader))
        {
            item.IsSelectedForPrinting = newState;
            item.IsSubTitleSelectedForPrinting = newState;
        }

        // Also update all items in DisplayItems for this division
        foreach (var item in DisplayItems.Where(x => x.KodeDivisi == divisionCode))
        {
            item.IsSelectedForPrinting = newState;
        }

        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void TogglePrintAll()
    {
        printAllSelected = !printAllSelected;

        // Toggle all rows in TransDetail
        foreach (var item in TransDetail)
        {
            item.IsSelectedForPrinting = printAllSelected;
        }

        // Also update DisplayItems (division headers and data rows)
        foreach (var item in DisplayItems)
        {
            item.IsSelectedForPrinting = printAllSelected;
        }

        BackgroundColor = printAllSelected ? "yellow" : "";

        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void CetakStockCard(string kodeItem, string namaItem, string satuan)
    {
        string encodedNamaItem = Uri.EscapeDataString(namaItem);
        string encodedSatuan = Uri.EscapeDataString(satuan);
        string encodedKodeItem = Uri.EscapeDataString(kodeItem);

        navigationmanager.NavigateTo($"/ModulePrinting/stockCard/{encodedNamaItem}/{encodedSatuan}/{encodedKodeItem}");
    }

    private async Task ExportToExcel()
    {
        try
        {
            Console.WriteLine("ExportToExcel button clicked");
            _shouldRender = true;

            // Generate Excel file
            var excelStream = GenerateExcelWorkbook();

            // Create file name with date
            string fileName = $"LaporanStock_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            Console.WriteLine($"Excel file generated: {fileName}, Size: {excelStream.Length} bytes");

            // Trigger browser download
            using var streamRef = new DotNetStreamReference(stream: excelStream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            Console.WriteLine("Download invoked successfully");

            _shouldRender = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to Excel: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
            _shouldRender = false;
        }
    }

    private MemoryStream GenerateExcelWorkbook()
    {
        using (var workbook = new XLWorkbook())
        {
            var worksheet = workbook.Worksheets.Add("Stock Report");

            int rowNum = 1;

            // Add title
            var titleCell = worksheet.Cell(rowNum, 1);
            titleCell.Value = Title;
            titleCell.Style.Font.Bold = true;
            titleCell.Style.Font.FontSize = 14;
            worksheet.Range(rowNum, 1, rowNum, 8).Merge();
            rowNum += 2;

            // Add header row
            var headerRow = rowNum;
            worksheet.Cell(rowNum, 1).Value = "No.";
            worksheet.Cell(rowNum, 2).Value = "Kode";
            worksheet.Cell(rowNum, 3).Value = "Nama Barang";
            worksheet.Cell(rowNum, 4).Value = "Satuan";
            worksheet.Cell(rowNum, 5).Value = "Qty";
            worksheet.Cell(rowNum, 6).Value = "PO";
            worksheet.Cell(rowNum, 7).Value = "SO";
            worksheet.Cell(rowNum, 8).Value = "Total";

            // Format header
            var headerRange = worksheet.Range(rowNum, 1, rowNum, 8);
            headerRange.Style.Font.Bold = true;
            headerRange.Style.Fill.BackgroundColor = XLColor.DarkGray;
            headerRange.Style.Font.FontColor = XLColor.White;
            headerRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            headerRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;

            rowNum++;

            // Track row grouping for outline feature
            int groupStartRow = rowNum;
            string currentDivision = null;
            int divisionItemCount = 0;

            // Add data rows grouped by division
            foreach (var item in DisplayItems)
            {
                // Only include rows marked for printing
                if (!item.IsSelectedForPrinting)
                    continue;

                if (item.IsDivisionHeader)
                {
                    // End previous group if exists
                    if (currentDivision != null && divisionItemCount > 0)
                    {
                        worksheet.Rows(groupStartRow, rowNum - 1).Group();
                    }

                    currentDivision = item.Divisi;
                    groupStartRow = rowNum;
                    divisionItemCount = 0;

                    // Add division header row
                    var divisionCell = worksheet.Cell(rowNum, 1);
                    divisionCell.Value = item.Divisi;
                    divisionCell.Style.Font.Bold = true;
                    divisionCell.Style.Fill.BackgroundColor = XLColor.LightGray;
                    worksheet.Range(rowNum, 1, rowNum, 8).Merge();
                    worksheet.Range(rowNum, 1, rowNum, 8).Style.Border.OutsideBorder = XLBorderStyleValues.Thin;

                    rowNum++;
                }
                else
                {
                    // Add data row
                    divisionItemCount++;
                    worksheet.Cell(rowNum, 1).Value = item.RowNumber;
                    worksheet.Cell(rowNum, 2).Value = item.ItemCode;
                    worksheet.Cell(rowNum, 3).Value = item.NamaItem;
                    worksheet.Cell(rowNum, 4).Value = item.Satuan;
                    worksheet.Cell(rowNum, 5).Value = item.Qty;
                    worksheet.Cell(rowNum, 6).Value = item.QtyBeli;
                    worksheet.Cell(rowNum, 7).Value = item.QtyJual;
                    worksheet.Cell(rowNum, 8).Value = item.QtyOrder;

                    // Format cells
                    var rowRange = worksheet.Range(rowNum, 1, rowNum, 8);
                    rowRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
                    rowRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;

                    // Format numbers
                    worksheet.Cell(rowNum, 5).Style.NumberFormat.Format = "#,##0.00";
                    worksheet.Cell(rowNum, 6).Style.NumberFormat.Format = "#,##0.00";
                    worksheet.Cell(rowNum, 7).Style.NumberFormat.Format = "#,##0.00";
                    worksheet.Cell(rowNum, 8).Style.NumberFormat.Format = "#,##0.00";

                    // Color negative values red
                    if (item.Qty < 0) worksheet.Cell(rowNum, 5).Style.Font.FontColor = XLColor.Red;
                    if (item.QtyOrder < 0) worksheet.Cell(rowNum, 8).Style.Font.FontColor = XLColor.Red;

                    rowNum++;
                }
            }

            // End last group
            if (currentDivision != null && divisionItemCount > 0)
            {
                worksheet.Rows(groupStartRow, rowNum - 1).Group();
            }

            // Set column widths to match CSS
            worksheet.Column(1).Width = 6;    // No.
            worksheet.Column(2).Width = 12;   // Kode
            worksheet.Column(3).Width = 35;   // Nama Barang
            worksheet.Column(4).Width = 10;   // Satuan
            worksheet.Column(5).Width = 12;   // Qty
            worksheet.Column(6).Width = 12;   // PO
            worksheet.Column(7).Width = 12;   // SO
            worksheet.Column(8).Width = 12;   // Total

            // Save workbook to stream
            var stream = new MemoryStream();
            workbook.SaveAs(stream);
            stream.Position = 0;
            return stream;
        }
    }
}
