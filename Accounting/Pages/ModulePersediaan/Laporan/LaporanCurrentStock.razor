@layout PrintLayout

@page "/ModulePersediaan/LaporanCurrentStock"

@using eSoft.Persediaan.Model
@using eSoft.Persediaan.View
@using eSoft.Persediaan.Services
@using eSoft.Order.Services
@using eSoft.LaporanStock.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@using ClosedXML.Excel
@using Microsoft.AspNetCore.Components.Web

@inject IInventoryServices serviceIC
@inject IOrderSalesServices serviceOrdJual
@inject ILaporanStockServices serviceLaporanStock
@inject NavigationManager navigationmanager
@inject IJSRuntime JSRuntime

<link rel="stylesheet" href="css/laporan-current-stock.css" />

<div class="dontprint stock-toolbar">
    <div class="stock-toolbar-heading">
        <h1>Laporan Current Stock</h1>
        <p>Periksa stok, pesanan aktif, dan mutasi barang.</p>
    </div>
    <div class="stock-toolbar-actions">
        <NavLink href="/" class="btn btn-outline-primary">Kembali</NavLink>
        <button type="button" class="btn btn-outline-warning" disabled="@(_isLoadingReport || TransDetail.Count == 0)" aria-pressed="@printAllSelected" @onclick="TogglePrintAll">@(printAllSelected ? "Batalkan Pilihan Cetak yang Ditampilkan" : "Pilih Semua yang Ditampilkan")</button>
        <button type="button" class="btn btn-success" disabled="@_isLoadingReport" onclick="window.print()">Cetak</button>
        <button type="button" class="btn btn-info" disabled="@_isLoadingReport" @onclick="PrintStockOpname">Stock Opname</button>
        <NavLink class="btn btn-outline-primary" href="/ModulePersediaan/LaporanStockOpname">Opname per Lokasi</NavLink>
        <button type="button" class="btn btn-secondary" disabled="@_isLoadingReport" @onclick="ExportToExcel">Export Excel</button>
    </div>
</div>

@if (_isLoadingReport)
{
    <div class="text-center p-4" role="status" aria-live="polite">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <div class="mt-2">Laporan stock sedang diproses, mohon tunggu...</div>
    </div>
}
else
{
    <div class="report-table" data-print-mode="@printMode">
        <div class="report-title">@Title</div>

        <div class="dontprint stock-search">
            <label for="stock-search" class="form-label fw-bold">Cari Item</label>
            <div class="input-group">
                <input id="stock-search" type="text" class="form-control" placeholder="Kode, nama item, atau search tags" value="@_searchText" @oninput="OnSearchTextChanged" />
                <button class="btn btn-outline-secondary" type="button" title="Hapus pencarian" aria-label="Hapus pencarian" @onclick="ClearSearch">&times;</button>
            </div>
            <div class="row g-2 mt-1">
                <div class="col-sm-6">
                    <label for="stock-order-filter" class="form-label fw-bold">Filter PO / SO</label>
                    <select id="stock-order-filter" class="form-select" value="@_orderFilter" @onchange="OnOrderFilterChanged">
                        <option value="">Semua item</option>
                        <option value="po">Ada PO</option>
                        <option value="so">Ada SO</option>
                        <option value="any">Ada PO atau SO</option>
                        <option value="both">Ada PO dan SO</option>
                        <option value="po-only">Hanya PO, tanpa SO</option>
                        <option value="so-only">Hanya SO, tanpa PO</option>
                        <option value="none">Tanpa PO dan SO</option>
                    </select>
                </div>
                <div class="col-sm-6">
                    <label for="stock-qty-filter" class="form-label fw-bold">Filter Qty Stok</label>
                    <select id="stock-qty-filter" class="form-select" value="@_qtyFilter" @onchange="OnQtyFilterChanged">
                        <option value="">Semua qty</option>
                        <option value="positive">Qty lebih dari 0</option>
                        <option value="zero">Qty 0</option>
                        <option value="negative">Qty minus</option>
                        <option value="non-positive">Qty 0 atau minus</option>
                    </select>
                </div>
            </div>
            <small class="text-muted">@TransDetail.Count item ditampilkan. Gunakan ikon detail untuk melihat transaksi.</small>
        </div>

        @if (DisplayItems != null && DisplayItems.Count > 0)
        {
            <div class="data-table-container">
                <table class="data-table">
                <thead>
                    <tr class="header-row">
                        <th class="col-no">No.</th>
                        <th class="col-code">Kode</th>
                        <th class="col-name">Nama Barang</th>
                        <th class="col-unit">Satuan</th>
                        <th class="col-qty">Qty</th>
                        <th class="col-po">PO</th>
                        <th class="col-so">SO</th>
                        <th class="col-total">Total</th>
                        <th class="col-opname-result">Hasil Stock</th>
                        <th class="col-opname-note">Keterangan</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in DisplayItems)
                    {
                        @if (item.IsDivisionHeader)
                        {
                            <tr class="division-header @(item.IsSelectedForPrinting ? "to-print" : "")">
                                <td colspan="10">
                                    @item.Divisi
                                    <span class="dontprint">
                                        <button type="button" class="btn btn-primary btn-sm @(item.IsSelectedForPrinting ? "btn-marked" : "")" title="Pilih atau batalkan cetak divisi" @onclick="@(() => ToggleRowsWithSameDivision(item.KodeDivisi))">Cetak</button>
                                    </span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="@(item.IsSelectedForPrinting ? "to-print" : "") @(item.HasHighlightedQty ? "highlight-row" : "")">
                                <td class="col-no">
                                    @item.RowNumber
                                    <span class="dontprint">
                                        <button type="button" class="btn btn-sm @(item.IsSelectedForPrinting ? "btn-marked btn-success" : "btn-outline-secondary")" aria-label="Pilih @item.ItemCode untuk cetak" aria-pressed="@item.IsSelectedForPrinting" @onclick="@(() => TogglePrintRow(item))">✓</button>
                                    </span>
                                </td>
                                 <td class="col-code">
                                    @item.ItemCode
                                    <button type="button" class="dontprint btn btn-info btn-sm" title="Cetak kartu stok kosong" aria-label="Cetak kartu stok kosong @item.ItemCode" @onclick="@(() => CetakStockCard(item.ItemCode,item.NamaItem,item.Satuan))"><span class="oi oi-print" aria-hidden="true"></span></button>
                                    <button type="button" class="dontprint btn btn-outline-primary btn-sm stock-detail-button" title="Lihat riwayat mutasi stok" aria-label="Lihat riwayat mutasi stok @item.ItemCode" @onclick="@(() => OpenStockHistory(item))"><span class="oi oi-list" aria-hidden="true"></span></button>
                                </td>
                                <td class="col-name" title="@item.Keterangan">
                                    @item.NamaItem
                                </td>
                                        <td class="col-unit">@item.Satuan</td>
                                        <td class="col-qty @item.QtyClass">
                                            @item.Qty.ToString("N")
                                            @if (item.HasLocationQty)
                                            {
                                                <button type="button" class="dontprint btn-lokasi @(item.ShowLocationQty ? "btn-lokasi-active" : "")" title="Lihat qty per lokasi" @onclick="@(() => ToggleLocationQty(item))">Lok</button>
                                            }
                                        </td>
                                        <td class="col-po">
                                            @item.QtyBeli.ToString("N")
                                            @if (item.HasPurchaseOrder)
                                            {
                                                <button type="button" class="dontprint btn btn-link btn-sm p-0 ms-1" title="Lihat detail PO" aria-label="Lihat detail PO aktif @item.ItemCode" @onclick="@(() => CicilanBeli(item.ItemCode))">&#x1F50D;</button>
                                            }
                                        </td>
                                        <td class="col-so">
                                            @item.QtyJual.ToString("N")
                                            @if (item.HasSalesOrder)
                                            {
                                                <button type="button" class="dontprint btn btn-link btn-sm p-0 ms-1" title="Lihat detail SO" aria-label="Lihat detail SO aktif @item.ItemCode" @onclick="@(() => CicilanJual(item.ItemCode))">&#x1F50D;</button>
                                            }
                                        </td>
                                        <td class="col-total @item.QtyOrderClass">@item.QtyOrder.ToString("N")</td>
                                        <td class="col-opname-result"></td>
                                        <td class="col-opname-note"></td>
                                     </tr>
                            @if (item.ShowLocationQty && item.LocationQtys != null)
                            {
                                <tr class="location-detail-row @(item.IsSelectedForPrinting ? "to-print" : "")">
                                    <td colspan="10">
                                        <span class="location-detail-label">Qty per Lokasi:</span>
                                        @foreach (var loc in item.LocationQtys.Where(l => l.Qty != 0))
                                        {
                                            <span class="location-chip" title="@loc.NamaLokasi">@loc.Lokasi: <strong>@loc.Qty.ToString("N")</strong></span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    }
                    <tr class="separator-row">
                        <td colspan="10">&nbsp;</td>
                    </tr>
                </tbody>
                </table>
            </div>
        }
    </div>

    <div style="margin-top: 20px;">
        <p id="print-date" class="print-date">Tanggal cetak: @DateTime.Now.ToString("dd-MM-yyyy HH:mm:ss")</p>
        <p>&nbsp;</p>
    </div>
}

@if (_historyItem != null)
{
    <div class="modal fade show stock-history-modal dontprint" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="stock-history-title" style="display:block">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="stock-history-title">Riwayat Mutasi Stok</h5>
                        <small class="text-muted">@_historyItem.ItemCode — @_historyItem.NamaItem</small>
                    </div>
                    <button type="button" class="btn-close" aria-label="Tutup" disabled="@_isLoadingHistory" @onclick="CloseStockHistory"></button>
                </div>
                <div class="modal-body">
                    <div class="stock-history-filters">
                        <div><label for="history-from" class="form-label">Dari tanggal</label><input id="history-from" type="date" class="form-control" @bind="_historyFrom" @bind:format="yyyy-MM-dd" disabled="@_isLoadingHistory" /></div>
                        <div><label for="history-to" class="form-label">Sampai tanggal</label><input id="history-to" type="date" class="form-control" @bind="_historyTo" @bind:format="yyyy-MM-dd" disabled="@_isLoadingHistory" /></div>
                        <button type="button" class="btn btn-primary" disabled="@_isLoadingHistory" @onclick="LoadStockHistory">Tampilkan</button>
                    </div>
                    @if (_isLoadingHistory)
                    {
                        <div class="text-center p-4" role="status" aria-live="polite"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span> Memuat riwayat mutasi...</div>
                    }
                    else if (!string.IsNullOrEmpty(_historyError))
                    {
                        <div class="alert alert-danger mt-3" role="alert">@_historyError</div>
                    }
                    else
                    {
                        <p class="text-muted mt-3" role="status">Riwayat periode @_loadedHistoryFrom.ToString("dd-MM-yyyy") s.d. @_loadedHistoryTo.ToString("dd-MM-yyyy"): @_stockHistory.Count baris, termasuk saldo awal.</p>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover stock-history-table">
                                <thead><tr><th>Tanggal</th><th>Dokumen</th><th>Keterangan</th><th class="text-end">Qty</th><th class="text-end">Saldo</th></tr></thead>
                                <tbody>
                                    @foreach (var transaction in _stockHistory)
                                    {
                                        <tr><td>@transaction.Tanggal.ToString("dd-MM-yyyy")</td><td>@transaction.Dokumen</td><td>@transaction.Keterangan</td><td class="text-end">@transaction.Qty.ToString("N")</td><td class="text-end">@transaction.Jumlah.ToString("N")</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" disabled="@_isLoadingHistory" @onclick="CloseStockHistory">Tutup</button></div>
            </div>
        </div>
    </div>
}

@if (dispCicilan)
{
    <ModalSearchComponent OnClose="OnSearchClose" Items="TransParsial" Context="transaksi2" Title="@_orderDetailTitle" GetFilterableText="@(item => $"{item.NamaVendor} {item.NoLpb} {item.Keterangan}")">
        <TableHeader>
            <th scope="col">Vendor</th>
            <th scope="col">Tanggal</th>
            <th scope="col">No. @_orderDetailType</th>
            <th scope="col">Keterangan</th>
            <th scope="col">Qty</th>
            <th scope="col">Harga</th>
            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>
                @transaksi2.NamaVendor
            </td>
            <td>
                @transaksi2.Tanggal.ToString("dd-MM-yyyy")
            </td>
            <td>
                @transaksi2.NoLpb
            </td>
            <td>
                @transaksi2.Keterangan
            </td>
            <td>
                @transaksi2.Qty
            </td>

            <td>
                @transaksi2.Harga
            </td>

            <td>

            </td>
        </RowTemplate>
         </ModalSearchComponent>
    }

    @code {

         public List<IcStockCardView> TransDetail = new List<IcStockCardView>();

    // PHASE 2: Display items includes division headers for proper grouping with virtualization
    public List<IcStockCardView> DisplayItems { get; set; } = new List<IcStockCardView>();

    public List<IcStockCardView> TransParsial = new List<IcStockCardView>();

    private string Title = "Laporan Stock";
    private string printMode = "normal"; // "normal" or "opname"

    private bool dispCicilan { get; set; }
    private string _orderDetailType;
    private string _orderDetailTitle;

    private bool printAllSelected = true;

    // OPTIMIZATION: Control render cycles
    private bool _shouldRender = true;
    private bool _isLoadingReport = true;
    private string _searchText = "";
    private string _orderFilter = "";
    private string _qtyFilter = "";
    private List<IcStockCardView> _allStock = new List<IcStockCardView>();
    private IcStockCardView _historyItem;
    private List<IcStockCardView> _stockHistory = new List<IcStockCardView>();
    private DateTime _historyFrom = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime _historyTo = DateTime.Today;
    private DateTime _loadedHistoryFrom;
    private DateTime _loadedHistoryTo;
    private bool _isLoadingHistory;
    private string _historyError;

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();

        try
        {
            await Task.Run(loadStock);
        }
        finally
        {
            _isLoadingReport = false;
            _shouldRender = true;
        }
    }

    /// <summary>
    /// OPTIMIZATION: Only render when necessary
    /// Prevents unnecessary re-renders and reduces bandwidth
    /// </summary>
    protected override bool ShouldRender() => _shouldRender;

    private void loadStock()
    {
        TransDetail = serviceIC.GetCurrentStock();
        TransDetail = serviceOrdJual.GetCurrentOrderJual(TransDetail);

        // Load stock per location once and index by item code for the expandable badge
        var qtyByLocation = serviceIC.GetAllIcItemQtyByLocation()
            .Where(x => !string.IsNullOrEmpty(x.ItemCode))
            .GroupBy(x => x.ItemCode)
            .ToDictionary(g => g.Key, g => g.First().Locations);

        // OPTIMIZATION: Pre-compute conditions once at load time
        foreach (var item in TransDetail)
        {
            item.HasPurchaseOrder = item.QtyBeli != 0;
            item.HasSalesOrder = item.QtyJual != 0;
            item.HasHighlightedQty = item.QtyJual != 0;
            item.QtyClass = item.Qty < 0 ? "qty-negative" : (item.Qty == 0 ? "qty-zero" : "");
            item.QtyOrderClass = item.QtyOrder < 0 ? "qty-negative" : (item.QtyOrder == 0 ? "qty-zero" : "");

            if (item.ItemCode != null && qtyByLocation.TryGetValue(item.ItemCode, out var locations))
            {
                item.LocationQtys = locations;
                item.HasLocationQty = locations != null && locations.Any(l => l.Qty != 0);
            }
        }

        _allStock = TransDetail;
        BuildDisplayItems();

        _shouldRender = true;
    }

    private void OnSearchTextChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        ApplySearch();
    }

    private void ClearSearch()
    {
        _searchText = string.Empty;
        ApplySearch();
    }

    private void OnOrderFilterChanged(ChangeEventArgs e)
    {
        _orderFilter = e.Value?.ToString() ?? "";
        ApplySearch();
    }

    private void OnQtyFilterChanged(ChangeEventArgs e)
    {
        _qtyFilter = e.Value?.ToString() ?? "";
        ApplySearch();
    }

    private void ApplySearch()
    {
        var terms = _searchText.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        TransDetail = _allStock.Where(x => terms.All(term =>
                (x.ItemCode?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.NamaItem?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.SearchTags?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (_orderFilter switch
            {
                "po" => x.HasPurchaseOrder,
                "so" => x.HasSalesOrder,
                "any" => x.HasPurchaseOrder || x.HasSalesOrder,
                "both" => x.HasPurchaseOrder && x.HasSalesOrder,
                "po-only" => x.HasPurchaseOrder && !x.HasSalesOrder,
                "so-only" => x.HasSalesOrder && !x.HasPurchaseOrder,
                "none" => !x.HasPurchaseOrder && !x.HasSalesOrder,
                _ => true
            }) &&
            (_qtyFilter switch
            {
                "positive" => x.Qty > 0,
                "zero" => x.Qty == 0,
                "negative" => x.Qty < 0,
                "non-positive" => x.Qty <= 0,
                _ => true
            })).ToList();

        BuildDisplayItems();

        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    /// <summary>
    /// PHASE 2: Builds display list including division headers
    /// This replaces the foreach logic in the template
    /// Handles division grouping with proper row numbering
    /// </summary>
    private void BuildDisplayItems()
    {
        DisplayItems = new List<IcStockCardView>();
        printAllSelected = TransDetail != null && TransDetail.Count > 0 && TransDetail.All(x => x.IsSelectedForPrinting);
        string lastDivision = null;
        int rowNumber = 1;

        if (TransDetail == null || TransDetail.Count == 0)
            return;

        foreach (var item in TransDetail)
        {
            // Add division header when division changes
            if (lastDivision != item.KodeDivisi)
            {
                lastDivision = item.KodeDivisi;
                rowNumber = 1;

                // Check if ANY item in this division is selected for printing
                bool hasPrintableChild = TransDetail.Any(x => 
                    x.KodeDivisi == item.KodeDivisi && 
                    !x.IsDivisionHeader && 
                    x.IsSelectedForPrinting);

                // Create virtual division header row
                DisplayItems.Add(new IcStockCardView
                {
                    IsDivisionHeader = true,
                    KodeDivisi = item.KodeDivisi,
                    Divisi = item.Divisi,
                    IsSelectedForPrinting = hasPrintableChild
                });
            }

            // Add data row
            item.RowNumber = rowNumber++;
            DisplayItems.Add(item);
        }
    }

    private void ToggleLocationQty(IcStockCardView item)
    {
        if (item == null || item.IsDivisionHeader)
            return;

        item.ShowLocationQty = !item.ShowLocationQty;

        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private async Task OpenStockHistory(IcStockCardView item)
    {
        _historyItem = item;
        await LoadStockHistory();
    }

    private async Task LoadStockHistory()
    {
        _shouldRender = true;
        if (_historyFrom.Date > _historyTo.Date)
        {
            _historyError = "Tanggal awal tidak boleh melebihi tanggal akhir.";
            return;
        }

        _historyError = null;
        _isLoadingHistory = true;
        StateHasChanged();
        await Task.Delay(50);

        try
        {
            _stockHistory = serviceLaporanStock.CetakMutasi(_historyFrom, _historyTo, _historyItem.ItemCode);
            _loadedHistoryFrom = _historyFrom;
            _loadedHistoryTo = _historyTo;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Gagal memuat mutasi stok: {ex}");
            _historyError = "Riwayat mutasi tidak dapat dimuat. Silakan coba lagi.";
        }
        finally
        {
            _isLoadingHistory = false;
            _shouldRender = true;
        }
    }

    private void CloseStockHistory()
    {
        _historyItem = null;
        _stockHistory.Clear();
        _historyError = null;
        _shouldRender = true;
    }

    private void CicilanBeli(string itemcode)
    {
        TransParsial = serviceOrdJual.GetListOrderAktif(itemcode, "71");
        _orderDetailType = "PO";
        _orderDetailTitle = $"Detail PO Aktif — {itemcode}";

        _shouldRender = true;
        dispCicilan = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void CicilanJual(string itemcode)
    {
        TransParsial = serviceOrdJual.GetListOrderAktif(itemcode, "76");
        _orderDetailType = "SO";
        _orderDetailTitle = $"Detail SO Aktif — {itemcode}";

        _shouldRender = true;
        dispCicilan = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void OnSearchClose(bool accepted)
    {
        _shouldRender = true;
        dispCicilan = false;
        StateHasChanged();
        _shouldRender = false;
    }

    private async Task PrintStockOpname()
    {
        // Set flag untuk CSS tahu mode opname saat print
        printMode = "opname";
        Title = "STOCK OPNAME";
        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;

        // Tunggu render selesai, baru trigger print
        await Task.Delay(200);
        await JSRuntime.InvokeVoidAsync("window.print");

        // Reset mode kembali ke normal setelah print dialog ditutup
        await Task.Delay(500);
        printMode = "normal";
        Title = "Laporan Stock";
        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void TogglePrintRow(IcStockCardView item)
    {
        if (item == null || item.IsDivisionHeader)
            return;

        // Toggle print state for this individual row
        item.IsSelectedForPrinting = !item.IsSelectedForPrinting;
        item.IsSubTitleSelectedForPrinting = item.IsSelectedForPrinting;
        printAllSelected = TransDetail.Count > 0 && TransDetail.All(x => x.IsSelectedForPrinting);
        var divisionHeader = DisplayItems.FirstOrDefault(x => x.IsDivisionHeader && x.KodeDivisi == item.KodeDivisi);
        if (divisionHeader != null)
            divisionHeader.IsSelectedForPrinting = TransDetail.Any(x => x.KodeDivisi == item.KodeDivisi && x.IsSelectedForPrinting);

        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void ToggleRowsWithSameDivision(string divisionCode)
    {
        // Find first item with this division to determine current state
        var firstItem = TransDetail.FirstOrDefault(x => x.KodeDivisi == divisionCode);
        bool newState = !(firstItem?.IsSelectedForPrinting ?? true);

        // Toggle all items in TransDetail for this division
        foreach (var item in TransDetail.Where(x => x.KodeDivisi == divisionCode && !x.IsDivisionHeader))
        {
            item.IsSelectedForPrinting = newState;
            item.IsSubTitleSelectedForPrinting = newState;
        }

        // Also update all items in DisplayItems for this division
        foreach (var item in DisplayItems.Where(x => x.KodeDivisi == divisionCode))
        {
            item.IsSelectedForPrinting = newState;
        }
        printAllSelected = TransDetail.Count > 0 && TransDetail.All(x => x.IsSelectedForPrinting);

        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void TogglePrintAll()
    {
        printAllSelected = !printAllSelected;

        // Toggle all rows in TransDetail
        foreach (var item in TransDetail)
        {
            item.IsSelectedForPrinting = printAllSelected;
        }

        // Also update DisplayItems (division headers and data rows)
        foreach (var item in DisplayItems)
        {
            item.IsSelectedForPrinting = printAllSelected;
        }

        _shouldRender = true;
        StateHasChanged();
        _shouldRender = false;
    }

    private void CetakStockCard(string kodeItem, string namaItem, string satuan)
    {
        string encodedNamaItem = Uri.EscapeDataString(namaItem);
        string encodedSatuan = Uri.EscapeDataString(satuan);
        string encodedKodeItem = Uri.EscapeDataString(kodeItem);

        navigationmanager.NavigateTo($"/ModulePrinting/stockCard?namaItem={encodedNamaItem}&satuanItem={encodedSatuan}&kodeItem={encodedKodeItem}");
    }

    private async Task ExportToExcel()
    {
        try
        {
            Console.WriteLine("ExportToExcel button clicked");
            _shouldRender = true;

            // Generate Excel file
            var excelStream = GenerateExcelWorkbook();

            // Create file name with date
            string fileName = $"LaporanStock_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            Console.WriteLine($"Excel file generated: {fileName}, Size: {excelStream.Length} bytes");

            // Trigger browser download
            using var streamRef = new DotNetStreamReference(stream: excelStream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            Console.WriteLine("Download invoked successfully");

            _shouldRender = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to Excel: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
            _shouldRender = false;
        }
    }

    private MemoryStream GenerateExcelWorkbook()
    {
        using (var workbook = new XLWorkbook())
        {
            var worksheet = workbook.Worksheets.Add("Stock Report");

            int rowNum = 1;

            // Add title
            var titleCell = worksheet.Cell(rowNum, 1);
            titleCell.Value = Title;
            titleCell.Style.Font.Bold = true;
            titleCell.Style.Font.FontSize = 14;
            titleCell.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            var titleRange = worksheet.Range(rowNum, 1, rowNum, 8);
            titleRange.Merge();
            titleRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            rowNum += 2;

            // Add header row
            var headerRow = rowNum;
            worksheet.Cell(rowNum, 1).Value = "No.";
            worksheet.Cell(rowNum, 2).Value = "Kode";
            worksheet.Cell(rowNum, 3).Value = "Nama Barang";
            worksheet.Cell(rowNum, 4).Value = "Satuan";
            worksheet.Cell(rowNum, 5).Value = "Qty";
            worksheet.Cell(rowNum, 6).Value = "PO";
            worksheet.Cell(rowNum, 7).Value = "SO";
            worksheet.Cell(rowNum, 8).Value = "Total";

            // Format header
            var headerRange = worksheet.Range(rowNum, 1, rowNum, 8);
            headerRange.Style.Font.Bold = true;
            headerRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            headerRange.Style.Fill.BackgroundColor = XLColor.DarkGray;
            headerRange.Style.Font.FontColor = XLColor.White;
            headerRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            headerRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;

            rowNum++;

            // Track row grouping for outline feature - per division
            int divisionHeaderRow = 0;
            int divisionFirstDataRow = 0;
            string currentDivision = null;
            int divisionItemCount = 0;

            // Add data rows grouped by division
            foreach (var item in DisplayItems)
            {
                // Only include rows marked for printing
                if (!item.IsSelectedForPrinting)
                    continue;

                if (item.IsDivisionHeader)
                {
                    // End previous group if exists - group ONLY data rows (exclude header)
                    if (currentDivision != null && divisionItemCount > 0 && divisionFirstDataRow > 0)
                    {
                        // Group dari first data row sampai row sebelum divisi baru
                        worksheet.Rows(divisionFirstDataRow, rowNum - 1).Group();
                    }

                    currentDivision = item.Divisi;
                    divisionHeaderRow = rowNum;
                    divisionFirstDataRow = 0;  // Reset, akan set saat item pertama
                    divisionItemCount = 0;

                    // Add division header row
                    var divisionCell = worksheet.Cell(rowNum, 1);
                    divisionCell.Value = item.Divisi;
                    divisionCell.Style.Font.Bold = true;
                    divisionCell.Style.Fill.BackgroundColor = XLColor.LightGray;
                    var divisionRange = worksheet.Range(rowNum, 1, rowNum, 8);
                    divisionRange.Merge();
                    divisionRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                    divisionRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;

                    rowNum++;
                }
                else
                {
                    // Set first data row marker untuk group
                    if (divisionFirstDataRow == 0)
                        divisionFirstDataRow = rowNum;

                    // Add data row
                    divisionItemCount++;
                    worksheet.Cell(rowNum, 1).Value = item.RowNumber;
                    worksheet.Cell(rowNum, 2).Value = item.ItemCode;
                    worksheet.Cell(rowNum, 3).Value = item.NamaItem;
                    worksheet.Cell(rowNum, 4).Value = item.Satuan;
                    worksheet.Cell(rowNum, 5).Value = item.Qty;
                    worksheet.Cell(rowNum, 6).Value = item.QtyBeli;
                    worksheet.Cell(rowNum, 7).Value = item.QtyJual;
                    worksheet.Cell(rowNum, 8).Value = item.QtyOrder;

                    // Color negative values red
                    if (item.Qty < 0) worksheet.Cell(rowNum, 5).Style.Font.FontColor = XLColor.Red;
                    if (item.QtyOrder < 0) worksheet.Cell(rowNum, 8).Style.Font.FontColor = XLColor.Red;

                    rowNum++;
                }
            }

            // End last group
            if (currentDivision != null && divisionItemCount > 0 && divisionFirstDataRow > 0)
            {
                worksheet.Rows(divisionFirstDataRow, rowNum - 1).Group();
            }

            if (rowNum > headerRow)
            {
                var reportRange = worksheet.Range(headerRow, 1, rowNum - 1, 8);
                reportRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
                reportRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;

                worksheet.Range(headerRow + 1, 5, rowNum - 1, 8)
                    .Style.NumberFormat.Format = "#,##0.00";
            }

            // Freeze top rows (title + spacer + header)
            worksheet.SheetView.FreezeRows(3);

            // Set column widths to match CSS
            worksheet.Column(1).Width = 6;    // No.
            worksheet.Column(2).Width = 12;   // Kode
            worksheet.Column(3).Width = 35;   // Nama Barang
            worksheet.Column(4).Width = 10;   // Satuan
            worksheet.Column(5).Width = 12;   // Qty
            worksheet.Column(6).Width = 12;   // PO
            worksheet.Column(7).Width = 12;   // SO
            worksheet.Column(8).Width = 12;   // Total

            // Save workbook to stream
            var stream = new MemoryStream();
            workbook.SaveAs(stream);
            stream.Position = 0;
            return stream;
        }
    }
}
