@page "/ModulePersediaan/LaporanPersediaan"

@using Accounting.Services
@using eSoft.Persediaan.Model
@using eSoft.Persediaan.View
@using eSoft.Persediaan.Services

@using eSoft.Penjualan.Model
@using eSoft.Penjualan.View
@using eSoft.Penjualan.Services

@using eSoft.Pembelian.Model
@using eSoft.Pembelian.View
@using eSoft.Pembelian.Services

@using eSoft.LaporanStock.Services
@using Microsoft.AspNetCore.Components.Web

@inject IExcelServices serviceXL
@inject IJSRuntime JS

@inject IInventoryServices   serviceIC
@inject ISalesServices   serviceOE
@inject IPurchaseServices   serviceIR
@inject ILaporanStockServices  services

@inject NavigationManager navigationmanager

<link rel="stylesheet" href="css/laporan-persediaan.css" />

<h3>Laporan Persediaan</h3>

<!-- Date Range & Display Buttons Section -->
<div class="card card-default mb-3">
    <div class="card-body">
        <div class="row align-items-end">
            <!-- Date Range Inputs -->
            <div class="col-lg-3">
                <div class="laporan-form-group">
                    <label class="form-label">Dari Tanggal</label>
                    <InputDate class="form-control" @bind-Value="Tanggal1" />
                </div>
            </div>

            <div class="col-lg-3">
                <div class="laporan-form-group">
                    <label class="form-label">Sd Tanggal</label>
                    <InputDate class="form-control" @bind-Value="Tanggal2" />
                </div>
            </div>

            <!-- Display Mode Buttons -->
            <div class="col-lg-6">
                <div class="btn-group-wrapper">
                    <button class="btn btn-outline-primary" @onclick="@(() => proses1())" title="Tampilkan mutasi per item">
                        <span class="oi oi-list"></span> Display Mutasi
                    </button>
                    <button class="btn btn-outline-primary" @onclick="@(() => proses2())" title="Tampilkan qty per lokasi">
                        <span class="oi oi-map"></span> Display Lokasi
                    </button>
                </div>
            </div>
        </div>

        <!-- Export Buttons Section -->
        <div class="row mt-3 pt-2 border-top">
            <div class="col-12">
                <label class="form-label d-block mb-2"><small class="text-muted">📊 Rekap Stock & Export</small></label>
                <button class="btn btn-outline-primary btn-sm me-2" @onclick="@(() => proses3())" title="Tampilkan rekap stock">
                    <span class="oi oi-spreadsheet"></span> Display Rekap
                </button>
                <button class="btn btn-success btn-sm me-2" @onclick="DownloadRekapToExcel">
                    <span class="oi oi-cloud-download"></span> Export Rekap to Excel
                </button>
                <button class="btn btn-success btn-sm" @onclick="DownloadRekapPjlSlsToExcel">
                    <span class="oi oi-cloud-download"></span> Export (PJL vs SLS)
                </button>
            </div>
        </div>
    </div>
</div>

<div class="br-spacer"></div>

@switch (Tampilan)
{
    case 1:
        <div class="container">
            <DataGridLaporanStockComponent Items="TransItem" OnDetail="OpenDetail" PrintDetail="printDetail"></DataGridLaporanStockComponent>
        </div>
        @if (DetailOpen)
        {
            <ModalSearchComponent OnClose="OnSearchClose" Items="TransDetail" Context="transaksi2" GetFilterableText="@(item => $"{item.ItemCode} {item.Keterangan} {item.Dokumen} ")">
                <TableHeader>
                    <th class="modal-table-col-dokumen">Dokumen</th>
                    <th class="modal-table-col-keterangan">Keterangan</th>
                    <th class="modal-table-col-qty">Qty</th>
                    <th class="modal-table-col-cost">Cost</th>
                    <th class="modal-table-col-balance">Balance</th>
                    <th class="modal-table-col-total">Total</th>
                    <th></th>
                </TableHeader>
                <RowTemplate>
                    <td class="modal-table-col-dokumen">
                        @transaksi2.Dokumen
                        <br />
                        <span class="table-badge">@transaksi2.Tanggal.ToShortDateString()</span>
                    </td>
                    <td class="modal-table-col-keterangan">@transaksi2.Keterangan</td>
                    <td class="modal-table-col-qty">@transaksi2.Qty.ToString("N")</td>
                    <td class="modal-table-col-cost">@transaksi2.Cost.ToString("N")</td>
                    <td class="modal-table-col-balance">@transaksi2.Jumlah.ToString("N")</td>
                    <td class="modal-table-col-total">@transaksi2.CostJumlah.ToString("N")</td>
                </RowTemplate>
            </ModalSearchComponent>
        }
        break;

    case 2:
        <div class="container">
            <DataGridLaporanLokasiQtyComponent Items="TransItemLokasi"></DataGridLaporanLokasiQtyComponent>
        </div>
        break;

    case 3:
        <div class="container">
            <DataGridComponent Items="TransRekap"
                               GetFilterableText="@(item => $"{item.ItemCode} {item.NamaItem}")"
                               GetRowStyle="@(item => item.QtyAwal < 0 || item.QtyAkhir < 0 ? "rekap-row-negative" : "")">

                <TableHeader>
                    <th class="rekap-col-itemcode">ItemCode</th>
                    <th class="rekap-col-name">Keterangan</th>
                    <th class="rekap-col-qty">Qty</th>
                    <th class="rekap-col-cost">Cost</th>
                    <th class="rekap-col-masuk-qty">Masuk</th>
                    <th class="rekap-col-masuk-cost">Masuk</th>
                    <th class="rekap-col-keluar-qty">Keluar</th>
                    <th class="rekap-col-keluar-cost">Keluar</th>
                    <th class="rekap-col-adjust-qty">Adjust</th>
                    <th class="rekap-col-adjust-cost">Adjust</th>
                    <th class="rekap-col-total-qty">Total</th>
                    <th class="rekap-col-total-cost">Total</th>
                </TableHeader>

                <RowTemplate>
                    <td class="rekap-col-itemcode">@context.ItemCode</td>
                    <td class="rekap-col-name">@context.NamaItem</td>
                    <td class="rekap-col-qty">@context.QtyAwal.ToString("N")</td>
                    <td class="rekap-col-cost">@context.SaldoAwal.ToString("N")</td>
                    <td class="rekap-col-masuk-qty">@context.QtyMasuk.ToString("N")</td>
                    <td class="rekap-col-masuk-cost">@context.SaldoMasuk.ToString("N")</td>
                    <td class="rekap-col-keluar-qty">@context.QtyKeluar.ToString("N")</td>
                    <td class="rekap-col-keluar-cost">@context.SaldoKeluar.ToString("N")</td>
                    <td class="rekap-col-adjust-qty">@context.QtyAdjust.ToString("N")</td>
                    <td class="rekap-col-adjust-cost">@context.SaldoAdjust.ToString("N")</td>
                    <td class="rekap-col-total-qty">@context.QtyAkhir.ToString("N")</td>
                    <td class="rekap-col-total-cost">@context.SaldoAkhir.ToString("N")</td>
                </RowTemplate>
            </DataGridComponent>
        </div>
        break;

}

@code {

    private List<IcStockCardView> TransDetail = new();
    private List<IcItem> TransItem = new();
    private List<IcItemQtyByLocationView> TransItemLokasi = new();
    private List<IcRekapStock> TransRekap = new();

    // Cache untuk detail mutasi per ItemCode
    private Dictionary<string, List<IcStockCardView>> _detailCache = new();
    private string _loadingItemCode = null;
    private bool _isLoadingDetail = false;

    private string nCount { get; set; }
    private string nOngkir { get; set; }
    private string nJumlah { get; set; }
    private string nPPn { get; set; }

    public IcStockCardView transh = new IcStockCardView();

    public int Tampilan { get; set; } = 1;
    private int _lastTampilan = 1;

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }
    public bool DetailOpen { get; set; }
    public bool DetailOpen2 { get; set; }
    public bool DetailOpen3 { get; set; }

    public DateTime Tanggal1 { get; set; }
    public DateTime Tanggal2 { get; set; }

    private bool _shouldRender = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Tanggal2 = DateTime.Today;
        Tanggal1 = DateTime.Today;
    }

    protected override bool ShouldRender()
    {
        var shouldRender = _shouldRender;
        _shouldRender = true;
        return shouldRender;
    }

    private void OnSearchClose(bool accepted)
    {
        DetailOpen = false;
        DetailOpen2 = false;
        DetailOpen3 = false;
        _shouldRender = true;
    }

    private void proses1()
    {
        if (Tampilan == 1 && TransItem.Count > 0)
            return;

        TransItem = serviceIC.GetIcItem(false);
        Tampilan = 1;
        _lastTampilan = 1;
        _shouldRender = true;
    }

    private async Task OpenDetail(IcItem xKdBank)
    {
        // Cek cache dulu
        if (_detailCache.ContainsKey(xKdBank.ItemCode))
        {
            TransDetail = _detailCache[xKdBank.ItemCode];
            DetailOpen = !DetailOpen;
            _shouldRender = true;
            return;
        }

        // Jika tidak ada di cache, load dengan showing loading state
        _isLoadingDetail = true;
        _loadingItemCode = xKdBank.ItemCode;
        _shouldRender = true;

        try
        {
            // Async call, biar UI tidak blocking
            await Task.Run(() =>
            {
                TransDetail = services.CetakMutasi(Tanggal1, Tanggal2, xKdBank.ItemCode);
                _detailCache[xKdBank.ItemCode] = TransDetail;
            });
        }
        finally
        {
            _isLoadingDetail = false;
            _loadingItemCode = null;
        }

        DetailOpen = !DetailOpen;
        _shouldRender = true;
    }

    private void printDetail(IcItem xKdBank)
    {
        string words = xKdBank.ItemCode + '+' + Tanggal1.ToString("yyyy-MM-dd") + '+' + Tanggal2.ToString("yyyy-MM-dd");
        navigationmanager.NavigateTo($"/ModulePrinting/Kartustock/{words}");
        _shouldRender = false;
    }

    private void proses2()
    {
        if (Tampilan == 2 && TransItemLokasi.Count > 0)
            return;

        TransItemLokasi = serviceIC.GetAllIcItemQtyByLocation();
        Tampilan = 2;
        _lastTampilan = 2;
        _shouldRender = true;
    }

    private void proses3()
    {
        if (Tampilan == 3 && TransRekap.Count > 0)
            return;

        TransRekap = services.RekapStock(Tanggal1, Tanggal2);
        Tampilan = 3;
        _lastTampilan = 3;
        _shouldRender = true;
    }

    private async Task DownloadRekapToExcel()
    {
        try
        {
            var data = TransRekap.Count == 0 ? services.RekapStock(Tanggal1, Tanggal2) : TransRekap;
            var bytes = serviceXL.CreateRekapStockWorksheet(data);
            using var ms = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream: ms);
            var fileName = $"RekapStock_{Tanggal1:yyyy-MM-dd}_{Tanggal2:yyyy-MM-dd}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export error: {ex.Message}");
        }
        _shouldRender = false;
    }

    private async Task DownloadRekapPjlSlsToExcel()
    {
        try
        {
            var data = TransRekap.Count == 0 ? services.RekapStock(Tanggal1, Tanggal2) : TransRekap;
            var bytes = serviceXL.CreateRekapStockPjlSlsPpnWorksheet(data, Tanggal1, Tanggal2);
            using var ms = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream: ms);
            var fileName = $"RekapStock_PJL_SLS_PPN_{Tanggal1:yyyy-MM-dd}_{Tanggal2:yyyy-MM-dd}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export error: {ex.Message}");
        }
        _shouldRender = false;
    }
}
