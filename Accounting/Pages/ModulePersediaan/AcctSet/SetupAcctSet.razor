@page "/ModulePersediaan/SetupAcctSet"
@using eSoft.Persediaan.Model
@using eSoft.Persediaan.Services

@inject IInventoryServices cashBank
@implements IDisposable
@inject NavigationManager navigationmanager

<div class="container">
    <h1>Setup Account Set</h1>
</div>


<div class="container">
    <NavLink href="/ModulePersediaan/AddAcctSet" class="btn btn-primary">Add</NavLink>
</div>

<br />
<br />

<div class="container">
    <DataGridComponent Items="SortedBanks" Context="cbBank" GetFilterableText="@(item =>$"{item.AcctSet} {item.Description}")">
        <TableHeader>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcAcct.AcctSet)))" @onclick='() => ApplySort(nameof(IcAcct.AcctSet))'>Code <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcAcct.AcctSet))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcAcct.Description)))" @onclick='() => ApplySort(nameof(IcAcct.Description))'>Description <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcAcct.Description))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcAcct.Acct1)))" @onclick='() => ApplySort(nameof(IcAcct.Acct1))'>IC Control <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcAcct.Acct1))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcAcct.Acct2)))" @onclick='() => ApplySort(nameof(IcAcct.Acct2))'>Adjustment <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcAcct.Acct2))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcAcct.Acct3)))" @onclick='() => ApplySort(nameof(IcAcct.Acct3))'>Account 3 <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcAcct.Acct3))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcAcct.Acct4)))" @onclick='() => ApplySort(nameof(IcAcct.Acct4))'>Account 4 <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcAcct.Acct4))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcAcct.Acct5)))" @onclick='() => ApplySort(nameof(IcAcct.Acct5))'>Account 5 <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcAcct.Acct5))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(IcAcct.Acct6)))" @onclick='() => ApplySort(nameof(IcAcct.Acct6))'>Account 6 <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(IcAcct.Acct6))</span></button></th>
            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@cbBank.AcctSet</td>
            <td>@cbBank.Description</td>
            <td>@cbBank.Acct1</td>
            <td>@cbBank.Acct2</td>
            <td>@cbBank.Acct3</td>
            <td>@cbBank.Acct4</td>
            <td>@cbBank.Acct5</td>
            <td>@cbBank.Acct6</td>
            <td>
                <button @onclick="() => OpenRubah(cbBank.IcAcctId)" class="btn btn-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                    </svg>
                </button>
                <button @onclick="() => OpenDeleteDialog(cbBank)" class="btn btn-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                    </svg>
                </button>
            </td>
        </RowTemplate>
    </DataGridComponent>


</div>

@if (DeleteDialogOpen)
{
    <ModalDialogComponent Title="Are you sure?" Text="Do you want to delete this entry?" OnClose="OnDeleteDialogClose"></ModalDialogComponent>
}

@if (NullDialogOpen)
{
    <ModalDialogComponent Title="MESSAGE" Text="Saldo is not Zero" TombolSave="false" OnClose="OnDeleteNullClose"></ModalDialogComponent>
}



@code {

    private List<IcAcct> Banks;
    private IcAcct _bankToDelete;
    private string currentSortColumn = nameof(IcAcct.AcctSet);
    private bool sortAscending = true;

    private IEnumerable<IcAcct> SortedBanks => ApplyCurrentSort(Banks ?? new List<IcAcct>());

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadGet();

    }


    private void LoadGet()
    {
        Banks = cashBank.GetIcAcct();
    }

    private void ApplySort(string columnName)
    {
        if (string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            sortAscending = !sortAscending;
            return;
        }

        currentSortColumn = columnName;
        sortAscending = true;
    }

    private IEnumerable<IcAcct> ApplyCurrentSort(IEnumerable<IcAcct> source)
    {
        return currentSortColumn switch
        {
            nameof(IcAcct.Description) => OrderBy(source, x => x.Description),
            nameof(IcAcct.Acct1) => OrderBy(source, x => x.Acct1),
            nameof(IcAcct.Acct2) => OrderBy(source, x => x.Acct2),
            nameof(IcAcct.Acct3) => OrderBy(source, x => x.Acct3),
            nameof(IcAcct.Acct4) => OrderBy(source, x => x.Acct4),
            nameof(IcAcct.Acct5) => OrderBy(source, x => x.Acct5),
            nameof(IcAcct.Acct6) => OrderBy(source, x => x.Acct6),
            _ => OrderBy(source, x => x.AcctSet)
        };
    }

    private IEnumerable<IcAcct> OrderBy<TKey>(IEnumerable<IcAcct> source, Func<IcAcct, TKey> keySelector)
    {
        return sortAscending ? source.OrderBy(keySelector) : source.OrderByDescending(keySelector);
    }

    private string GetSortButtonClass(string columnName)
    {
        return string.Equals(currentSortColumn, columnName, StringComparison.Ordinal) ? "active" : string.Empty;
    }

    private string GetSortIndicator(string columnName)
    {
        if (!string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            return "↕";
        }

        return sortAscending ? "↑" : "↓";
    }


    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {
            await cashBank.DelIcAcct(_bankToDelete.IcAcctId);
            _bankToDelete = null;
        }

        DeleteDialogOpen = false;
        LoadGet();

        StateHasChanged();

    }

    private void OnDeleteNullClose(bool accepted)
    {
        //if (accepted)
        //{
        //    await cashBank.DelBank(_bankToDelete.CbBankId);
        //    _bankToDelete = null;
        //}

        DeleteDialogOpen = false;
        NullDialogOpen = false;
        LoadGet();
        StateHasChanged();

    }
    private void OpenDeleteDialog(IcAcct bank)
    {

        DeleteDialogOpen = true;



        _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenRubah(int xKdBank)
    {
        navigationmanager.NavigateTo($"/ModulePersediaan/EditAcctSet/{xKdBank}");
    }


    public void Dispose()
    {

    }
}
