@page "/"
@using Accounting.Services;
@using eSoft.CashBank.Model
@using eSoft.CashBank.Services
@using eSoft.Hutang.Services
@using eSoft.Hutang.View
@using eSoft.Penjualan.Model
@using eSoft.Penjualan.Services
@using eSoft.Penjualan.View
@using eSoft.Piutang.View
@using eSoft.Piutang.Services
@using eSoft.Order.Model
@using eSoft.Order.Services



@implements IDisposable
@inject IAdministrationServices service
@inject ICashBankServices serviceBank
@inject IPayableServices serviceAP
@inject IReceivableServices serviceAR
@inject ISalesServices serviceSales
@inject IOrderSalesServices serviceOrderSales
@inject NavigationManager navigationmanager


<div class="dashboard-shell">
    <section class="dashboard-hero dashboard-hero-bmapt @(isHeroCollapsed ? "dashboard-hero-collapsed" : string.Empty)">
        <div>
            <div class="dashboard-hero-title-row">
                <div>
                    <span class="dashboard-kicker">Dashboard</span>
                    <h1>BMA Group Executive Dashboard</h1>
                </div>
                <button type="button" class="btn btn-sm btn-outline-light dashboard-toggle-light" @onclick="ToggleHeroCollapse">
                    @(isHeroCollapsed ? "Tampilkan header" : "Sembunyikan header")
                </button>
            </div>

            @if (!isHeroCollapsed)
            {
                <p class="dashboard-lead">Tampilan dashboard ini disusun mengikuti pola BMA-PT: ringkasan KPI utama, perbandingan piutang dan hutang, posisi saldo bank, serta shortcut operasional yang langsung bisa dipakai.</p>
            }
        </div>

        @if (!isHeroCollapsed)
        {
            <div class="dashboard-hero-meta">
                <div class="dashboard-refresh-card">
                    <span class="dashboard-refresh-label">Last refresh</span>
                    <strong>@GetLastRefreshLabel()</strong>
                </div>
                <div class="dashboard-hero-badges">
                    <span class="dashboard-badge">Bank</span>
                    <span class="dashboard-badge">Piutang</span>
                    <span class="dashboard-badge">Hutang</span>
                    <span class="dashboard-badge">Penjualan</span>
                </div>
            </div>
        }
    </section>

    <AuthorizeView Roles="Admin, Finance">
        <section class="dashboard-kpi-grid">
            <article class="dashboard-kpi-card dashboard-kpi-primary">
                <div class="dashboard-kpi-icon"><span class="oi oi-briefcase"></span></div>
                <div>
                    <span class="dashboard-kpi-label">Total Saldo Bank</span>
                    <h2>@totalSaldoBank.ToString("N0")</h2>
                    <p>@bankList.Count rekening aktif</p>
                </div>
            </article>

            <article class="dashboard-kpi-card dashboard-kpi-success">
                <div class="dashboard-kpi-icon"><span class="oi oi-dollar"></span></div>
                <div>
                    <span class="dashboard-kpi-label">Total Piutang</span>
                    <h2>@totalPiutang.ToString("N0")</h2>
                    <p>@jumlahDokPiutang dokumen receivable</p>
                </div>
            </article>

            <article class="dashboard-kpi-card dashboard-kpi-danger">
                <div class="dashboard-kpi-icon"><span class="oi oi-credit-card"></span></div>
                <div>
                    <span class="dashboard-kpi-label">Total Hutang</span>
                    <h2>@totalHutangRp.ToString("N0")</h2>
                    <p>@jumlahDokHutang dokumen payable</p>
                </div>
            </article>

            <article class="dashboard-kpi-card dashboard-kpi-neutral">
                <div class="dashboard-kpi-icon"><span class="oi oi-pulse"></span></div>
                <div>
                    <span class="dashboard-kpi-label">Selisih Net</span>
                    <h2>@((totalPiutang - totalHutangRp).ToString("N0"))</h2>
                    <p>@(totalPiutang >= totalHutangRp ? "Piutang lebih besar" : "Hutang lebih besar")</p>
                </div>
            </article>
        </section>

        <section class="dashboard-analytics-grid">
            <article class="dashboard-panel-card">
                <div class="dashboard-panel-header-row">
                    <h2><span class="oi oi-bar-chart"></span> Aging Piutang</h2>
                    <a href="/ModulePiutang/AgingPiutangDashboard" class="btn btn-sm btn-outline-primary">Open detail</a>
                </div>
                <div class="dashboard-aging-list">
                    <div class="dashboard-aging-item">
                        <div class="dashboard-aging-label-row"><span>Current</span><strong>@arCurrent.ToString("N0")</strong></div>
                        <div class="progress dashboard-progress"><div class="progress-bar bg-success" style="width: @(GetPercent(arCurrent, arMax))%;"></div></div>
                    </div>
                    <div class="dashboard-aging-item">
                        <div class="dashboard-aging-label-row"><span>1 - 30 Hari</span><strong>@ar30.ToString("N0")</strong></div>
                        <div class="progress dashboard-progress"><div class="progress-bar bg-info" style="width: @(GetPercent(ar30, arMax))%;"></div></div>
                    </div>
                    <div class="dashboard-aging-item">
                        <div class="dashboard-aging-label-row"><span>31 - 60 Hari</span><strong>@ar60.ToString("N0")</strong></div>
                        <div class="progress dashboard-progress"><div class="progress-bar bg-warning" style="width: @(GetPercent(ar60, arMax))%;"></div></div>
                    </div>
                    <div class="dashboard-aging-item">
                        <div class="dashboard-aging-label-row"><span>61 - 90 Hari</span><strong>@ar90.ToString("N0")</strong></div>
                        <div class="progress dashboard-progress"><div class="progress-bar bg-danger" style="width: @(GetPercent(ar90, arMax))%;"></div></div>
                    </div>
                    <div class="dashboard-aging-item">
                        <div class="dashboard-aging-label-row"><span>&gt; 90 Hari</span><strong>@arOver.ToString("N0")</strong></div>
                        <div class="progress dashboard-progress"><div class="progress-bar bg-dark" style="width: @(GetPercent(arOver, arMax))%;"></div></div>
                    </div>
                </div>
            </article>

            <article class="dashboard-panel-card">
                <div class="dashboard-panel-header-row">
                    <h2><span class="oi oi-arrow-circle-bottom"></span> Aging Hutang</h2>
                    <a href="/ModuleHutang/LaporanAgingHutang" class="btn btn-sm btn-outline-primary">Open detail</a>
                </div>
                <div class="dashboard-aging-list">
                    <div class="dashboard-aging-item">
                        <div class="dashboard-aging-label-row"><span>Current</span><strong>@apCurrent.ToString("N0")</strong></div>
                        <div class="progress dashboard-progress"><div class="progress-bar bg-success" style="width: @(GetPercent(apCurrent, apMax))%;"></div></div>
                    </div>
                    <div class="dashboard-aging-item">
                        <div class="dashboard-aging-label-row"><span>1 - 30 Hari</span><strong>@ap30.ToString("N0")</strong></div>
                        <div class="progress dashboard-progress"><div class="progress-bar bg-info" style="width: @(GetPercent(ap30, apMax))%;"></div></div>
                    </div>
                    <div class="dashboard-aging-item">
                        <div class="dashboard-aging-label-row"><span>31 - 60 Hari</span><strong>@ap60.ToString("N0")</strong></div>
                        <div class="progress dashboard-progress"><div class="progress-bar bg-warning" style="width: @(GetPercent(ap60, apMax))%;"></div></div>
                    </div>
                    <div class="dashboard-aging-item">
                        <div class="dashboard-aging-label-row"><span>61 - 90 Hari</span><strong>@ap90.ToString("N0")</strong></div>
                        <div class="progress dashboard-progress"><div class="progress-bar bg-danger" style="width: @(GetPercent(ap90, apMax))%;"></div></div>
                    </div>
                    <div class="dashboard-aging-item">
                        <div class="dashboard-aging-label-row"><span>&gt; 90 Hari</span><strong>@apOver.ToString("N0")</strong></div>
                        <div class="progress dashboard-progress"><div class="progress-bar bg-dark" style="width: @(GetPercent(apOver, apMax))%;"></div></div>
                    </div>
                    @if (jumlahDokValas > 0)
                    {
                        <div class="dashboard-warning-note">
                            <span class="oi oi-info"></span> Hutang telah dikonversi ke rupiah untuk @jumlahDokValas dokumen valas.
                        </div>
                    }
                </div>
            </article>

            <article class="dashboard-panel-card">
                <div class="dashboard-panel-header-row">
                    <h2><span class="oi oi-graph"></span> Piutang vs Hutang</h2>
                    <span class="dashboard-pill">Kurs sudah diperhitungkan</span>
                </div>
                <div class="dashboard-aging-item">
                    <div class="dashboard-aging-label-row"><span>Piutang</span><strong>@totalPiutang.ToString("N0")</strong></div>
                    <div class="progress dashboard-progress dashboard-progress-lg"><div class="progress-bar bg-success" style="width: @(GetPercent(totalPiutang, Math.Max(totalPiutang, totalHutangRp)))%;">@GetPercent(totalPiutang, Math.Max(totalPiutang, totalHutangRp))%</div></div>
                </div>
                <div class="dashboard-aging-item">
                    <div class="dashboard-aging-label-row"><span>Hutang</span><strong>@totalHutangRp.ToString("N0")</strong></div>
                    <div class="progress dashboard-progress dashboard-progress-lg"><div class="progress-bar bg-danger" style="width: @(GetPercent(totalHutangRp, Math.Max(totalPiutang, totalHutangRp)))%;">@GetPercent(totalHutangRp, Math.Max(totalPiutang, totalHutangRp))%</div></div>
                </div>
                <div class="dashboard-comparison @(totalPiutang >= totalHutangRp ? "dashboard-comparison-positive" : "dashboard-comparison-negative")">
                    <strong>Selisih: @((totalPiutang - totalHutangRp).ToString("N0"))</strong>
                    <span class="badge @(totalPiutang >= totalHutangRp ? "bg-success" : "bg-danger")">@(totalPiutang >= totalHutangRp ? "Piutang Lebih Besar" : "Hutang Lebih Besar")</span>
                </div>
            </article>
        </section>

        <section class="dashboard-bank-panel dashboard-panel-card">
            <div class="dashboard-panel-header-row">
                <div>
                    <h2><span class="oi oi-spreadsheet"></span> Saldo Per Rekening Bank</h2>
                    <p class="dashboard-section-note">@bankList.Count rekening aktif dengan total saldo @totalSaldoBank.ToString("N0")</p>
                </div>
                <div class="dashboard-panel-actions">
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ToggleBankPanelCollapse">
                        @(isBankPanelCollapsed ? "Tampilkan saldo" : "Sembunyikan saldo")
                    </button>
                    <a href="/ModuleBank/LaporanCashBank" class="btn btn-sm btn-outline-primary">View report</a>
                </div>
            </div>
            @if (!isBankPanelCollapsed)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 dashboard-bank-table">
                        <thead>
                            <tr>
                                <th>Kode Bank</th>
                                <th>Nama Bank</th>
                                <th style="text-align:right">Saldo</th>
                                <th style="width:30%">Proporsi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bank in bankList)
                            {
                                var bankPct = totalSaldoBank != 0 ? Math.Abs(bank.Saldo / totalSaldoBank * 100) : 0;
                                <tr>
                                    <td><span class="badge bg-primary">@bank.KodeBank</span></td>
                                    <td>@bank.NmBank</td>
                                    <td style="text-align:right"><strong class="@(bank.Saldo >= 0 ? "text-primary" : "text-warning")">@bank.Saldo.ToString("N0")</strong></td>
                                    <td>
                                        <div class="progress dashboard-progress dashboard-progress-sm">
                                            <div class="progress-bar @(bank.Saldo >= 0 ? "bg-primary" : "bg-warning")" style="@($"width:{bankPct:N0}%;")">@bankPct.ToString("N1")%</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="dashboard-collapsed-state dashboard-collapsed-state-compact">
                    <span class="oi oi-chevron-bottom"></span>
                    <span>Panel saldo rekening disembunyikan agar quick menu lebih cepat terlihat.</span>
                </div>
            }
        </section>
    </AuthorizeView>

    <section class="dashboard-shortcuts-section dashboard-panel-card">
        <div class="dashboard-panel-header-row">
            <div>
                <span class="dashboard-section-kicker">Quick access</span>
                <h2>Menu utama per modul</h2>
                <p class="dashboard-section-note">Setiap modul menampilkan child menu penting agar akses laporan dan menu utama lebih cepat.</p>
            </div>
        </div>

        <div class="dashboard-shortcuts-grid dashboard-shortcuts-grid-bmapt">
            <article class="dashboard-shortcut-card dashboard-shortcut-card-stock">
                <div class="dashboard-shortcut-module-header">
                    <span class="oi oi-layers dashboard-shortcut-icon"></span>
                    <div class="dashboard-shortcut-header">
                        <h3>Inventory</h3>
                        <p>Akses cepat laporan stock dan persediaan.</p>
                    </div>
                </div>
                <div class="dashboard-shortcut-actions">
                    <a href="/ModulePersediaan/LaporanCurrentStock" class="btn btn-outline-primary">Laporan Stock</a>
                    <a href="/ModulePersediaan/LaporanPersediaan" class="btn btn-outline-primary">Laporan Persediaan</a>
                </div>
            </article>

            <article class="dashboard-shortcut-card dashboard-shortcut-card-sales">
                <div class="dashboard-shortcut-module-header">
                    <span class="oi oi-cart dashboard-shortcut-icon"></span>
                    <div class="dashboard-shortcut-header">
                        <h3>Penjualan</h3>
                        <p>Ringkasan laporan penjualan yang paling sering dipakai.</p>
                    </div>
                </div>
                <div class="dashboard-shortcut-actions">
                    <a href="/ModuleJual/LaporanPenjualan" class="btn btn-outline-primary">Laporan Penjualan</a>
                    <a href="/ModuleJual/LaporanJualPerCustomer" class="btn btn-outline-primary">Per Customer</a>
                    <a href="/ModuleJual/LaporanJualPertahun" class="btn btn-outline-primary">Per Tahun</a>
                </div>
            </article>

            <article class="dashboard-shortcut-card dashboard-shortcut-card-bank">
                <div class="dashboard-shortcut-module-header">
                    <span class="oi oi-briefcase dashboard-shortcut-icon"></span>
                    <div class="dashboard-shortcut-header">
                        <h3>Cash Bank</h3>
                        <p>Masuk ke laporan saldo dan rekap kas bank.</p>
                    </div>
                </div>
                <div class="dashboard-shortcut-actions">
                    <a href="/ModuleBank/LaporanCashBank" class="btn btn-outline-primary">Laporan Cash Bank</a>
                </div>
            </article>

            <article class="dashboard-shortcut-card dashboard-shortcut-card-ar">
                <div class="dashboard-shortcut-module-header">
                    <span class="oi oi-dollar dashboard-shortcut-icon"></span>
                    <div class="dashboard-shortcut-header">
                        <h3>Piutang</h3>
                        <p>Akses aging, laporan piutang, dan forecast.</p>
                    </div>
                </div>
                <div class="dashboard-shortcut-actions">
                    <a href="/ModulePiutang/AgingPiutangDashboard" class="btn btn-outline-primary">Aging Dashboard</a>
                    <a href="/ModulePiutang/LaporanPiutang" class="btn btn-outline-primary">Laporan Piutang</a>
                    <a href="/ModulePiutang/LaporanForecastPiutang" class="btn btn-outline-primary">Forecast Piutang</a>
                </div>
            </article>

            <article class="dashboard-shortcut-card dashboard-shortcut-card-ap">
                <div class="dashboard-shortcut-module-header">
                    <span class="oi oi-credit-card dashboard-shortcut-icon"></span>
                    <div class="dashboard-shortcut-header">
                        <h3>Hutang</h3>
                        <p>Akses aging dan laporan hutang vendor.</p>
                    </div>
                </div>
                <div class="dashboard-shortcut-actions">
                    <a href="/ModuleHutang/LaporanAgingHutang" class="btn btn-outline-primary">Aging Hutang</a>
                    <a href="/ModuleHutang/LaporanHutang" class="btn btn-outline-primary">Laporan Hutang</a>
                </div>
            </article>

            <article class="dashboard-shortcut-card dashboard-shortcut-card-purchase">
                <div class="dashboard-shortcut-module-header">
                    <span class="oi oi-basket dashboard-shortcut-icon"></span>
                    <div class="dashboard-shortcut-header">
                        <h3>Pembelian</h3>
                        <p>Laporan pembelian dan order currency.</p>
                    </div>
                </div>
                <div class="dashboard-shortcut-actions">
                    <a href="/ModuleBeli/LaporanPembelian" class="btn btn-outline-primary">Laporan Pembelian</a>
                    <a href="/ModuleBeli/LaporanOrderCurrency" class="btn btn-outline-primary">Laporan Item/Order</a>
                </div>
            </article>
        </div>
    </section>
</div>

<AuthorizeView Roles="Admin, Finance">
    <section class="dashboard-data-section dashboard-panel-card dashboard-lazy-panel">
        <div class="dashboard-section-header dashboard-section-header-stack">
            <div>
                <span class="dashboard-section-kicker">Activity queue</span>
                <h2>Transaksi operasional</h2>
                <p class="dashboard-section-note">Bagian ini dibuat lazy load agar dashboard awal tetap ringan saat diakses.</p>
            </div>
            <button type="button" class="btn btn-outline-primary dashboard-toggle-btn" @onclick="ToggleOperationalSectionAsync">
                @(showOperationalSection ? "Sembunyikan detail" : "Tampilkan detail operasional")
            </button>
        </div>

        @if (showOperationalSection)
        {
            @if (isOperationalDataLoading)
            {
                <div class="dashboard-loading-state">
                    <span class="oi oi-loop-circular"></span>
                    <span>Memuat data operasional...</span>
                </div>
            }
            else
            {
                <div class="dashboard-section-note-row">
                    <span class="dashboard-pill">@TransHeader.Count transaksi siap ditinjau</span>
                    <span class="dashboard-subtle-text">Detail dimuat hanya saat diperlukan.</span>
                </div>

                <section class="dashboard-data-section">
                    <div class="dashboard-section-header">
                        <div>
                            <span class="dashboard-section-kicker">Activity queue</span>
                            <h2>Transaksi pengiriman aktif</h2>
                        </div>
                    </div>

                    <div class="dashboard-grid-card">
                    <DataGridVerticalComponent Items="TransHeader"
                                               Context="transaksi"
                                               GetFilterableText="@(item =>$"{item.NoLpb} {item.NamaCust} {item.Keterangan}")"
                                               TotalEnabled=false
                                               SearchEnabled=false>

            <TableHeader>

                <th scope="col" style="width:15%">No Bukti</th>
                <th scope="col" style="width:20%">Customer</th>

                <th scope="col" style="width:20%">Keterangan</th>
                <th scope="col" style="width:40%">Kurir</th>


                <th scope="col" style="width:5%"></th>
            </TableHeader>
            <RowTemplate>
                @if (transaksi.Kode != "76")

                {

                    <td style="width:15%; background-color:@(transaksi.Jumlah == 0 ? "yellow" : "")">
                        @transaksi.NoLpb
                        <br />
                        <span class="badge bg-primary">@transaksi.Tanggal.ToShortDateString()</span>
                        <br />
                        <span class="badge bg-success">@transaksi.NoPrj</span>
                    </td>
                    <td style="width:20%;background-color:@(transaksi.Jumlah == 0 ? "yellow" : "")">@transaksi.NamaCust</td>

                    <td style="width:20%;background-color:@(transaksi.Jumlah == 0 ? "yellow" : "")">@transaksi.Keterangan</td>
                    <td style="width:40%;text-align:right;background-color:@(transaksi.Jumlah == 0 ? "yellow" : "")">

                        @*<SearchInputSelectComponent Items="kurirs" Context="transaksi2" GetFilterableText="@(item =>$"{item.Kurir}")">
                    <BindTemplate>
                    @transaksi2.Kurir
                    </BindTemplate>
                    <OptionTemplate>
                    <option value="@transaksi2.Kurir">[@transaksi2.Kurir]&nbsp; @transaksi2.NamaKurir</option>
                    </OptionTemplate>

                    </SearchInputSelectComponent>*@
                        <select class="form-control" @bind="transaksi.Kurir" style="width:60%; display:inline">
                            <option value="">&nbsp;&nbsp;---Select Kurir---&nbsp;&nbsp;</option>
                            @foreach (var item in kurirs)
                            {
                                <option value="@item.Kurir">[@item.Kurir]&nbsp; @item.NamaKurir</option>
                            }

                        </select>

                        <select class="form-control" @bind="transaksi.Salesman" style="width:60%; display:inline">
                            <option value="">&nbsp;&nbsp;---Select Salesman---&nbsp;&nbsp;</option>
                            @foreach (var item in salesmans)
                            {
                                <option value="@item.Salesman">[@item.Salesman]&nbsp; @item.NamaSales</option>
                            }

                        </select>
                        @*   <button class="btn btn-primary" type="button" @onclick="@(()=> SearchOpen = !SearchOpen)">Cari</button>*@

                    </td>



                    <td style="width:5%;background-color:@(transaksi.Jumlah == 0 ? "yellow" : "")">

                        <button @onclick="() => OpenDeleteDialog(transaksi)" class="btn btn-danger">

                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-save" viewBox="0 0 16 16">
                                <path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z" />
                            </svg>
                        </button>
                        <button @onclick="() => OpenPrint(transaksi.OeTransHId)" class="btn btn-info">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-printer" viewBox="0 0 16 16">
                                <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z" />
                                <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2H5zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1z" />
                            </svg>
                        </button>
                        <button @onclick="() => OpenDetail3(transaksi.Customer)" class="btn btn-success">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrows-expand" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13A.5.5 0 0 1 1 8zM7.646.146a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 1.707V5.5a.5.5 0 0 1-1 0V1.707L6.354 2.854a.5.5 0 1 1-.708-.708l2-2zM8 10a.5.5 0 0 1 .5.5v3.793l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 0 1 .708-.708L7.5 14.293V10.5A.5.5 0 0 1 8 10z" />
                            </svg>

                        </button>
                    </td>

                }
            </RowTemplate>
                    </DataGridVerticalComponent>
                    </div>
                </section>


                <section class="dashboard-data-section">
                    <div class="dashboard-section-header">
                        <div>
                            <span class="dashboard-section-kicker">Sales order</span>
                            <h2>Order yang belum diproses</h2>
                        </div>
                    </div>

                    <div class="dashboard-grid-card">
                    <DataGridVerticalComponent Items="TransHeader"
                                               Context="transaksi"
                                               GetFilterableText="@(item =>$"{item.NoLpb} {item.NamaCust} {item.Keterangan}")"
                                               TotalEnabled=false
                                               SearchEnabled=false>

            <TableHeader>

                <th scope="col" style="width:15%">No Bukti</th>
                <th scope="col" style="width:20%">Customer</th>

                <th scope="col" style="width:20%">Keterangan</th>
                <th scope="col" style="width:40%">Kurir</th>


                <th scope="col" style="width:5%"></th>
            </TableHeader>
            <RowTemplate>
                @if (transaksi.Kode == "76")
                {
                    <td style="width:15%; background-color:@(transaksi.Jumlah == 0 ? "lemonchiffon" : "lemonchiffon")">
                        @transaksi.NoLpb
                        <br />
                        <span class="badge bg-primary">@transaksi.Tanggal.ToShortDateString()</span>
                        <br />
                        <span class="badge bg-success">@transaksi.NoPrj</span>
                    </td>
                    <td style="width:20%;background-color:@(transaksi.Jumlah == 0 ? "lemonchiffon" : "lemonchiffon")">@transaksi.NamaCust</td>

                    <td style="width:20%;background-color:@(transaksi.Jumlah == 0 ? "lemonchiffon" : "lemonchiffon")">@transaksi.Keterangan</td>
                    <td style="width:40%;text-align:right;background-color:@(transaksi.Jumlah == 0 ? "lemonchiffon" : "lemonchiffon")"> </td>
                   



                    <td style="width:5%;background-color:@(transaksi.Jumlah == 0 ? "lemonchiffon" : "lemonchiffon")">


                        <button @onclick="() => OpenPrintOrder(transaksi.OeTransHId)" class="btn btn-info">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-printer" viewBox="0 0 16 16">
                                <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z" />
                                <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2H5zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1z" />
                            </svg>
                        </button>
                    </td>
                }

            </RowTemplate>
                    </DataGridVerticalComponent>
                    </div>
                </section>
            }
        }
        else
        {
            <div class="dashboard-collapsed-state">
                <span class="oi oi-chevron-bottom"></span>
                <span>Klik tombol di atas bila perlu melihat transaksi aktif dan sales order.</span>
            </div>
        }
    </section>
</AuthorizeView>

