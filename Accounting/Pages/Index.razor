@page "/"
@using Accounting.Services;
@using eSoft.CashBank.Model
@using eSoft.CashBank.Services
@using eSoft.Hutang.Services
@using eSoft.Hutang.View
@using eSoft.Penjualan.Model
@using eSoft.Penjualan.Services
@using eSoft.Penjualan.View
@using eSoft.Piutang.View
@using eSoft.Piutang.Services
@using eSoft.Order.Model
@using eSoft.Order.Services



@implements IDisposable
@inject IAdministrationServices service
@inject ICashBankServices serviceBank
@inject IPayableServices serviceAP
@inject IReceivableServices serviceAR
@inject ISalesServices serviceSales
@inject IOrderSalesServices serviceOrderSales
@inject NavigationManager navigationmanager

<!-- Header dengan toggle Home/Dashboard -->
<div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
    <div>
        <h2>@AppBranding.CompanyName</h2>
        <p>Menu Utama</p>
    </div>
    <div style="gap: 10px; display: flex;">
        <button class="btn @(isShowDashboard ? "btn-outline-primary" : "btn-primary")" @onclick="() => isShowDashboard = false">
            Home
        </button>
        <button class="btn @(isShowDashboard ? "btn-primary" : "btn-outline-primary")" @onclick="ShowDashboardAsync">
            Dashboard
        </button>
    </div>
</div>

@if (!isShowDashboard)
{
    <!-- HOME VIEW: Module cards -->
    <div class="row">
    <AuthorizeView Roles="Admin, Finance">
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-layers"></span> Inventory
                    </h5>
                    <p class="card-text">Laporan stock dan persediaan.</p>
                    <div class="btn-group-wrap">
                        <a href="/ModulePersediaan/LaporanCurrentStock" class="btn btn-primary btn-sm">Laporan Stock</a>
                        <a href="/ModulePersediaan/LaporanPersediaan" class="btn btn-primary btn-sm">Laporan Persediaan</a>
                    </div>
                </div>
            </div>
        </div>
    </AuthorizeView>

    <AuthorizeView Roles="Admin, Finance">
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-cart"></span> Penjualan
                    </h5>
                    <p class="card-text">Ringkasan laporan penjualan.</p>
                    <div class="btn-group-wrap">
                        <a href="/ModuleJual/LaporanPenjualan" class="btn btn-primary btn-sm">Laporan Penjualan</a>
                        <a href="/ModuleJual/LaporanJualPerCustomer" class="btn btn-primary btn-sm">Per Customer</a>
                        <a href="/ModuleJual/LaporanJualPertahun" class="btn btn-primary btn-sm">Per Tahun</a>
                    </div>
                </div>
            </div>
        </div>
    </AuthorizeView>

    <AuthorizeView Roles="Admin, Finance">
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-list-rich"></span> Sales Order
                    </h5>
                    <p class="card-text">Order penjualan dan pengecekan stok.</p>
                    <div class="btn-group-wrap">
                        <a href="/ModuleJual/TransOrderJual" class="btn btn-primary btn-sm">Order Penjualan</a>
                        <a href="/ModuleJual/CekStockSalesOrder" class="btn btn-primary btn-sm">Cek Stock SO</a>
                    </div>
                </div>
            </div>
        </div>
    </AuthorizeView>
</div>

<div class="row">
    &emsp;
</div>

<div class="row">
    <AuthorizeView Roles="Admin, Finance">
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-dollar"></span> Piutang
                    </h5>
                    <p class="card-text">Aging dan laporan receivable.</p>
                    <div class="btn-group-wrap">
                        <a href="/ModulePiutang/LaporanAgingPiutang" class="btn btn-primary btn-sm">Aging Receivable</a>
                        <a href="/ModulePiutang/LaporanPiutang" class="btn btn-primary btn-sm">Laporan Piutang</a>
                    </div>
                </div>
            </div>
        </div>
    </AuthorizeView>

    <AuthorizeView Roles="Admin, Finance">
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-briefcase"></span> Bank and Cash
                    </h5>
                    <p class="card-text">Kas bank dan rekap saldo.</p>
                    <div class="btn-group-wrap">
                        <a href="/ModuleBank/LaporanCashBank" class="btn btn-primary btn-sm">Laporan Kas Bank</a>
                        <a href="/ModuleBank/SourceBank" class="btn btn-primary btn-sm">Laporan per Kode</a>
                    </div>
                </div>
            </div>
        </div>
    </AuthorizeView>

    <AuthorizeView Roles="Admin, Finance">
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-credit-card"></span> Hutang
                    </h5>
                    <p class="card-text">Aging dan laporan payable.</p>
                    <div class="btn-group-wrap">
                        <a href="/ModuleHutang/LaporanAgingHutang" class="btn btn-primary btn-sm">Aging Payable</a>
                        <a href="/ModuleHutang/LaporanHutang" class="btn btn-primary btn-sm">Laporan Hutang</a>
                    </div>
                </div>
            </div>
        </div>
    </AuthorizeView>
</div>

<div class="row">
    &emsp;
</div>

<div class="row">
    <AuthorizeView Roles="Admin, Finance">
        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="oi oi-basket"></span> Pembelian
                    </h5>
                    <p class="card-text">Laporan pembelian dan order.</p>
                    <div class="btn-group-wrap">
                        <a href="/ModuleBeli/LaporanPembelian" class="btn btn-primary btn-sm">Laporan Pembelian</a>
                        <a href="/ModuleBeli/LaporanOrderCurrency" class="btn btn-primary btn-sm">Laporan Item/Order</a>
                    </div>
                </div>
            </div>
        </div>
    </AuthorizeView>
</div>

<!-- Sales & Order Transactions Section -->
<section style="margin-top: 30px;">
    <div style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
        <div>
            <h4 style="margin-bottom: 5px;">Penjualan Menunggu Kurir</h4>
            <span class="badge bg-warning text-dark">
                <span class="oi oi-alert"></span> Belum Terisi Kurir
            </span>
        </div>
        <button class="btn btn-outline-primary btn-sm ms-auto" @onclick="() => showTransactionDetailAsync()">
            @(showTransactionDetail ? "Sembunyikan Detail" : "Tampilkan Detail")
        </button>
    </div>

    @if (showTransactionDetail)
    {
        @if (isLoadingTransactions)
        {
            <div class="alert alert-info">Memuat data transaksi...</div>
        }
        else if (TransHeader != null && TransHeader.Count > 0)
        {
            <div class="card" style="margin-top: 15px;">
                <div class="card-body">
                    <h5>Daftar Penjualan Menunggu Assign Kurir</h5>
                    <p class="text-muted small mb-3">
                        <span class="oi oi-info"></span> Transaksi di bawah belum memiliki kurir yang ditugaskan. Silakan assign kurir untuk melanjutkan pengiriman.
                    </p>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>No Bukti</th>
                                    <th>Tanggal</th>
                                    <th>Customer</th>
                                    <th>Keterangan</th>
                                    <th>Tipe</th>
                                    <th>Summary</th>
                                    <th style="width: 200px;">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trans in TransHeader)
                                {
                                    var summary = GetTransactionSummary(trans.NoLpb);
                                    <tr>
                                        <td>@trans.NoLpb</td>
                                        <td>@trans.Tanggal.ToShortDateString()</td>
                                        <td>@trans.NamaCust</td>
                                        <td>@trans.Keterangan</td>
                                        <td>
                                            @if (trans.Kode == "76")
                                            {
                                                <span class="badge bg-info">Sales Order</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Penjualan</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted d-block">
                                                Qty: <span class="badge bg-primary text-white">@summary.TotalQty.ToString("N0")</span>
                                            </small>
                                            @if (summary.TotalJumlah > 0)
                                            {
                                                <small class="text-muted d-block">
                                                    Jml: <span class="badge bg-info text-dark">@summary.TotalJumlah.ToString("N0")</span>
                                                </small>
                                            }
                                            @if (summary.TotalPpn > 0)
                                            {
                                                <small class="text-muted d-block">
                                                    PPN: <span class="badge bg-warning text-dark">@summary.TotalPpn.ToString("N0")</span>
                                                </small>
                                            }
                                            @if (summary.TotalOngkos > 0)
                                            {
                                                <small class="text-muted d-block">
                                                    Ongkir: <span class="badge bg-secondary text-white">@summary.TotalOngkos.ToString("N0")</span>
                                                </small>
                                            }
                                            @if (summary.GrandTotal > 0)
                                            {
                                                <small class="text-success fw-bold d-block">
                                                    Total: @summary.GrandTotal.ToString("N0")
                                                </small>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenAssignKurirDialog(trans)">
                                                <span class="oi oi-person"></span> Assign Kurir
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenDetail3(trans.NoLpb)">
                                                <span class="oi oi-layers"></span> Detail
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Modal Assign Kurir & Salesman -->
            @if (showAssignKurirModal && selectedTransaction != null)
            {
                <div class="modal-backdrop fade show" style="display:block; z-index: 1040; position: fixed; top: 0; left: 0; width: 100%; height: 100%;" @onclick="() => CloseAssignKurirModal()"></div>

                <div class="modal fade show" tabindex="-1" role="dialog" style="display:block; z-index: 1050; position: fixed; top: 0; left: 0; width: 100%; height: 100%; padding: 0; margin: 0; overflow-y: auto;">
                    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document" style="margin: 30px auto; max-height: calc(100vh - 60px); margin-top: 2rem;">
                        <div class="modal-content">
                            <div class="modal-header alert-primary">
                                <h5 class="modal-title">
                                    <span class="oi oi-pencil"></span> Assign Kurir & Salesman - @selectedTransaction.NoLpb
                                </h5>
                                <button type="button" class="close" aria-label="Close" @onclick="() => CloseAssignKurirModal()">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <p class="text-muted"><strong>No Bukti:</strong> @selectedTransaction.NoLpb</p>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label fw-bold">Pilih Kurir</label>
                                            <select class="form-control" @onchange="(e) => selectedTransaction.Kurir = e.Value?.ToString()">
                                                <option value="">-- Pilih Kurir --</option>
                                                @foreach (var kurir in kurirs)
                                                {
                                                    <option value="@kurir.Kurir">@kurir.NamaKurir</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label fw-bold">Pilih Salesman</label>
                                            <select class="form-control" @onchange="(e) => selectedTransaction.Salesman = e.Value?.ToString()">
                                                <option value="">-- Pilih Salesman --</option>
                                                @foreach (var salesman in salesmans)
                                                {
                                                    <option value="@salesman.Salesman">@salesman.NamaSales</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">Catatan (Opsional)</label>
                                    <textarea class="form-control" rows="2" @bind="selectedTransaction.Keterangan" placeholder="Tambahkan catatan atau instruksi khusus"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-success" @onclick="() => SaveKurirAndSalesman()">
                                    <span class="oi oi-check"></span> Simpan & Cetak
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="() => CloseAssignKurirModal()">
                                    <span class="oi oi-x"></span> Batal
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-success">
                <span class="oi oi-check"></span> Semua penjualan sudah terisi kurir. Tidak ada yang menunggu pengiriman.
            </div>
        }
    }
</section>
}
else
{
    <!-- DASHBOARD VIEW: Financial Summary (PT Style) -->
    <section class="dashboard-hero mb-4">
        <div>
            <span class="dashboard-eyebrow">Ringkasan Operasional</span>
            <h3 class="mb-2">
                <span class="oi oi-dashboard" aria-hidden="true"></span> Dashboard Keuangan
            </h3>
            <p class="dashboard-hero-copy mb-0">Pantau posisi kas, piutang, hutang, dan aging schedule dalam satu tampilan yang lebih ringkas.</p>
        </div>
        @if (isLoaded)
        {
            <div class="dashboard-status-card">
                <span class="dashboard-status-label">Status Data</span>
                <strong class="dashboard-status-value">@GetLastRefreshLabel()</strong>
                <span class="dashboard-status-caption">@bankList.Count rekening, @jumlahDokPiutang piutang, @jumlahDokHutang hutang</span>
            </div>
        }
    </section>

    @if (isDashboardLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Memuat data dashboard...</p>
        </div>
    }
    else
    {
        <!-- ROW 1: Summary Cards -->
        <div class="row g-3 mb-4">
            <!-- Card: Total Saldo Bank -->
            <div class="col-lg-4 col-md-6">
                <div class="card dashboard-card border-0 shadow-sm h-100 summary-card summary-card-bank">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted text-uppercase small fw-bold mb-1">Total Saldo Bank</h6>
                                <h3 class="fw-bold text-primary mb-0">@totalSaldoBank.ToString("N0")</h3>
                                <small class="text-muted">@bankList.Count rekening aktif</small>
                            </div>
                            <div class="dashboard-icon bg-primary bg-opacity-10 text-primary">
                                <span class="oi oi-dollar"></span>
                            </div>
                        </div>
                        <hr class="my-2" />
                        <a href="/ModuleBank/LaporanCashBank" class="text-decoration-none small">
                            <span class="oi oi-arrow-right"></span> Lihat Detail Bank
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card: Total Piutang -->
            <div class="col-lg-4 col-md-6">
                <div class="card dashboard-card border-0 shadow-sm h-100 summary-card summary-card-piutang">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted text-uppercase small fw-bold mb-1">Total Piutang</h6>
                                <h3 class="fw-bold text-success mb-0">@totalPiutang.ToString("N0")</h3>
                                <small class="text-muted">@jumlahDokPiutang dokumen outstanding</small>
                            </div>
                            <div class="dashboard-icon bg-success bg-opacity-10 text-success">
                                <span class="oi oi-arrow-circle-top"></span>
                            </div>
                        </div>
                        <hr class="my-2" />
                        <a href="/ModulePiutang/LaporanAgingPiutang" class="text-decoration-none small">
                            <span class="oi oi-arrow-right"></span> Lihat Aging Piutang
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card: Total Hutang (sudah konversi kurs) -->
            <div class="col-lg-4 col-md-6">
                <div class="card dashboard-card border-0 shadow-sm h-100 summary-card summary-card-hutang">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted text-uppercase small fw-bold mb-1">Total Hutang (Rp)</h6>
                                <h3 class="fw-bold text-danger mb-0">@totalHutangRp.ToString("N0")</h3>
                                <small class="text-muted">@jumlahDokHutang dokumen outstanding</small>
                                @if (jumlahDokValas > 0)
                                {
                                    <br />
                                    <span class="badge bg-warning text-dark mt-1">
                                        <span class="oi oi-globe"></span> @jumlahDokValas dok valas (konversi kurs)
                                    </span>
                                }
                            </div>
                            <div class="dashboard-icon bg-danger bg-opacity-10 text-danger">
                                <span class="oi oi-arrow-circle-bottom"></span>
                            </div>
                        </div>
                        <hr class="my-2" />
                        <a href="/ModuleHutang/LaporanAgingHutang" class="text-decoration-none small">
                            <span class="oi oi-arrow-right"></span> Lihat Aging Hutang
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 2: Gauge - Net Position & Comparison -->
        <div class="row g-3 mb-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 dashboard-panel">
                    <div class="card-header bg-white fw-bold dashboard-panel-header">
                        <span class="oi oi-bar-chart"></span> Posisi Keuangan Bersih
                    </div>
                    <div class="card-body text-center">
                        @{
                            var netPosition = totalSaldoBank + totalPiutang - totalHutangRp;
                            var netClass = netPosition >= 0 ? "text-success" : "text-danger";
                            var netLabel = netPosition >= 0 ? "SURPLUS" : "DEFISIT";
                        }
                        <div class="gauge-container mb-3">
                            <div class="gauge-circle @(netPosition >= 0 ? "gauge-positive" : "gauge-negative")">
                                <div class="gauge-value">
                                    <small class="d-block text-muted">@netLabel</small>
                                    <strong class="@netClass" style="font-size: 1.3rem;">@netPosition.ToString("N0")</strong>
                                </div>
                            </div>
                        </div>
                        <div class="row text-center mt-3">
                            <div class="col-4">
                                <small class="text-muted d-block">Bank</small>
                                <strong class="text-primary">@totalSaldoBank.ToString("N0")</strong>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">+ Piutang</small>
                                <strong class="text-success">@totalPiutang.ToString("N0")</strong>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">- Hutang (Rp)</small>
                                <strong class="text-danger">@totalHutangRp.ToString("N0")</strong>
                            </div>
                        </div>
                        @if (jumlahDokValas > 0)
                        {
                            <div class="alert alert-warning small mt-2 mb-0 py-1 px-2">
                                <span class="oi oi-info"></span> Hutang sudah dikonversi ke Rupiah (ada @jumlahDokValas dok mata uang asing)
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Piutang vs Hutang Comparison Bar -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 dashboard-panel">
                    <div class="card-header bg-white fw-bold dashboard-panel-header">
                        <span class="oi oi-graph"></span> Perbandingan Piutang vs Hutang
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-2"><span class="oi oi-info"></span> Semua nilai dalam Rupiah (hutang valas sudah dikonversi kurs)</p>
                        @{
                            var maxVal = Math.Max(totalPiutang, totalHutangRp);
                            var piutangPct = maxVal > 0 ? (int)(totalPiutang / maxVal * 100) : 0;
                            var hutangPct = maxVal > 0 ? (int)(totalHutangRp / maxVal * 100) : 0;
                        }
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-bold text-success">Piutang (Receivable)</span>
                                <span class="fw-bold">@totalPiutang.ToString("N0")</span>
                            </div>
                            <div class="progress" style="height: 25px;">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @(piutangPct)%;" aria-valuenow="@piutangPct"
                                     aria-valuemin="0" aria-valuemax="100">
                                    @(piutangPct)%
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-bold text-danger">Hutang (Payable) - Rp</span>
                                <span class="fw-bold">@totalHutangRp.ToString("N0")</span>
                            </div>
                            <div class="progress" style="height: 25px;">
                                <div class="progress-bar bg-danger" role="progressbar"
                                     style="width: @(hutangPct)%;" aria-valuenow="@hutangPct"
                                     aria-valuemin="0" aria-valuemax="100">
                                    @(hutangPct)%
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 p-2 rounded @(totalPiutang >= totalHutangRp ? "bg-success" : "bg-danger") bg-opacity-10 text-center">
                            <strong>Selisih: @((totalPiutang - totalHutangRp).ToString("N0"))</strong>
                            <span class="badge @(totalPiutang >= totalHutangRp ? "bg-success" : "bg-danger") ms-2">
                                @(totalPiutang >= totalHutangRp ? "Piutang Lebih Besar" : "Hutang Lebih Besar")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 3: Bank Detail -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm dashboard-panel">
                    <div class="card-header bg-white fw-bold dashboard-panel-header">
                        <span class="oi oi-spreadsheet"></span> Saldo Per Rekening Bank
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Kode Bank</th>
                                        <th>Nama Bank</th>
                                        <th style="text-align:right">Saldo</th>
                                        <th style="width:30%">Proporsi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bank in bankList)
                                    {
                                        var bankPct = totalSaldoBank != 0 ? Math.Abs(bank.Saldo / totalSaldoBank * 100) : 0;
                                        var barColor = bank.Saldo >= 0 ? "bg-primary" : "bg-warning";
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary">@bank.KodeBank</span>
                                            </td>
                                            <td>@bank.NmBank</td>
                                            <td style="text-align:right">
                                                <strong class="@(bank.Saldo >= 0 ? "text-primary" : "text-warning")">
                                                    @bank.Saldo.ToString("N0")
                                                </strong>
                                            </td>
                                            <td>
                                                <div class="progress" style="height: 18px;">
                                                    <div class="progress-bar @barColor" role="progressbar"
                                                         style="width: @((int)bankPct)%;">
                                                        @bankPct.ToString("N1")%
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-primary">
                                    <tr>
                                        <td colspan="2"><strong>TOTAL</strong></td>
                                        <td style="text-align:right"><strong>@totalSaldoBank.ToString("N0")</strong></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 4: Aging Piutang & Hutang -->
        <div class="row g-3 mb-4">
            <!-- Aging Piutang -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 dashboard-panel">
                    <div class="card-header bg-white fw-bold dashboard-panel-header">
                        <span class="oi oi-clock"></span> Aging Piutang
                    </div>
                    <div class="card-body">
                        @if (agingPiutang != null && agingPiutang.Count > 0)
                        {
                            <div class="aging-bar-group">
                                @AgingBar("Current", arCurrent, arMax, "bg-success")
                                @AgingBar("31-60 hari", ar30, arMax, "bg-info")
                                @AgingBar("61-90 hari", ar60, arMax, "bg-warning")
                                @AgingBar("91-120 hari", ar90, arMax, "bg-orange")
                                @AgingBar("> 120 hari", arOver, arMax, "bg-danger")
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">Tidak ada data aging piutang</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Aging Hutang (konversi Rp) -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100 dashboard-panel">
                    <div class="card-header bg-white fw-bold dashboard-panel-header">
                        <span class="oi oi-clock"></span> Aging Hutang <small class="text-muted fw-normal">(dalam Rp)</small>
                    </div>
                    <div class="card-body">
                        @if (agingHutang != null && agingHutang.Count > 0)
                        {
                            <div class="aging-bar-group">
                                @AgingBar("Current", apCurrent, apMax, "bg-success")
                                @AgingBar("31-60 hari", ap30, apMax, "bg-info")
                                @AgingBar("61-90 hari", ap60, apMax, "bg-warning")
                                @AgingBar("91-120 hari", ap90, apMax, "bg-orange")
                                @AgingBar("> 120 hari", apOver, apMax, "bg-danger")
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">Tidak ada data aging hutang</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 5: Quick Links -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm dashboard-panel">
                    <div class="card-header bg-white fw-bold dashboard-panel-header">
                        <span class="oi oi-link-intact"></span> Akses Cepat
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-lg-3 col-md-6">
                                <a href="/ModuleBank/LaporanCashBank" class="btn btn-outline-primary w-100 py-3 quick-link-btn">
                                    <span class="oi oi-dollar d-block mb-1" style="font-size:1.5rem"></span>
                                    Laporan Kas Bank
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a href="/ModulePiutang/LaporanAgingPiutang" class="btn btn-outline-success w-100 py-3 quick-link-btn">
                                    <span class="oi oi-arrow-circle-top d-block mb-1" style="font-size:1.5rem"></span>
                                    Aging Piutang
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a href="/ModuleHutang/LaporanAgingHutang" class="btn btn-outline-danger w-100 py-3 quick-link-btn">
                                    <span class="oi oi-arrow-circle-bottom d-block mb-1" style="font-size:1.5rem"></span>
                                    Aging Hutang
                                </a>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <a href="/ModulePiutang/LaporanPiutang" class="btn btn-outline-warning w-100 py-3 quick-link-btn">
                                    <span class="oi oi-target d-block mb-1" style="font-size:1.5rem"></span>
                                    Laporan Piutang
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

