            </td>

            <td style="text-align:right">@transaksi2.Qty.ToString("N")</td>
            <td style="text-align:right">@transaksi2.Harga.ToString("N")</td>
            <td style="text-align:right">@transaksi2.Persen.ToString("N")</td>
            <td style="text-align:right">@transaksi2.Jumlah.ToString("N")</td>
            <td>@transaksi2.Lokasi</td>
        </RowTemplate>
    </ModalDetailJualComponent>
}

@code {

    private List<OeTransH> TransHeader;
    private OeTransH _bankToDelete;
    public bool DeleteDialogOpen { get; set; }
    public string textAlert { get; set; } = "Transaction Already Posting";
    public string textDelete { get; set; } = "Do you want to delete this entry?";
    private List<OeKurir> kurirs;
    private List<OeSalesman> salesmans;

    private List<PoTransH> poTransh;
    public List<OeTrans> TransDetail2;

    public bool NullDialogOpen { get; set; }
    public bool DetailOpen3 { get; set; }

    string currentUri;
    protected override void OnInitialized()
    {
        // base.OnInitialized();
        currentUri = navigationmanager.Uri;

        LoadCek();
        LoadGet();

        LoadKurirs();
        LoadSalesmans();

    }


    private void LoadCek()
    {
       service.SeedUserRole();
    }

    void LoadpoTransAktif()
    {

        poTransh = serviceOrderSales.GetTransHAktif();

    }

    public void Dispose()
    {
        // GC.SuppressFinalize(this);
    }

    private void LoadGet()
    {

        TransHeader = serviceSales.GetTransKurir();
        LoadpoTransAktif();
        foreach (var aktif in poTransh)
        {
            TransHeader.Add(
                new OeTransH()
                    {
                        OeTransHId = aktif.PoTransHId,
                        Tanggal = aktif.Tanggal,
                        Kode = aktif.Kode,
                        NoLpb = aktif.NoLpb,
                        NoPrj = aktif.NoPrj,
                        Customer = aktif.Vendor,
                        NamaCust = aktif.NamaVendor,
                        Keterangan = aktif.Keterangan
                    }
            );
        }
        StateHasChanged();
    }

    private void OpenPrint(int xKdBank)
    {

        navigationmanager.NavigateTo($"/ModulePrinting/PrintSuratJalan/{xKdBank}?prevUri = {Uri.EscapeDataString(currentUri)}");
    }

    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {

            await serviceSales.DelTransH(_bankToDelete.OeTransHId);


            _bankToDelete = null;
        }

        DeleteDialogOpen = false;
        LoadGet();

        StateHasChanged();

    }

    private void OpenDeleteDialog(OeTransH bank)
    {
        try
        {
            serviceSales.SimpanKurir(bank);
        }
        catch
        {

        };



        //Console.WriteLine(bank.NoLpb);
        //Console.WriteLine(bank.Kurir);
        //System.Console.WriteLine(bank.Keterangan);
        LoadGet();
        StateHasChanged();
    }

    private void LoadKurirs()
    {

        kurirs = serviceSales.GetKurir();

    }
    private void LoadSalesmans()
    {
        salesmans = serviceSales.GetSalesman();
    }

    private void OpenPrintOrder(int xKdBank)
    {

        navigationmanager.NavigateTo($"/ModulePrinting/PrintOrderSales/{xKdBank}");
    }

    private void OpenDetail3(string xKdBank)
    {
        try
        {


            TransDetail2 = serviceSales.Detail3Index(xKdBank);
            DetailOpen3 = !DetailOpen3;
            //  navigationmanager.NavigateTo($"/ModuleJual/EditTransJual/{xKdBank}");
            StateHasChanged();
        }
        catch
        {

        };
    }

    private void OnSearchClose(bool accepted)
    {


        DetailOpen3 = false;

        StateHasChanged();

    }
}