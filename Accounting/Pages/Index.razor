@code {

    private List<OeTransH> TransHeader = new();
    private Dictionary<string, List<OeTrans>> TransDetailCache = new();
    private OeTransH _bankToDelete;
    public bool DeleteDialogOpen { get; set; }
    public string textAlert { get; set; } = "Transaction Already Posting";
    public string textDelete { get; set; } = "Do you want to delete this entry?";
    private List<OeKurir> kurirs = new List<OeKurir>();
    private List<OeSalesman> salesmans = new List<OeSalesman>();
    public List<OeTrans> TransDetail2 = new();
    public bool DetailOpen3 { get; set; }
    private OeTransH selectedTransaction = null;
    private bool showAssignKurirModal = false;

    private bool isShowDashboard = false;
    private bool isDashboardLoading = false;
    private bool isLoaded = false;
    private DateTime? lastLoadedAt;
    private bool showTransactionDetail = false;
    private bool isLoadingTransactions = false;

    private List<CbBank> bankList = new();
    private decimal totalSaldoBank;
    private decimal totalPiutang;
    private decimal totalHutangRp;
    private int jumlahDokPiutang;
    private int jumlahDokHutang;
    private int jumlahDokValas;
    private decimal arCurrent;
    private decimal ar30;
    private decimal ar60;
    private decimal ar90;
    private decimal arOver;
    private decimal arMax;
    private decimal apCurrent;
    private decimal ap30;
    private decimal ap60;
    private decimal ap90;
    private decimal apOver;
    private decimal apMax;

    private List<ArAgingView> agingPiutang = new();
    private List<ApAgingView> agingHutang = new();

    string currentUri;

    protected override async Task OnInitializedAsync()
    {
        currentUri = navigationmanager.Uri;
        LoadCek();
        await Task.CompletedTask;
    }

    private void LoadCek()
    {
        service.SeedUserRole();
    }

    public void Dispose()
    {
        // GC.SuppressFinalize(this);
    }

    private async Task ShowDashboardAsync()
    {
        isShowDashboard = true;

        if (!isDashboardLoading)
        {
            isDashboardLoading = true;
            try
            {
                await LoadDashboardDataAsync();
            }
            finally
            {
                isDashboardLoading = false;
            }
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        await Task.Run(() =>
        {
            // Load Bank Data
            bankList = serviceBank.GetBank() ?? new List<CbBank>();
            totalSaldoBank = bankList.Sum(x => x.Saldo);

            // Load Piutang Data
            agingPiutang = serviceAR.GetAgingSchedule() ?? new List<ArAgingView>();
            totalPiutang = agingPiutang.Sum(x => x.Sisa);
            jumlahDokPiutang = agingPiutang.Count;

            arCurrent = agingPiutang.Sum(x => x.Jumlah1);
            ar30 = agingPiutang.Sum(x => x.Jumlah2);
            ar60 = agingPiutang.Sum(x => x.Jumlah3);
            ar90 = agingPiutang.Sum(x => x.Jumlah4);
            arOver = agingPiutang.Sum(x => x.Jumlah5);
            arMax = new[] { arCurrent, ar30, ar60, ar90, arOver }.DefaultIfEmpty().Max();

            // Load Hutang Data
            agingHutang = serviceAP.GetAgingSchedule() ?? new List<ApAgingView>();
            jumlahDokHutang = agingHutang.Count;
            jumlahDokValas = agingHutang.Count(x => x.Kurs > 1);
            totalHutangRp = agingHutang.Sum(x => x.Sisa * KursEfektif(x));

            apCurrent = agingHutang.Sum(x => x.Jumlah1 * KursEfektif(x));
            ap30 = agingHutang.Sum(x => x.Jumlah2 * KursEfektif(x));
            ap60 = agingHutang.Sum(x => x.Jumlah3 * KursEfektif(x));
            ap90 = agingHutang.Sum(x => x.Jumlah4 * KursEfektif(x));
            apOver = agingHutang.Sum(x => x.Jumlah5 * KursEfektif(x));
            apMax = new[] { apCurrent, ap30, ap60, ap90, apOver }.DefaultIfEmpty().Max();

            lastLoadedAt = DateTime.Now;
            isLoaded = true;
        });

        StateHasChanged();
    }

    private static decimal KursEfektif(ApAgingView item)
    {
        return item.Kurs > 0 ? item.Kurs : 1;
    }

    private static int GetPercent(decimal value, decimal max)
    {
        if (max <= 0)
            return 0;
        return (int)Math.Round((value / max) * 100, MidpointRounding.AwayFromZero);
    }

    private async Task showTransactionDetailAsync()
    {
        showTransactionDetail = !showTransactionDetail;

        if (showTransactionDetail && TransHeader.Count == 0)
        {
            isLoadingTransactions = true;
            try
            {
                await LoadGetAsync();
                LoadKurirs();
                LoadSalesmans();
            }
            finally
            {
                isLoadingTransactions = false;
            }
        }
    }

    private async Task LoadGetAsync()
    {
        TransHeader = await serviceSales.GetTransKurirAsync();
        var poTransh = serviceOrderSales.GetTransHAktif();

        foreach (var aktif in poTransh)
        {
            TransHeader.Add(
                new OeTransH()
                {
                    OeTransHId = aktif.PoTransHId,
                    Tanggal = aktif.Tanggal,
                    Kode = aktif.Kode,
                    NoLpb = aktif.NoLpb,
                    NoPrj = aktif.NoPrj,
                    Customer = aktif.Vendor,
                    NamaCust = aktif.NamaVendor,
                    Keterangan = aktif.Keterangan,
                    Status = "PoOrder"  // Mark ini dari PoTransH
                }
            );
        }

        // Load detail untuk setiap transaksi dalam cache untuk summary
        TransDetailCache.Clear();
        foreach (var trans in TransHeader)
        {
            try
            {
                var isPoOrder = trans.Status == "PoOrder";
                List<OeTrans> details = new();

                if (isPoOrder)
                {
                    var poDetails = serviceOrderSales.GetTransD();
                    details = poDetails
                        .Where(x => x.NoLpb == trans.NoLpb)
                        .Select(x => new OeTrans
                        {
                            ItemCode = x.ItemCode,
                            NamaItem = x.NamaItem,
                            NoLpb = x.NoLpb,
                            Tanggal = x.Tanggal,
                            Qty = x.Qty,
                            Harga = x.Harga,
                            Persen = x.Persen,
                            Jumlah = x.Jumlah,
                            Satuan = x.Satuan,
                            Lokasi = x.Lokasi,
                            Ongkos = 0,
                            Ppn = 0
                        })
                        .ToList();
                }
                else
                {
                    details = serviceSales.Detail3Index(trans.NoLpb);
                }

                TransDetailCache[trans.NoLpb] = details;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading details for {trans.NoLpb}: {ex.Message}");
                TransDetailCache[trans.NoLpb] = new List<OeTrans>();
            }
        }

        StateHasChanged();
    }

    private void OpenPrint(int xKdBank)
    {
        navigationmanager.NavigateTo($"/ModulePrinting/PrintSuratJalan/{xKdBank}?prevUri = {Uri.EscapeDataString(currentUri)}");
    }

    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {
            await serviceSales.DelTransH(_bankToDelete.OeTransHId);
            _bankToDelete = null;
        }

        DeleteDialogOpen = false;
        await LoadGetAsync();
        StateHasChanged();
    }

    private void OpenDeleteDialog(OeTransH bank)
    {
        try
        {
            serviceSales.SimpanKurir(bank);
        }
        catch
        {
        }
        _ = LoadGetAsync();
        StateHasChanged();
    }

    private void LoadKurirs()
    {
        kurirs = serviceSales.GetKurir();
    }

    private void LoadSalesmans()
    {
        salesmans = serviceSales.GetSalesman();
    }

    private void OpenPrintOrder(int xKdBank)
    {
        navigationmanager.NavigateTo($"/ModulePrinting/PrintOrderSales/{xKdBank}");
    }

    private async Task OpenDetail3Async(string xKdBank)
    {
        try
        {
            if (string.IsNullOrEmpty(xKdBank))
            {
                Console.WriteLine("Error: NoLpb is empty");
                return;
            }

            Console.WriteLine($"[Detail] Loading detail for NoLpb: {xKdBank}");

            // Find transaction header untuk determine tipe
            var transHeader = TransHeader.FirstOrDefault(x => x.NoLpb == xKdBank);
            var isPoOrder = transHeader?.Status == "PoOrder";

            Console.WriteLine($"[Detail] Transaction type: {(isPoOrder ? "PoOrder" : "Sales")}");

            // Load data in background task
            var details = await Task.Run(() =>
            {
                try
                {
                    if (isPoOrder)
                    {
                        // Ambil detail dari PoTransD (Order Sales)
                        var poDetails = serviceOrderSales.GetTransD();
                        var filtered = poDetails
                            .Where(x => x.NoLpb == xKdBank)
                            .Select(x => new OeTrans
                            {
                                ItemCode = x.ItemCode,
                                NamaItem = x.NamaItem,
                                NoLpb = x.NoLpb,
                                Tanggal = x.Tanggal,
                                Qty = x.Qty,
                                Harga = x.Harga,
                                Persen = x.Persen,
                                Jumlah = x.Jumlah,
                                Satuan = x.Satuan,
                                Lokasi = x.Lokasi
                            })
                            .ToList();
                        return filtered;
                    }
                    else
                    {
                        // Ambil detail dari OeTrans (Sales)
                        return serviceSales.Detail3Index(xKdBank);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Detail] Service error: {ex.Message}");
                    return null;
                }
            });

            if (details != null)
            {
                TransDetail2 = details;
                Console.WriteLine($"[Detail] Loaded {details.Count} items");
            }
            else
            {
                TransDetail2 = new List<OeTrans>();
                Console.WriteLine("[Detail] Service returned null");
            }

            DetailOpen3 = true;
            StateHasChanged();
            Console.WriteLine($"[Detail] Modal state changed. DetailOpen3={DetailOpen3}, Items count={TransDetail2.Count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Detail] Exception: {ex.Message}");
            Console.WriteLine($"[Detail] Stack: {ex.StackTrace}");
            TransDetail2 = new List<OeTrans>();
            DetailOpen3 = false;
            StateHasChanged();
        }
    }

    private void OpenDetail3(string xKdBank)
    {
        _ = OpenDetail3Async(xKdBank);
    }

     private void OnSearchClose(bool accepted)
    {
        DetailOpen3 = false;
        StateHasChanged();
    }

    private void OpenAssignKurirDialog(OeTransH trans)
    {
        selectedTransaction = trans;
        showAssignKurirModal = true;
        StateHasChanged();
    }

    private void CloseAssignKurirModal()
    {
        selectedTransaction = null;
        showAssignKurirModal = false;
        StateHasChanged();
    }

    private async Task SaveKurirAndSalesman()
    {
        if (selectedTransaction != null)
        {
            try
            {
                // Save kurir dan salesman ke transaksi
                serviceSales.SimpanKurir(selectedTransaction);

                // Refresh data dan clear form
                await LoadGetAsync();
                CloseAssignKurirModal();

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error saving kurir: {ex.Message}");
            }
        }
    }

    private string GetLastRefreshLabel() => lastLoadedAt?.ToString("dd MMM yyyy HH:mm") ?? "Belum dimuat";

    private TransactionSummary GetTransactionSummary(string noLpb)
    {
        if (!TransDetailCache.ContainsKey(noLpb))
            return new TransactionSummary();

        var items = TransDetailCache[noLpb];

        if (items.Count == 0)
            return new TransactionSummary();

        return new TransactionSummary
        {
            TotalQty = items.Sum(x => x.Qty),
            TotalJumlah = items.Sum(x => x.Jumlah),
            TotalPpn = items.Sum(x => x.Ppn),
            TotalOngkos = items.FirstOrDefault()?.Ongkos ?? 0,
            GrandTotal = items.Sum(x => x.Jumlah) + items.Sum(x => x.Ppn) + (items.FirstOrDefault()?.Ongkos ?? 0)
        };
    }

    private class TransactionSummary
    {
        public decimal TotalQty { get; set; }
        public decimal TotalJumlah { get; set; }
        public decimal TotalPpn { get; set; }
        public decimal TotalOngkos { get; set; }
        public decimal GrandTotal { get; set; }
    }

    private RenderFragment AgingBar(string Label, decimal Value, decimal Max, string Color) => __builder =>
    {
        var pct = Max > 0 ? (int)(Value / Max * 100) : 0;
        <div class="mb-2">
            <div class="d-flex justify-content-between small mb-1">
                <span>@Label</span>
                <strong>@Value.ToString("N0")</strong>
            </div>
            <div class="progress" style="height: 20px;">
                <div class="progress-bar @Color" role="progressbar"
                     style="width: @(pct)%;" aria-valuenow="@pct"
                     aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>
        </div>
    };

}
