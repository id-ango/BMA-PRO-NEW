@page "/ModuleMaintenance/ProsesStock"
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.AspNetCore.Identity;
@using Accounting.Services;
@using Accounting.Services.View;
@using Accounting.Data;
@using eSoft.LaporanStock.Services;
@using eSoft.Persediaan.Model;
@using eSoft.Persediaan.Services;

@inject ILaporanStockServices service;
@inject IInventoryServices serviceIC;
@inject AuditContext AuditContext
@inject IJSRuntime JSRuntime

<h3>Proses Stock</h3>

<button class="btn-success" @onclick="prosesstock" style="display: flex; justify-content:space-between;">
    <span>Proses Stock</span>
    <span style="display: @(isProcessing ? "inline" : "none");margin-left:5px; ">
        <i class="fas fa-spinner fa-spin"></i>
    </span>

</button>
@if (!string.IsNullOrWhiteSpace(stockStatus))
{
    <div class="alert @(stockStatus.StartsWith("Gagal", StringComparison.Ordinal) ? "alert-danger" : stockStatus.StartsWith("Proses stock selesai", StringComparison.Ordinal) ? "alert-success" : "alert-info") mt-2" role="status">
        <i class="fas @(stockStatus.StartsWith("Proses stock selesai", StringComparison.Ordinal) ? "fa-check-circle" : "fa-info-circle") me-2"></i>@stockStatus
    </div>
}
<br/>
<br />
<br />
<button class="btn-success" @onclick="prosesSalesPiutang" style="display: flex; justify-content:space-between;">
    <span>Proses Sales Piutang </span>
    <span style="display: @(isProcessPiutang ? "inline" : "none");margin-left:5px; ">
        <i class="fas fa-spinner fa-spin"></i>
    </span>

</button>
@if (!string.IsNullOrWhiteSpace(piutangStatus))
{
    <div class="alert @(piutangStatus.StartsWith("Gagal", StringComparison.Ordinal) ? "alert-danger" : piutangStatus.StartsWith("Proses sales piutang selesai", StringComparison.Ordinal) ? "alert-success" : "alert-info") mt-2" role="status">
        <i class="fas @(piutangStatus.StartsWith("Proses sales piutang selesai", StringComparison.Ordinal) ? "fa-check-circle" : "fa-info-circle") me-2"></i>@piutangStatus
    </div>
}
<br />
<br />
<br />
<div>
    <h3>Proses Rubah Item untuk Seluruh Transaksi</h3>
</div>
<div class="content px-4">
    <EditForm Model="@bank" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group mb-3">
            <label class="form-label" for="sourceItem">Kode Item Awal</label>
            <div class="input-group">
                <InputSelect id="sourceItem" class="form-control" @bind-Value="bank.ItemCode" @oninput="OnChangeItem" disabled="@IsAnyProcessing">
                    <option value="">&nbsp;&nbsp;---Select Item Code---&nbsp;&nbsp;</option>
                    @foreach (var item in SrcCode)
                    {
                        <option value="@item.ItemCode">@item.NamaItem [@item.ItemCode]</option>
                    }

                </InputSelect>
                <button class="btn btn-primary" type="button" @onclick="@(()=> SearchOpen = !SearchOpen)" disabled="@IsAnyProcessing">Cari</button>
            </div>
        </div>
        <div class="form-group mb-3">
            <label class="form-label" for="targetItem">Diganti dengan Kode</label>
            <InputText id="targetItem" class="form-control" @bind-Value="bank.NamaLengkap" disabled="@IsAnyProcessing" />
        </div>
        <div class="d-flex justify-content-end">
            <button class="btn btn-warning" type="submit" disabled="@IsAnyProcessing">
                <span>Proses Rubah Item</span>
                @if (isProcessingRubah)
                {
                    <span style="margin-left: 8px;">
                        <i class="fas fa-spinner fa-spin"></i>
                    </span>
                }
            </button>

        </div>

    </EditForm>
    @if (!string.IsNullOrWhiteSpace(rubahStatus))
    {
        <div class="alert @(rubahStatus.StartsWith("Gagal", StringComparison.Ordinal) ? "alert-danger" : rubahStatus.StartsWith("Perubahan kode item selesai", StringComparison.Ordinal) ? "alert-success" : "alert-info") mt-3" role="status">
            <i class="fas @(rubahStatus.StartsWith("Perubahan kode item selesai", StringComparison.Ordinal) ? "fa-check-circle" : "fa-info-circle") me-2"></i>@rubahStatus
        </div>
    }
</div>

@if (SearchOpen)
{

    <ModalSearchComponent OnClose="OnSearchClose" Items="SrcCode" Context="cbBank" GetFilterableText="@(item =>$"{item.ItemCode} {item.NamaItem} ")">
        <TableHeader>
            <th scope="col">Code</th>
            <th scope="col">Name</th>
            <th scope="col">Satuan</th>
            <th scope="col">Qty</th>
            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@cbBank.ItemCode</td>
            <td>@cbBank.NamaItem</td>
            <td>@cbBank.Satuan</td>
            <td>@cbBank.Qty</td>
            <td>
                <button @onclick="() => BtnChoose(cbBank.ItemCode)" class="btn btn-success">Choose</button>

            </td>
        </RowTemplate>
    </ModalSearchComponent>


}

@code {

    IcItem bank = new ();
    public List<IcItem> SrcCode { get; set; }
    public bool SearchOpen { get; set; }
    private string previousItemCode = ""; // Track item yang terakhir diproses
    private bool isProcessing = false;
    private bool isProcessPiutang = false;
    private string stockStatus = "";
    private string piutangStatus = "";
    private string rubahStatus = "";
    private bool isProcessingRubah = false; // Loading state untuk proses rubah item
    private bool IsAnyProcessing => isProcessing || isProcessPiutang || isProcessingRubah;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        LoadSrcCode();

    }


    private async Task prosesstock()
    {
        if (isProcessing) return;

        var startedAt = DateTime.Now;
        try
        {
            using var auditScope = AuditContext.BeginSuppressAudit();
            isProcessing = true;
            stockStatus = $"Mulai: {startedAt:dd/MM/yyyy HH:mm:ss}";
            await InvokeAsync(StateHasChanged);

            var progress = new Progress<string>(status =>
            {
                stockStatus = status;
                _ = InvokeAsync(StateHasChanged);
            });

            await service.prosesStock(progress);
            stockStatus = $"Proses stock selesai pada {DateTime.Now:dd/MM/yyyy HH:mm:ss}. Data stock sudah diperbarui.";
        }
        catch (Exception ex)
        {
            stockStatus = $"Gagal: {DateTime.Now:dd/MM/yyyy HH:mm:ss} - {ex.Message}";
            await JSRuntime.InvokeVoidAsync("alert", "Terjadi Kesalahan: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

     private async Task prosesSalesPiutang()
    {
        if (IsAnyProcessing) return;

        piutangStatus = $"Mulai: {DateTime.Now:dd/MM/yyyy HH:mm:ss}";
        try
        {
            using var auditScope = AuditContext.BeginSuppressAudit();
            isProcessPiutang = true;
           await service.ProsesSalesPiutang();
           piutangStatus = $"Proses sales piutang selesai pada {DateTime.Now:dd/MM/yyyy HH:mm:ss}. Data sudah diperbarui.";
        }
        catch (Exception ex)
        {
            piutangStatus = $"Gagal: {DateTime.Now:dd/MM/yyyy HH:mm:ss} - {ex.Message}";
            await JSRuntime.InvokeVoidAsync("alert", "Terjadi Kesalahan: " + ex.Message);
        }
        finally
        {
            isProcessPiutang = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSearchClose(bool accepted)
    {

        SearchOpen = false;
        StateHasChanged();

    }

    void LoadSrcCode()
    {

        SrcCode = serviceIC.GetIcItem(false);

    }

    private void BtnChoose(string textSearch)
    {
        if (!string.IsNullOrEmpty(textSearch))
        {
            bank.ItemCode = textSearch;
            var itemcode = SrcCode.FirstOrDefault(e => e.ItemCode == bank.ItemCode);
            if (itemcode is not null)
            {
                bank.NamaItem = itemcode.NamaItem;
                bank.Satuan = itemcode.Satuan;
                bank.Harga = itemcode.HrgJual;
            }
         

        }

        SearchOpen = false;
        StateHasChanged();
    }

    public void OnChangeItem(ChangeEventArgs args)
    {

        var itemcode = SrcCode.FirstOrDefault(e => e.ItemCode == args.Value?.ToString());
        if (itemcode is null) return;

        bank.NamaItem = itemcode.NamaItem;
        bank.Satuan = itemcode.Satuan;
        bank.Harga = itemcode.HrgJual;

    }

    private async Task HandleValidSubmit()
    {
        if (IsAnyProcessing) return;

        if (string.IsNullOrWhiteSpace(bank.ItemCode) || string.IsNullOrWhiteSpace(bank.NamaLengkap))
        {
            rubahStatus = "Gagal: Kode item sumber dan kode pengganti wajib diisi.";
            return;
        }

        if (string.Equals(bank.ItemCode.Trim(), bank.NamaLengkap.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            rubahStatus = "Gagal: Kode item pengganti harus berbeda dari kode item sumber.";
            return;
        }

        if (bank.ItemCode == previousItemCode)
        {
            rubahStatus = "Gagal: Item ini sudah diproses. Silakan pilih item lain.";
            return;
        }

        isProcessingRubah = true;
        rubahStatus = "Memproses perubahan kode item...";

        try
        {
            using var auditScope = AuditContext.BeginSuppressAudit();
            service.ProsesRubahKodeItem(bank.ItemCode, bank.NamaLengkap);
            rubahStatus = "Perubahan kode item selesai. Seluruh transaksi terkait sudah diperbarui.";

            // Simpan item code yang baru diproses
            previousItemCode = bank.ItemCode;

            // Clear form untuk input item baru
            bank = new IcItem();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            rubahStatus = "Gagal: " + ex.Message;
        }
        finally
        {
            isProcessingRubah = false;
            await InvokeAsync(StateHasChanged);
        }
    }

}
