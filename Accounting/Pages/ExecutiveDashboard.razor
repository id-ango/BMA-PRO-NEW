@page "/ExecutiveDashboard"
@using Accounting.Services
@using Accounting.Services.View
@inject IExecutiveDashboardService DashboardService

<PageTitle>Executive Dashboard</PageTitle>

<div class="executive-dashboard">
    <div class="dashboard-heading">
        <div>
            <div class="eyebrow">EXECUTIVE OVERVIEW</div>
            <h1>Dashboard Keuangan & Operasional</h1>
            <p class="text-muted mb-0">Snapshot saldo berjalan kas, piutang, hutang, persediaan, SO, dan PO.</p>
        </div>
        <div class="text-end">
            <button class="btn btn-primary" @onclick="LoadAsync" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                Refresh Data
            </button>
            @if (dashboard != null)
            {
                <small class="d-block text-muted mt-2">Diperbarui @dashboard.GeneratedAt.ToString("dd MMM yyyy HH:mm")</small>
            }
        </div>
    </div>

    @if (isLoading && dashboard == null)
    {
        <div class="dashboard-state"><div class="spinner-border text-primary" role="status"></div><p>Memuat ringkasan manajemen...</p></div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (dashboard != null)
    {
        <div class="kpi-grid">
            <div class="metric-card cash"><span>Kas & Bank</span><strong>@Money(dashboard.KasBank)</strong><small>Saldo saat ini</small></div>
            <div class="metric-card receivable"><span>Piutang</span><strong>@Money(dashboard.Piutang)</strong><small>@Money(dashboard.PiutangJatuhTempo) jatuh tempo</small></div>
            <div class="metric-card payable"><span>Hutang</span><strong>@Money(dashboard.Hutang)</strong><small>@Money(dashboard.HutangJatuhTempo) jatuh tempo</small></div>
            <div class="metric-card inventory"><span>Nilai Persediaan</span><strong>@Money(dashboard.Persediaan)</strong><small>@dashboard.JumlahItemStock item aktif</small></div>
            <div class="metric-card sales-order"><span>SO Outstanding</span><strong>@Money(dashboard.SalesOrder)</strong><small>@dashboard.JumlahSalesOrder dokumen berjalan</small></div>
            <div class="metric-card purchase-order"><span>PO Outstanding</span><strong>@Money(dashboard.PurchaseOrder)</strong><small>@dashboard.JumlahPurchaseOrder dokumen berjalan</small></div>
        </div>

        <div class="dashboard-grid mt-4">
            <section class="panel chart-panel">
                <div class="panel-heading"><div><h2>Posisi Saldo Berjalan</h2><small>Perbandingan seluruh nilai pada saat ini</small></div></div>
                <div class="bar-chart">
                    @foreach (var item in CurrentMetrics())
                    {
                        <div class="bar-row"><div class="bar-label">@item.Label</div><div class="bar-track"><div class="bar-fill @item.CssClass" style="width:@Percent(item.Value, CurrentMax)%"></div></div><div class="bar-value">@Money(item.Value)</div></div>
                    }
                </div>
            </section>

            <section class="panel">
                <div class="panel-heading"><div><h2>Aging Piutang & Hutang</h2><small>Saldo yang perlu menjadi perhatian</small></div></div>
                <div class="aging-summary">
                    <div><span class="dot ar"></span><label>Piutang jatuh tempo</label><strong>@Money(dashboard.PiutangJatuhTempo)</strong></div>
                    <div><span class="dot ap"></span><label>Hutang jatuh tempo</label><strong>@Money(dashboard.HutangJatuhTempo)</strong></div>
                    <div><span class="dot net"></span><label>Kas setelah piutang-hutang</label><strong>@Money(dashboard.KasBank + dashboard.Piutang - dashboard.Hutang)</strong></div>
                </div>
            </section>
        </div>

        <section class="panel mt-4">
            <div class="panel-heading"><div><h2>Saldo Berjalan Saat Ini</h2><small>Termasuk persediaan saat ini dan SO/PO yang masih outstanding</small></div></div>
            <div class="current-balance-chart">
                @foreach (var item in CurrentMetrics())
                {
                    <div class="current-balance-column">
                        <div class="current-balance-value">@Money(item.Value)</div>
                        <div class="current-balance-track">
                            <div class="current-balance-bar @item.CssClass" style="height:@Percent(item.Value, CurrentMax)%"></div>
                        </div>
                        <small>@item.Label</small>
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    private ExecutiveDashboardView? dashboard;
    private bool isLoading;
    private string? errorMessage;

    private decimal CurrentMax => CurrentMetrics().Select(x => x.Value).DefaultIfEmpty(1).Max();
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            dashboard = await DashboardService.GetDashboardAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Data dashboard belum dapat dimuat: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<MetricItem> CurrentMetrics() => dashboard == null
        ? Enumerable.Empty<MetricItem>()
        : new[]
        {
            new MetricItem("Kas & Bank", dashboard.KasBank, "cash"),
            new MetricItem("Piutang", dashboard.Piutang, "receivable"),
            new MetricItem("Hutang", dashboard.Hutang, "payable"),
            new MetricItem("Persediaan", dashboard.Persediaan, "inventory"),
            new MetricItem("SO Aktif", dashboard.SalesOrder, "sales-order"),
            new MetricItem("PO Aktif", dashboard.PurchaseOrder, "purchase-order")
        };

    private static string Money(decimal value) => value.ToString("N0");
    private static int Percent(decimal value, decimal max) => max <= 0 ? 0 : Math.Clamp((int)Math.Round(value / max * 100), 0, 100);
    private sealed record MetricItem(string Label, decimal Value, string CssClass);
}
