@code {


    public List<ArCust> TransDetail;
    private string Title = "Daftar Customer";
    private string cekDivisi = "";
    private int No = 0;
  

    protected override void OnInitialized()
    {
        base.OnInitialized();
        loadStock();

    }



    private void loadStock()
    {

        TransDetail = serviceIC.GetCustomer().OrderBy(x =>x.Kota).ToList();

        StateHasChanged();

    }


}
