                                    <td class="text-end">@(item.Jumlah3 > 0 ? item.Jumlah3.ToString("N0") : "-")</td>
                                    <td class="text-end">@(item.Jumlah4 > 0 ? item.Jumlah4.ToString("N0") : "-")</td>
