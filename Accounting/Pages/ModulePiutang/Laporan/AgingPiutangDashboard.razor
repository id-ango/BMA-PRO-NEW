        @* ══ TAB: ANALISA CUSTOMER ══ *@
        @if (ActiveTab == "analisa")
        {
            <div class="container-fluid ar-scroll-area">
                @if (AnalisaLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Menghitung analisa customer...</p>
                    </div>
                }
                else if (AnalisaData == null || !AnalisaData.Any())
                {
                    <div class="alert alert-info mt-2">Tidak ada data analisa.</div>
                }
                else
                {
                    @* ── Ringkasan distribusi risiko ── *@
                    <div class="row g-2 mb-3 mt-1">
                        <div class="col-6 col-md-3">
                            <div class="card text-center border-danger" style="background:#fff5f5;">
                                <div class="card-body p-2">
                                    <div class="fw-bold fs-4 text-danger">@AnalisaData.Count(x=>x.RiskLabel=="Blacklist")</div>
                                    <small>⛔ Blacklist</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center border-danger" style="background:#fff0f0;">
                                <div class="card-body p-2">
                                    <div class="fw-bold fs-4 text-danger">@AnalisaData.Count(x=>x.RiskLabel=="Macet")</div>
                                    <small>🔴 Macet</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center" style="background:#fff3e0;border-color:#e67e22;">
                                <div class="card-body p-2">
                                    <div class="fw-bold fs-4" style="color:#e67e22;">@AnalisaData.Count(x=>x.RiskLabel=="Jelek")</div>
                                    <small>🟠 Jelek</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center" style="background:#fffbe6;border-color:#fd7e14;">
                                <div class="card-body p-2">
                                    <div class="fw-bold fs-4" style="color:#fd7e14;">@AnalisaData.Count(x=>x.RiskLabel=="Hati-hati")</div>
                                    <small>🔶 Hati-hati</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center border-warning" style="background:#fffff0;">
                                <div class="card-body p-2">
                                    <div class="fw-bold fs-4" style="color:#856404;">@AnalisaData.Count(x=>x.RiskLabel=="Cukup")</div>
                                    <small>⚠️ Cukup</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-center border-success" style="background:#f0fff4;">
                                <div class="card-body p-2">
                                    <div class="fw-bold fs-4 text-success">@AnalisaData.Count(x=>x.RiskLabel=="Baik")</div>
                                    <small>✅ Baik</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ── Filter analisa ── *@
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-md-4">
                            <input class="form-control form-control-sm" @bind="AnalisaSearch" @bind:event="oninput"
                                   placeholder="Cari nama customer / salesman..." />
                        </div>
                        <div class="col-md-2">
                            <select class="form-select form-select-sm" @bind="AnalisaFilterLabel">
                                <option value="">Semua Risiko</option>
                                <option value="Blacklist">⛔ Blacklist</option>
                                <option value="Macet">🔴 Macet</option>
                                <option value="Jelek">🟠 Jelek</option>
                                <option value="Hati-hati">🔶 Hati-hati</option>
                                <option value="Cukup">⚠️ Cukup</option>
                                <option value="Baik">✅ Baik</option>
                                <option value="Baru">🔵 Baru</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="()=>{AnalisaSearch=string.Empty;AnalisaFilterLabel=string.Empty;}">Reset</button>
                        </div>
                        <div class="col-auto ms-auto">
                            <span class="badge bg-secondary">@FilteredAnalisa.Count customer</span>
                        </div>
                    </div>

                    @* ── Tabel analisa ── *@
                    <div class="ar-table-wrapper" style="max-height:calc(100vh - 340px);">
                        <table class="table table-sm ar-table" style="border-collapse:separate;border-spacing:0;font-size:0.81rem;white-space:nowrap;margin:0;">
                            <thead>
                                <tr>
                                    <th class="ar-th ar-sticky-col-1">Customer</th>
                                    <th class="ar-th" style="min-width:80px;">Salesman</th>
                                    <th class="ar-th text-center" style="min-width:90px;">Risk Score</th>
                                    <th class="ar-th text-center" style="min-width:100px;">Label Risiko</th>
                                    <th class="ar-th text-end">Outstanding</th>
                                    <th class="ar-th text-center">Faktur Open</th>
                                    <th class="ar-th text-center">Cicilan</th>
                                    <th class="ar-th text-center">Diam (hr)</th>
                                    <th class="ar-th text-center">Tgl Bayar Terakhir</th>
                                    <th class="ar-th text-end">Nunggak &gt;60hr</th>
                                    <th class="ar-th text-center">Avg Terlambat</th>
                                    <th class="ar-th text-center">Max Terlambat</th>
                                    <th class="ar-th text-center">On-Time %</th>
                                    <th class="ar-th text-center">DSO (hr)</th>
                                    <th class="ar-th" style="min-width:300px;">Rekomendasi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in FilteredAnalisa)
                                {
                                    var (rowBg, labelBadge) = GetRiskStyle(a.RiskLabel);
                                    var scoreBar = GetScoreBar(a.RiskScore);
                                    <tr style="background:@rowBg;">
                                        <td class="ar-sticky-col-1 fw-bold" style="background:@rowBg;">@a.NamaCust</td>
                                        <td style="font-size:0.75rem;">@a.Salesman</td>
                                        <td class="text-center">@scoreBar</td>
                                        <td class="text-center">@labelBadge</td>
                                        <td class="text-end fw-bold">@a.TotalOutstanding.ToString("N0")</td>
                                        <td class="text-center">@a.JumlahFakturOpen</td>
                                        <td class="text-center">
                                            @if (a.JumlahFakturCicilan == 0)
                                            {
                                                <span style="color:#aaa;">-</span>
                                            }
                                            else
                                            {
                                                <span class="ar-badge" style="background:#e67e22;color:#fff;">@a.JumlahFakturCicilan fk</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @GetDiamBadge(a.MaxHariMacetOutstanding, a.JumlahFakturOpen)
                                        </td>
                                        <td class="text-center" style="font-size:0.75rem;">
                                            @if (a.TglTerakhirBayarOutstanding.HasValue)
                                            {
                                                <span>@a.TglTerakhirBayarOutstanding.Value.ToString("dd/MM/yy")</span>
                                            }
                                            else if (a.JumlahFakturOpen > 0)
                                            {
                                                <span style="color:#aaa;">belum bayar</span>
                                            }
                                            else
                                            {
                                                <span style="color:#aaa;">-</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (a.CountTelat60 == 0)
                                            {
                                                <span class="ar-badge ar-badge-baru">-</span>
                                            }
                                            else
                                            {
                                                <span class="ar-badge ar-badge-lama">@a.CountTelat60 fk · @a.OutstandingTelat60.ToString("N0")</span>
                                            }
                                        </td>
                                        <td class="text-center">@GetDaysLateBadge(a.AvgDaysLate, false)</td>
                                        <td class="text-center">@GetDaysLateBadge(a.MaxDaysLate, true)</td>
                                        <td class="text-center">@GetOnTimeRateBadge(a.OnTimeRate)</td>
                                        <td class="text-center">@GetDsoBadge(a.DSO)</td>
                                        <td style="font-size:0.78rem; white-space:normal; max-width:300px;">@a.Rekomendasi</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }

</div>

@code {
    private List<ArAgingView> Aging;
    private List<ArForecastPiutangView> ForecastData = new();
    private List<ArCustomerAnalysisView> AnalisaData;
    private bool AnalisaLoading = false;

    private List<ArMonthlyCollectionView> CollectionData;
    private bool CollectionLoading = false;

    private string SearchText = string.Empty;
    private string SelectedCustomer = string.Empty;
    private string SortBy = "aging";
    private string ActiveTab = "overview";
    private string AgingFilter = string.Empty;
    private string ExpandedForecast = string.Empty;
    private HashSet<string> ExpandedCustomers = new();
    private string AnalisaSearch = string.Empty;
    private string AnalisaFilterLabel = string.Empty;

    // ── Computed ──────────────────────────────────────────────
    private List<string> CustomerList =>
        Aging?.Select(x => x.NamaCust).Distinct().OrderBy(x => x).ToList() ?? new();

    private List<ArAgingView> FilteredRows
    {
        get
        {
            if (Aging == null) return new();

            var q = Aging.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SelectedCustomer))
                q = q.Where(x => x.NamaCust == SelectedCustomer);

            if (!string.IsNullOrWhiteSpace(SearchText))
                q = q.Where(x =>
                    $"{x.NamaCust} {x.Customer} {x.Dokumen} {x.Keterangan} {x.NamaSales}"
                    .Contains(SearchText, StringComparison.OrdinalIgnoreCase));

            if (AgingFilter == "belum")   q = q.Where(x => x.Jumlah > 0);
            if (AgingFilter == "1-30")    q = q.Where(x => x.Jumlah1 > 0);
            if (AgingFilter == "31-60")   q = q.Where(x => x.Jumlah2 > 0);
            if (AgingFilter == "61-90")   q = q.Where(x => x.Jumlah3 > 0);
            if (AgingFilter == "90+")     q = q.Where(x => x.Jumlah4 > 0);

            q = SortBy switch
            {
                "aging"    => q.OrderBy(x => x.Duedate).ThenBy(x => x.Customer),
                "customer" => q.OrderBy(x => x.NamaCust).ThenBy(x => x.Duedate),
                "sisa"     => q.OrderByDescending(x => x.Sisa),
                _          => q
            };

            return q.ToList();
        }
    }

    private Dictionary<string, List<ArAgingView>> CustomerGroups =>
        FilteredRows
            .GroupBy(x => x.Customer)
            .ToDictionary(g => g.Key, g => g.ToList());

    // ── Totals ────────────────────────────────────────────────
    private decimal TotalSisa   => FilteredRows.Sum(x => x.Sisa);
    private decimal TotalBelum  => FilteredRows.Sum(x => x.Jumlah);
    private decimal Total130    => FilteredRows.Sum(x => x.Jumlah1);
    private decimal Total3160   => FilteredRows.Sum(x => x.Jumlah2);
    private decimal Total6190   => FilteredRows.Sum(x => x.Jumlah3);
    private decimal Total90Plus => FilteredRows.Sum(x => x.Jumlah4);

    // ── Lifecycle ─────────────────────────────────────────────
    protected override void OnInitialized()
    {
        Load();
    }

    private void Load()
    {
        Aging = serviceAR.GetAgingSchedule();
        ForecastData = serviceAR.GetForecastPiutang(DateTime.Today, 12);
    }

    private void Refresh()
    {
        Aging = null;
        StateHasChanged();
        Load();
    }

    // ── Filter helpers ────────────────────────────────────────
    private void SetTab(string filter)
    {
        AgingFilter = filter == "semua" ? string.Empty : filter;
        ActiveTab = "tabel";
    }

    private void ResetFilter()
    {
        SearchText = string.Empty;
        SelectedCustomer = string.Empty;
        SortBy = "aging";
        AgingFilter = string.Empty;
    }

    private void ToggleCustomer(string code)
    {
        if (!ExpandedCustomers.Add(code))
            ExpandedCustomers.Remove(code);
    }

    private void ToggleForecast(int tahun, int bulan)
    {
        var key = $"{tahun}-{bulan}";
        ExpandedForecast = ExpandedForecast == key ? string.Empty : key;
    }

    // ── Analisa Customer ─────────────────────────────────────
    private List<ArCustomerAnalysisView> FilteredAnalisa
    {
        get
        {
            if (AnalisaData == null) return new();
            var q = AnalisaData.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(AnalisaFilterLabel))
                q = q.Where(x => x.RiskLabel == AnalisaFilterLabel);
            if (!string.IsNullOrWhiteSpace(AnalisaSearch))
                q = q.Where(x => $"{x.NamaCust} {x.Customer} {x.Salesman}"
                    .Contains(AnalisaSearch, StringComparison.OrdinalIgnoreCase));
            return q.ToList();
        }
    }

    private async Task LoadCollection()
    {
        ActiveTab = "collection";
        if (CollectionData != null) return;
        CollectionLoading = true;
        StateHasChanged();
        CollectionData = await Task.Run(() => serviceAR.GetMonthlyCollection(12));
        CollectionLoading = false;
    }

    private int AlertCount =>
        Aging == null ? 0 :
        Aging.Count(x => (int)(DateTime.Today - x.Duedate).TotalDays > 60);

    // ── Collection computed ───────────────────────────────────
    private ArMonthlyCollectionView ColLast => CollectionData?.LastOrDefault();
    private double Col3MonthAvg => CollectionData != null && CollectionData.Count >= 3 ? CollectionData.TakeLast(3).Average(x => (double)x.TotalPenerimaan) : 0;
    private decimal ColTotal    => CollectionData?.Sum(x => x.TotalPenerimaan) ?? 0;
    private decimal ColMax      => CollectionData != null && CollectionData.Any() ? CollectionData.Max(x => x.TotalPenerimaan) : 0;
    private double ColMaxVal    => ColMax > 0 ? (double)ColMax : 1;

    private async Task LoadAnalisa()
    {
        ActiveTab = "analisa";
        if (AnalisaData != null) return; // sudah dimuat
        AnalisaLoading = true;
        StateHasChanged();
        AnalisaData = await Task.Run(() => serviceAR.GetCustomerAnalysis());
        AnalisaLoading = false;
    }

    private (string bg, MarkupString badge) GetRiskStyle(string label) => label switch
    {
        "Blacklist"  => ("#fde8e8", new MarkupString("<span class='badge bg-dark'>⛔ Blacklist</span>")),
        "Macet"      => ("#ffe0e0", new MarkupString("<span class='badge bg-danger'>🔴 Macet</span>")),
        "Jelek"      => ("#fff3e0", new MarkupString("<span class='badge' style='background:#e67e22;color:#fff;'>🟠 Jelek</span>")),
        "Hati-hati"  => ("#fffbe6", new MarkupString("<span class='badge' style='background:#fd7e14;color:#fff;'>🔶 Hati-hati</span>")),
        "Cukup"      => ("#fffff0", new MarkupString("<span class='badge' style='background:#ffc107;color:#212529;'>⚠️ Cukup</span>")),
        "Baik"       => ("#f0fff4", new MarkupString("<span class='badge bg-success'>✅ Baik</span>")),
        "Baru"       => ("#f8f9fa", new MarkupString("<span class='badge bg-info text-dark'>🔵 Baru</span>")),
        _            => ("#fff",    new MarkupString("<span class='badge bg-secondary'>-</span>"))
    };

    private MarkupString GetDiamBadge(int hari, int fakturOpen)
    {
        if (fakturOpen == 0) return new MarkupString("<span style='color:#aaa;'>-</span>");
        if (hari <= 0) return new MarkupString("<span class='ar-badge ar-badge-baru'>belum JT</span>");
        var cls = hari > 60 ? "ar-badge-lama" : hari > 30 ? "ar-badge-sedang" : "ar-badge-baru";
        return new MarkupString($"<span class='ar-badge {cls}'>{hari} hr</span>");
    }

    private MarkupString GetScoreBar(int score)
    {
        var color = score >= 75 ? "#198754" : score >= 55 ? "#ffc107" : score >= 35 ? "#e67e22" : score >= 15 ? "#dc3545" : "#6f1a1a";
        var textColor = (score >= 55 && score < 75) ? "#212529" : "#fff";
        return new MarkupString(
            $"<div style='display:flex;align-items:center;gap:4px;'>" +
            $"<div style='flex:1;height:8px;background:#e9ecef;border-radius:4px;overflow:hidden;'>" +
            $"<div style='width:{score}%;height:100%;background:{color};border-radius:4px;'></div></div>" +
            $"<span class='badge' style='background:{color};color:{textColor};min-width:34px;'>{score}</span>" +
            $"</div>");
    }

    private MarkupString GetOnTimeRateBadge(double rate)
    {
        var color = rate >= 80 ? "ar-badge-baru" : rate >= 50 ? "ar-badge-sedang" : "ar-badge-lama";
        return new MarkupString($"<span class='ar-badge {color}'>{rate:0.0}%</span>");
    }

    private MarkupString GetDaysLateBadge(double days, bool isMax)
    {
        if (days <= 0) return new MarkupString("<span class='ar-badge ar-badge-baru'>0 hr</span>");
        var color = days <= 15 ? "ar-badge-baru" : days <= 30 ? "ar-badge-sedang" : "ar-badge-lama";
        var prefix = isMax ? "max " : "avg ";
        return new MarkupString($"<span class='ar-badge {color}'>{prefix}{days:0.0} hr</span>");
    }

    private MarkupString GetDsoBadge(double dso)
    {
        if (dso <= 0) return new MarkupString("<span class='ar-badge ar-badge-baru'>0</span>");
        var color = dso <= 30 ? "ar-badge-baru" : dso <= 60 ? "ar-badge-sedang" : "ar-badge-lama";
        return new MarkupString($"<span class='ar-badge {color}'>{dso:0.0}</span>");
    }

    // ── UI helpers ────────────────────────────────────────────
    private string GetAgingRowBg(ArAgingView item)
    {
        if (item.Jumlah4 > 0) return "#ffe0e0";   // >90 hari — merah muda
        if (item.Jumlah3 > 0) return "#ffe8d1";   // 61-90 — oranye muda
        if (item.Jumlah2 > 0) return "#fff3cd";   // 31-60 — kuning
        if (item.Jumlah1 > 0) return "#fffbe6";   // 1-30  — kuning terang
        return "#f0fff4";                           // belum JT — hijau muda
    }

    private MarkupString GetTerlambatBadge(int hari)
    {
        if (hari <= 0) return new MarkupString($"<span class='badge bg-success'>Belum JT</span>");
        if (hari <= 30) return new MarkupString($"<span class='badge' style='background:#ffc107;color:#212529;'>{hari} hr</span>");
        if (hari <= 60) return new MarkupString($"<span class='badge' style='background:#fd7e14;color:#fff;'>{hari} hr</span>");
        if (hari <= 90) return new MarkupString($"<span class='badge bg-danger'>{hari} hr</span>");
        return new MarkupString($"<span class='badge bg-danger'><strong>⚠ {hari} hr</strong></span>");
    }

    private MarkupString GetInfoBayarBadge(ArAgingView item)
    {
        var sb = new System.Text.StringBuilder();

        // Deteksi uang muka: nilai awal atau sisa negatif
        if (item.JumlahAwal < 0 || item.Sisa < 0)
        {
            sb.Append("<span class='ar-badge' style='background:#e0cffc;color:#3d0a91;border:1px solid #c5a3ff;' title='Ini adalah uang muka / advance payment'>&#128176; Uang Muka</span>");
            return new MarkupString(sb.ToString());
        }

        // Badge: sudah bayar berapa kali
        if (item.JumlahCicilan > 0)
        {
            sb.Append($"<span class='ar-badge ar-badge-cicilan' title='Sudah {item.JumlahCicilan}x cicilan'>&#128178; {item.JumlahCicilan}x</span> ");
        }
        else
        {
            sb.Append("<span class='ar-badge ar-badge-belum' title='Belum ada pembayaran sama sekali'>&#10060; Blm bayar</span> ");
        }

        // Badge: persen sudah dibayar
        if (item.SudahBayar > 0)
        {
            var persen = item.JumlahAwal > 0 ? (int)(item.SudahBayar / item.JumlahAwal * 100) : 0;
            sb.Append($"<span class='ar-badge ar-badge-bayar' title='Sudah bayar: {item.SudahBayar:N0} dari {item.JumlahAwal:N0}'>&#10003; {persen}%</span> ");
        }

        // Badge: tanggal terakhir bayar
        if (item.TglTerakhirBayar.HasValue)
        {
            var hariSejak = item.HariSejakTerakhirBayar;
            var warna = hariSejak > 60 ? "ar-badge-lama" : hariSejak > 30 ? "ar-badge-sedang" : "ar-badge-baru";
            sb.Append($"<span class='ar-badge {warna}' title='Terakhir bayar: {item.TglTerakhirBayar:dd/MM/yy}'>"
                      + $"&#128337; {item.TglTerakhirBayar:dd/MM/yy} ({hariSejak}hr lalu)</span>");
        }
        else
        {
            sb.Append($"<span class='ar-badge ar-badge-lama' title='Invoice tgl {item.Tanggal:dd/MM/yy}, belum pernah ada pembayaran'>&#128337; Invoice {item.HariSejakTerakhirBayar}hr lalu</span>");
        }

        return new MarkupString(sb.ToString());
    }

    // ── Excel ─────────────────────────────────────────────────
    private async Task DownloadExcel()
    {
        var data = serviceXL.CreateAgingPiutangExcel(FilteredRows, ForecastData, AnalisaData);
        var stream = new MemoryStream(data);
        var fileName = $"AgingPiutang_{DateTime.Today:yyyyMMdd}.xlsx";
        using var streamRef = new DotNetStreamReference(stream: stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
}

