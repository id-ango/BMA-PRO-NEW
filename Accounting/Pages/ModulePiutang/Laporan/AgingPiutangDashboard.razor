@page "/ModulePiutang/AgingPiutangDashboard"
@using eSoft.Piutang.View
@using eSoft.Piutang.Services
@using Accounting.Services
@using System.IO

@inject IReceivableServices serviceAR
@inject IExcelServices serviceXL
@inject IJSRuntime JS

<div class="ar-page-shell">

    
    <div class="container-fluid py-2 border-bottom">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h4 class="mb-0 fw-bold">&#128196; Aging Piutang Dashboard</h4>
                <small class="text-muted">Per tanggal: @DateTime.Today.ToString("dd MMMM yyyy")</small>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-sm btn-outline-secondary" @onclick="Refresh">
                    &#8635; Refresh
                </button>
                <a class="btn btn-sm btn-outline-primary" href="/ModulePiutang/LaporanAgingPiutang" target="_blank">
                    &#128438; Versi Print
                </a>
                <button class="btn btn-sm btn-success" @onclick="DownloadExcel">
                    &#128196; Download Excel
                </button>
            </div>
        </div>
    </div>

    @if (Aging == null)
    {
        <div class="container-fluid mt-4 text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Memuat data...</p>
        </div>
    }
    else
    {
        
        <div class="container-fluid py-2">
            <div class="row g-2">
                <div class="col-6 col-md-2">
                    <div class="card text-white h-100" style="background:#0d6efd; cursor:pointer;" @onclick='()=>SetTab("semua")'>
                        <div class="card-body p-2 text-center">
                            <div class="fw-bold" style="font-size:1.2rem;">@TotalSisa.ToString("N0")</div>
                            <small>Total Piutang</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-dark h-100" style="background:#d1e7dd; cursor:pointer;" @onclick='()=>SetTab("belum")'>
                        <div class="card-body p-2 text-center">
                            <div class="fw-bold" style="font-size:1.2rem;">@TotalBelum.ToString("N0")</div>
                            <small>Belum JT</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-dark h-100" style="background:#fff3cd; cursor:pointer;" @onclick='()=>SetTab("1-30")'>
                        <div class="card-body p-2 text-center">
                            <div class="fw-bold" style="font-size:1.2rem;">@Total130.ToString("N0")</div>
                            <small>1 – 30 hari</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-dark h-100" style="background:#ffc107; cursor:pointer;" @onclick='()=>SetTab("31-60")'>
                        <div class="card-body p-2 text-center">
                            <div class="fw-bold" style="font-size:1.2rem;">@Total3160.ToString("N0")</div>
                            <small>31 – 60 hari</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-white h-100" style="background:#fd7e14; cursor:pointer;" @onclick='()=>SetTab("61-90")'>
                        <div class="card-body p-2 text-center">
                            <div class="fw-bold" style="font-size:1.2rem;">@Total6190.ToString("N0")</div>
                            <small>61 – 90 hari</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-white h-100" style="background:#dc3545; cursor:pointer;" @onclick='()=>SetTab("90+")'>
                        <div class="card-body p-2 text-center">
                            <div class="fw-bold" style="font-size:1.2rem;">@Total90Plus.ToString("N0")</div>
                            <small>&gt; 90 hari</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="container-fluid py-1">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <input class="form-control form-control-sm" @bind="SearchText" @bind:event="oninput"
                           placeholder="Cari customer / dokumen / keterangan..." />
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" @bind="SelectedCustomer">
                        <option value="">Semua Customer</option>
                        @foreach (var c in CustomerList)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" @bind="SortBy">
                        <option value="aging">Urutkan: Paling Lama JT</option>
                        <option value="customer">Urutkan: Customer</option>
                        <option value="sisa">Urutkan: Sisa Terbesar</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilter">Reset</button>
                </div>
                <div class="col-auto ms-auto">
                    <span class="badge bg-secondary">@FilteredRows.Count dokumen</span>
                    <span class="badge bg-primary ms-1">@FilteredRows.Select(x=>x.Customer).Distinct().Count() customer</span>
                </div>
            </div>
        </div>

        
        <div class="container-fluid">
            <ul class="nav nav-tabs nav-fill" style="font-size:0.85rem;">
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab=="overview" ? "active fw-bold" : "")" @onclick='()=>ActiveTab="overview"'>
                        &#127968; Overview
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab=="tabel" ? "active fw-bold" : "")" @onclick='()=>ActiveTab="tabel"'>
                        &#128203; Tabel Aging
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab=="customer" ? "active fw-bold" : "")" @onclick='()=>ActiveTab="customer"'>
                        &#128101; Per Customer
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab=="alert" ? "active fw-bold" : "")" @onclick='()=>ActiveTab="alert"'>
                        &#128680; Alert
                        @if (AlertCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@AlertCount</span>
                        }
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab=="collection" ? "active fw-bold" : "")" @onclick="LoadCollection">
                        &#128179; Collection
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab=="forecast" ? "active fw-bold" : "")" @onclick='()=>ActiveTab="forecast"'>
                        &#128197; Forecast Tagihan
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab=="analisa" ? "active fw-bold" : "")" @onclick="LoadAnalisa">
                        &#128202; Analisa Customer
                    </button>
                </li>
            </ul>
        </div>

        
        @* ══════════════════ TAB OVERVIEW ══════════════════ *@
        @if (ActiveTab == "overview")
        {
            <div class="ar-scroll-tab">
            <div class="container-fluid py-3">

                @* ── Baris 1: Distribusi aging (bar) ── *@
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-header py-2 fw-bold">📊 Distribusi Aging Piutang</div>
                            <div class="card-body py-2">
                                @{
                                    var totalAll = TotalSisa > 0 ? TotalSisa : 1;
                                    var bars = new[]
                                    {
                                        ("Belum JT",  TotalBelum,  "#198754"),
                                        ("1–30 hr",   Total130,    "#ffc107"),
                                        ("31–60 hr",  Total3160,   "#fd7e14"),
                                        ("61–90 hr",  Total6190,   "#dc3545"),
                                        (">90 hr",    Total90Plus, "#6f1a1a"),
                                    };
                                }
                                <div class="d-flex gap-1 mb-1" style="height:28px;">
                                    @foreach (var (lbl, val, color) in bars)
                                    {
                                        var pct = (double)val / (double)totalAll * 100;
                                        if (pct > 0)
                                        {
                                            <div title="@lbl: @val.ToString("N0")"
                                                 style="width:@pct.ToString("0.##")%;background:@color;border-radius:4px;display:flex;align-items:center;justify-content:center;overflow:hidden;">
                                                @if (pct > 6)
                                                {
                                                    <span style="color:#fff;font-size:0.7rem;font-weight:600;">@pct.ToString("0")%</span>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                                <div class="d-flex flex-wrap gap-3 mt-1">
                                    @foreach (var (lbl, val, color) in bars)
                                    {
                                        <span style="font-size:0.78rem;">
                                            <span style="display:inline-block;width:10px;height:10px;background:@color;border-radius:2px;margin-right:3px;"></span>
                                            @lbl: <strong>@val.ToString("N0")</strong>
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    @* ── Top 10 Outstanding ── *@
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header py-2 fw-bold">🏆 Top 10 Outstanding Terbesar</div>
                            <div class="card-body p-0">
                                <table class="table table-sm table-bordered mb-0" style="font-size:0.8rem;">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>#</th>
                                            <th>Customer</th>
                                            <th class="text-end">Sisa</th>
                                            <th class="text-center">Maks JT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var top10 = Aging
                                                .GroupBy(x => x.NamaCust)
                                                .Select(g => new {
                                                    Nama = g.Key,
                                                    Sisa = g.Sum(x => x.Sisa),
                                                    MaxHari = g.Max(x => (int)(DateTime.Today - x.Duedate).TotalDays)
                                                })
                                                .OrderByDescending(x => x.Sisa)
                                                .Take(10)
                                                .ToList();
                                            int r10 = 1;
                                        }
                                        @foreach (var c in top10)
                                        {
                                            var bg = c.MaxHari > 90 ? "#ffe0e0" : c.MaxHari > 60 ? "#fff3cd" : "";
                                            <tr style="background:@bg;">
                                                <td class="text-muted">@r10</td>
                                                <td>@c.Nama</td>
                                                <td class="text-end fw-bold">@c.Sisa.ToString("N0")</td>
                                                <td class="text-center">@GetTerlambatBadge(c.MaxHari)</td>
                                            </tr>
                                            r10++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    @* ── Salesman performance ── *@
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header py-2 fw-bold">👤 Piutang per Salesman</div>
                            <div class="card-body p-0">
                                <table class="table table-sm table-bordered mb-0" style="font-size:0.8rem;">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Salesman</th>
                                            <th class="text-end">Total Sisa</th>
                                            <th class="text-end">&gt;60hr</th>
                                            <th class="text-center">Cust</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var bySales = Aging
                                                .GroupBy(x => string.IsNullOrWhiteSpace(x.NamaSales) ? "(kosong)" : x.NamaSales)
                                                .Select(g => new {
                                                    Sales = g.Key,
                                                    Sisa  = g.Sum(x => x.Sisa),
                                                    Macet = g.Where(x => (int)(DateTime.Today - x.Duedate).TotalDays > 60)
                                                             .Sum(x => x.Sisa),
                                                    Cust  = g.Select(x => x.Customer).Distinct().Count()
                                                })
                                                .OrderByDescending(x => x.Sisa)
                                                .ToList();
                                        }
                                        @foreach (var s in bySales)
                                        {
                                            <tr>
                                                <td>@s.Sales</td>
                                                <td class="text-end fw-bold">@s.Sisa.ToString("N0")</td>
                                                <td class="text-end @(s.Macet > 0 ? "text-danger fw-bold" : "text-muted")">@s.Macet.ToString("N0")</td>
                                                <td class="text-center">@s.Cust</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── Baris 3: Faktur jatuh tempo 7 hari ke depan ── *@
                @{
                    var jt7 = Aging.Where(x =>
                    {
                        var hari = (int)(x.Duedate - DateTime.Today).TotalDays;
                        return hari >= 0 && hari <= 7;
                    }).OrderBy(x => x.Duedate).ToList();
                }
                @if (jt7.Any())
                {
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="card shadow-sm border-warning">
                                <div class="card-header py-2 fw-bold text-warning">
                                    ⏰ Jatuh Tempo dalam 7 Hari ke Depan (@jt7.Count dokumen · @jt7.Sum(x=>x.Sisa).ToString("N0"))
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-sm table-bordered mb-0" style="font-size:0.8rem;">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Customer</th>
                                                <th>Dokumen</th>
                                                <th class="text-center">Due Date</th>
                                                <th class="text-center">Sisa Hari</th>
                                                <th class="text-end">Sisa</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var f in jt7)
                                            {
                                                var hariSisa = (int)(f.Duedate - DateTime.Today).TotalDays;
                                                <tr>
                                                    <td class="fw-bold">@f.NamaCust</td>
                                                    <td style="font-size:0.75rem;">@f.Dokumen</td>
                                                    <td class="text-center">@(f.Duedate.ToString("dd/MM/yy"))</td>
                                                    <td class="text-center">
                                                        <span class="badge @(hariSisa == 0 ? "bg-danger" : "bg-warning text-dark")">@(hariSisa == 0 ? "HARI INI" : $"{hariSisa} hari")</span>
                                                    </td>
                                                    <td class="text-end fw-bold">@f.Sisa.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            </div>
        }

        @* ══════════════════ TAB ALERT ══════════════════ *@
        @if (ActiveTab == "alert")
        {
            <div class="ar-scroll-tab">
            <div class="container-fluid py-3">
                @{
                    var alertMacet   = Aging.Where(x => (int)(DateTime.Today - x.Duedate).TotalDays > 60).OrderByDescending(x=>x.Sisa).ToList();
                    var alertJt7     = Aging.Where(x => { var h=(int)((x.Duedate)-DateTime.Today).TotalDays; return h>=0&&h<=7; }).OrderBy(x=>x.Duedate).ToList();
                    var alertBelumBayar = Aging.Where(x => x.JumlahCicilan == 0 && (int)(DateTime.Today-(x.Duedate)).TotalDays > 30).OrderByDescending(x=>x.Sisa).ToList();
                }

                @* Macet >60 hari *@
                <div class="card border-danger mb-3 shadow-sm">
                    <div class="card-header bg-danger text-white py-2 fw-bold">
                        🚨 Belum Bayar / Cicilan Berhenti &gt;60 Hari (@alertMacet.Count dokumen · @alertMacet.Sum(x=>x.Sisa).ToString("N0"))
                    </div>
                    @if (alertMacet.Any())
                    {
                        <div class="card-body p-0" style="max-height:280px;overflow-y:auto;">
                            <table class="table table-sm table-bordered mb-0" style="font-size:0.8rem;">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th>Customer</th>
                                        <th>Dokumen</th>
                                        <th class="text-end">Sisa</th>
                                        <th class="text-center">Hari Telat</th>
                                        <th>Info Bayar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in alertMacet)
                                    {
                                        var hari = (int)(DateTime.Today - f.Duedate).TotalDays;
                                        <tr style="background:#fff5f5;">
                                            <td class="fw-bold">@f.NamaCust</td>
                                            <td style="font-size:0.75rem;">@f.Dokumen</td>
                                            <td class="text-end fw-bold text-danger">@f.Sisa.ToString("N0")</td>
                                            <td class="text-center">@GetTerlambatBadge(hari)</td>
                                            <td>@GetInfoBayarBadge(f)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="card-body text-muted py-2">✅ Tidak ada piutang >60 hari.</div>
                    }
                </div>

                @* Belum pernah bayar sama sekali >30 hari *@
                <div class="card border-warning mb-3 shadow-sm">
                    <div class="card-header py-2 fw-bold" style="background:#fff3cd;">
                        ⚠️ Belum Ada Pembayaran Sama Sekali &gt;30 Hari (@alertBelumBayar.Count dokumen · @alertBelumBayar.Sum(x=>x.Sisa).ToString("N0"))
                    </div>
                    @if (alertBelumBayar.Any())
                    {
                        <div class="card-body p-0" style="max-height:250px;overflow-y:auto;">
                            <table class="table table-sm table-bordered mb-0" style="font-size:0.8rem;">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th>Customer</th>
                                        <th>Dokumen</th>
                                        <th class="text-end">Sisa</th>
                                        <th class="text-center">Terlambat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in alertBelumBayar)
                                    {
                                        var hari = (int)(DateTime.Today - f.Duedate).TotalDays;
                                        <tr style="background:#fffbe6;">
                                            <td class="fw-bold">@f.NamaCust</td>
                                            <td style="font-size:0.75rem;">@f.Dokumen</td>
                                            <td class="text-end fw-bold">@f.Sisa.ToString("N0")</td>
                                            <td class="text-center">@GetTerlambatBadge(hari)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="card-body text-muted py-2">✅ Semua faktur sudah ada cicilan.</div>
                    }
                </div>

                @* Jatuh tempo 7 hari *@
                <div class="card border-info mb-3 shadow-sm">
                    <div class="card-header py-2 fw-bold" style="background:#e0f7fa;">
                        ⏰ Jatuh Tempo dalam 7 Hari (@alertJt7.Count dokumen · @alertJt7.Sum(x=>x.Sisa).ToString("N0"))
                    </div>
                    @if (alertJt7.Any())
                    {
                        <div class="card-body p-0" style="max-height:250px;overflow-y:auto;">
                            <table class="table table-sm table-bordered mb-0" style="font-size:0.8rem;">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th>Customer</th>
                                        <th>Dokumen</th>
                                        <th class="text-center">Due Date</th>
                                        <th class="text-center">Sisa Hari</th>
                                        <th class="text-end">Sisa</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in alertJt7)
                                    {
                                        var hariSisa = (int)(f.Duedate - DateTime.Today).TotalDays;
                                        <tr style="background:#e0f7fa;">
                                            <td class="fw-bold">@f.NamaCust</td>
                                            <td style="font-size:0.75rem;">@f.Dokumen</td>
                                            <td class="text-center">@(f.Duedate.ToString("dd/MM/yy"))</td>
                                            <td class="text-center">
                                                <span class="badge @(hariSisa==0?"bg-danger":"bg-info text-dark")">@(hariSisa==0?"HARI INI":$"{hariSisa} hari")</span>
                                            </td>
                                            <td class="text-end fw-bold">@f.Sisa.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="card-body text-muted py-2">✅ Tidak ada yang jatuh tempo dalam 7 hari.</div>
                    }
                </div>
            </div>
            </div>
        }

        @* ══════════════════ TAB COLLECTION ══════════════════ *@
        @if (ActiveTab == "collection")
        {
            <div class="ar-scroll-tab">
            <div class="container-fluid py-3">
                @if (CollectionLoading)
                {
                    <div class="text-center mt-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Memuat data collection...</p>
                    </div>
                }
                else if (CollectionData != null)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-6 col-md-3">
                            <div class="card text-white h-100" style="background:#0d6efd;">
                                <div class="card-body p-2 text-center">
                                    <div class="fw-bold" style="font-size:1.1rem;">@(ColLast?.TotalPenerimaan.ToString("N0") ?? "0")</div>
                                    <small>Bulan Ini / Terakhir</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-dark h-100" style="background:#d1e7dd;">
                                <div class="card-body p-2 text-center">
                                    <div class="fw-bold" style="font-size:1.1rem;">@(((decimal)Col3MonthAvg).ToString("N0"))</div>
                                    <small>Rata-rata 3 Bulan</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-dark h-100" style="background:#fff3cd;">
                                <div class="card-body p-2 text-center">
                                    <div class="fw-bold" style="font-size:1.1rem;">@ColMax.ToString("N0")</div>
                                    <small>Tertinggi</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card text-white h-100" style="background:#6c757d;">
                                <div class="card-body p-2 text-center">
                                    <div class="fw-bold" style="font-size:1.1rem;">@ColTotal.ToString("N0")</div>
                                    <small>Total @CollectionData.Count Bulan</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-3">
                        <div class="card-header py-2 fw-bold">📈 Tren Penerimaan Bulanan</div>
                        <div class="card-body">
                            <div class="d-flex align-items-flex-end gap-2" style="height:140px;">
                                @foreach (var m in CollectionData)
                                {
                                    var pct = ColMaxVal > 0 ? (double)m.TotalPenerimaan / ColMaxVal * 100.0 : 0;
                                    var isLast = m == ColLast;
                                    <div class="d-flex flex-column align-items-center justify-content-end" style="flex:1;height:100%;">
                                        <span style="font-size:0.6rem;color:#555;margin-bottom:2px;">@m.TotalPenerimaan.ToString("N0")</span>
                                        <div title="@m.LabelBulan: @m.TotalPenerimaan.ToString("N0")"
                                             style="width:100%;height:@pct.ToString("0.##")%;background:@(isLast?"#0d6efd":"#86b7fe");border-radius:3px 3px 0 0;min-height:4px;">
                                        </div>
                                        <span style="font-size:0.65rem;margin-top:3px;font-weight:@(isLast?"700":"400");">@m.LabelBulan</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Tabel detail *@
                    <div class="card shadow-sm">
                        <div class="card-header py-2 fw-bold">📋 Detail per Bulan</div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-bordered mb-0" style="font-size:0.82rem;">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Bulan</th>
                                        <th class="text-end">Penerimaan</th>
                                        <th class="text-end">Bayar</th>
                                        <th class="text-end">Diskon</th>
                                        <th class="text-center">Faktur</th>
                                        <th class="text-center">Tren</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int ci = 0; ci < CollectionData.Count; ci++)
                                    {
                                        var m = CollectionData[ci];
                                        var prev = ci > 0 ? CollectionData[ci - 1].TotalPenerimaan : m.TotalPenerimaan;
                                        var diff = m.TotalPenerimaan - prev;
                                        var trendIcon = ci == 0 ? "–" : diff > 0 ? "▲" : diff < 0 ? "▼" : "–";
                                        var trendColor = diff > 0 ? "text-success" : diff < 0 ? "text-danger" : "text-muted";
                                        <tr>
                                            <td class="fw-bold">@m.LabelBulan</td>
                                            <td class="text-end fw-bold">@m.TotalPenerimaan.ToString("N0")</td>
                                            <td class="text-end text-muted">@m.TotalBayar.ToString("N0")</td>
                                            <td class="text-end text-muted">@m.TotalDiscount.ToString("N0")</td>
                                            <td class="text-center">@m.JumlahFaktur</td>
                                            <td class="text-center @trendColor fw-bold">
                                                @trendIcon
                                                @if (ci > 0)
                                                {
                                                    <small style="font-size:0.7rem;">@diff.ToString("N0")</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary fw-bold">
                                    <tr>
                                        <td>Total</td>
                                        <td class="text-end">@ColTotal.ToString("N0")</td>
                                        <td class="text-end">@CollectionData.Sum(x=>x.TotalBayar).ToString("N0")</td>
                                        <td class="text-end">@CollectionData.Sum(x=>x.TotalDiscount).ToString("N0")</td>
                                        <td class="text-center">@CollectionData.Sum(x=>x.JumlahFaktur)</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }
            </div>
            </div>
        }

        @* ══════════════════ TAB TABEL (existing) ══════════════════ *@
