                                <td class="text-end">@FilteredRows.Sum(x=>x.Jumlah1).ToString("N0")</td>
                                <td class="text-end">@FilteredRows.Sum(x=>x.Jumlah2).ToString("N0")</td>
                                <td class="text-end">@FilteredRows.Sum(x=>x.Jumlah3).ToString("N0")</td>
                                <td class="text-end">@FilteredRows.Sum(x=>x.Jumlah4).ToString("N0")</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }

        
        @if (ActiveTab == "customer")
