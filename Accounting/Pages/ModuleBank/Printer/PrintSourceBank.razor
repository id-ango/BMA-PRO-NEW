@layout PrintLayout

@page "/ModulePrinting/PrintSourceBank/{query}"

@using eSoft.CashBank.Model
@using eSoft.CashBank.View
@using eSoft.CashBank.Services



@inject ICashBankServices cashBank

@inject NavigationManager navigationmanager

<div class="dontprint" style="display:none inline">
    <br />
    &emsp;

    <NavLink href="/ModuleBank/SourceBank" class="btn btn-primary btn-lg">&nbsp;Back&nbsp;</NavLink>

    &emsp;
    <NavLink class="btn btn-success btn-lg" onclick="window.print()">&nbsp; Cetak &nbsp;</NavLink>
    &emsp;
</div>

<table width="100%" border="0" cellspacing="0" cellpadding="0">

    <thead>

        <tr>
            <td colspan="3">&nbsp;</td>
        </tr>


        <tr>
            <td colspan="3" style="font-family:Verdana, Geneva, sans-serif; font-weight:600; font-size:15px;" align="center">
                @Title
            </td>
        </tr>

    </thead>
    <tbody>
        <tr>
            <td colspan="3">
                <table width="100%" border="0" cellspacing="0" cellpadding="4">
                    <thead>
                        <tr>
                            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:600; font-size:13px; border-top:1px solid #333; border-bottom:1px solid #333; border-left:1px solid #333; border-right:1px solid #333;" width="5%" height="32" align="center">No.</td>
                            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:600; font-size:13px; border-top:1px solid #333; border-bottom:1px solid #333; border-right:1px solid #333;" width="20%" align="center">Dokumen</td>
                            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:600; font-size:13px; border-top:1px solid #333; border-bottom:1px solid #333; border-right:1px solid #333;" width="10%" align="center">Tanggal</td>
                              <td style="font-family:Verdana, Geneva, sans-serif; font-weight:600; font-size:13px; border-top:1px solid #333; border-bottom:1px solid #333; border-right:1px solid #333;" width="5%" align="center">Code</td>
                              <td style="font-family:Verdana, Geneva, sans-serif; font-weight:600; font-size:13px; border-top:1px solid #333; border-bottom:1px solid #333; border-right:1px solid #333;" width="5%" align="center">Bank</td>
                            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:600; font-size:13px; border-top:1px solid #333; border-bottom:1px solid #333; border-right:1px solid #333;" width="40%" align="center">Keterangan</td>
                            @* <td style="font-family:Verdana, Geneva, sans-serif; font-weight:600; font-size:13px; border-top:1px solid #333; border-bottom:1px solid #333; border-right:1px solid #333;" width="15%" align="center">Qty</td>*@
                            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:600; font-size:13px; border-top:1px solid #333; border-bottom:1px solid #333; border-right:1px solid #333;" width="15%" align="center">Saldo</td>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in TransDetail)
                        {

                            <tr>
                                <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px;  border-left:1px solid #333; " align="left">@(No++)</td>
                                <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px;  " align="left">@item.DocNo </td>
                                <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px;  " align="left">@item.Tanggal.ToShortDateString()</td>
                                <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px;  " align="center">@item.SrcCode</td>
                                <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px;  " align="center">@item.KodeBank</td>
                                <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px;  " align="left">@item.Keterangan</td>
                              
                                <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px;   border-right:1px solid #333;" align="right">@item.Saldo.ToString("N")</td>
                            </tr>
                        }



                        <tr>
                            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:13px; border-bottom:1px solid #333;  border-left:1px solid #333; " align="center">&emsp;</td>
                            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:13px; border-bottom:1px solid #333;  " align="center"></td>
                            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:13px; border-bottom:1px solid #333;  " align="center"></td>
                             <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:13px; border-bottom:1px solid #333;  " align="center"></td>
                              <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:13px; border-bottom:1px solid #333;  " align="center"></td>
                            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:13px; border-bottom:1px solid #333;  " align="center"></td>
                            @* <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:13px; border-bottom:1px solid #333;  " align="center"></td>*@
                            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:13px; border-bottom:1px solid #333;   border-right:1px solid #333;" align="center"></td>
                        </tr>

                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:13px;" align="right">
                            </td>
                        </tr>
                    </tfoot>

                </table>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px;   " align="left">Tanggal cetak. @DateTime.Now</td>
            @*<td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px; border-top:1px solid #333;  " align="right">&nbsp;</td>
            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px; border-top:1px solid #333;  " align="right">&nbsp;</td>*@
            @* <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:13px; border-bottom:1px solid #333;  " align="center"></td>*@
            <td style="font-family:Verdana, Geneva, sans-serif; font-weight:300; font-size:11px; border-top:1px solid #333;  " align="right">@TransDetail.Sum(x =>x.Saldo).ToString("N")</td>
        </tr>



        <tr>
            <td colspan="2">&nbsp;</td>
        </tr>

    </tbody>
</table>






@code {

    [Parameter] public string query { get; set; }

    public string Kode { get; set; }
    public string Banks { get; set; } 
    public DateTime Tanggal1 { get; set; }
    public DateTime Tanggal2 { get; set; }

    private List<RekeningView> TransDetail = new List<RekeningView>();

    private string Title = "Rekening Bank/Kas";

    private int No = 0;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        loadStock();

    }

    protected override void OnParametersSet()
    {
        //the param will be set now
        var test = query;
    }

    private void loadStock()
    {
        string[] words = query.Split('+');
        string[] srcCode = new string[] { };
        string[] kodeBank = new string[] { };

        Kode = words[0];
        Tanggal1 = DateTime.Parse(words[1]);
        Tanggal2 = DateTime.Parse(words[2]);
        Banks = words[3];

        srcCode = Kode.Split('-');
         kodeBank = Banks.Split('-');

     //   if(!string.IsNullOrWhiteSpace(Kode))
      //      Title = cashBank.GetSrcCodeKd(Kode).NamaSrc;

        TransDetail = cashBank.CetakSourceBank(Tanggal1, Tanggal2, srcCode,kodeBank);

        StateHasChanged();

    }


}
