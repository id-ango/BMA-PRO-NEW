    private void LoadGet()
    {
        Banks = cashBank.GetBank();
    }




    private void OpenCetak()
    {
        SearchOpen = !SearchOpen;

        RekKoran = cashBank.CetakMutasi(TglStart, TglEnd, kodeBank);
        StateHasChanged();

    }

