          navigationmanager.NavigateTo($"/ModulePrinting/RekeningBank/{words}");
        StateHasChanged();

    }

    private void OnKurs(ChangeEventArgs args)
    {
        kurs = (from e in Banks where e.KodeBank == args.Value.ToString() select e.Kurs).FirstOrDefault();
    }

  

