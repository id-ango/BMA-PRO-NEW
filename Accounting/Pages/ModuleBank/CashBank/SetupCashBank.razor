@page "/ModuleBank/SetupCashBank"
@using eSoft.CashBank.Model
@using eSoft.CashBank.Services



@inject ICashBankServices cashBank
@implements IDisposable
@inject NavigationManager navigationmanager

<div class="container">
    <h1>Setup CashBank</h1>
</div>


<div class="container">
    <NavLink href="/ModuleBank/AddCashBank" class="btn btn-primary">Add</NavLink>
</div>

<br />
<br />


<div class="container">
    <DataGridComponent Items="SortedBanks" Context="cbBank" GetFilterableText="@(item =>$"{item.KodeBank} {item.NmBank} {item.Kurs}")">
        <TableHeader>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(CbBank.KodeBank)))" @onclick='() => ApplySort(nameof(CbBank.KodeBank))'>Code <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(CbBank.KodeBank))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(CbBank.NmBank)))" @onclick='() => ApplySort(nameof(CbBank.NmBank))'>Bank Name <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(CbBank.NmBank))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(CbBank.Saldo)))" @onclick='() => ApplySort(nameof(CbBank.Saldo))'>Saldo <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(CbBank.Saldo))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(CbBank.KSaldo)))" @onclick='() => ApplySort(nameof(CbBank.KSaldo))'>Balance <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(CbBank.KSaldo))</span></button></th>
            <th scope="col"><button type="button" class="data-grid-sort-button @(GetSortButtonClass(nameof(CbBank.Kurs)))" @onclick='() => ApplySort(nameof(CbBank.Kurs))'>Currency <span class="data-grid-sort-indicator">@GetSortIndicator(nameof(CbBank.Kurs))</span></button></th>
            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@cbBank.KodeBank</td>
            <td>@cbBank.NmBank</td>
            <td>@cbBank.Saldo.ToString("N")</td>
            <td>@cbBank.KSaldo.ToString("N")</td>
            <td>@cbBank.Kurs</td>
            <td>
                <button @onclick="() => OpenRubah(cbBank.CbBankId)" class="btn btn-success">Edit</button>
                <button @onclick="() => OpenDeleteDialog(cbBank)" class="btn btn-danger">Delete</button>
            </td>
        </RowTemplate>
    </DataGridComponent>

    
</div>

@if (DeleteDialogOpen)
{
    <ModalDialogComponent Title="Are you sure?" Text="Do you want to delete this entry?" OnClose="OnDeleteDialogClose"></ModalDialogComponent>
}

@if (NullDialogOpen)
{
    <ModalDialogComponent Title="MESSAGE" Text="Saldo is not Zero" TombolSave="false" OnClose="OnDeleteNullClose"></ModalDialogComponent>
}



@code {

    private List<CbBank> Banks;
    private CbBank _bankToDelete;
    private string currentSortColumn = nameof(CbBank.KodeBank);
    private bool sortAscending = true;

    private IEnumerable<CbBank> SortedBanks => ApplyCurrentSort(Banks ?? new List<CbBank>());

    public bool DeleteDialogOpen { get; set; }
    public bool NullDialogOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LoadGet();

    }

    private void LoadGet()
    {
        Banks = cashBank.GetBank();
    }

    private void ApplySort(string columnName)
    {
        if (string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            sortAscending = !sortAscending;
            return;
        }

        currentSortColumn = columnName;
        sortAscending = true;
    }

    private IEnumerable<CbBank> ApplyCurrentSort(IEnumerable<CbBank> source)
    {
        return currentSortColumn switch
        {
            nameof(CbBank.NmBank) => OrderBy(source, x => x.NmBank),
            nameof(CbBank.Saldo) => sortAscending ? source.OrderBy(x => x.Saldo) : source.OrderByDescending(x => x.Saldo),
            nameof(CbBank.KSaldo) => sortAscending ? source.OrderBy(x => x.KSaldo) : source.OrderByDescending(x => x.KSaldo),
            nameof(CbBank.Kurs) => OrderBy(source, x => x.Kurs),
            _ => OrderBy(source, x => x.KodeBank)
        };
    }

    private IEnumerable<CbBank> OrderBy<TKey>(IEnumerable<CbBank> source, Func<CbBank, TKey> keySelector)
    {
        return sortAscending ? source.OrderBy(keySelector) : source.OrderByDescending(keySelector);
    }

    private string GetSortButtonClass(string columnName)
    {
        return string.Equals(currentSortColumn, columnName, StringComparison.Ordinal) ? "active" : string.Empty;
    }

    private string GetSortIndicator(string columnName)
    {
        if (!string.Equals(currentSortColumn, columnName, StringComparison.Ordinal))
        {
            return "↕";
        }

        return sortAscending ? "↑" : "↓";
    }


    private async Task OnDeleteDialogClose(bool accepted)
    {
        if (accepted)
        {
            await cashBank.DelBank(_bankToDelete.CbBankId);
            _bankToDelete = null;
        }

        DeleteDialogOpen = false;
        LoadGet();

        StateHasChanged();

    }

    private void OnDeleteNullClose(bool accepted)
    {
        //if (accepted)
        //{
        //    await cashBank.DelBank(_bankToDelete.CbBankId);
        //    _bankToDelete = null;
        //}

        DeleteDialogOpen = false;
        NullDialogOpen = false;
        LoadGet();
        StateHasChanged();

    }
    private void OpenDeleteDialog(CbBank bank)
    {
        if (bank.Saldo != 0)
        {
            NullDialogOpen = true;
        }
        else
        {
            DeleteDialogOpen = true;
        }


        _bankToDelete = bank;
        StateHasChanged();
    }

    private void OpenRubah(int xKdBank)
    {
        navigationmanager.NavigateTo($"/ModuleBank/EditCashBank/{xKdBank}");
    }


    public void Dispose()
    {

    }
}
