@page "/ModuleBank/AddSrcGroup"
@using eSoft.CashBank.Model
@using eSoft.CashBank.View

@inject ICashBankServices service

@inject NavigationManager navigationmanager


<div class="top-row px-4 " style="z-index:5">
    <h3>Add Source Group</h3>
</div>

<div class="content px-4">
    <EditForm Model="@bank" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label>
                Group Code :
                <InputText id="codeBank" class="form-control" @bind-Value="bank.Grp" style="text-transform:uppercase" @onfocusout="cekKode" />
            </label>
        </div>
        <div class="form-group">
            <label>
                Nama Group :
                <InputText class="form-control" @bind-Value="bank.NamaGrp" />
            </label>
        </div>
        <br />

        
        <br />
        <div class="float-md-right">
            <button class="btn-success" type="submit">Simpan</button>
            <button class="btn-danger" type="button" @onclick="@(() => navigationmanager.NavigateTo("/ModuleBank/SetupSrcGroup", false))">Batal</button>
        </div>

    </EditForm>
</div>

@if (DialogOpen)
{
    <ModalDialogComponent Title="Alert" Text="Kode Group Sudah Ada" TombolSave="false" OnClose="OnDialogClose"></ModalDialogComponent>
}



<style>
    label {
        width: 100%;
    }
</style>


@code {
    SrcGroupView bank = new ();
    public string Testing { get; set; }
    private bool DialogOpen { get; set; }
  

    protected override void OnInitialized()
    {
        base.OnInitialized();
        bank.Grp = "";
       
    }

    private void cekKode()
    {
        Testing = bank.Grp;
        DialogOpen = service.CekSrcGroup(Testing);
        if (DialogOpen)
        {
            bank.Grp = "";
        }
        StateHasChanged();
    }

    private void OnDialogClose(bool accepted)
    {

        DialogOpen = false;
        StateHasChanged();

    }



    private void HandleValidSubmit()
    {
        var newEdit = service.AddSrcGroup(bank);
        if (newEdit)
        {


        }

        navigationmanager.NavigateTo("/ModuleBank/SetupSrcGroup", false);

    }

  
}
