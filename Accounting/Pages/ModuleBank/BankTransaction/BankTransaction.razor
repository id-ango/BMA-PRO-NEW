    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        transactions.Clear();
        var file = e.File;
        try
        {
            // Read all lines first to detect header style
            var allText = string.Empty;
            using (var reader = new StreamReader(file.OpenReadStream()))
            {
                allText = await reader.ReadToEndAsync();
            }

            var lines = allText.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries).ToList();

            // Try detect header line for 'Tanggal Transaksi' (Indonesian export)
            int startIndex = -1;
            for (int i = 0; i < lines.Count; i++)
            {
                if (lines[i].IndexOf("Tanggal Transaksi", StringComparison.OrdinalIgnoreCase) >= 0 ||
                    lines[i].IndexOf("Tanggal transaksi", StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    startIndex = i + 1; // start after header
                    break;
                }
            }

            List<string> dataLines = new();

            if (startIndex >= 0)
            {
                // collect lines after header until Saldo Awal or similar
                for (int i = startIndex; i < lines.Count; i++)
                {
                    var l = lines[i].Trim();
                    if (string.IsNullOrWhiteSpace(l)) continue;
                    if (l.StartsWith("Saldo Awal", StringComparison.OrdinalIgnoreCase) || l.StartsWith("\"Saldo Awal", StringComparison.OrdinalIgnoreCase))
                        break;
                    dataLines.Add(l);
                }
            }
            else
            {
                // fallback: many exports have 4 header lines then data
                if (lines.Count > 4)
                {
                    dataLines = lines.Skip(4).ToList();
                }
                else
                {
                    dataLines = lines;
                }
            }

            parseErrors.Clear();
            int row = startIndex >= 0 ? startIndex + 1 : 5;
            foreach (var line in dataLines)
            {
                try
                {
                    if (string.IsNullOrWhiteSpace(line))
                    {
                        row++;
                        continue;
                    }

                    // skip summary lines
                    if (line.StartsWith("Starting Balance", StringComparison.OrdinalIgnoreCase)
                        || line.StartsWith("Credit", StringComparison.OrdinalIgnoreCase)
                        || line.StartsWith("Debet", StringComparison.OrdinalIgnoreCase)
                        || line.StartsWith("Ending Balance", StringComparison.OrdinalIgnoreCase))
                    {
                        row++;
                        continue;
                    }

                    var values = SplitCsvLine(line);
                    if (values.Count < 5)
                    {
                        // not enough columns
                        var msg = $"Line {row} skipped: columns={values.Count} | Raw: {line}";
                        Console.Error.WriteLine(msg);
                        parseErrors.Add(msg);
                        row++;
                        continue;
                    }

                    var transaction = ParseTransaction(values);
                    if (transaction != null) transactions.Add(transaction);
                }
                catch (Exception ex)
                {
                    var msg = $"Error processing line {row}: {ex.Message} | Raw: {line}";
                    Console.Error.WriteLine(msg);
                    parseErrors.Add(msg);
                }
                finally
                {
                    row++;
                }
            }

            // After parsing, check duplicates if bank selected
            if (!string.IsNullOrEmpty(formModel.BankName) && transactions.Any())
            {
                try
                {
                    var flags = await service.CheckDuplicatesAsync(transactions, formModel.BankName);
                    for (int i = 0; i < transactions.Count && i < flags.Count; i++)
                    {
                        transactions[i].IsDuplicate = flags[i];
                        // auto-uncheck duplicates so user must explicitly re-select if needed
                        if (flags[i]) transactions[i].IsSelected = false;
                    }
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Error checking duplicates: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error processing file: {ex.Message}");
        }
        StateHasChanged();
    }

