@page "/ModuleBank/BankTransaction"

@using System.Globalization
@using System.IO
@using System.ComponentModel.DataAnnotations
@using eSoft.CashBank.View
@using eSoft.CashBank.Model
@using eSoft.CashBank.Services
@using eSoft.Piutang.Services
@using eSoft.Hutang.Services
@using eSoft.Piutang.Model
@using eSoft.Hutang.Model

@inject ICashBankServices service
@inject NavigationManager navigationmanager
@inject IJSRuntime JS
@inject IReceivableServices receivableService
@inject IPayableServices payableService

<style>
    .textarea-auto-height {
        height: 80px;
        width: 100%;
        overflow-y: auto;
        resize: vertical;
    }

    .alloc-badge {
        display: inline-block;
        font-size: 0.78rem;
        background: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
        border-radius: 12px;
        padding: 2px 10px;
    }

        .alloc-badge.warn {
            background: #fff3cd;
            color: #856404;
            border-color: #ffc107;
        }

        .alloc-badge.over {
            background: #f8d7da;
            color: #842029;
            border-color: #f5c2c7;
        }

        .alloc-badge.exact {
            background: #d1e7dd;
            color: #0a3622;
            border-color: #a3cfbb;
        }

    .trx-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
    }

        .trx-table thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #343a40;
            color: #fff;
            padding: 6px 8px;
            white-space: nowrap;
        }

        .trx-table tbody td {
            padding: 6px 8px;
            vertical-align: top;
            border-bottom: 1px solid #dee2e6;
        }

    .trx-main-row:hover > td {
        background: #f0f4ff;
    }

    .trx-detail-row > td {
        background: #f0f7ff !important;
        border-top: none !important;
        padding: 10px 14px !important;
    }

    .dup-row > td {
        background: #fff3cd !important;
    }

    .doc-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
    }

        .doc-table th {
            background: #e9ecef;
            padding: 4px 8px;
            text-align: left;
            font-size: 0.75rem;
            color: #495057;
        }

        .doc-table td {
            padding: 4px 6px;
            border-bottom: 1px solid #e9ecef;
            vertical-align: middle;
        }

        .doc-table tr.selected-doc > td {
            background: #d4edda;
        }
</style>

<div class="top-row px-4" style="z-index:5">
    <h3>Bank Transactions</h3>
</div>

<div class="container">
    <EditForm Model="@formModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Select Bank:</label>
            <InputSelect class="form-control" @bind-Value="formModel.BankName" style="width:100% !important">
                <option value="">---Select Bank---</option>
                @foreach (var item in banks)
                {
                    <option value="@item.KodeBank">[@item.KodeBank] @item.NmBank</option>
                }
            </InputSelect>
        </div>

        <div class="form-group">
            <label>Date:</label>
            <InputDate class="form-control" @bind-Value="formModel.Date" />
        </div>
        <br />
        <div class="form-group">
            <label>Upload CSV:</label>
            <InputFile OnChange="HandleFileSelected" disabled="@isProcessing" />
        </div>

        <div class="float-md-right">
            <button class="btn btn-primary" type="submit" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                    <span>Processing...</span>
                }
                else
                {
                    <span><i class="bi bi-save"></i> Submit</span>
                }
            </button>
        </div>
    </EditForm>
</div>

@* Confirmation modal *@
@if (showConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Konfirmasi Simpan</h5>
                    <button type="button" class="close" @onclick="() => showConfirm = false">&times;</button>
                </div>
                <div class="modal-body">
                    <p>Anda akan menyimpan <strong>@SelectedCount</strong> transaksi.</p>
                    @if (!string.IsNullOrEmpty(confirmMessage))
                    {
                        <pre style="white-space:pre-wrap;">@confirmMessage</pre>
                    }
                    else
                    {
                        <p>Apakah anda yakin ingin melanjutkan?</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showConfirm = false" disabled="@isProcessing">Batal</button>
                    <button class="btn btn-primary" @onclick="ConfirmSave" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                            <span>Menyimpan...</span>
                        }
                        else
                        {
                            <span>Simpan</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="container">
    @if (showErrorDetails && !string.IsNullOrEmpty(lastErrorDetails))
    {
        <div class="alert alert-danger alert-dismissible">
            <button type="button" class="close" aria-label="Close" @onclick="() => { showErrorDetails = false; lastErrorDetails = string.Empty; }">&times;</button>
            <strong>Error saat menyimpan:</strong>
            <pre style="white-space:pre-wrap; max-height:360px; overflow:auto;">@lastErrorDetails</pre>
            <div>
                <button class="btn btn-sm btn-outline-light" @onclick="CopyLastError">Copy Error</button>
            </div>
        </div>
    }
    @if (transactions != null && transactions.Any())
    {
        <h4>Transaction Data</h4>
        @if (parseErrors != null && parseErrors.Any())
        {
            <div class="alert alert-warning alert-dismissible mt-2 mb-2" style="font-size:0.88rem;">
                <button type="button" class="close" @onclick="() => parseErrors.Clear()">&times;</button>
                <strong>⚠ @parseErrors.Count baris dilewati saat parsing</strong>
                <pre style="white-space:pre-wrap; max-height:100px; overflow:auto; font-size:0.75rem; margin:4px 0 0 0;">@string.Join("\n", parseErrors)</pre>
                <button class="btn btn-sm btn-outline-secondary mt-1" @onclick="CopyErrors">Copy Errors</button>
            </div>
        }
        <div class="d-flex flex-wrap gap-1 mb-2">
            <button class="btn btn-danger btn-sm" @onclick="DeleteSelectedTransactions"><i class="bi bi-trash"></i> Delete Selected</button>
            <button class="btn btn-secondary btn-sm" @onclick="SelectAllRows"><i class="bi bi-check-all"></i> Select All</button>
            <button class="btn btn-info btn-sm" @onclick="SelectNonDuplicateRows">Select Non-Duplicates</button>
            <button class="btn btn-warning btn-sm" @onclick="UncheckDuplicates">Uncheck Duplicates</button>
            <span class="badge bg-primary align-self-center ms-2">@SelectedCount dipilih</span>
        </div>
        <div class="mb-2 d-flex align-items-center gap-2">
            <input class="form-control form-control-sm" style="max-width:320px;" placeholder="🔍 Cari deskripsi / tipe..." @bind="searchText" @bind:event="oninput" />
        </div>
        <div style="overflow-x:auto;">
            <table class="trx-table">
                <thead>
                    <tr>
                        <th style="width:32px"><input type="checkbox" checked="@selectAll" @onchange="SelectAllChanged" /></th>
                        <th style="width:80px">Target</th>
                        <th style="width:68px">Dup</th>
                        <th style="width:88px">Tanggal</th>
                        <th>Deskripsi</th>
                        <th style="width:110px; text-align:right">Jumlah</th>
                        <th style="width:110px; text-align:right">Saldo</th>
                        <th style="width:130px">Tgl Transaksi</th>
                        <th style="width:170px">Source Code</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ctx in FilteredTransactions)
                    {
                        <tr class="trx-main-row @(ctx.IsDuplicate ? "dup-row" : "")" @key="ctx">
                            <td style="padding-top:10px;">
                                <input type="checkbox" checked="@ctx.IsSelected" @onchange="@(e => ToggleSelection(ctx, e))" />
                            </td>
                            <td>
                                <InputSelect class="form-control form-control-sm" @bind-Value="ctx.Target">
                                    <option value="CB">CB (Bank)</option>
                                    <option value="AR">AR (Regular)</option>
                                    <option value="ARDP">ARDP (DP)</option>
                                    <option value="AP">AP (Regular)</option>
                                    <option value="APDP">APDP (DP)</option>
                                </InputSelect>
                            </td>
                            <td style="padding-top:10px;">
                                @if (ctx.IsDuplicate)
                                {
                                    <span class="badge bg-warning text-dark">Duplikat</span>
                                }
                            </td>
                            <td style="padding-top:10px; white-space:nowrap; font-size:0.85rem;">@ctx.Date</td>
                            <td>
                                <textarea class="form-control textarea-auto-height" @bind="ctx.Description" @bind:event="oninput"></textarea>
                            </td>
                            <td style="padding-top:10px; text-align:right; white-space:nowrap; font-size:0.9rem;">
                                @{
                                    // DB (Debit) = red, CR (Credit) = current color logic
                                    var amtStyle = ctx.Type == "DB" ? "color:#dc3545; font-weight:600;" : ctx.Amount < 0 ? "color:#dc3545;" : ctx.Amount > 0 ? "color:#198754;" : "";
                                }
                                <span style="@amtStyle">@ctx.Amount.ToString("N2")</span>
                            </td>
                            <td style="padding-top:10px; text-align:right; white-space:nowrap; font-size:0.9rem;">@ctx.Balance.ToString("N2")</td>
                            <td>
                                <input type="date" @bind="ctx.Tanggal" class="form-control form-control-sm" />
                            </td>
                            <td>
                                <div style="display:flex; flex-direction:column; gap:4px;">
                                    <div style="display:flex; gap:4px; align-items:center;">
                                        <input type="text" class="form-control form-control-sm" placeholder="Search source code..." 
                                               value="@GetSrcCodeFilterText(ctx)" 
                                               @oninput="@((ChangeEventArgs e) => OnSrcCodeFilterChanged(ctx, e))" style="flex:1;" />
                                        @if (!string.IsNullOrEmpty(GetSrcCodeFilterText(ctx)))
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => { SetSrcCodeFilterText(ctx, string.Empty); })" style="padding: 0.25rem 0.5rem;">✕</button>
                                        }
                                    </div>
                                    <InputSelect class="form-control form-control-sm" @bind-Value="ctx.SrcCode">
                                        <option value="">--- Select SrcCode ---</option>
                                        @foreach (var item in GetFilteredSourceCodes(ctx))
                                        {
                                            <option value="@item.SrcCode">[@item.SrcCode] @item.NamaSrc</option>
                                        }
                                    </InputSelect>
                                </div>
                            </td>
                        </tr>
                        @if (ctx.Target == "AR" || ctx.Target == "AP" || ctx.Target == "ARDP" || ctx.Target == "APDP")
                        {
                            <tr class="trx-detail-row">
                                <td colspan="9">
                                    <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:8px;">
                                        @if (ctx.Target == "AR")
                                        {
                                            <label style="font-size:0.78rem; font-weight:600; color:#6c757d; text-transform:uppercase; margin:0;">Customer</label>
                                            <div style="display:flex; flex-direction:column; gap:4px; min-width:420px;">
                                                <div style="display:flex; gap:4px; align-items:center;">
                                                    <input type="text" class="form-control form-control-sm" placeholder="Search customer by code or name..." 
                                                           value="@GetCustomerFilterText(ctx)" 
                                                           @oninput="@((ChangeEventArgs e) => OnCustomerFilterChanged(ctx, e))" style="flex:1;" />
                                                    @if (!string.IsNullOrEmpty(GetCustomerFilterText(ctx)))
                                                    {
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => { SetCustomerFilterText(ctx, string.Empty); })" style="padding: 0.25rem 0.5rem;">✕</button>
                                                    }
                                                </div>
                                                <select class="form-control form-control-sm" style="max-width:420px;" value="@ctx.PartyCode"
                                                        @onchange="@(async (ChangeEventArgs e) => await PartySelectionChanged(ctx, e))">
                                                    <option value="">--- Pilih Customer ---</option>
                                                    @foreach (var c in GetFilteredCustomers(ctx))
                                                    {
                                                        <option value="@c.Customer">[@c.Customer] @c.NamaCust</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else if (ctx.Target == "ARDP")
                                        {
                                            <label style="font-size:0.78rem; font-weight:600; color:#6c757d; text-transform:uppercase; margin:0;">Customer</label>
                                            <div style="display:flex; flex-direction:column; gap:4px; min-width:420px;">
                                                <div style="display:flex; gap:4px; align-items:center;">
                                                    <input type="text" class="form-control form-control-sm" placeholder="Search customer by code or name..." 
                                                           value="@GetCustomerFilterText(ctx)" 
                                                           @oninput="@((ChangeEventArgs e) => OnCustomerFilterChanged(ctx, e))" style="flex:1;" />
                                                    @if (!string.IsNullOrEmpty(GetCustomerFilterText(ctx)))
                                                    {
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => { SetCustomerFilterText(ctx, string.Empty); })" style="padding: 0.25rem 0.5rem;">✕</button>
                                                    }
                                                </div>
                                                <select class="form-control form-control-sm" style="max-width:420px;" value="@ctx.PartyCode"
                                                        @onchange="@(async (ChangeEventArgs e) => await PartySelectionChanged(ctx, e))">
                                                    <option value="">--- Pilih Customer ---</option>
                                                    @foreach (var c in GetFilteredCustomers(ctx))
                                                    {
                                                        <option value="@c.Customer">[@c.Customer] @c.NamaCust</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else
                                        {
                                            <label style="font-size:0.78rem; font-weight:600; color:#6c757d; text-transform:uppercase; margin:0;">Supplier</label>
                                            <div style="display:flex; flex-direction:column; gap:4px; min-width:420px;">
                                                <div style="display:flex; gap:4px; align-items:center;">
                                                    <input type="text" class="form-control form-control-sm" placeholder="Search supplier by code or name..." 
                                                           value="@GetSupplierFilterText(ctx)" 
                                                           @oninput="@((ChangeEventArgs e) => OnSupplierFilterChanged(ctx, e))" style="flex:1;" />
                                                    @if (!string.IsNullOrEmpty(GetSupplierFilterText(ctx)))
                                                    {
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => { SetSupplierFilterText(ctx, string.Empty); })" style="padding: 0.25rem 0.5rem;">✕</button>
                                                    }
                                                </div>
                                                <select class="form-control form-control-sm" style="max-width:420px;" value="@ctx.PartyCode"
                                                        @onchange="@(async (ChangeEventArgs e) => await PartySelectionChanged(ctx, e))">
                                                    <option value="">--- Pilih Supplier ---</option>
                                                    @foreach (var s in GetFilteredSuppliers(ctx))
                                                    {
                                                        <option value="@s.Supplier">[@s.Supplier] @s.NamaSup</option>
                                                    }
                                                </select>
                                            </div>
                                        }

                                        @* TransactionType selector for AR & AP *@
                                        @* @if (ctx.Target == "AR" || ctx.Target == "AP")
                                        {
                                            <label style="font-size:0.78rem; font-weight:600; color:#6c757d; text-transform:uppercase; margin:0; margin-left:12px;">Tipe</label>
                                            <select class="form-control form-control-sm" style="max-width:180px;" @bind="ctx.TransactionType">
                                                <option value="PAYMENT">Regular Payment</option>
                                                <option value="DOWNPAYMENT">Down Payment</option>
                                            </select>
                                        } *@

                                        @* Currency & Kurs for APDP only *@
                                        @if (ctx.Target == "APDP")
                                        {
                                            @* For APDP: Currency loaded from supplier master (read-only display) *@
                                            <label style="font-size:0.78rem; font-weight:600; color:#6c757d; text-transform:uppercase; margin:0; margin-left:12px;">Currency (from Supplier)</label>
                                            <input type="text" class="form-control form-control-sm" style="max-width:100px;" @bind="ctx.Currency" readonly />
                                            <small style="color:#6c757d; font-size:0.75rem;">Loaded from supplier master data</small>

                                            <label style="font-size:0.78rem; font-weight:600; color:#6c757d; text-transform:uppercase; margin:0;"><span style="color:red;">*</span> Kurs</label>
                                            <input type="number" class="form-control form-control-sm" placeholder="15500.00" style="max-width:150px;" @bind="ctx.Kurs" @bind:event="oninput" step="0.0001" min="0" />

                                            @if (ctx.Kurs > 1m && !string.IsNullOrEmpty(ctx.Currency))
                                            {
                                                <small style="color:#198754; font-weight:600;">1 @ctx.Currency = @(ctx.Kurs.ToString("N2")) IDR</small>
                                            }
                                            else
                                            {
                                                <small style="color:#dc3545; font-weight:600;">⚠️ Required for APDP</small>
                                            }
                                        }
                                    </div>

                                    @* Foreign Amount Section for APDP only *@
                                    @if (ctx.Target == "APDP")
                                    {
                                        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:8px; border-top:1px solid #dee2e6; padding-top:8px;">
                                            <label style="font-size:0.78rem; font-weight:600; color:#6c757d; text-transform:uppercase; margin:0;"><span style="color:red;">*</span> Amount (@ctx.Currency)</label>
                                            <input type="number" class="form-control form-control-sm" placeholder="300.75" style="max-width:150px;" @bind="ctx.Nilai" @bind:event="oninput" step="0.0001" min="0" />

                                            @if (ctx.Nilai > 0 && ctx.Kurs > 1m)
                                            {
                                                var idrAmount = ctx.Nilai * ctx.Kurs;
                                                <small style="color:#198754; font-weight:600;">= IDR @(idrAmount.ToString("N2"))</small>
                                            }
                                        </div>
                                    }
                                    @* Down Payment Amount Section for ARDP *@
                                    @if (ctx.Target == "ARDP")
                                    {
                                        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:8px; border-top:1px solid #dee2e6; padding-top:8px;">
                                            <label style="font-size:0.78rem; font-weight:600; color:#6c757d; text-transform:uppercase; margin:0;">Down Payment Amount (IDR) <span style="color:red;">*</span></label>
                                            <input type="number" class="form-control form-control-sm" placeholder="500000" style="max-width:150px;" @bind="ctx.Nilai" @bind:event="oninput" step="0.01" min="0" />
                                            <small style="color:#6c757d;">(Required)</small>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(ctx.PartyCode) && (ctx.Target == "AP" || ctx.Target == "AR"))
                                    {
                                        <div style="margin-top:8px;">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AllocateAmount(ctx)">
                                                <i class="bi bi-lightning-charge"></i> Auto Alokasi
                                            </button>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(ctx.PartyCode))
                                    {
                                        var allocDocs = ctx.OutstandingDocs?.Where(d => d.IsSelected || d.Bayar > 0 || d.Discount > 0).ToList();
                                        var totalBayar = allocDocs?.Sum(d => d.Bayar * (d.Kurs > 1 ? d.Kurs : 1m)) ?? 0m;
                                        var totalDiscount = allocDocs?.Sum(d => d.Discount * (d.Kurs > 1 ? d.Kurs : 1m)) ?? 0m;
                                        var srcAmt = Math.Abs(ctx.Amount);
                                        var selisih = srcAmt - totalBayar;
                                        var isShortfall = selisih > 0.01m;
                                        var isOver = selisih < -0.01m;
                                        <span class="alloc-badge @(isShortfall ? "warn" : isOver ? "over" : "exact")">
                                            @(allocDocs?.Count ?? 0) dok | Bayar @totalBayar.ToString("N2") / @srcAmt.ToString("N2") | Disc @totalDiscount.ToString("N2")
                                            @if (isShortfall)
                                            {
                                                <text> ⚠ Selisih: @selisih.ToString("N2")</text>
                                            }
                                            @if (isOver)
                                            {
                                                <text> ❌ Lebih: @((-selisih).ToString("N2"))</text>
                                            }
                                            @if (!isShortfall && !isOver)
                                            {
                                                <text> ✓</text>
                                            }
                                        </span>
                                    }
                                </td>
                            </tr>
                        }

                        @if ((ctx.Target == "AR" || ctx.Target == "AP") && ctx.OutstandingDocs != null && ctx.OutstandingDocs.Any())
                        {
                            <tr class="trx-detail-row">
                                <td colspan="9">
                                    <table class="doc-table">
                                            <thead>
                                                <tr>
                                                    <th style="width:32px"></th>
                                                    <th>Dokumen</th>
                                                    <th style="width:90px">Tgl/Due</th>
                                                    <th style="width:60px">Tipe</th>
                                                    <th style="width:110px; text-align:right">Sisa</th>
                                                    @if (ctx.Target == "AP")
                                                    {
                                                        <th style="width:130px; text-align:right">Sisa IDR</th>
                                                    }
                                                    <th style="width:120px; text-align:right">Bayar</th>
                                                    <th style="width:120px; text-align:right">Discount</th>
                                                    <th style="width:140px; text-align:right">Sisa</th>
                                                    <th style="width:170px">Aksi</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var d in ctx.OutstandingDocs)
                                                {
                                                    <tr class="@(d.IsSelected || d.Bayar > 0 || d.Discount > 0 ? "selected-doc" : "")" @key="d">
                                                        <td><input type="checkbox" checked="@d.IsSelected" @onchange="@(e => ToggleOutstandingSelected(ctx, d, e))" /></td>
                                                        <td>
                                                            <div><strong>@d.Dokumen</strong></div>
                                                            <div style="font-size:0.78rem; color:#6c757d;">@d.Label</div>
                                                        </td>
                                                        <td style="white-space:nowrap; font-size:0.82rem;">@(d.DueDate?.ToString("dd/MM/yy") ?? d.Tanggal.ToString("dd/MM/yy"))</td>
                                                        <td style="font-size:0.82rem;">@d.KodeTran</td>
                                                        <td style="text-align:right; font-size:0.82rem;">@d.Sisa.ToString("N2")</td>
                                                        @if (ctx.Target == "AP")
                                                        {
                                                            <td style="text-align:right; font-size:0.82rem; color:#198754;">@d.SisaIDR.ToString("N2")</td>
                                                        }
                                                        <td>
                                                            <InputNumber class="form-control form-control-sm" @bind-Value="d.Bayar" @bind-Value:after="@(() => NormalizeDocAllocation(ctx, d))" step="0.01" />
                                                        </td>
                                                        <td>
                                                            <InputNumber class="form-control form-control-sm" @bind-Value="d.Discount" @bind-Value:after="@(() => NormalizeDocAllocation(ctx, d))" step="0.01" />
                                                        </td>
                                                        <td style="text-align:right; font-size:0.8rem; white-space:nowrap;">
                                                            <div>Dok: @GetDocRemaining(d).ToString("N2")</div>
                                                            <div style="color:#0d6efd;">Trx: @GetTransactionRemainingIdr(ctx).ToString("N2")</div>
                                                        </td>
                                                        <td>
                                                            <div class="d-flex gap-1">
                                                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AllocateToRow(ctx, d, false)">Isi Bayar</button>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AllocateToRow(ctx, d, true)">Isi Disc</button>
                                                            </div>
                                                        </td>
