    private BankTransactionView ParseTransaction(IList<string> values)
    {
        try
        {
            // Normalize fields and handle two common formats:
            // Format A (6 columns): Date, Description, Branch, Amount, Type, Balance
            // Format B (5 columns): Date, Description, Branch, AmountWithSuffix(DB/CR), Balance

            string rawDate = CleanField(values.ElementAtOrDefault(0));
            string rawDesc = CleanField(values.ElementAtOrDefault(1));
            string rawBranch = CleanField(values.ElementAtOrDefault(2));
            string rawAmount = values.Count > 3 ? CleanField(values[3]) : string.Empty;
            string rawType = string.Empty;
            string rawBalance = string.Empty;

            if (values.Count >= 6)
            {
                rawType = CleanField(values[4]);
                rawBalance = CleanField(values[5]);
            }
            else if (values.Count == 5)
            {
                // amount may include DB/CR suffix
                rawBalance = CleanField(values[4]);
                var m = System.Text.RegularExpressions.Regex.Match(rawAmount, "(.*)\\s*(DB|CR)$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                if (m.Success)
                {
                    rawAmount = m.Groups[1].Value.Trim();
                    rawType = m.Groups[2].Value.ToUpper();
                }
            }

            var amount = ParseDecimalFromString(rawAmount);
            var balance = ParseDecimalFromString(rawBalance);

            DateTime tanggal = formModel.Date;
            if (!string.IsNullOrEmpty(rawDate) && !rawDate.Equals("PEND", StringComparison.OrdinalIgnoreCase))
            {
                if (!DateTime.TryParseExact(rawDate, new[] { "dd/MM/yyyy", "d/M/yyyy", "yyyy-MM-dd" }, CultureInfo.InvariantCulture, DateTimeStyles.None, out tanggal))
                {
                    DateTime.TryParse(rawDate, CultureInfo.InvariantCulture, DateTimeStyles.None, out tanggal);
                }
            }

            return new BankTransactionView
            {
                Date = rawDate,
                Description = rawDesc,
                Branch = rawBranch,
                Amount = amount,
                Type = rawType,
                Balance = balance,
                Tanggal = tanggal,
                IsSelected = true
            };
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error parsing transaction: {ex.Message}");
            return null;
        }
    }

    private static List<string> SplitCsvLine(string line)
    {
        var result = new List<string>();
        if (line == null) return result;

        var current = new System.Text.StringBuilder();
        bool inQuotes = false;
        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            if (c == '"')
            {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"')
                {
                    // Escaped quote
                    current.Append('"');
                    i++; // skip next
                }
                else
                {
                    inQuotes = !inQuotes;
                }
            }
            else if (c == ',' && !inQuotes)
            {
                result.Add(current.ToString());
                current.Clear();
            }
            else
            {
                current.Append(c);
            }
        }
        result.Add(current.ToString());
        return result;
    }

    private static string CleanField(string s)
    {
        if (s == null) return string.Empty;
        return s.Trim().Trim('"').Trim();
    }

    private static decimal ParseDecimalFromString(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return 0m;
        s = s.Trim();

        bool negative = false;
        if (s.StartsWith("(") && s.EndsWith(")"))
        {
            negative = true;
            s = s.Substring(1, s.Length - 2);
        }

        // remove any non-digit, non-separator characters except - and , and .
        s = System.Text.RegularExpressions.Regex.Replace(s, "[^0-9,\\.-]", "");

        int lastDot = s.LastIndexOf('.');
        int lastComma = s.LastIndexOf(',');
        char? decimalSep = null;
        if (lastDot >= 0 && lastComma >= 0)
        {
            decimalSep = lastDot > lastComma ? '.' : ',';
        }
        else if (lastDot >= 0) decimalSep = '.';
        else if (lastComma >= 0) decimalSep = ',';

        if (decimalSep.HasValue)
        {
            char ds = decimalSep.Value;
            // remove thousand separators (the other char)
            if (ds == '.') s = s.Replace(",", string.Empty);
            else s = s.Replace(".", string.Empty);
            // normalize decimal separator to dot
            if (ds == ',') s = s.Replace(',', '.');
        }
        else
        {
            // no separators, leave as is
        }

        if (!decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out decimal result))
        {
            result = 0m;
        }
        if (negative) result = -result;
        return result;
    }

    private async Task HandleValidSubmit()
    {
        // validate selection and show confirmation modal
        if (transactions == null || !transactions.Any(t => t.IsSelected))
        {
            await JS.InvokeVoidAsync("alert", "Tidak ada transaksi yang dipilih untuk disimpan.");
            return;
        }

        var (ok, msg) = ValidateSelections();
        if (!ok)
        {
            await JS.InvokeVoidAsync("alert", msg);
            return;
        }

        confirmMessage = string.Empty;
        showConfirm = true;
    }

    private (bool, string) ValidateSelections()
    {
        if (transactions == null) return (true, string.Empty);
        foreach (var t in transactions.Where(x => x.IsSelected))
        {
            if (t.Target != null && (t.Target.Equals("AR", StringComparison.OrdinalIgnoreCase) || t.Target.Equals("AP", StringComparison.OrdinalIgnoreCase)))
            {
                if (string.IsNullOrWhiteSpace(t.PartyCode))
                    return (false, $"Baris dengan deskripsi '{t.Description}' membutuhkan Customer/Supplier pilihan.");

                var sel = t.OutstandingDocs?.Where(d => d.IsSelected || d.Bayar > 0 || d.Discount > 0).ToList();
                if (sel == null || !sel.Any())
                    return (false, $"Baris dengan deskripsi '{t.Description}' harus memiliki minimal satu dokumen outstanding yang dipilih atau diisi Bayar/Discount.");

                foreach (var d in sel)
                {
                    if (d.Bayar <= 0 && d.Discount <= 0)
                        return (false, $"Dokumen {d.Dokumen} pada baris '{t.Description}' harus memiliki nilai Bayar atau Discount lebih besar dari 0.");

                    if (d.Bayar + d.Discount > d.Sisa + 0.01m)
                        return (false, $"Dokumen {d.Dokumen} pada baris '{t.Description}' melebihi sisa invoice ({d.Sisa:N2}). Kurangi Bayar/Discount.");
                }
                // convert to IDR for comparison against bank amount (handles foreign-currency AP docs)
                var kursMap = sel.ToDictionary(d => d, d => d.Kurs > 1 ? d.Kurs : 1m);
                var totalBayarIDR = sel.Sum(d => d.Bayar * kursMap[d]);
                var sourceAmt = Math.Abs(t.Amount);
                if (totalBayarIDR > sourceAmt + 0.01m)
                    return (false, $"Total Bayar ({totalBayarIDR:N2}) melebihi jumlah transaksi ({sourceAmt:N2}) pada baris '{t.Description}'. Kurangi nilai Bayar.");
                if (totalBayarIDR < sourceAmt - 0.01m)
                {
                    var selisih = sourceAmt - totalBayarIDR;
                    return (false, $"Total Bayar ({totalBayarIDR:N2}) kurang dari jumlah transaksi ({sourceAmt:N2}) pada baris '{t.Description}'. Selisih {selisih:N2} belum dialokasikan. Tambah dokumen, sesuaikan Bayar, atau ubah Target ke CB.");
                }
            }
            else if (t.Target != null && (t.Target.Equals("APDP", StringComparison.OrdinalIgnoreCase) || t.Target.Equals("ARDP", StringComparison.OrdinalIgnoreCase)))
            {
                // APDP/ARDP: downpayment, only need PartyCode and Amount
                if (string.IsNullOrWhiteSpace(t.PartyCode))
                    return (false, $"Baris dengan deskripsi '{t.Description}' membutuhkan Customer/Supplier pilihan.");

                if (Math.Abs(t.Amount) <= 0)
                    return (false, $"Baris dengan deskripsi '{t.Description}' membutuhkan Amount > 0 untuk downpayment.");
            }
        }
        return (true, string.Empty);
    }

    private void AllocateAmount(BankTransactionView ctx)
    {
        if (ctx == null || ctx.OutstandingDocs == null || !ctx.OutstandingDocs.Any()) return;

        // available amount from bank statement (IDR)
        decimal remaining = Math.Abs(ctx.Amount);

        // reset previous allocations
        foreach (var d in ctx.OutstandingDocs)
        {
            d.Bayar = 0;
            d.Discount = 0;
            d.IsSelected = false;
        }

        // allocate in order of due date then tanggal
        // for AP docs in foreign currency, compare SisaIDR (Sisa*Kurs) with remaining IDR
        foreach (var d in ctx.OutstandingDocs.OrderBy(x => x.DueDate ?? x.Tanggal))
        {
            if (remaining <= 0) break;
            var kurs = d.Kurs > 1 ? d.Kurs : 1m;
            var sisaIDR = d.Sisa * kurs;
            var canIDR = Math.Min(sisaIDR, remaining);
            if (canIDR > 0)
            {
                // Bayar stored in original currency so payment service updates ApHutang correctly
                d.Bayar = Math.Round(canIDR / kurs, 4);
                d.IsSelected = true;
                remaining -= canIDR;
            }
        }

        StateHasChanged();
    }

    private static decimal GetKursFactor(BankTransactionView.OutstandingDocView doc)
    {
        if (doc == null) return 1m;
        return doc.Kurs > 1 ? doc.Kurs : 1m;
    }

    private static decimal GetDocRemaining(BankTransactionView.OutstandingDocView doc)
    {
        if (doc == null) return 0m;
        return Math.Max(0m, doc.Sisa - (doc.Bayar + doc.Discount));
    }

    private decimal GetTransactionAllocatedIdr(BankTransactionView ctx)
    {
        if (ctx?.OutstandingDocs == null) return 0m;
        return ctx.OutstandingDocs.Sum(d => d.Bayar * GetKursFactor(d));
    }

    private decimal GetTransactionRemainingIdr(BankTransactionView ctx)
    {
        if (ctx == null) return 0m;
        var sourceAmt = Math.Abs(ctx.Amount);
        var allocated = GetTransactionAllocatedIdr(ctx);
        return Math.Max(0m, sourceAmt - allocated);
    }

    private void NormalizeDocAllocation(BankTransactionView ctx, BankTransactionView.OutstandingDocView doc)
    {
        if (ctx == null || doc == null) return;

        if (doc.Bayar < 0) doc.Bayar = 0;
        if (doc.Discount < 0) doc.Discount = 0;

        var maxDoc = Math.Max(0m, doc.Sisa);
        if (doc.Bayar > maxDoc)
        {
            doc.Bayar = maxDoc;
            doc.Discount = 0;
        }
        else if (doc.Bayar + doc.Discount > maxDoc)
        {
            doc.Discount = Math.Max(0m, maxDoc - doc.Bayar);
        }

        var sourceAmt = Math.Abs(ctx.Amount);
        var totalBayarIdr = GetTransactionAllocatedIdr(ctx);
        if (totalBayarIdr > sourceAmt)
        {
            var overIdr = totalBayarIdr - sourceAmt;
            var kurs = GetKursFactor(doc);
            var reduceBy = overIdr / kurs;

            doc.Bayar = Math.Max(0m, doc.Bayar - reduceBy);
        }

        if (doc.Bayar > 0 || doc.Discount > 0)
        {
            doc.IsSelected = true;
        }
    }

    private void AllocateToRow(BankTransactionView ctx, BankTransactionView.OutstandingDocView doc, bool toDiscount)
    {
        if (ctx == null || doc == null) return;

        NormalizeDocAllocation(ctx, doc);

        var kurs = GetKursFactor(doc);
        var remainingTrxIdr = GetTransactionRemainingIdr(ctx);
        var docRemainingIdr = GetDocRemaining(doc) * kurs;
        var allocateIdr = toDiscount ? docRemainingIdr : Math.Min(remainingTrxIdr, docRemainingIdr);

        if (allocateIdr <= 0) return;

        var addAmount = Math.Round(allocateIdr / kurs, 4);
        if (toDiscount)
        {
            doc.Discount += addAmount;
        }
        else
        {
            doc.Bayar += addAmount;
        }

        doc.IsSelected = true;
        NormalizeDocAllocation(ctx, doc);
        StateHasChanged();
    }

    private async Task ConfirmSave()
    {
        showConfirm = false;
        await DoSaveAsync();
    }

    private async Task DoSaveAsync()
    {
        isProcessing = true;
        StateHasChanged();

        try
        {
            await service.SaveTransactionsAsync(transactions, formModel.Date, formModel.BankName, "X1", "Y1");
            await JS.InvokeVoidAsync("alert", "Proses Sudah Selesai");
            transactions.Clear();
            formModel = new BankTransactionFormModel();
        }
        catch (Exception ex)
        {
            // store full exception text so user can see stacktrace in UI
            Console.Error.WriteLine($"Error saving transactions: {ex}");
            lastErrorDetails = ex.ToString();
            showErrorDetails = true;
            parseErrors.Add($"Error saving: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Terjadi kesalahan saat menyimpan. Periksa pesan error.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task CopyLastError()
    {
        if (string.IsNullOrEmpty(lastErrorDetails)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", lastErrorDetails);
    }

    void LoadBank()
    {
        banks = service.GetBank();
        SourceCode = service.GetSrcCode();
    }

    private void DeleteSelectedTransactions() => transactions.RemoveAll(t => t.IsSelected);

    private void UncheckDuplicates()
    {
        if (transactions == null) return;
        foreach (var t in transactions.Where(t => t.IsDuplicate))
            t.IsSelected = false;

        selectAll = transactions.All(x => x.IsSelected);
        StateHasChanged();
    }

    private void SelectAllRows()
    {
        if (transactions == null) return;
        foreach (var t in transactions)
            t.IsSelected = true;
        selectAll = true;
        StateHasChanged();
    }

    private void SelectNonDuplicateRows()
    {
        if (transactions == null) return;
        foreach (var t in transactions)
            t.IsSelected = !t.IsDuplicate;
        selectAll = transactions.All(x => x.IsSelected);
        StateHasChanged();
    }

    private void SelectAllChanged(ChangeEventArgs e)
    {
        if (transactions == null) return;
        selectAll = e?.Value as bool? ?? false;
        foreach (var t in transactions)
            t.IsSelected = selectAll;
    }

    private void ToggleSelection(BankTransactionView item, ChangeEventArgs e)
    {
        if (item == null || transactions == null) return;

        item.IsSelected = e?.Value as bool? ?? false;
        selectAll = transactions.All(x => x.IsSelected);
    }

    public class BankTransactionFormModel
    {
        [Required]
        public string BankName { get; set; }
        public DateTime Date { get; set; } = DateTime.Today;
    }

}
