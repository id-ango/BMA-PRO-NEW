@using eSoft.Penjualan.Model
@using eSoft.Penjualan.View
@using eSoft.Persediaan.Model
@using eSoft.Persediaan.View

<div class="modal fade show modal-shell" role="dialog" style="display:block">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header modal-header-shell modal-header-success">
                <h5 class="modal-title">Detail Transaksi</h5>
                <button type="button" class="btn-close modal-close-button" aria-label="Close" @onclick="@ModalOk"></button>
            </div>
            <div class="modal-body modal-body-shell">
                <EditForm Model="@Detail">
                    <div class="modal-form-grid">
                        <div class="modal-form-group modal-form-group-wide">
                            <label class="form-label">Item</label>
                            <div class="modal-inline-actions">
                                <InputSelect class="form-select" @bind-Value="Detail.ItemCode" @oninput="OnChangeItem">
                                    <option value="">---Select Item Code---</option>
                                    @foreach (var item in SrcCode)
                                    {
                                        <option value="@item.ItemCode">@item.NamaItem</option>
                                    }
                                </InputSelect>
                                <button class="btn btn-outline-primary" type="button" @onclick="@(()=> SearchOpen = !SearchOpen)">Cari</button>
                            </div>
                        </div>

                        <div class="modal-form-group modal-form-group-wide">
                            <label class="form-label">Nama Item</label>
                            <InputText class="form-control" @bind-Value="@Detail.NamaItem"></InputText>
                        </div>

                        <div class="modal-form-group">
                            <label class="form-label">Qty</label>
                            <InputNumber class="form-control" @bind-Value="@Detail.Qty" @onfocusout="UbahJumlah"></InputNumber>
                        </div>

                        <div class="modal-form-group">
                            <label class="form-label">Harga</label>
                            <InputNumber class="form-control" @bind-Value="@Detail.Harga" @onfocusout="UbahJumlah"></InputNumber>
                        </div>

                        <div class="modal-form-group">
                            <label class="form-label">Persen Diskon</label>
                            <InputNumber class="form-control" @bind-Value="@Detail.Persen" @onfocusout="rubahDiskon"></InputNumber>
                        </div>

                        <div class="modal-form-group">
                            <label class="form-label">Diskon</label>
                            <InputNumber class="form-control" @bind-Value="@Detail.Discount" @onfocusout="UbahJumlah"></InputNumber>
                        </div>

                        <div class="modal-form-group">
                            <label class="form-label">Jumlah</label>
                            <InputNumber class="form-control" @bind-Value="@Detail.Jumlah"></InputNumber>
                        </div>

                        <div class="modal-form-group">
                            <label class="form-label">Lokasi</label>
                            <InputSelect class="form-select" @bind-Value="Detail.Lokasi">
                                <option value="">---Select Lokasi---</option>
                                @foreach (var item in Location)
                                {
                                    <option value="@item.Lokasi">@item.NamaLokasi</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </EditForm>
            </div>
            <div class="modal-footer modal-footer-shell">
                <button type="button" class="btn btn-outline-secondary" @onclick="@ModalOk">Close</button>
                <button type="submit" class="btn btn-primary" @onclick="@SaveDetail">Save</button>
            </div>
        </div>
    </div>
</div>

@if (SearchOpen)
{

    <ModalSearchComponent OnClose="OnSearchClose" Items="SrcCode" Context="cbBank" GetFilterableText="@(item =>$"{item.ItemCode} {item.NamaItem} ")">
        <TableHeader>
            <th scope="col">Code</th>
            <th scope="col">Name</th>
            <th scope="col">Satuan</th>
            <th scope="col">Qty</th>
            <th></th>
        </TableHeader>
        <RowTemplate>
            <td>@cbBank.ItemCode</td>
            <td>@cbBank.NamaItem</td>
            <td>@cbBank.Satuan</td>
            <td>@cbBank.Qty</td>
            <td>
                <button @onclick="() => BtnChoose(cbBank.ItemCode)" class="btn btn-success">Choose</button>

            </td>
        </RowTemplate>
    </ModalSearchComponent>


}

@code{

    [Parameter]
    public string Currency { get; set; }

    [Parameter]
    public List<IcItem> SrcCode { get; set; }

    [Parameter]
    public List<IcLokasi> Location { get; set; }

    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    [Parameter]
    public EventCallback<OeTransDView> OnDetail { get; set; }

    [Parameter]
    public OeTransDView DetailRubah { get; set; }

    [Parameter]
    public bool isEdit { get; set; }

    public OeTransDView Detail = new OeTransDView();

    public bool SearchOpen { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (isEdit)
        {
            Detail = DetailRubah;
        }
    }

    private Task ModalOk()
    {
        return OnClose.InvokeAsync(true);
    }

    private Task SaveDetail()
    {
        return OnDetail.InvokeAsync(Detail);

    }

    private void UbahJumlah()
    {
      
        Detail.Jumlah = (Detail.Qty * Detail.Harga)-Detail.Discount;

    }

    private void BtnChoose(string textSearch)
    {
        if (!string.IsNullOrEmpty(textSearch))
        {
            Detail.ItemCode = textSearch;
            var itemcode = (from e in SrcCode where e.ItemCode == Detail.ItemCode select e).FirstOrDefault();
            Detail.NamaItem = itemcode.NamaItem;
            Detail.Satuan = itemcode.Satuan;
            Detail.Harga = itemcode.HrgJual;
            Detail.HrgCost = itemcode.HrgNetto;

        }

        SearchOpen = false;
        StateHasChanged();
    }

    private void OnSearchClose(bool accepted)
    {

        SearchOpen = false;
        StateHasChanged();

    }


    public void OnChangeItem(ChangeEventArgs args)
    {

        var itemcode = (from e in SrcCode where e.ItemCode == args.Value.ToString() select e).FirstOrDefault();
        Detail.NamaItem = itemcode.NamaItem;
        Detail.Satuan = itemcode.Satuan;
        Detail.Harga = itemcode.HrgJual;
        Detail.HrgCost = itemcode.HrgNetto;
        //if (Detail.Lokasi == null)
        //{
        //    Transd.Lokasi = Transh.Lokasi;
        //}
        //this.ItemId = itemData.IcItemId;
        //Transd.NamaItem = serviceInv.GetIcItemId(this.ItemId).NamaItem;

    }

    private void rubahDiskon()
    {

        var price = Detail.Qty * Detail.Harga;
        var Discount = price * Detail.Persen / 100;
        Detail.Discount = Discount;
       // Detail.Jumlah = (Detail.Qty * Detail.Harga) - Detail.Discount;
          Detail.Jumlah = price - Discount;
    }



}