@typeparam TItem
@using System.Collections.Generic
@using System.Linq

<div class="data-grid-shell">
    <div class="data-grid-toolbar">
        <div class="data-grid-summary">
            @if (TotalEnabled)
            {
                <span class="data-grid-summary-label">Total</span>
                <strong>@TotalJumlah.ToString("N")</strong>
            }
        </div>

        @if (SearchEnabled)
        {
            <div class="data-grid-search">
                <div class="data-grid-search-input-wrap">
                    <input class="form-control data-grid-search-input" type="search" placeholder="Search" aria-label="Search" value="@searchText" @oninput="HandleSearchInput">
                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <button type="button" class="data-grid-search-clear" @onclick="ClearSearch" aria-label="Clear search">×</button>
                    }
                </div>
            </div>
        }
    </div>

    <div class="table-responsive data-grid-table-wrap">
        <table class="table table-striped table-hover align-middle data-grid-table">
            <thead>
                <tr>@TableHeader</tr>
            </thead>
            <tbody>
                @foreach (var item in GetPageItems())
                {
                    <tr>@RowTemplate(item)</tr>
                }
            </tbody>
        </table>
    </div>

    <div class="data-grid-footer">
        <div class="data-grid-page-status">
            Page <input class="form-control data-grid-page-input" type="number" max="@TotalPage" min="1" @bind-value="currentPageNumber" @bind-value:event="oninput" /> of @TotalPage
        </div>

        <div class="data-grid-pagination">
            <button class="btn btn-outline-secondary" type="button" @onclick="BtnPrevPage">Prev</button>
            <button class="btn btn-outline-primary" type="button" @onclick="BtnNextPage">Next</button>
        </div>
    </div>
</div>
@code {

    [Parameter]
    public RenderFragment TableHeader { get; set; }

    [Parameter]
    public RenderFragment<TItem> RowTemplate { get; set; }

    [Parameter]
    public IEnumerable<TItem> Items { get; set; }

    [Parameter]
    public decimal TotalJumlah { get; set; } = 0;

    [Parameter]
    public Func<TItem, string> GetFilterableText { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 20;

    [Parameter]
    public bool TotalEnabled { get; set; } = true;

    [Parameter]
    public bool SearchEnabled { get; set; } = true;


    private string searchText;

    private int currentPageNumber { get; set; } = 1;

    private int TotalPage { get; set; }

    private bool Enabled { get; set; } = true;

    private static readonly Func<TItem, string> DefaultGetFilterableText = item => BuildDefaultFilterableText(item);

    private IEnumerable<TItem> searchResult = null;

    //private void searchFind()
    //{
    //    Func<TItem, string> filterFunc = GetFilterableText ?? DefaultGetFilterableText;
    //    IEnumerable<TItem> result = (Items ?? Array.Empty<TItem>());
    //    if (!string.IsNullOrEmpty(searchText))
    //    {
    //        result = result.
    //        Where(x =>
    //        (GetFilterableText(x) ?? "")
    //        .Contains(searchText, StringComparison.InvariantCultureIgnoreCase));
    //    }
    //    Items = result;

    //    TotalPage = MaxPageNumber(Items.Count());
    //}

    private void searchFind()
    {
        Func<TItem, string> filterFunc = GetFilterableText ?? DefaultGetFilterableText;
        IEnumerable<TItem> result = (Items ?? Array.Empty<TItem>());

        if (!string.IsNullOrEmpty(searchText))
        {
            result = result.Where(x => (filterFunc(x) ?? string.Empty).Contains(searchText, StringComparison.InvariantCultureIgnoreCase));
        }

        searchResult = result;
        int maxPage = MaxPageNumber(searchResult.Count());

        // Jika halaman yang sedang aktif masih valid, jangan ubah
        if (currentPageNumber > maxPage)
        {
            currentPageNumber = Math.Max(1, maxPage);
        }

        TotalPage = maxPage;
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        searchFind();
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
        searchFind();
    }



    private int NumOfItemToSkip(int pageNumber)
    {
        if (Enabled)
        {
            return (pageNumber - 1) * PageSize;
        }
        return 0;
    }

    private int NumOfItemToTake(int totalItemsCount)
    {
        if (Enabled)
        {
            return PageSize;
        }
        return totalItemsCount;
    }


    private void BtnPrevPage()
    {
        if (currentPageNumber > 1)
        {
            currentPageNumber--;
        }
    }

    private void BtnNextPage()
    {
        if (currentPageNumber < TotalPage)
        {
            currentPageNumber++;
        }
    }


    protected override void OnInitialized()
    {
        TotalPage = MaxPageNumber((Items ?? Array.Empty<TItem>()).Count());
    }

    protected override void OnParametersSet()
    {
        if (searchResult == null)
        {
            TotalPage = MaxPageNumber((Items ?? Array.Empty<TItem>()).Count());
        }
        else
        {
            TotalPage = MaxPageNumber(searchResult.Count());
        }

        // Pertahankan halaman jika masih valid
        if (currentPageNumber > TotalPage)
        {
            currentPageNumber = Math.Max(1, TotalPage);
        }
    }


    private int MaxPageNumber(int totalItemCount)
    {
        int maxPageNumber;
        double numberOfPages = (double)totalItemCount / (double)PageSize;
        if (numberOfPages == Math.Floor(numberOfPages))
            maxPageNumber = (int)numberOfPages;
        else
            maxPageNumber = (int)numberOfPages + 1;

        return Math.Max(1, maxPageNumber);
    }

    private IEnumerable<TItem> GetPageItems()
    {
        if (searchResult == null)
        {
            var items = Items ?? Array.Empty<TItem>();
            return items.Skip(NumOfItemToSkip(currentPageNumber)).Take(NumOfItemToTake(items.Count()));
        }
        else
        {
            return searchResult.Skip(NumOfItemToSkip(currentPageNumber)).Take(NumOfItemToTake(searchResult.Count()));
        }
    }

    private static string BuildDefaultFilterableText(TItem item)
    {
        if (item is null)
        {
            return string.Empty;
        }

        var values = typeof(TItem)
            .GetProperties()
            .Where(property => property.CanRead)
            .Select(property => property.GetValue(item)?.ToString())
            .Where(value => !string.IsNullOrWhiteSpace(value));

        return string.Join(" ", values);
    }

}