<div class="modal fade show modal-shell" tabindex="-1" role="dialog" style="display:block">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header-shell @(TombolSave ? "modal-header-danger" : "modal-header-success")">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="btn-close modal-close-button" aria-label="Close" @onclick="@ModalCancel"></button>
            </div>
            <div class="modal-body modal-body-shell">
                <p>@Text</p>
            </div>
            <div class="modal-footer modal-footer-shell">
                @if (TombolSave)
                {
                    <button type="button" class="btn btn-primary" @onclick="@ModalOk">OK</button>
                }

                <button type="button" class="btn btn-outline-secondary" @onclick="@ModalCancel">Close</button>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public string Title { get; set; }
    [Parameter]
    public string Text { get; set; }
    [Parameter]
    public bool TombolSave { get; set; } = true;
    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    private Task ModalCancel()
    {
        return OnClose.InvokeAsync(false);
    }

    private Task ModalOk()
    {
        return OnClose.InvokeAsync(true);
    }
}