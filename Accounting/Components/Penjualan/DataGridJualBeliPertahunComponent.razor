<div style="display:block;position:relative;overflow:auto ">
    <table class="table table-striped table-hover">

        @*<thead>

        <tr>@TableHeader</tr>
        </thead>*@
        <tbody>
            @foreach (var transaksi in result)
            {
                <tr>
                    <td rowspan="4" style="width:20%">
                        @transaksi.NamaItem

                    </td>

                    <td style="text-align:right ; width:5% ; background-color:yellow "><strong>BELI</strong></td>
                    <td style="text-align:right ; width:15% ; background-color:yellow ">@transaksi.BeliBulan01.ToString("N")</td>
                    <td style="text-align:right ; width:15% ; background-color:yellow ">@transaksi.BeliBulan02.ToString("N")</td>
                    <td style="text-align:right ; width:15% ; background-color:yellow ">@transaksi.BeliBulan03.ToString("N")</td>
                    <td style="text-align:right ; width:15% ; background-color:yellow ">@transaksi.BeliBulan04.ToString("N")</td>
                    <td style="text-align:right  ; width:15% ; background-color:yellow ">@transaksi.BeliBulan05.ToString("N")</td>
                </tr>
                <tr></tr>
                <tr>
                    <td style="text-align:right ; width:5% ; background-color:aliceblue "><strong>JUAL</strong></td>
                    <td style="text-align:right ; width:15% ; background-color:aliceblue">@transaksi.Bulan01.ToString("N")</td>
                    <td style="text-align:right ; width:15% ; background-color:aliceblue">@transaksi.Bulan02.ToString("N")</td>
                    <td style="text-align:right ; width:15% ; background-color:aliceblue">@transaksi.Bulan03.ToString("N")</td>
                    <td style="text-align:right ; width:15% ; background-color:aliceblue">@transaksi.Bulan04.ToString("N")</td>
                    <td style="text-align:right ; width:15% ; background-color:aliceblue">@transaksi.Bulan05.ToString("N")</td>

                </tr>
                <tr></tr>
            }
        </tbody>

    </table>
</div>

