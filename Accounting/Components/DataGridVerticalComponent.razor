@typeparam TItem
@using System.Collections.Generic
@using System.Linq

<div class="vertical-grid-shell">
    <div class="vertical-grid-toolbar">
        <div class="vertical-grid-summary">
            @if (TotalEnabled)
            {
                <span class="vertical-grid-summary-label">Total</span>
                <strong>@DisplayTotalJumlah.ToString("N")</strong>
            }
        </div>

        @if (SearchEnabled)
        {
            <div class="vertical-grid-search">
                <div class="vertical-grid-search-input-wrap">
                    <input class="form-control vertical-grid-search-input" type="search" placeholder="Search" aria-label="Search" value="@searchText" @oninput="HandleSearchInput">
                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <button type="button" class="vertical-grid-search-clear" @onclick="ClearSearch" aria-label="Clear search">×</button>
                    }
                </div>
            </div>
        }
    </div>

    <div class="vertical-grid-card">
        <table class="table table-striped table-hover align-middle vertical-grid-table vertical-grid-table-head">
            <thead>
                <tr>@TableHeader</tr>
            </thead>
        </table>

        <div class="vertical-grid-scroll">
            <table class="table table-striped table-hover align-middle vertical-grid-table">
                <tbody>
                    @foreach (var item in FilteredItems)
                    {
                        <tr>@RowTemplate(item)</tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@code {

    [Parameter]
    public RenderFragment TableHeader { get; set; }

    [Parameter]
    public RenderFragment<TItem> RowTemplate { get; set; }

    [Parameter]
    public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();

    [Parameter]
    public Func<TItem, string> GetFilterableText { get; set; }

    [Parameter]
    public decimal TotalJumlah { get; set; } = 0;

    [Parameter]
    public bool TotalEnabled { get; set; } = true;

    [Parameter]
    public bool SearchEnabled { get; set; } = true;

    [Parameter]
    public string fieldName { get; set; }


    private string searchText = string.Empty;

    private static readonly Func<TItem, string> DefaultGetFilterableText = item => BuildDefaultFilterableText(item);

    private IEnumerable<TItem> FilteredItems { get; set; } = Enumerable.Empty<TItem>();

    private decimal DisplayTotalJumlah { get; set; }

    protected override void OnParametersSet()
    {
        ApplyFilter();
    }

    private void searchFind()
    {
        ApplyFilter();
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var sourceItems = Items ?? Enumerable.Empty<TItem>();
        var filterFunc = GetFilterableText ?? DefaultGetFilterableText;

        if (string.IsNullOrWhiteSpace(searchText))
        {
            FilteredItems = sourceItems;
        }
        else
        {
            FilteredItems = sourceItems.Where(x =>
                (filterFunc(x) ?? string.Empty)
                    .Contains(searchText, StringComparison.InvariantCultureIgnoreCase));
        }

        DisplayTotalJumlah = string.IsNullOrWhiteSpace(fieldName)
            ? TotalJumlah
            : CalculateTotalJumlah(FilteredItems);
    }

    private decimal CalculateTotalJumlah(IEnumerable<TItem> items)
    {
        decimal total = 0;

        foreach (var item in items)
        {
            total += GetAmountFromTItem(item);
        }

        return total;
    }

    private decimal GetAmountFromTItem(TItem item)
    {
        if (string.IsNullOrWhiteSpace(fieldName) || item is null)
        {
            return 0;
        }

        var propertyInfo = typeof(TItem).GetProperty(fieldName);
        if (propertyInfo is null)
        {
            return 0;
        }

        var value = propertyInfo.GetValue(item);
        if (value is null)
        {
            return 0;
        }

        try
        {
            return Convert.ToDecimal(value);
        }
        catch
        {
            return 0;
        }
    }

    private static string BuildDefaultFilterableText(TItem item)
    {
        if (item is null)
        {
            return string.Empty;
        }

        var values = typeof(TItem)
            .GetProperties()
            .Where(property => property.CanRead)
            .Select(property => property.GetValue(item)?.ToString())
            .Where(value => !string.IsNullOrWhiteSpace(value));

        return string.Join(" ", values);
    }

}
