@typeparam TItem
@using System.Collections.Generic
@using System.Linq


<div class="bg-light justify-content-between">
    @if (TotalEnabled)
    {
        @DisplayTotalJumlah.ToString("N")
    }


    @if (SearchEnabled)
    {
        <p align="right">
            <input class="mr-sm-2" type="search" placeholder="Search" aria-label="Search" @bind-value="searchText">
            <button class="btn btn-outline-success my-2 my-sm-0" type="button" @onclick="searchFind">Search</button>
        </p>
    }
    else
    {
        <p>
            &emsp;
        </p>
    }
</div>
<table class="table table-striped table-hover">

    <thead>

        <tr>@TableHeader</tr>
    </thead>
</table>
<div style="display:block;position:relative;height:430px;overflow:auto ">
    <table class="table table-striped table-hover">

        @*<thead>

            <tr>@TableHeader</tr>
            </thead>*@
        <tbody>
            @foreach (var item in FilteredItems)
            {
                <tr>@RowTemplate(item)</tr>
            }
        </tbody>

    </table>
</div>
@code {

    [Parameter]
    public RenderFragment TableHeader { get; set; }

    [Parameter]
    public RenderFragment<TItem> RowTemplate { get; set; }

    [Parameter]
    public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();

    [Parameter]
    public Func<TItem, string> GetFilterableText { get; set; }

    [Parameter]
    public decimal TotalJumlah { get; set; } = 0;

    [Parameter]
    public bool TotalEnabled { get; set; } = true;

    [Parameter]
    public bool SearchEnabled { get; set; } = true;

    [Parameter]
    public string fieldName { get; set; }


    private string searchText = string.Empty;

    private static readonly Func<TItem, string> DefaultGetFilterableText = item => item?.ToString() ?? string.Empty;

    private IEnumerable<TItem> FilteredItems { get; set; } = Enumerable.Empty<TItem>();

    private decimal DisplayTotalJumlah { get; set; }

    protected override void OnParametersSet()
    {
        ApplyFilter();
    }

    private void searchFind()
    {
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var sourceItems = Items ?? Enumerable.Empty<TItem>();
        var filterFunc = GetFilterableText ?? DefaultGetFilterableText;

        if (string.IsNullOrWhiteSpace(searchText))
        {
            FilteredItems = sourceItems;
        }
        else
        {
            FilteredItems = sourceItems.Where(x =>
                (filterFunc(x) ?? string.Empty)
                    .Contains(searchText, StringComparison.InvariantCultureIgnoreCase));
        }

        DisplayTotalJumlah = string.IsNullOrWhiteSpace(fieldName)
            ? TotalJumlah
            : CalculateTotalJumlah(FilteredItems);
    }

    private decimal CalculateTotalJumlah(IEnumerable<TItem> items)
    {
        decimal total = 0;

        foreach (var item in items)
        {
            total += GetAmountFromTItem(item);
        }

        return total;
    }

    private decimal GetAmountFromTItem(TItem item)
    {
        if (string.IsNullOrWhiteSpace(fieldName) || item is null)
        {
            return 0;
        }

        var propertyInfo = typeof(TItem).GetProperty(fieldName);
        if (propertyInfo is null)
        {
            return 0;
        }

        var value = propertyInfo.GetValue(item);
        if (value is null)
        {
            return 0;
        }

        try
        {
            return Convert.ToDecimal(value);
        }
        catch
        {
            return 0;
        }
    }

}
