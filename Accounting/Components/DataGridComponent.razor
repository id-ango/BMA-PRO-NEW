@typeparam TItem
@using System.Collections.Generic
@using System.Linq

<div class="data-grid-shell">
    <div class="data-grid-toolbar">
        <div class="data-grid-toolbar-panel data-grid-summary-panel">
            <div class="data-grid-summary">
                @if (TotalEnabled)
                {
                    <span class="data-grid-summary-label">Total</span>
                    <strong>@TotalJumlah.ToString(TotalFormat)</strong>
                }
            </div>
        </div>

        @if (SearchEnabled)
        {
            <div class="data-grid-toolbar-panel data-grid-search-panel">
                <div class="data-grid-search">
                    <div class="data-grid-search-input-wrap">
                        <span class="data-grid-search-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                            </svg>
                        </span>
                        <input class="form-control data-grid-search-input" type="search" placeholder="Search" aria-label="Search" value="@searchText" @oninput="HandleSearchInput">
                        @if (!string.IsNullOrWhiteSpace(searchText))
                        {
                            <button type="button" class="data-grid-search-clear" @onclick="ClearSearch" aria-label="Clear search">×</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="table-responsive data-grid-table-wrap">
        <table class="table table-hover table-bordered align-middle data-grid-table">
            <thead>
                <tr>@TableHeader</tr>
            </thead>
            <tbody>
                @foreach (var item in GetPageItems())
                {
                    <tr style="@GetRowStyle?.Invoke(item)">@RowTemplate(item)</tr>
                }
            </tbody>
        </table>
    </div>

    <div class="data-grid-footer">
        <div class="data-grid-page-status">
            Page <input class="form-control data-grid-page-input" type="number" max="@TotalPage" min="1" @bind-value="currentPageNumber" @bind-value:event="oninput" /> of @TotalPage
        </div>

        <div class="data-grid-pagination">
            <button class="btn btn-outline-secondary" type="button" @onclick="BtnPrevPage">Prev</button>
            <button class="btn btn-outline-primary" type="button" @onclick="BtnNextPage">Next</button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public RenderFragment TableHeader { get; set; }

    [Parameter]
    public RenderFragment<TItem> RowTemplate { get; set; }

    [Parameter]
    public IEnumerable<TItem> Items { get; set; }

    [Parameter]
    public decimal TotalJumlah { get; set; } = 0;

    [Parameter]
    public string TotalFormat { get; set; } = "N";

    [Parameter]
    public Func<TItem, string> GetFilterableText { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 20;

    [Parameter]
    public bool TotalEnabled { get; set; } = true;

    [Parameter]
    public bool SearchEnabled { get; set; } = true;

    [Parameter]
    public Func<TItem, decimal> PropertyJumlahSelector { get; set; }

    [Parameter]
    public Func<TItem, string> GetRowStyle { get; set; }

    private string searchText;
    private int currentPageNumber = 1;
    private int TotalPage { get; set; }
    private bool Enabled { get; set; } = true;
    private static readonly Func<TItem, string> DefaultGetFilterableText = item => (item?.ToString() ?? "");
    private IEnumerable<TItem> searchResult = null;

    private void searchFind()
    {
        Func<TItem, string> filterFunc = GetFilterableText ?? DefaultGetFilterableText;
        IEnumerable<TItem> result = (Items ?? Array.Empty<TItem>());
        if (!string.IsNullOrEmpty(searchText))
        {
            result = result.Where(x => filterFunc(x).Contains(searchText, StringComparison.InvariantCultureIgnoreCase));
        }
        searchResult = result;
        UpdatePagination();
        if (PropertyJumlahSelector != null)
        {
            CalculateTotalJumlah();
        }
        currentPageNumber = 1;
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        searchFind();
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
        searchFind();
    }

    private void BtnPrevPage()
    {
        if (currentPageNumber > 1)
        {
            currentPageNumber--;
        }
    }

    private void BtnNextPage()
    {
        if (currentPageNumber < TotalPage)
        {
            currentPageNumber++;
        }
    }

    protected override void OnParametersSet()
    {
        UpdatePagination();
        if (PropertyJumlahSelector != null)
        {
            CalculateTotalJumlah();
        }
    }

    private void UpdatePagination()
    {
        var itemCount = (searchResult ?? Items ?? Array.Empty<TItem>()).Count();
        TotalPage = MaxPageNumber(itemCount);

        // Ensure currentPageNumber is within valid range
        if (currentPageNumber > TotalPage)
        {
            currentPageNumber = 1;
        }
    }

    private void CalculateTotalJumlah()
    {
        TotalJumlah = (searchResult ?? Items ?? Array.Empty<TItem>()).Sum(PropertyJumlahSelector);
    }

    private int MaxPageNumber(int totalItemCount)
    {
        return Math.Max(1, (int)Math.Ceiling((double)totalItemCount / PageSize));
    }

    private IEnumerable<TItem> GetPageItems()
    {
        var itemsToPaginate = searchResult ?? Items ?? Array.Empty<TItem>();
        return itemsToPaginate
            .Skip((currentPageNumber - 1) * PageSize)
            .Take(PageSize);
    }
}
