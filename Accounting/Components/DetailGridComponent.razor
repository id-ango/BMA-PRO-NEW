@typeparam TItem
@using System.Collections.Generic
@using System.Linq

<div class="detail-grid-shell">
    <div class="table-responsive detail-grid-table-wrap">
        <table class="table table-striped table-hover align-middle detail-grid-table">
            <thead>
                <tr>@TableHeader</tr>
            </thead>
            <tbody>
                @if (WithPage)
                {
                    @foreach (var item in CurrentItems)
                    {
                        <tr>@RowTemplate(item)</tr>
                    }
                }
                else
                {
                    @foreach (var item in SafeItems)
                    {
                        <tr>@RowTemplate(item)</tr>
                    }
                }

            </tbody>

        </table>
    </div>
@if (WithPage)
{

    <div class="detail-grid-footer">
        <div class="detail-grid-page-status">
            Page <input class="form-control detail-grid-page-input" type="number" max="@TotalPage" min="1" @bind-value="currentPageNumber" @bind-value:event="oninput" /> of @TotalPage
        </div>

        <div class="detail-grid-pagination">
            <button class="btn btn-outline-secondary" type="button" @onclick="BtnPrevPage">Prev</button>
            <button class="btn btn-outline-primary" type="button" @onclick="BtnNextPage">Next</button>
        </div>
    </div>

}
</div>

@code {

    [Parameter]
    public RenderFragment TableHeader { get; set; }

    [Parameter]
    public RenderFragment<TItem> RowTemplate { get; set; }

    [Parameter]
    public IEnumerable<TItem> Items { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public bool WithPage { get; set; } = false;

    private IEnumerable<TItem> SafeItems => Items ?? Enumerable.Empty<TItem>();

    private IEnumerable<TItem> CurrentItems => SafeItems.Skip(NumOfItemToSkip(currentPageNumber)).Take(NumOfItemToTake(SafeItems.Count()));

    private int currentPageNumber { get; set; } = 1;

    private int TotalPage { get; set; }

    private bool Enabled { get; set; } = true;


    private int NumOfItemToSkip(int pageNumber)
    {
        if (Enabled)
        {
            return (pageNumber - 1) * PageSize;
        }
        return 0;
    }

    private int NumOfItemToTake(int totalItemsCount)
    {
        if (Enabled)
        {
            return PageSize;
        }
        return totalItemsCount;
    }


    private void BtnPrevPage()
    {
        currentPageNumber = currentPageNumber - 1;
        if (currentPageNumber <= 0)
            currentPageNumber = 1;
    }

    private void BtnNextPage()
    {
        // TotalPage = MaxPageNumber(Items.Count());
        currentPageNumber = currentPageNumber + 1;
        if (currentPageNumber > TotalPage)
            currentPageNumber = TotalPage;
    }

    protected override void OnInitialized()
    {
        TotalPage = MaxPageNumber(SafeItems.Count());
    }

    protected override void OnParametersSet()
    {
        TotalPage = MaxPageNumber(SafeItems.Count());
        if (currentPageNumber > TotalPage)
        {
            currentPageNumber = TotalPage;
        }
    }

    private int MaxPageNumber(int totalItemCount)
    {
        int maxPageNumber;
        double numberOfPages = (double)totalItemCount / (double)PageSize;
        if (numberOfPages == Math.Floor(numberOfPages))
            maxPageNumber = (int)numberOfPages;
        else
            maxPageNumber = (int)numberOfPages + 1;

        return Math.Max(1, maxPageNumber);
    }
}