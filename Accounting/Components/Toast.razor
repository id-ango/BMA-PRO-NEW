<div class="toast-container">
    @if (IsVisible)
    {
        <div class="toast toast-shell show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header toast-header-shell">
                <strong class="me-auto">Error</strong>
                <button type="button" class="btn-close" aria-label="Close" @onclick="HideToast"></button>
            </div>
            <div class="toast-body toast-body-shell">
                @ErrorMessage
            </div>
        </div>
    }
</div>

@code {
    private bool IsVisible { get; set; }
    private string ErrorMessage { get; set; }

    public void ShowToast(string message)
    {
        IsVisible = true;
        ErrorMessage = message;
        StateHasChanged();

        // Auto-hide the toast after a certain duration
        Task.Delay(5000).ContinueWith(_ =>
        {
            HideToast();
        });
    }

    private void HideToast()
    {
        IsVisible = false;
        ErrorMessage = string.Empty;
        StateHasChanged();
    }
}
