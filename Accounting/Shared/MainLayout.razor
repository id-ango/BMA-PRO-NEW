@inherits LayoutComponentBase

<PageTitle>@AppBranding.CompanyName</PageTitle>

<div class="app-shell">
    <aside class="app-sidebar">
        <div class="app-sidebar-inner">
            <NavMenu />
        </div>
    </aside>

    <main class="app-main">
        <header class="app-header">
            <div class="app-header-copy">
                <span class="app-header-eyebrow">Business Management</span>
                <div class="app-header-title-group">
                    <strong class="app-header-title">@AppBranding.CompanyName Workspace</strong>
                    <span class="app-header-subtitle">@AppBranding.WorkspaceSubtitle</span>
                </div>
            </div>

            <div class="app-header-actions">
                <div class="app-status-pill">.NET 10 • Blazor</div>
            </div>
        </header>

        <section class="app-content-shell">
            <div class="app-content-intro">
                <div>
                    <span class="app-content-eyebrow">Operational Console</span>
                    <p class="app-content-summary">Kelola transaksi, laporan, dan administrasi dari satu panel kerja yang lebih modern.</p>
                </div>
            </div>

            <article class="content app-content">
                @Body
            </article>
        </section>
    </main>
</div>
