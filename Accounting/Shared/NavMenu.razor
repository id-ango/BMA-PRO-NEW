@code {
    private bool collapseNavMenu = true;
    private string? activeSection;
    private string? expandedSection;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        SyncExpandedSectionWithRoute();
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private bool IsExpanded(string section)
    {
        return string.Equals(expandedSection, section, StringComparison.Ordinal);
    }

    private bool IsActiveSection(string section)
    {
        return string.Equals(activeSection, section, StringComparison.Ordinal);
    }

    private string GetNavButtonClass(string section)
    {
        var classes = "nav-link nav-link-button";

        if (IsExpanded(section))
        {
            classes += " nav-group-expanded";
        }

        if (IsActiveSection(section))
        {
            classes += " nav-group-active";
        }

        return classes;
    }

    private void ToggleSection(string section)
    {
        expandedSection = IsExpanded(section) ? null : section;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncExpandedSectionWithRoute();
        InvokeAsync(StateHasChanged);
    }

    private void SyncExpandedSectionWithRoute()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        activeSection = GetSectionFromPath(relativePath);
        expandedSection = activeSection;
    }

    private static string? GetSectionFromPath(string? relativePath)
    {
        if (string.IsNullOrWhiteSpace(relativePath))
        {
            return null;
        }

        var normalizedPath = relativePath.Split('?', '#')[0].Trim('/');

        if (normalizedPath.StartsWith("ModuleJual", StringComparison.OrdinalIgnoreCase))
        {
            return "Penjualan";
        }

        if (normalizedPath.StartsWith("ModuleBeli", StringComparison.OrdinalIgnoreCase))
        {
            return "Pembelian";
        }

        if (normalizedPath.StartsWith("ModulePersediaan", StringComparison.OrdinalIgnoreCase))
        {
            return normalizedPath.Contains("RubahItemDivisi", StringComparison.OrdinalIgnoreCase)
                ? "Maintenance"
                : "Persediaan";
        }

        if (normalizedPath.StartsWith("ModuleHutang", StringComparison.OrdinalIgnoreCase))
        {
            return "Hutang";
        }

        if (normalizedPath.StartsWith("ModulePiutang", StringComparison.OrdinalIgnoreCase))
        {
            return "Piutang";
        }

        if (normalizedPath.StartsWith("ModuleBank", StringComparison.OrdinalIgnoreCase))
        {
            return "CashBank";
        }

        if (normalizedPath.StartsWith("ModuleAsset", StringComparison.OrdinalIgnoreCase))
        {
            return "Asset";
        }

        if (normalizedPath.StartsWith("ModuleLedger", StringComparison.OrdinalIgnoreCase))
        {
            return "Ledger";
        }

        if (normalizedPath.StartsWith("ModuleFinancial", StringComparison.OrdinalIgnoreCase))
        {
            return "Financial";
        }

        if (normalizedPath.StartsWith("ModuleAdministration", StringComparison.OrdinalIgnoreCase))
        {
            return "Administration";
        }

        if (normalizedPath.StartsWith("ModuleMaintenance", StringComparison.OrdinalIgnoreCase)
            || normalizedPath.StartsWith("ModuleTestRun", StringComparison.OrdinalIgnoreCase))
        {
            return "Maintenance";
        }

        return null;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
